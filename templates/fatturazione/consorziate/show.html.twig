{% extends "layout/base.html.twig" %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/fatturazione/consorziate_show.css">
{% endblock %}

{# ── Macro: render the "Nostra fattura" cell content ────────────────────
   Period-scoped only: totals + righe whose data is inside [from, to].
   VERDE  = riga passata per una bozza APPLICATA (status fatturata)
   ARANCIO = riga in una bozza ancora in lavorazione (non applicata) #}
{% macro nostra_fattura_cell(nostraFatturaTotal, nostraBozzaTotal, righe) %}
    {% set righeInPeriod = righe|filter(rf => rf.in_period) %}
    {% if nostraFatturaTotal > 0 or nostraBozzaTotal > 0 or righeInPeriod|length > 0 %}
        {% if nostraFatturaTotal > 0 %}
            <div class="fc-nostra-tot is-applied" title="Bozza applicata (fatturata)">€ {{ nostraFatturaTotal|number_format(2, ',', '.') }}</div>
        {% endif %}
        {% if nostraBozzaTotal > 0 %}
            <div class="fc-nostra-tot is-pending" title="Bozza in lavorazione, non ancora applicata">€ {{ nostraBozzaTotal|number_format(2, ',', '.') }} <span class="fc-nostra-tag">in bozza</span></div>
        {% endif %}
        {% if righeInPeriod|length > 0 %}
            {# righe nascoste di default: a prima vista si vedono solo i totali #}
            <button type="button" class="fc-righe-toggle" data-toggle-righe>
                {{ righeInPeriod|length }} rig{{ righeInPeriod|length == 1 ? 'a' : 'he' }}
                <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="fc-righe-list fc-righe-list-in hidden">
            {% for rf in righeInPeriod %}
                <li>
                    <span class="fc-righe-date">{% if rf.data %}{{ rf.data|date('d/m/Y') }}{% endif %}</span>
                    <span class="fc-righe-descr" title="{{ rf.descrizione|e('html_attr') }}">{{ rf.descrizione }}</span>
                    <span class="fc-righe-amt {{ rf.applied ? 'is-applied' : 'is-pending' }}"
                          title="{{ rf.applied ? 'Bozza applicata' : 'Bozza in lavorazione' }}">€ {{ rf.totale_imponibile|number_format(2, ',', '.') }}</span>
                </li>
            {% endfor %}
            </ul>
        {% endif %}
    {% else %}<span class="fp-dash">—</span>{% endif %}
{% endmacro %}

{% import _self as nf %}

{% block content %}
<div class="fp-page">

    {# ── Hero ── #}
    <div class="fp-hero">
        <div class="fp-hero-content">
            <div class="fp-hero-left">
                <div class="fp-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                    <p class="fp-hero-breadcrumb">
                        <a href="/fatturazione/consorziate">Pagamenti Consorziate</a>
                        <span style="opacity:.4; margin:0 4px;">›</span>
                        {{ consorziata.name }}
                    </p>
                    <h1 class="fp-hero-title">{{ consorziata.name }}</h1>
                    <p class="fp-hero-period">Periodo: <strong>{{ fromLabel }}</strong> – <strong>{{ toLabel }}</strong></p>
                </div>
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
                {% if rows is not empty %}
                <a href="/fatturazione/consorziate/{{ consorziata.id }}/export?from={{ from }}&to={{ to }}"
                   class="fp-btn-period" style="background:#16a34a; border-color:#16a34a; text-decoration:none;">
                    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Esporta Excel
                </a>
                {% endif %}
                <button type="button" class="fp-btn-period" data-tw-toggle="modal" data-tw-target="#period-modal">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Cambia periodo
                </button>
            </div>
        </div>
    </div>

    {# ── Stats ── #}
    {% set residuoTot = totalOrdine - totalGiaPagato - totalSpese %}
    <div class="fp-stats">
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:#3b82f6;"></div>
            <div>
                <div class="fp-stat-value">{{ totalPresenze|number_format(1, ',', '.') }}</div>
                <div class="fp-stat-label">Presenze (gg)</div>
                <div class="fp-stat-sub">nel periodo</div>
            </div>
        </div>
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:#0ea5e9;"></div>
            <div>
                <div class="fp-stat-value">€ {{ totalContratto|number_format(0, ',', '.') }}</div>
                <div class="fp-stat-label">Totale contratto</div>
                <div class="fp-stat-sub">cantieri nel periodo</div>
            </div>
        </div>
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:#f97316;"></div>
            <div>
                <div class="fp-stat-value">€ {{ totalNostraFattura|number_format(0, ',', '.') }}</div>
                <div class="fp-stat-label">Nostra fattura</div>
                <div class="fp-stat-sub">da bozze applicate{% if totalNostraBozza > 0 %} · <span style="color:#b45309;font-weight:600;">€ {{ totalNostraBozza|number_format(0, ',', '.') }} in bozza</span>{% endif %}</div>
            </div>
        </div>
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:#8b5cf6;"></div>
            <div>
                <div class="fp-stat-value">€ {{ totalOrdine|number_format(0, ',', '.') }}</div>
                <div class="fp-stat-label">Valore ordini</div>
                <div class="fp-stat-sub">cantieri nel periodo</div>
            </div>
        </div>
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:#22c55e;"></div>
            <div>
                <div class="fp-stat-value">€ {{ totalStorico|number_format(0, ',', '.') }}</div>
                <div class="fp-stat-label">Totale pagato</div>
                <div class="fp-stat-sub">storico completo</div>
            </div>
        </div>
        {% if totalSpese > 0 %}
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:#f43f5e;"></div>
            <div>
                <div class="fp-stat-value danger">€ {{ totalSpese|number_format(0, ',', '.') }}</div>
                <div class="fp-stat-label">Spese a loro carico</div>
                <div class="fp-stat-sub">prenotazioni nel periodo</div>
            </div>
        </div>
        {% endif %}
        <div class="fp-stat">
            <div class="fp-stat-dot" style="background:{% if residuoTot < 0 %}#dc2626{% elseif residuoTot == 0 %}#94a3b8{% else %}#0ea5e9{% endif %};"></div>
            <div>
                <div class="fp-stat-value{% if residuoTot < 0 %} danger{% elseif residuoTot == 0 %}{% else %}{% endif %}">
                    € {{ residuoTot|number_format(0, ',', '.') }}
                </div>
                <div class="fp-stat-label">Residuo</div>
                <div class="fp-stat-sub">ordini – già pagato</div>
            </div>
        </div>
    </div>

    {# ── Payment form ── #}
    <form id="payment-form" method="POST" action="/fatturazione/consorziate/{{ consorziata.id }}/pay">
        <input type="hidden" name="from" value="{{ from }}">
        <input type="hidden" name="to"   value="{{ to }}">

        <div class="fp-section">
            <div class="fp-section-header">
                <h2 class="fp-section-title">
                    <span class="fp-section-dot" style="background:#3b82f6;"></span>
                    Cantieri nel periodo
                    <span class="fp-section-count">({{ rows|length }})</span>
                </h2>
            </div>

            {% if rows is empty %}
                <div class="fp-table-wrap">
                    <div class="fp-empty">
                        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
                        <p class="fp-empty-text">
                            Nessuna presenza registrata per <strong>{{ consorziata.name }}</strong> nel periodo selezionato.
                        </p>
                    </div>
                </div>
            {% else %}
                <div class="fp-table-wrap">
                    <div style="overflow-x:auto;">
                        <table class="fp-table" id="detail-table">
                            <thead>
                                <tr>
                                    <th>Cantiere</th>
                                    <th class="right">Presenze (gg)</th>
                                    <th class="right" title="Totale contratto cantiere = total_offer + somma extras">Totale contratto</th>
                                    <th title="Righe di bb_billing già passate per una bozza applicata">Nostra fattura</th>
                                    <th>Ordine</th>
                                    <th class="right">Valore ordine</th>
                                    <th class="right">Data ordine</th>
                                    <th class="right">Già pagato</th>
                                    <th class="right">Spese a carico</th>
                                    <th class="right">Residuo</th>
                                    <th class="right" style="min-width:150px;">Da pagare (€)</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in rows %}
                                    {% set wsOrdini = ordiniByWorksite[r.worksite_id] ?? [] %}
                                    {% set wsRighe  = righeByWorksite[r.worksite_id]  ?? [] %}
                                    {% set rowCount = wsOrdini|length > 0 ? wsOrdini|length : 1 %}
                                    {% set residuoCantiere = r.valore_ordine - r.gia_pagato - r.spese_consorziata %}

                                    {% if wsOrdini is empty %}
                                        {# No ordini → single row, no per-ordine columns #}
                                        <tr class="detail-row fc-cantiere-first"
                                            data-valore="{{ r.valore_ordine }}"
                                            data-pagato="{{ r.gia_pagato }}"
                                            data-spese="{{ r.spese_consorziata }}">
                                            <td>
                                                <input type="hidden" name="worksite_id[]" value="{{ r.worksite_id }}">
                                                <input type="hidden" name="ordine_id[]"   value="">
                                                <a href="/worksites/{{ r.worksite_id }}" class="fp-link" target="_blank">
                                                    {% if r.worksite_code %}<span class="fp-code">{{ r.worksite_code }}</span>{% endif %}
                                                    {{ r.worksite_name }}
                                                </a>
                                            </td>
                                            <td class="right">{{ r.presenze_gg|number_format(2, ',', '.') }}</td>
                                            <td class="right">
                                                {% if r.totale_contratto > 0 %}€ {{ r.totale_contratto|number_format(2, ',', '.') }}{% else %}<span class="fp-dash">—</span>{% endif %}
                                            </td>
                                            <td>{{ nf.nostra_fattura_cell(r.nostra_fattura, r.nostra_fattura_bozza, wsRighe) }}</td>
                                            <td><span class="fp-dash">—</span></td>
                                            <td class="right"><span class="fp-dash">—</span></td>
                                            <td class="right"><span class="fp-dash">—</span></td>
                                            <td class="right">
                                                <span class="fc-pagato-wrap">
                                                    {% if r.gia_pagato > 0 %}<span class="fp-success">€ {{ r.gia_pagato|number_format(2, ',', '.') }}</span>{% else %}<span class="fp-dash">—</span>{% endif %}
                                                    <button type="button" class="fc-edit-pagato" title="Imposta manualmente il già pagato (saldo iniziale)"
                                                            data-set-pagato data-ws="{{ r.worksite_id }}" data-ordine=""
                                                            data-current="{{ r.gia_pagato }}"
                                                            data-label="{{ r.worksite_name|e('html_attr') }}">
                                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                    </button>
                                                </span>
                                            </td>
                                            <td class="right">
                                                {% if r.spese_consorziata > 0 %}<span class="fp-danger">€ {{ r.spese_consorziata|number_format(2, ',', '.') }}</span>{% else %}<span class="fp-dash">—</span>{% endif %}
                                            </td>
                                            <td class="right fc-residuo">
                                                <span class="{{ residuoCantiere < 0 ? 'fp-danger' : (residuoCantiere == 0 ? 'fp-muted' : '') }}">
                                                    € {{ residuoCantiere|number_format(2, ',', '.') }}
                                                </span>
                                            </td>
                                            <td class="right">
                                                <input type="number" name="importo[]" class="fp-input fc-importo-input"
                                                       step="0.01" min="0" placeholder="0,00" autocomplete="off">
                                            </td>
                                        </tr>
                                    {% else %}
                                        {% for o in wsOrdini %}
                                            <tr class="detail-row {{ loop.first ? 'fc-cantiere-first' : 'fc-cantiere-sub' }}"
                                                data-valore="{{ o.total }}"
                                                data-pagato="{{ o.gia_pagato_ordine }}"
                                                data-spese="{{ loop.first ? r.spese_consorziata : 0 }}">
                                                {% if loop.first %}
                                                    <td rowspan="{{ rowCount }}">
                                                        <a href="/worksites/{{ r.worksite_id }}" class="fp-link" target="_blank">
                                                            {% if r.worksite_code %}<span class="fp-code">{{ r.worksite_code }}</span>{% endif %}
                                                            {{ r.worksite_name }}
                                                        </a>
                                                    </td>
                                                    <td rowspan="{{ rowCount }}" class="right">{{ r.presenze_gg|number_format(2, ',', '.') }}</td>
                                                    <td rowspan="{{ rowCount }}" class="right">
                                                        {% if r.totale_contratto > 0 %}€ {{ r.totale_contratto|number_format(2, ',', '.') }}{% else %}<span class="fp-dash">—</span>{% endif %}
                                                    </td>
                                                    <td rowspan="{{ rowCount }}">{{ nf.nostra_fattura_cell(r.nostra_fattura, r.nostra_fattura_bozza, wsRighe) }}</td>
                                                {% endif %}
                                                {# Per-ordine cells #}
                                                <td>
                                                    <input type="hidden" name="worksite_id[]" value="{{ r.worksite_id }}">
                                                    <input type="hidden" name="ordine_id[]"   value="{{ o.id }}">
                                                    <strong>{{ o.order_number ?: ('#' ~ o.id) }}</strong>
                                                    {% if o.oggetto %}<div class="fc-ord-oggetto">{{ o.oggetto }}</div>{% endif %}
                                                </td>
                                                <td class="right">
                                                    {% if o.total > 0 %}€ {{ o.total|number_format(2, ',', '.') }}{% else %}<span class="fp-dash">—</span>{% endif %}
                                                </td>
                                                <td class="right" style="white-space:nowrap;">
                                                    {% if o.order_date %}{{ o.order_date|date('d/m/Y') }}{% else %}<span class="fp-dash">—</span>{% endif %}
                                                </td>
                                                <td class="right">
                                                    <span class="fc-pagato-wrap">
                                                        {% if o.gia_pagato_ordine > 0 %}<span class="fp-success">€ {{ o.gia_pagato_ordine|number_format(2, ',', '.') }}</span>{% else %}<span class="fp-dash">—</span>{% endif %}
                                                        <button type="button" class="fc-edit-pagato" title="Imposta manualmente il già pagato di questo ordine (saldo iniziale)"
                                                                data-set-pagato data-ws="{{ r.worksite_id }}" data-ordine="{{ o.id }}"
                                                                data-current="{{ o.gia_pagato_ordine }}"
                                                                data-label="{{ r.worksite_name|e('html_attr') }} — ordine {{ (o.order_number ?: '#' ~ o.id)|e('html_attr') }}">
                                                            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                        </button>
                                                    </span>
                                                </td>
                                                {% if loop.first %}
                                                    <td rowspan="{{ rowCount }}" class="right">
                                                        {% if r.spese_consorziata > 0 %}<span class="fp-danger">€ {{ r.spese_consorziata|number_format(2, ',', '.') }}</span>{% else %}<span class="fp-dash">—</span>{% endif %}
                                                    </td>
                                                {% endif %}
                                                <td class="right fc-residuo">
                                                    {% set residuoOrd = o.total - o.gia_pagato_ordine - (loop.first ? r.spese_consorziata : 0) %}
                                                    <span class="{{ residuoOrd < 0 ? 'fp-danger' : (residuoOrd == 0 ? 'fp-muted' : '') }}">
                                                        € {{ residuoOrd|number_format(2, ',', '.') }}
                                                    </span>
                                                </td>
                                                <td class="right">
                                                    <input type="number" name="importo[]" class="fp-input fc-importo-input"
                                                           step="0.01" min="0" placeholder="0,00" autocomplete="off">
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="right fp-muted" colspan="2">Totali</td>
                                    <td class="right">€ {{ totalContratto|number_format(2, ',', '.') }}</td>
                                    <td class="right">€ {{ totalNostraFattura|number_format(2, ',', '.') }}</td>
                                    <td></td>
                                    <td class="right">€ {{ totalOrdine|number_format(2, ',', '.') }}</td>
                                    <td></td>
                                    <td class="right">€ {{ totalGiaPagato|number_format(2, ',', '.') }}</td>
                                    <td class="right">{% if totalSpese > 0 %}<span class="fp-danger">€ {{ totalSpese|number_format(2, ',', '.') }}</span>{% else %}—{% endif %}</td>
                                    <td class="right" id="tot-residuo"></td>
                                    <td class="right" id="tot-da-pagare">—</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    {# ── Save bar ── #}
                    <div class="fp-save-bar">
                        <div>
                            <label class="fp-save-bar-label">Data pagamento <span style="color:#dc2626;">*</span></label>
                            <input type="date" id="data_pagamento" name="data_pagamento"
                                   value="{{ "now"|date("Y-m-d") }}" required>
                        </div>
                        <div class="fp-save-bar-note">
                            <label class="fp-save-bar-label">Note</label>
                            <input type="text" name="nota" placeholder="Note opzionali…">
                        </div>
                        <div>
                            <button type="submit" id="save-btn" class="fp-btn-save" disabled>
                                <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/><polyline points="7,3 7,8 15,8"/></svg>
                                Salva pagamenti
                            </button>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </form>

    {# ── Form nascosto: impostazione manuale "Già pagato" (saldo iniziale).
         Il click sulla matita apre un prompt; la differenza rispetto al
         totale attuale viene registrata come rettifica nello storico. #}
    <form id="gia-pagato-form" method="POST" action="/fatturazione/consorziate/{{ consorziata.id }}/gia-pagato" style="display:none;">
        <input type="hidden" name="from" value="{{ from }}">
        <input type="hidden" name="to"   value="{{ to }}">
        <input type="hidden" name="worksite_id"  id="gp-worksite">
        <input type="hidden" name="ordine_id"    id="gp-ordine">
        <input type="hidden" name="nuovo_totale" id="gp-totale">
    </form>

    {# ── Storico pagamenti ── #}
    <div class="fp-storico">
        <div class="fp-storico-header" data-action="toggle-storico">
            <h2 class="fp-storico-title">
                <span class="fp-section-dot" style="background:#22c55e; width:8px; height:8px;"></span>
                Storico Pagamenti
                <span class="fp-storico-meta">
                    ({{ payments|length }} {% if payments|length == 1 %}pagamento{% else %}pagamenti{% endif %}
                    — tot. € {{ totalStorico|number_format(2, ',', '.') }})
                </span>
            </h2>
            <svg class="fp-storico-chevron" id="storico-chevron" viewBox="0 0 24 24">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </div>

        <div id="storico-body" class="fp-storico-body{{ payments is empty ? ' hidden' : '' }}">
            {% if payments is empty %}
                <div class="fp-empty">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <p class="fp-empty-text">Nessun pagamento registrato.</p>
                </div>
            {% else %}
                <div style="overflow-x:auto;">
                    <table class="fp-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Cantiere</th>
                                <th>Ordine</th>
                                <th class="right">Importo</th>
                                <th>Note</th>
                                <th>Registrato il</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in payments %}
                            <tr>
                                <td style="white-space:nowrap;">{{ p.data_pagamento|date('d/m/Y') }}</td>
                                <td>
                                    {% if p.worksite_code %}<span class="fp-code">{{ p.worksite_code }}</span>{% endif %}
                                    {{ p.worksite_name }}
                                </td>
                                <td style="white-space:nowrap;">
                                    {% if p.ordine_id %}
                                        {{ p.order_number ?: ('Ordine #' ~ p.ordine_id) }}
                                        {% if p.order_date %}<span class="fp-muted" style="font-size:11px;"> · {{ p.order_date|date('d/m/Y') }}</span>{% endif %}
                                    {% else %}
                                        <span class="fp-dash">—</span>
                                    {% endif %}
                                </td>
                                <td class="right fp-success">€ {{ p.importo|number_format(2, ',', '.') }}</td>
                                <td class="fp-muted" style="font-size:12px;">{{ p.note ?? '—' }}</td>
                                <td class="fp-muted" style="font-size:12px; white-space:nowrap;">{{ p.created_at|date('d/m/Y') }}</td>
                                <td class="right">
                                    <form method="POST"
                                          action="/fatturazione/consorziate/{{ consorziata.id }}/payment/{{ p.id }}/delete"
                                          data-confirm="Eliminare il pagamento di € {{ p.importo|number_format(2, ',', '.') }}?">
                                        <input type="hidden" name="from" value="{{ from }}">
                                        <input type="hidden" name="to"   value="{{ to }}">
                                        <button type="submit" class="fp-btn-delete">
                                            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="right fp-muted">Totale pagato</td>
                                <td class="right">€ {{ totalStorico|number_format(2, ',', '.') }}</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

</div>

{# ── "Cambia periodo" modal ── #}
<div id="period-modal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="font-medium text-base mr-auto">Cambia Periodo</h2>
            </div>
            <form method="GET" action="/fatturazione/consorziate/{{ consorziata.id }}">
                <div class="modal-body grid grid-cols-2 gap-4 p-5">
                    <div>
                        <label class="form-label">Dal <span class="text-danger">*</span></label>
                        <input type="date" name="from" class="form-control" value="{{ from }}" required>
                    </div>
                    <div>
                        <label class="form-label">Al <span class="text-danger">*</span></label>
                        <input type="date" name="to" class="form-control" value="{{ to }}" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary mr-2" data-tw-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-primary">Applica</button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="/assets/js/views/fatturazione/consorziate.js"></script>
{% endblock %}
