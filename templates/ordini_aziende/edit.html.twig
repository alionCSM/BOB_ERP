{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/ordini/ordini_form.css">
{% endblock %}

{% block content %}
{% set monthsIt = {1:'Gennaio',2:'Febbraio',3:'Marzo',4:'Aprile',5:'Maggio',6:'Giugno',7:'Luglio',8:'Agosto',9:'Settembre',10:'Ottobre',11:'Novembre',12:'Dicembre'} %}

<div class="cof-page">

  {# Hero #}
  <div class="cof-hero">
    <div class="cof-hero-left">
      <div class="cof-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </div>
      <div class="cof-hero-info">
        <h1 class="cof-hero-title">Modifica Ordine {{ ordine.order_number }}</h1>
        <p class="cof-hero-sub">{{ ordine.azienda_name }}</p>
      </div>
    </div>
    <div class="cof-hero-actions">
      <a href="/ordini-aziende/{{ ordine.id }}" class="cof-btn-back">
        <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Torna al dettaglio
      </a>
    </div>
  </div>

  <form method="POST" action="/ordini-aziende/{{ ordine.id }}/update" class="cof-card">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="cof-card-header">
      <h3 class="cof-card-title">Dati ordine</h3>
    </div>

    <div class="cof-card-body">
      <div class="cof-grid" style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:12px;">
        <div class="cof-field">
          <label class="cof-label">Azienda *</label>
          <select name="azienda_id" required class="cof-input">
            {% for a in aziende %}
              <option value="{{ a.id }}"{{ a.id == ordine.azienda_id ? ' selected' : '' }}>
                {{ a.name }}{% if a.codice %} ({{ a.codice }}){% endif %}
              </option>
            {% endfor %}
          </select>
        </div>
        <div class="cof-field">
          <label class="cof-label">Mese</label>
          <select name="mese" class="cof-input">
            {% for n, label in monthsIt %}
              <option value="{{ n }}"{{ n == ordine.mese ? ' selected' : '' }}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="cof-field">
          <label class="cof-label">Anno</label>
          <select name="anno" class="cof-input">
            {% for y in years %}
              <option value="{{ y }}"{{ y == ordine.anno ? ' selected' : '' }}>{{ y }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="cof-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:14px;">
        <div class="cof-field">
          <label class="cof-label">Data ordine *</label>
          <input type="date" name="order_date" required value="{{ ordine.order_date }}" class="cof-input">
        </div>
        <div class="cof-field">
          <label class="cof-label">Totale (€) *</label>
          <input type="text" name="total" required value="{{ ordine.total|number_format(2, ',', '.') }}" inputmode="decimal" class="cof-input">
        </div>
      </div>

      <div class="cof-field" style="margin-top:14px;">
        <label class="cof-label" style="display:flex; justify-content:space-between; align-items:center;">
          <span>Descrizione</span>
          <button type="button" id="oa-refresh-descr" class="cof-btn-ghost" style="font-size:11px; padding:4px 10px;">
            ↻ Rigenera dai cantieri attuali
          </button>
        </label>
        <textarea id="oa-descr" name="descrizione" rows="11" class="cof-input cof-textarea-mono">{{ ordine.descrizione }}</textarea>
      </div>

      <div class="cof-field" style="margin-top:14px;">
        <label class="cof-label">Note</label>
        <textarea name="note" rows="3" class="cof-input">{{ ordine.note }}</textarea>
      </div>
    </div>

    <div class="cof-card-footer" style="display:flex; justify-content:space-between; align-items:center;">
      <button type="button" id="oa-delete-btn" class="cof-btn-ghost" style="color:#b91c1c; border-color:#fecaca;">
        Elimina ordine
      </button>
      <button type="submit" class="cof-btn-primary">
        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
        Salva modifiche
      </button>
    </div>
  </form>

  {# Hidden delete form (triggered from the button above) #}
  <form id="oa-delete-form" method="POST" action="/ordini-aziende/{{ ordine.id }}/delete" style="display:none;">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  </form>

  <textarea id="oa-descr-preview" hidden>{{ descrizionePreview }}</textarea>
</div>

<style nonce="{{ cspNonce }}">
.cof-textarea-mono { font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 12px; }
</style>

<script nonce="{{ cspNonce }}">
(function () {
    var btn  = document.getElementById('oa-refresh-descr');
    var ta   = document.getElementById('oa-descr');
    var src  = document.getElementById('oa-descr-preview');
    if (btn && ta && src) {
        btn.addEventListener('click', function () {
            if (!confirm('Sostituire la descrizione corrente con la lista cantieri attuale?')) return;
            ta.value = src.value;
        });
    }

    var delBtn = document.getElementById('oa-delete-btn');
    var delForm = document.getElementById('oa-delete-form');
    if (delBtn && delForm) {
        delBtn.addEventListener('click', function () {
            if (confirm('Eliminare l\'ordine {{ ordine.order_number }}? L\'operazione è irreversibile.')) {
                delForm.submit();
            }
        });
    }
})();
</script>
{% endblock %}
