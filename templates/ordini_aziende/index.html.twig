{% extends "layout/base.html.twig" %}

{% block content %}
<div class="oa-page" style="padding:20px;">

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
        <div>
            <h1 style="font-size:22px; font-weight:700; margin:0;">Ordini Aziende</h1>
            <p style="color:#64748b; margin:4px 0 0;">Tracking ordini per aziende non consorziate</p>
        </div>
        <a href="/ordini-aziende/create" class="btn btn-primary"
           style="background:#6366f1; color:#fff; padding:10px 16px; border-radius:6px; text-decoration:none; font-weight:500; font-size:13px;">
            + Nuovo ordine
        </a>
    </div>

    {% if app_session_success ?? '' %}
        <div style="background:#dcfce7; color:#166534; padding:10px 14px; border-radius:6px; margin-bottom:12px; font-size:13px;">{{ app_session_success }}</div>
    {% endif %}

    <form method="GET" action="/ordini-aziende"
          style="display:flex; gap:10px; align-items:flex-end; margin-bottom:16px; padding:12px; background:#fff; border:1px solid #e2e8f0; border-radius:10px;">
        <div>
            <label style="display:block; font-size:12px; color:#64748b; margin-bottom:4px;">Anno</label>
            <select name="year" style="height:34px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px;">
                {% for y in years %}
                    <option value="{{ y }}"{{ y == year ? ' selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label style="display:block; font-size:12px; color:#64748b; margin-bottom:4px;">Azienda</label>
            <select name="azienda_id" style="height:34px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px; min-width:220px;">
                <option value="">— tutte —</option>
                {% for a in aziende %}
                    <option value="{{ a.id }}"{{ a.id == aziendaId ? ' selected' : '' }}>
                        {{ a.name }}{% if a.codice %} ({{ a.codice }}){% endif %}
                    </option>
                {% endfor %}
            </select>
        </div>
        <button type="submit"
                style="height:34px; padding:0 14px; border:0; border-radius:6px; background:#6366f1; color:#fff; font-size:13px; font-weight:500; cursor:pointer;">
            Filtra
        </button>
    </form>

    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:10px; overflow:hidden;">
        {% if ordini is empty %}
            <div style="padding:40px; text-align:center; color:#64748b;">Nessun ordine registrato.</div>
        {% else %}
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead style="background:#f1f5f9; color:#475569;">
                    <tr>
                        <th style="text-align:left; padding:10px;">N. Ordine</th>
                        <th style="text-align:left; padding:10px;">Data</th>
                        <th style="text-align:left; padding:10px;">Azienda</th>
                        <th style="text-align:center; padding:10px;">Periodo</th>
                        <th style="text-align:right; padding:10px;">Totale</th>
                        <th style="padding:10px;"></th>
                    </tr>
                </thead>
                <tbody>
                {% set monthsIt = ['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'] %}
                {% for o in ordini %}
                    <tr style="border-top:1px solid #f1f5f9;">
                        <td style="padding:10px; font-weight:600;">{{ o.order_number }}</td>
                        <td style="padding:10px;">{{ o.order_date|date('d/m/Y') }}</td>
                        <td style="padding:10px;">{{ o.azienda_name }}{% if o.azienda_codice %} <span style="color:#94a3b8;">({{ o.azienda_codice }})</span>{% endif %}</td>
                        <td style="padding:10px; text-align:center;">{{ monthsIt[o.mese - 1] }} {{ o.anno }}</td>
                        <td style="padding:10px; text-align:right;">€ {{ o.total|number_format(2, ',', '.') }}</td>
                        <td style="padding:10px; text-align:right;">
                            <a href="/ordini-aziende/{{ o.id }}" style="color:#6366f1; text-decoration:none; margin-right:10px;">Apri</a>
                            <a href="/ordini-aziende/{{ o.id }}/edit" style="color:#475569; text-decoration:none;">Modifica</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
