{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/ordini/ordini_list.css">
<link rel="stylesheet" href="/assets/css/views/ordini/ordini_form.css">
<link rel="stylesheet" href="/assets/css/views/offers/offer_show.css">
<link rel="stylesheet" href="/assets/css/views/ordini/ordine_show.css">
{% endblock %}

{% block content %}
{% set monthsIt = ['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'] %}

<div class="cos-page">

  {# Hero #}
  <div class="cos-hero">
    <div class="cos-hero-left">
      <div class="cos-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
      </div>
      <div class="cos-hero-info">
        <div class="cos-hero-row">
          <h1 class="cos-hero-title">Ordine {{ ordine.order_number }}</h1>
        </div>
        <p class="cos-hero-sub">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          {{ ordine.azienda_name }}
          <span class="cos-hero-sep">·</span>
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{ monthsIt[ordine.mese - 1] }} {{ ordine.anno }}
        </p>
      </div>
    </div>
    <div class="cos-hero-actions">
      <a href="/ordini-aziende" class="cos-btn-action">
        <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Lista
      </a>
      <a href="/ordini-aziende/{{ ordine.id }}/pdf" target="_blank" class="cos-btn-action cos-btn-pdf">
        <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Scarica PDF
      </a>
      <a href="/ordini-aziende/{{ ordine.id }}/edit" class="cos-btn-edit">
        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Modifica
      </a>
    </div>
  </div>

  {% if app_session_success ?? '' %}
    <div class="cof-alert cof-alert-success" style="margin-bottom:16px;">{{ app_session_success }}</div>
  {% endif %}

  <div class="cos-grid">

    {# Left column: details #}
    <div class="cos-left">
      <div class="cos-card">
        <div class="cos-card-title">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Riepilogo
        </div>
        <div class="cos-details">
          <div class="cos-detail-row">
            <div class="cos-detail-label">N. Ordine</div>
            <div class="cos-detail-value"><strong>{{ ordine.order_number }}</strong></div>
          </div>
          <div class="cos-detail-row">
            <div class="cos-detail-label">Data ordine</div>
            <div class="cos-detail-value">{{ ordine.order_date|date('d/m/Y') }}</div>
          </div>
          <div class="cos-detail-row">
            <div class="cos-detail-label">Azienda</div>
            <div class="cos-detail-value">
              {{ ordine.azienda_name }}
              {% if ordine.azienda_codice %}<span style="color:#94a3b8;"> ({{ ordine.azienda_codice }})</span>{% endif %}
            </div>
          </div>
          <div class="cos-detail-row">
            <div class="cos-detail-label">Periodo</div>
            <div class="cos-detail-value">{{ monthsIt[ordine.mese - 1] }} {{ ordine.anno }}</div>
          </div>
          {% set ivaPerc   = ordine.iva_percentage|default(22) + 0 %}
          {% set imponibile = ordine.total + 0 %}
          {% set ivaAmount = (imponibile * ivaPerc / 100)|round(2) %}
          {% set totaleDoc = imponibile + ivaAmount %}
          <div class="cos-detail-row">
            <div class="cos-detail-label">Imponibile</div>
            <div class="cos-detail-value">€ {{ imponibile|number_format(2, ',', '.') }}</div>
          </div>
          <div class="cos-detail-row">
            <div class="cos-detail-label">IVA {{ ivaPerc|number_format(0, ',', '.') }}%</div>
            <div class="cos-detail-value">€ {{ ivaAmount|number_format(2, ',', '.') }}</div>
          </div>
          <div class="cos-detail-row cos-detail-total">
            <div class="cos-detail-label">Totale documento</div>
            <div class="cos-detail-value">€ {{ totaleDoc|number_format(2, ',', '.') }}</div>
          </div>
        </div>
      </div>

      {% if ordine.note %}
      <div class="cos-card">
        <div class="cos-card-title">
          <svg viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Note
        </div>
        <div class="cos-internal-note">{{ ordine.note|nl2br }}</div>
      </div>
      {% endif %}
    </div>

    {# Right column: descrizione cantieri #}
    <div class="cos-right">
      <div class="cos-card">
        <div class="cos-card-title">
          <svg viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Descrizione cantieri del periodo
        </div>
        <pre class="oa-descr-pre">{{ ordine.descrizione ?: '—' }}</pre>
      </div>
    </div>

  </div>

</div>

<style nonce="{{ cspNonce }}">
.oa-descr-pre {
    background: #f8fafc; padding: 14px;
    border-radius: 8px; border: 1px solid #e2e8f0;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 12px; white-space: pre-wrap; word-break: break-word;
    margin: 0; color: #1e293b; line-height: 1.55;
}
</style>
{% endblock %}
