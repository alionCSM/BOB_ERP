{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/fleet/fleet.css">
{% endblock %}

{% block content %}
<div class="fl-page">

    {# ── Hero ─────────────────────────────────────────────────────────── #}
    <div class="fl-hero">
        <div class="fl-hero-content">
            <div class="fl-hero-left">
                <div class="fl-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                </div>
                <div>
                    <h1 class="fl-hero-title">Mappatura suggerita carta → veicolo</h1>
                    <p class="fl-hero-sub">L'AI confronta tx Q8 e tratte GPS dello stesso periodo per suggerire chi guida cosa</p>
                </div>
            </div>
            <a href="/fleet" class="fl-btn-primary" style="background:rgba(255,255,255,.12);box-shadow:none;border:1px solid rgba(255,255,255,.18);">← Torna a Flotta</a>
        </div>
    </div>

    {# ── Spiegazione ──────────────────────────────────────────────────── #}
    <div style="background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:12px;padding:16px 20px;margin-bottom:18px;">
        <div style="display:flex;align-items:flex-start;gap:12px;">
            <svg viewBox="0 0 24 24" width="20" height="20" style="flex-shrink:0;margin-top:2px;fill:none;stroke:#1e40af;stroke-width:2;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <div style="font-size:13px;color:#1e40af;line-height:1.6;">
                <b>Come funziona:</b> per ogni carta Q8 cerchiamo quale veicolo aveva tratte GPS coerenti
                (orario ±3h dalla tx, città corrispondente). Le percentuali sono indicative.
                Verifica e conferma — il sistema crea l'assegnazione carta→veicolo con data inizio = oggi.
            </div>
        </div>
    </div>

    {# ── Suggerimenti per carta ───────────────────────────────────────── #}
    {% if suggestions is empty %}
        <div class="fl-table-wrap">
            <div class="fl-empty" style="padding:60px 20px;">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
                <p class="fl-empty-text">Nessuna carta da mappare. Carica una fattura Q8 prima.</p>
            </div>
        </div>
    {% else %}
        {% for entry in suggestions %}
            {% set card = entry.card %}
            {% set assigned = card.current_vehicle_id is not null %}

            <div class="fl-table-wrap" style="margin-bottom:14px;padding:18px 22px;">

                {# Card header #}
                <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px;flex-wrap:wrap;">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div class="fl-modal-icon" style="background:#fef3c7;color:#b45309;width:42px;height:42px;">
                            <svg viewBox="0 0 24 24" width="20" height="20"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        </div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#0f172a;">Carta {{ card.fornitore }} · No. {{ card.card_no ?: card.numero }}</div>
                            <div class="fl-small">{{ card.txs|length }} transazioni nel periodo</div>
                        </div>
                    </div>
                    {% if assigned %}
                        <span class="fl-chip fl-chip-worker">✓ già assegnata</span>
                    {% endif %}
                </div>

                {% if entry.suggestions is empty %}
                    <p class="fl-small" style="background:#fef3c7;color:#92400e;padding:10px 12px;border-radius:8px;margin:0;">
                        Nessun veicolo con tratte coerenti nel periodo. Verifica manualmente o carica un GPS più completo.
                    </p>
                {% else %}
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px;">
                        {% for s in entry.suggestions %}
                            {% set color = s.confidence >= 70 ? '#16a34a'
                                       : s.confidence >= 40 ? '#d97706'
                                       : '#94a3b8' %}
                            {% set bg = s.confidence >= 70 ? '#ecfdf5'
                                     : s.confidence >= 40 ? '#fef3c7'
                                     : '#f8fafc' %}
                            {% set bd = s.confidence >= 70 ? '#86efac'
                                     : s.confidence >= 40 ? '#fcd34d'
                                     : '#e2e8f0' %}

                            <div style="background:{{ bg }};border:1.5px solid {{ bd }};border-radius:10px;padding:14px;">
                                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:8px;">
                                    <div>
                                        <div style="font-weight:700;color:#0f172a;font-size:14px;">
                                            <span class="fl-targa">{{ s.vehicle.targa }}</span>
                                        </div>
                                        <div class="fl-small" style="margin-top:2px;">{{ s.vehicle.modello ?: s.vehicle.tipo|capitalize }}</div>
                                    </div>
                                    <div style="text-align:right;">
                                        <div style="font-size:22px;font-weight:800;color:{{ color }};line-height:1;">{{ s.confidence }}%</div>
                                        <div class="fl-small" style="color:{{ color }};">confidence</div>
                                    </div>
                                </div>

                                <div class="fl-small" style="margin:8px 0;background:rgba(255,255,255,.6);padding:6px 8px;border-radius:6px;">
                                    {{ s.matches }} / {{ s.total_tx }} tx match · score {{ '%.1f'|format(s.score) }}
                                </div>

                                {% if s.debug %}
                                    <details style="margin:6px 0;">
                                        <summary style="cursor:pointer;font-size:11px;color:#64748b;">Dettagli match</summary>
                                        <div class="fl-small" style="margin-top:4px;font-family:monospace;background:rgba(0,0,0,.04);padding:6px;border-radius:4px;">
                                            {{ s.debug }}
                                        </div>
                                    </details>
                                {% endif %}

                                {% if not assigned %}
                                    <form method="POST" action="/fleet/mapping/accept" style="margin-top:10px;">
                                        <input type="hidden" name="card_id" value="{{ card.id }}">
                                        <input type="hidden" name="vehicle_id" value="{{ s.vehicle.id }}">
                                        <input type="hidden" name="from_date" value="{{ from ?: 'now'|date('Y-m-01') }}">
                                        <button type="submit" class="fl-btn-submit" style="width:100%;padding:8px;background:linear-gradient(135deg,{{ color }} 0%,{{ color }} 100%);font-size:12px;">
                                            ✓ Accetta · assegna a {{ s.vehicle.targa }}
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        <div style="display:flex;justify-content:center;margin-top:24px;">
            <a href="/fleet?tab=cards" class="fl-btn-primary">
                Vai alla lista carte completa
            </a>
        </div>
    {% endif %}

</div>
{% endblock %}
