{# Riassegnazione carta/telepass a veicolo XOR operaio.
   Param: modalId, action, entityIdField, entityId, entityLabel, vehicles, workers #}
<div id="{{ modalId }}" class="fl-modal">
    <div class="fl-modal-backdrop"></div>
    <form method="POST" action="{{ action }}" class="fl-modal-dialog">
        <input type="hidden" name="{{ entityIdField }}" value="{{ entityId }}">
        <div class="fl-modal-head">
            <div class="fl-modal-icon">
                <svg viewBox="0 0 24 24"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            </div>
            <div>
                <h3 class="fl-modal-title">Assegna {{ entityLabel }}</h3>
                <p class="fl-modal-sub">Holder esclusivo: veicolo OPPURE operaio</p>
            </div>
            <button type="button" class="fl-modal-close" data-fl-close>&times;</button>
        </div>
        <div class="fl-modal-body">
            <div class="fl-field" style="margin-bottom:14px;">
                <label>Tipo holder</label>
                <div class="fl-radio-group">
                    <label>
                        <input type="radio" name="holder_type" value="vehicle" data-fl-holder="{{ modalId }}" checked>
                        <span>Veicolo</span>
                    </label>
                    <label>
                        <input type="radio" name="holder_type" value="worker" data-fl-holder="{{ modalId }}">
                        <span>Operaio</span>
                    </label>
                    <label>
                        <input type="radio" name="holder_type" value="none" data-fl-holder="{{ modalId }}">
                        <span>Libera</span>
                    </label>
                </div>
            </div>

            <div data-fl-holder-panel="vehicle" data-modal="{{ modalId }}" class="fl-field" style="margin-bottom:14px;">
                <label>Veicolo</label>
                <select name="vehicle_id" class="fl-select">
                    <option value="">— seleziona —</option>
                    {% for v in vehicles %}
                        <option value="{{ v.id }}">{{ v.targa }} · {{ v.modello }}</option>
                    {% endfor %}
                </select>
            </div>

            <div data-fl-holder-panel="worker" data-modal="{{ modalId }}" class="fl-field" style="display:none;margin-bottom:14px;">
                <label>Operaio</label>
                <select name="worker_id" class="fl-select">
                    <option value="">— seleziona —</option>
                    {% for w in workers %}
                        <option value="{{ w.id }}">{{ w.full_name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div data-fl-holder-panel="none" data-modal="{{ modalId }}" style="display:none;">
                <p class="fl-small" style="padding:8px 0;">Nessun holder — la carta/telepass sarà marcata come libera.</p>
            </div>

            <div class="fl-grid-2">
                <div class="fl-field">
                    <label>Data inizio</label>
                    <input type="date" name="from_date" class="fl-input" value="{{ 'now'|date('Y-m-d') }}">
                </div>
                <div class="fl-field">
                    <label>Note (opzionale)</label>
                    <input type="text" name="notes" class="fl-input" maxlength="255">
                </div>
            </div>
        </div>
        <div class="fl-modal-foot">
            <button type="button" class="fl-btn-cancel" data-fl-close>Annulla</button>
            <button type="submit" class="fl-btn-submit">Conferma</button>
        </div>
    </form>
</div>
