{# Crea/modifica veicolo. Param: v (null = create), modalId, worksitesForSel #}
<div id="{{ modalId }}" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 600px;">
        <form method="POST" action="/fleet/vehicle/save" class="modal-content">
            <div class="modal-header">
                <h2 class="font-medium text-base mr-auto">
                    {{ v ? 'Modifica veicolo ' ~ v.targa : 'Nuovo veicolo' }}
                </h2>
            </div>
            <div class="modal-body">
                {% if v %}<input type="hidden" name="id" value="{{ v.id }}">{% endif %}

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="form-label">Targa *</label>
                        <input type="text" name="targa" class="form-control uppercase" required
                               value="{{ v.targa|default('') }}" maxlength="16">
                    </div>
                    <div>
                        <label class="form-label">Tipo</label>
                        <select name="tipo" class="form-select">
                            {% for t in ['furgone','auto','camion','altro'] %}
                                <option value="{{ t }}" {{ v.tipo|default('furgone') == t ? 'selected' : '' }}>{{ t|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label class="form-label">Modello</label>
                        <input type="text" name="modello" class="form-control" value="{{ v.modello|default('') }}">
                    </div>
                    <div>
                        <label class="form-label">GPS device id</label>
                        <input type="text" name="gps_device_id" class="form-control" value="{{ v.gps_device_id|default('') }}">
                    </div>
                    <div>
                        <label class="form-label">Cantiere corrente</label>
                        <select name="current_worksite_id" class="form-select">
                            <option value="">— nessuno —</option>
                            {% for w in worksitesForSel %}
                                <option value="{{ w.id }}" {{ v.current_worksite_id|default(0) == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label class="form-label">Note</label>
                        <textarea name="notes" class="form-control" rows="2">{{ v.notes|default('') }}</textarea>
                    </div>
                    <div class="col-span-2">
                        <label class="inline-flex items-center">
                            <input type="checkbox" name="active" class="form-check-input mr-2" {{ v is null or v.active ? 'checked' : '' }}>
                            <span>Attivo in flotta</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer text-right">
                <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary mr-2">Annulla</button>
                <button type="submit" class="btn btn-primary">Salva</button>
            </div>
        </form>
    </div>
</div>
