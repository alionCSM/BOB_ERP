{% extends 'layout/base.html.twig' %}

{% block head %}
<link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/views/attendance/presenze.css">
{% endblock %}

{% set totaleRimborsi = 0 %}
{% for r in rimborsi %}{% set totaleRimborsi = totaleRimborsi + r.importo %}{% endfor %}

{% block content %}
<div class="fe-page">

    <div class="fe-hero">
        <div class="fe-hero-content">
            <div class="fe-hero-left">
                <div class="fe-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
                </div>
                <div>
                    <h1 class="fe-hero-title">Rimborsi</h1>
                    <p class="fe-hero-sub">Rimborsi spese riconosciuti agli operai</p>
                </div>
            </div>
        </div>
        <div class="fe-hero-stats">
            <div class="fe-stat">
                <div class="fe-stat-num">{{ rimborsi|length }}</div>
                <div class="fe-stat-lbl">Rimborsi</div>
            </div>
            <div class="fe-stat">
                <div class="fe-stat-num">€ {{ totaleRimborsi|number_format(0, ',', '.') }}</div>
                <div class="fe-stat-lbl">Totale</div>
            </div>
        </div>
    </div>

    {# ── Form ── #}
    <div class="fe-card accent-green">
        <div class="fe-card-head">
            <h3 class="fe-card-title">Registra nuovo rimborso</h3>
        </div>
        <div class="fe-card-body">
            <form method="POST" action="/attendance/refunds/save">
                <input type="hidden" name="rimborso_id" value="">
                <div class="fe-grid">
                    <div>
                        <span class="fe-label">Data</span>
                        <input type="date" name="data" class="fe-input" required>
                    </div>
                    <div style="grid-column: span 2; min-width: 220px;">
                        <span class="fe-label">Operaio</span>
                        <select id="operaioSelect" name="operaio_id" required></select>
                    </div>
                    <div>
                        <span class="fe-label">Importo (€)</span>
                        <input type="number" name="importo" step="0.01" min="0" class="fe-input" placeholder="0,00" required>
                    </div>
                </div>
                <div style="margin-top: 14px;">
                    <span class="fe-label">Note</span>
                    <textarea name="note" class="fe-textarea" rows="2" placeholder="Inserisci eventuali note..."></textarea>
                </div>
                <div class="fe-form-foot">
                    <button type="submit" class="fe-btn-save">
                        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Salva
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── Toolbar ── #}
    <div class="fe-toolbar">
        <div class="fe-search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchInput" placeholder="Cerca per nome operaio, data o note...">
        </div>
    </div>

    {# ── Tabella ── #}
    <div class="fe-table-wrap">
        <table class="fe-table" id="rimborsiTable">
            <thead>
            <tr>
                <th>Data</th>
                <th>Operaio</th>
                <th>Importo (€)</th>
                <th>Note</th>
                <th style="text-align:right;">Azioni</th>
            </tr>
            </thead>
            <tbody>
            {% for row in rimborsi %}
                <tr>
                    <td style="white-space:nowrap; font-weight:600;">{{ row.data|date('d/m/Y') }}</td>
                    <td>{{ row.operaio_nome }}</td>
                    <td class="fe-amount">€ {{ row.importo|number_format(2, ',', '.') }}</td>
                    <td style="font-size:12px; color:#64748b; max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ row.note|e('html_attr') }}">{{ row.note }}</td>
                    <td>
                        <div style="display:flex; gap:6px; justify-content:flex-end;">
                            <button type="button" class="fe-btn fe-btn-edit edit-btn"
                                    data-id="{{ row.id }}"
                                    data-data="{{ row.data }}"
                                    data-operaio="{{ row.operaio_id }}"
                                    data-importo="{{ row.importo }}"
                                    data-note="{{ row.note|e('html_attr') }}">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifica
                            </button>
                            <form method="POST"
                                  action="/attendance/refunds/save"
                                  class="inline-block"
                                  data-confirm="Confermi eliminazione di questo rimborso?">
                                <input type="hidden" name="delete_id" value="{{ row.id }}">
                                <button type="submit" class="fe-btn fe-btn-del">
                                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    Elimina
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="fe-empty">Nessun rimborso registrato. Usa il form qui sopra per iniziare.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="/assets/js/views/attendance/add_rimborso.js"></script>
{% endblock %}
