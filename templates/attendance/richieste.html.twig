{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/attendance/presenze.css">
<link rel="stylesheet" href="/assets/css/views/attendance/richieste.css?v=1">
{% endblock %}

{#
  Le presenze dichiarate dagli operai dall'app.

  Una scheda per dichiarazione e non una tabella: ogni riga porta con se'
  pasti, albergo, auto e gli avvisi, e in tabella diventerebbero dodici
  colonne di cui otto vuote quasi sempre.

  I campi sono modificabili prima di approvare: quello che finisce nelle
  presenze vere e' quello che l'ufficio ha davanti dopo averlo sistemato. La
  dichiarazione resta com'era, cosi' resta la traccia di cosa e' cambiato.
#}
{% block content %}
<div class="fe-page">

    <div class="fe-hero">
        <div class="fe-hero-content">
            <div class="fe-hero-icon">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <div>
                <h1 class="fe-hero-title">Presenze dichiarate</h1>
                <p class="fe-hero-sub">Quello che gli operai hanno mandato dall'app</p>
            </div>
        </div>
        <div class="fe-hero-stats">
            <div class="fe-stat">
                <div class="fe-stat-num">{{ inAttesa }}</div>
                <div class="fe-stat-lbl">Da guardare</div>
            </div>
        </div>
    </div>

    {% if successMsg %}<div class="fe-alert is-ok">{{ successMsg }}</div>{% endif %}
    {% if errorMsg %}<div class="fe-alert is-ko">{{ errorMsg }}</div>{% endif %}

    <form method="GET" class="ri-filtri">
        <label class="ri-f">
            <span>Stato</span>
            <select name="stato">
                <option value="in_attesa"{{ filtri.stato == 'in_attesa' ? ' selected' : '' }}>Da guardare</option>
                <option value="approvata"{{ filtri.stato == 'approvata' ? ' selected' : '' }}>Approvate</option>
                <option value="rifiutata"{{ filtri.stato == 'rifiutata' ? ' selected' : '' }}>Rifiutate</option>
            </select>
        </label>
        <label class="ri-f">
            <span>Dal</span>
            <input type="date" name="dal" value="{{ filtri.dal }}">
        </label>
        <label class="ri-f">
            <span>Al</span>
            <input type="date" name="al" value="{{ filtri.al }}">
        </label>
        <button class="ri-btn ri-btn-primary">Filtra</button>
    </form>

    {% for r in righe %}
        <div class="ri-card{{ r.avvisi|length ? ' has-avvisi' : '' }}">

            <div class="ri-card-head">
                <div>
                    <div class="ri-operaio">{{ r.operaio_nome }}</div>
                    <div class="ri-azienda">{{ r.operaio_azienda }}</div>
                </div>
                <div class="ri-quando">
                    <span class="ri-data">{{ r.data|date('d/m/Y') }}</span>
                    <span class="ri-cantiere">
                        {{ r.cantiere_codice ? r.cantiere_codice ~ ' — ' : '' }}{{ r.cantiere_nome ?: 'cantiere non trovato' }}
                    </span>
                </div>
            </div>

            {# Gli avvisi in cima e in evidenza: con centoquaranta operai le
               righe si leggono in fretta, e quelle che meritano un secondo
               sguardo devono saltare all'occhio da sole. #}
            {% if r.avvisi %}
                <div class="ri-avvisi">
                    {% for a in r.avvisi %}
                        <div class="ri-avviso">
                            <svg viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                            {{ a }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if r.note %}<div class="ri-note">{{ r.note }}</div>{% endif %}

            {% if r.stato == 'in_attesa' %}
                <form method="POST" action="/attendance/richieste/decidi" class="ri-form">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <input type="hidden" name="id" value="{{ r.id }}">
                    <input type="hidden" name="torna_stato" value="{{ filtri.stato }}">
                    <input type="hidden" name="azienda" value="{{ r.operaio_azienda }}">

                    <div class="ri-campi">
                        <label class="ri-f">
                            <span>Turno</span>
                            <select name="turno">
                                <option value="Intero"{{ r.turno == 'Intero' ? ' selected' : '' }}>Intero</option>
                                <option value="Mezzo"{{ r.turno == 'Mezzo' ? ' selected' : '' }}>Mezzo</option>
                            </select>
                        </label>

                        {# Il prezzo compare solo su "Noi": su "Loro" ha pagato
                           l'operaio e all'azienda non costa niente. #}
                        <label class="ri-f">
                            <span>Pranzo</span>
                            <select name="pranzo" class="ri-pasto">
                                {% for opt in ['-', 'Loro', 'Noi'] %}
                                    <option value="{{ opt }}"{{ r.pranzo == opt ? ' selected' : '' }}>{{ opt }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="ri-f ri-prezzo"{{ r.pranzo != 'Noi' ? ' hidden' : '' }}>
                            <span>€ pranzo</span>
                            <input type="number" step="0.01" name="pranzo_prezzo" placeholder="0,00">
                        </label>

                        <label class="ri-f">
                            <span>Cena</span>
                            <select name="cena" class="ri-pasto">
                                {% for opt in ['-', 'Loro', 'Noi'] %}
                                    <option value="{{ opt }}"{{ r.cena == opt ? ' selected' : '' }}>{{ opt }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="ri-f ri-prezzo"{{ r.cena != 'Noi' ? ' hidden' : '' }}>
                            <span>€ cena</span>
                            <input type="number" step="0.01" name="cena_prezzo" placeholder="0,00">
                        </label>

                        <label class="ri-f">
                            <span>Hotel</span>
                            <input type="text" name="hotel" value="{{ r.hotel }}" placeholder="Struttura">
                        </label>

                        <label class="ri-f">
                            <span>Auto</span>
                            <input type="text" name="targa_auto" value="{{ r.targa_auto }}" placeholder="Targa">
                        </label>

                        <label class="ri-f ri-check">
                            <span>Trasferta</span>
                            <span class="ri-check-box">
                                <input type="checkbox" name="trasferta" value="1"{{ r.trasferta ? ' checked' : '' }}>
                                <span>Ha dormito fuori</span>
                            </span>
                        </label>
                    </div>

                    <div class="ri-azioni">
                        <input type="text" name="motivo" class="ri-motivo"
                               placeholder="Motivo del rifiuto (l'operaio lo legge)">
                        <button type="submit" name="azione" value="rifiuta" class="ri-btn ri-btn-ko">
                            Rifiuta
                        </button>
                        <button type="submit" name="azione" value="approva" class="ri-btn ri-btn-ok">
                            Approva e registra
                        </button>
                    </div>
                </form>
            {% else %}
                <div class="ri-decisa">
                    <span class="ri-stato ri-stato-{{ r.stato }}">{{ r.stato }}</span>
                    {% if r.decisa_at %}<span>{{ r.decisa_at|date('d/m/Y H:i') }}</span>{% endif %}
                    {% if r.motivo %}<span class="ri-motivo-testo">{{ r.motivo }}</span>{% endif %}
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="ri-vuoto">
            {% if filtri.stato == 'in_attesa' %}
                Nessuna dichiarazione da guardare.
            {% else %}
                Nessuna dichiarazione in questo stato.
            {% endif %}
        </div>
    {% endfor %}

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/attendance/rifiuto_motivo.js?v=1"></script>
<script src="/assets/js/views/attendance/richieste.js?v=2"></script>
{% endblock %}
