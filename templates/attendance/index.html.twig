{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/attendance/attendance_list.css">
<link rel="stylesheet" href="/assets/css/views/attendance/presenze.css">
<link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="fe-hero" style="margin-top:16px;">
    <div class="fe-hero-content">
        <div class="fe-hero-left">
            <div class="fe-hero-icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4m8-4v4"/><path d="M9 16l2 2 4-4"/></svg>
            </div>
            <div>
                <h1 class="fe-hero-title">Presenze</h1>
                <p class="fe-hero-sub">Cerca, filtra ed esporta le presenze registrate</p>
            </div>
        </div>
        <div style="display:flex; gap:8px; align-items:center; position:relative; z-index:1;">
            <a href="/attendance/create" class="fe-btn-add">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Inserisci presenze
            </a>
            <div class="dropdown">
                <button class="dropdown-toggle fe-btn" style="color:#fff; border-color:rgba(255,255,255,.25); background:rgba(255,255,255,.1); padding:10px 16px;" aria-expanded="false" data-tw-toggle="dropdown">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Esporta
                </button>
                <div class="dropdown-menu lg:w-56">
                    <ul class="dropdown-content">
                        <li>
                            <button type="button" data-tw-toggle="modal" data-tw-target="#modalExcelOperaio" class="dropdown-item">
                                <i data-lucide="file-text" class="w-4 h-4 mr-2"></i> Excel Operaio
                            </button>
                        </li>
                        <li>
                            <button type="button" data-tw-toggle="modal" data-tw-target="#modalExcelBulkOperai" class="dropdown-item">
                                <i data-lucide="file-text" class="w-4 h-4 mr-2"></i> Excel Bulk Operai (ZIP)
                            </button>
                        </li>
                        <li>
                            <button type="button" data-tw-toggle="modal" data-tw-target="#modalExcelAzienda" class="dropdown-item">
                                <i data-lucide="file-text" class="w-4 h-4 mr-2"></i> Excel Azienda
                            </button>
                        </li>
                        <li>
                            <button type="button" data-tw-toggle="modal" data-tw-target="#modalExcelCommittente" class="dropdown-item">
                                <i data-lucide="file-text" class="w-4 h-4 mr-2"></i> Excel Committente
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

{# activeTab: il tab consorziate resta aperto dopo un filtro consorziate #}
<ul class="nav nav-tabs fe-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                data-tw-target="#tab-presenze" role="tab"
                aria-controls="tab-presenze" aria-selected="{{ activeTab == 'nostri' ? 'true' : 'false' }}">
            Presenze Nostri
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                data-tw-target="#tab-consorziate" role="tab"
                aria-controls="tab-consorziate" aria-selected="{{ activeTab == 'consorziate' ? 'true' : 'false' }}">
           Presenze Consorziate
        </button>
    </li>
</ul>

<div class="tab-content mt-5">
    <div id="tab-presenze" class="tab-pane {{ activeTab == 'nostri' ? 'active' : 'hidden' }}" role="tabpanel">
        <!-- FILTRI -->
        <div class="fe-card">
            <div class="fe-card-body" style="padding:16px 22px;">
                <form method="GET" style="display:flex; flex-wrap:wrap; gap:14px; align-items:flex-end;">
                    <div>
                        <span class="fe-label">Data Inizio</span>
                        <input type="date" name="start_date" value="{{ startDate }}" class="fe-input" style="width:170px;" data-range-start>
                    </div>
                    <div>
                        <span class="fe-label">Data Fine</span>
                        <input type="date" name="end_date" value="{{ endDate }}" class="fe-input" style="width:170px;" data-range-end>
                    </div>
                    <div style="min-width:230px;">
                        <span class="fe-label">Cantiere</span>
                        <select name="cantiere_id" id="cantiereSelect" style="width:100%;">
                            {% if cantiereId is not empty %}
                                <option value="{{ cantiereId }}" selected>{{ selectedCantiere }}</option>
                            {% endif %}
                        </select>
                    </div>
                    <div style="min-width:230px;">
                        <span class="fe-label">Operaio</span>
                        <select name="worker_id" id="workerSelect" style="width:100%;">
                            {% if workerId is not empty %}
                                <option value="{{ selectedWorker.id }}" selected>{{ selectedWorker.first_name }} {{ selectedWorker.last_name }}</option>
                            {% endif %}
                        </select>
                    </div>
                    <button type="submit" class="fe-btn-save" style="padding:9px 22px;">
                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        Filtra
                    </button>
                    <a href="/attendance" class="fe-btn" style="color:#64748b; border-color:#e2e8f0; padding:9px 18px;">Reset filtri</a>
                    <div class="fe-presets" style="width:100%;">
                        <span class="fe-presets-lbl">Rapidi:</span>
                        <button type="button" class="fe-preset" data-preset="oggi">Oggi</button>
                        <button type="button" class="fe-preset" data-preset="settimana">Questa settimana</button>
                        <button type="button" class="fe-preset" data-preset="mese">Questo mese</button>
                        <button type="button" class="fe-preset" data-preset="mese-scorso">Mese scorso</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- TABELLA -->
        <div class="fe-table-wrap">
            <table class="fe-table">
                <thead>
                <tr>
                    <th>Data</th>
                    <th>Operaio</th>
                    <th>Cantiere</th>
                    <th style="text-align:center;">Turno</th>
                    <th style="text-align:center;">Pranzo</th>
                    <th style="text-align:center;">Cena</th>
                    <th style="text-align:center;">Hotel</th>
                    <th style="text-align:center;">Targa</th>
                    <th>Note</th>
                    <th style="text-align:right;">Azioni</th>
                </tr>
                </thead>
                <tbody>
                {% for row in presenze %}
                    <tr>
                        <td style="white-space:nowrap; font-weight:600;">{{ row.data|date('d/m/Y') }}</td>
                        <td style="font-weight:600;">{{ row.lavoratore }}</td>
                        <td>{{ row.cantiere }}</td>
                        <td style="text-align:center;">
                            <span class="fe-badge" style="{{ row.turno == 'Mezzo' ? 'background:#fef3c7; color:#b45309; border:1px solid #fde68a;' : 'background:#dcfce7; color:#15803d; border:1px solid #86efac;' }}">
                                {{ row.turno }}
                            </span>
                        </td>
                        <td style="text-align:center;">
                            {% if row.pranzo == 'Noi' and row.pranzo_prezzo is not null %}
                                {{ row.pranzo_prezzo|number_format(2, ',', '') }} €
                            {% else %}
                                {{ row.pranzo }}
                            {% endif %}
                        </td>
                        <td style="text-align:center;">
                            {% if row.cena == 'Noi' and row.cena_prezzo is not null %}
                                {{ row.cena_prezzo|number_format(2, ',', '') }} €
                            {% else %}
                                {{ row.cena }}
                            {% endif %}
                        </td>
                        <td style="text-align:center;">{{ row.hotel }}</td>
                        <td style="text-align:center; font-family:monospace;">{{ row.targa_auto }}</td>
                        <td style="font-size:12px; color:#64748b; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ row.note|e('html_attr') }}">{{ row.note }}</td>
                        <td>
                            <div style="display:flex; gap:6px; justify-content:flex-end;">
                                <a class="fe-btn fe-btn-edit" href="/attendance/edit?cantiere={{ row.cantiere_id|url_encode }}&data={{ row.data|url_encode }}">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    Edit
                                </a>
                                <form
                                        action="/attendance/delete"
                                        method="POST"
                                        data-confirm="Confermi eliminazione di questa presenza?"
                                        class="inline-block"
                                >
                                    <input type="hidden" name="type" value="nostri">
                                    <input type="hidden" name="id"   value="{{ row.id }}">
                                    <button type="submit" class="fe-btn fe-btn-del">
                                        <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        Elimina
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="10" class="fe-empty">Nessuna presenza trovata con questi filtri.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div id="tab-consorziate" class="tab-pane {{ activeTab == 'consorziate' ? 'active' : 'hidden' }}" role="tabpanel">
        <div class="fe-card">
            <div class="fe-card-body" style="padding:16px 22px;">
                <form method="GET" action="/attendance" style="display:flex; flex-wrap:wrap; gap:14px; align-items:flex-end;">
                    <input type="hidden" name="type" value="consorziata">
                    <div>
                        <span class="fe-label">Data Inizio</span>
                        <input type="date" name="cons_start_date" value="{{ consStartDate }}" class="fe-input" style="width:170px;" data-range-start>
                    </div>
                    <div>
                        <span class="fe-label">Data Fine</span>
                        <input type="date" name="cons_end_date" value="{{ consEndDate }}" class="fe-input" style="width:170px;" data-range-end>
                    </div>
                    <div style="min-width:230px;">
                        <span class="fe-label">Cantiere</span>
                        <select name="cons_cantiere_id" id="consCantiereSelect" style="width:100%;">
                            {% if consCantiereId is not empty %}
                                <option value="{{ consCantiereId }}" selected>{{ selectedConsCantiere }}</option>
                            {% endif %}
                        </select>
                    </div>
                    <div style="min-width:230px;">
                        <span class="fe-label">Consorziata</span>
                        {# solo aziende con consorziata=1, niente testo libero #}
                        <select name="cons_azienda_id" id="consAziendaSelect" style="width:100%;">
                            <option value="">Tutte le consorziate</option>
                            {% for c in consorziateList %}
                                <option value="{{ c.id }}" {{ consAziendaId == c.id ? 'selected' : '' }}>{{ c.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="fe-btn-save" style="padding:9px 22px;">
                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        Filtra
                    </button>
                    <a href="/attendance?type=consorziata" class="fe-btn" style="color:#64748b; border-color:#e2e8f0; padding:9px 18px;">Reset</a>
                    <div class="fe-presets" style="width:100%;">
                        <span class="fe-presets-lbl">Rapidi:</span>
                        <button type="button" class="fe-preset" data-preset="oggi">Oggi</button>
                        <button type="button" class="fe-preset" data-preset="settimana">Questa settimana</button>
                        <button type="button" class="fe-preset" data-preset="mese">Questo mese</button>
                        <button type="button" class="fe-preset" data-preset="mese-scorso">Mese scorso</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="fe-table-wrap">
            <table class="fe-table">
                <thead>
                <tr>
                    <th>Data</th>
                    <th>Consorziata</th>
                    <th>Cantiere</th>
                    <th style="text-align:center;">N. Operai</th>
                    <th style="text-align:center;">Costo Unitario</th>
                    <th style="text-align:center;">Pasti</th>
                    <th style="text-align:center;">Auto</th>
                    <th style="text-align:center;">Hotel</th>
                    <th>Note</th>
                    <th style="text-align:right;">Azioni</th>
                </tr>
                </thead>
                <tbody>
                {% for row in presenzeConsorziate %}
                    <tr>
                        <td style="white-space:nowrap; font-weight:600;">{{ row.data_presenza|date('d/m/Y') }}</td>
                        <td style="font-weight:600;">{{ row.consorziata_name }}</td>
                        <td>{{ row.cantiere }}</td>
                        <td style="text-align:center;">
                            {# quantita e' DECIMAL: 2.000000 → 2, 7.500000 → 7,5 #}
                            {% set q = row.quantita + 0 %}
                            <span class="fe-badge" style="background:#dbeafe; color:#1d4ed8; border:1px solid #bfdbfe;">{{ q == q|round ? q|number_format(0, ',', '.') : q|number_format(1, ',', '.') }}</span>
                        </td>
                        <td style="text-align:center;" class="fe-amount">{{ row.costo_unitario|number_format(2, ',', '.') }} €</td>
                        <td style="text-align:center;">{{ (row.pasti + 0) > 0 ? (row.pasti|number_format(2, ',', '.') ~ ' €') : '—' }}</td>
                        <td style="text-align:center;">{{ row.auto ?: '—' }}</td>
                        <td style="text-align:center;">{{ (row.hotel + 0) > 0 ? (row.hotel|number_format(2, ',', '.') ~ ' €') : (row.hotel ?: '—') }}</td>
                        <td style="font-size:12px; color:#64748b; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ row.note|e('html_attr') }}">{{ row.note }}</td>
                        <td>
                            <div style="display:flex; gap:6px; justify-content:flex-end;">
                                <a class="fe-btn fe-btn-edit" href="/attendance/edit?cantiere={{ row.cantiere_id|url_encode }}&data={{ row.data_presenza|url_encode }}">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    Edit
                                </a>
                                <form
                                        action="/attendance/delete"
                                        method="POST"
                                        data-confirm="Confermi eliminazione di questa presenza consorziata?"
                                        class="inline-block"
                                >
                                    <input type="hidden" name="type" value="consorziata">
                                    <input type="hidden" name="id"   value="{{ row.id }}">
                                    <button type="submit" class="fe-btn fe-btn-del">
                                        <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        Elimina
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="10" class="fe-empty">Nessuna presenza consorziata trovata con questi filtri.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<div id="delete-confirmation-modal" class="modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body p-0">
                <div class="p-5 text-center">
                    <i data-lucide="x-circle" class="w-16 h-16 text-danger mx-auto mt-3"></i>
                    <div class="text-3xl mt-5">Are you sure?</div>
                    <div class="text-slate-500 mt-2">
                        Do you really want to delete these records?
                        <br>
                        This process cannot be undone.
                    </div>
                </div>
                <div class="px-5 pb-8 text-center">
                    <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary w-24 mr-1">Cancel</button>
                    <button type="button" class="btn btn-danger w-24">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Excel -->

<div id="modalExcelOperaio" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/attendance/export/worker" method="GET">
                <div class="modal-header">
                    <h2 class="font-medium text-base mr-auto">Esporta Excel Operaio</h2>
                </div>
                <div class="modal-body grid grid-cols-12 gap-4 gap-y-3">
                    <div class="col-span-12">
                        <label class="form-label">Operaio</label>
                        <select id="operaioSelect" name="worker_id" class="w-full"></select>
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Inizio</label>
                        <input type="date" name="start_date" class="form-control">
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Fine</label>
                        <input type="date" name="end_date" class="form-control">
                    </div>
                </div>
                <div class="modal-footer text-right">
                    <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary">Chiudi</button>
                    <button type="submit" class="btn btn-primary">Esporta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="modalExcelBulkOperai" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/attendance/export/bulk" method="GET">
                <div class="modal-header">
                    <h2 class="font-medium text-base mr-auto">Excel Bulk Operai (ZIP)</h2>
                </div>
                <div class="modal-body grid grid-cols-12 gap-4">
                    <div class="col-span-6">
                        <label class="form-label">Data Inizio</label>
                        <input type="date" name="start_date" class="form-control" required>
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Fine</label>
                        <input type="date" name="end_date" class="form-control" required>
                    </div>
                    <div class="col-span-12 text-slate-500 text-sm mt-2">
                        Esporta uno ZIP con una cartella per azienda interna (consorziata=0) e un Excel per ogni operaio che ha almeno una presenza.
                    </div>
                </div>
                <div class="modal-footer text-right">
                    <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary">Chiudi</button>
                    <button type="submit" class="btn btn-primary">Esporta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="modalExcelAzienda" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/attendance/export/company" method="GET">
                <div class="modal-header">
                    <h2 class="font-medium text-base mr-auto">Esporta Excel Azienda</h2>
                </div>
                <div class="modal-body grid grid-cols-12 gap-4">
                    <div class="col-span-12">
                        <label class="form-label">Azienda</label>
                        <select id="aziendaSelect" name="azienda" class="w-full"></select>
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Inizio</label>
                        <input type="date" name="start_date" class="form-control">
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Fine</label>
                        <input type="date" name="end_date" class="form-control">
                    </div>
                </div>
                <div class="modal-footer text-right">
                    <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary">Chiudi</button>
                    <button type="submit" class="btn btn-primary">Esporta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="modalExcelCommittente" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/attendance/export/client" method="POST">
                <div class="modal-header">
                    <h2 class="font-medium text-base mr-auto">Excel Committente</h2>
                </div>
                <div class="modal-body grid grid-cols-12 gap-4">
                    <div class="col-span-12">
                        <label class="form-label">Committente</label>
                        <select id="committenteSelect" name="client_id" class="w-full"></select>
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Inizio</label>
                        <input type="date" name="start_date" class="form-control">
                    </div>
                    <div class="col-span-6">
                        <label class="form-label">Data Fine</label>
                        <input type="date" name="end_date" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary">Chiudi</button>
                    <button type="submit" class="btn btn-primary">Esporta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- END Modal Excel -->
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="/assets/js/views/attendance/attendance_list.js"></script>
{% endblock %}
