{% extends 'layout/base.html.twig' %}

{% block head %}
<link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/views/attendance/presenze.css">
<link rel="stylesheet" href="/assets/css/views/attendance/richieste.css?v=1">
{% endblock %}

{% set today = "now"|date('Y-m-d') %}
{# Una richiesta in attesa non e' un'assenza: quello la' domani e' al lavoro
   finche' qualcuno non gli risponde. Contarla fra gli assenti farebbe
   programmare la squadra senza di lui per un giorno che nessuno ha concesso. #}
{% set concesse = righe|filter(r => r.stato != 'in_attesa' and r.stato != 'rifiutata') %}
{% set ferieCount = concesse|filter(r => r.tipo == 'ferie')|length %}
{% set permessiCount = concesse|filter(r => r.tipo == 'permesso')|length %}
{% set oggiAssenti = concesse|filter(r => r.data_inizio <= today and r.data_fine >= today)|length %}

{% block content %}
<div class="fe-page">

    <div class="fe-hero">
        <div class="fe-hero-content">
            <div class="fe-hero-icon">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            </div>
            <div>
                <h1 class="fe-hero-title">Ferie e Permessi</h1>
                <p class="fe-hero-sub">Registra e gestisci le assenze degli operai</p>
            </div>
        </div>
        <div class="fe-hero-stats">
            {% if daApprovare|length %}
                <div class="fe-stat">
                    <div class="fe-stat-num">{{ daApprovare|length }}</div>
                    <div class="fe-stat-lbl">Da decidere</div>
                </div>
            {% endif %}
            <div class="fe-stat">
                <div class="fe-stat-num">{{ oggiAssenti }}</div>
                <div class="fe-stat-lbl">Assenti oggi</div>
            </div>
            <div class="fe-stat">
                <div class="fe-stat-num">{{ ferieCount }}</div>
                <div class="fe-stat-lbl">Ferie</div>
            </div>
            <div class="fe-stat">
                <div class="fe-stat-num">{{ permessiCount }}</div>
                <div class="fe-stat-lbl">Permessi</div>
            </div>
        </div>
    </div>

    {% if successMsg %}
        <div class="fe-toast fe-toast-ok"><span>✓ {{ successMsg }}</span><button type="button" data-dismiss-alert>&times;</button></div>
    {% endif %}
    {% if errorMsg %}
        <div class="fe-toast fe-toast-err"><span>{{ errorMsg }}</span><button type="button" data-dismiss-alert>&times;</button></div>
    {% endif %}

    {# ── Richieste dall'app ──
       In cima e non in fondo: un operaio che aspetta risposta per prenotare
       un volo conta piu' dell'elenco storico, che sta li' e non scappa.
       Dalla piu' vecchia, perche' quella ferma da una settimana e' quella
       che scotta. #}
    {% if daApprovare %}
        <div class="fe-card">
            <div class="fe-card-head">
                <h3 class="fe-card-title">
                    Richieste dall'app — {{ daApprovare|length }} da decidere
                </h3>
            </div>
            <div class="fe-card-body">
                {% for r in daApprovare %}
                    <div class="ri-card{{ r.giorni_in_attesa > 3 ? ' has-avvisi' : '' }}">

                        <div class="ri-card-head">
                            <div>
                                <div class="ri-operaio">{{ r.operaio_nome }}</div>
                                <div class="ri-azienda">{{ r.operaio_azienda ?: '—' }}</div>
                            </div>
                            <div class="ri-quando">
                                <span class="ri-data">
                                    {% if r.tipo == 'ferie' %}
                                        <span class="fe-badge fe-badge-ferie">Ferie</span>
                                    {% else %}
                                        <span class="fe-badge fe-badge-permesso">Permesso</span>
                                    {% endif %}
                                    {{ r.data_inizio|date('d/m/Y') }}
                                    {% if r.data_fine != r.data_inizio %} → {{ r.data_fine|date('d/m/Y') }}{% endif %}
                                </span>
                                <span class="ri-cantiere">
                                    {% set giorni = date(r.data_fine).diff(date(r.data_inizio)).days + 1 %}
                                    {{ r.ore ? r.ore ~ ' ore' : giorni ~ (giorni == 1 ? ' giorno' : ' giorni') }}
                                </span>
                            </div>
                        </div>

                        {# Da quanto aspetta. Dopo tre giorni passa in evidenza:
                           non e' un errore, e' che nessuno le ha guardate. #}
                        {% if r.giorni_in_attesa > 3 %}
                            <div class="ri-avvisi">
                                <div class="ri-avviso">
                                    <svg viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                                    In attesa da {{ r.giorni_in_attesa }} giorni
                                </div>
                            </div>
                        {% endif %}

                        {% if r.note %}<div class="ri-note">{{ r.note }}</div>{% endif %}

                        <form method="POST" action="/attendance/leaves/decidi" class="ri-form">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                            <input type="hidden" name="id" value="{{ r.id }}">
                            <div class="ri-azioni">
                                <input type="text" name="motivo" class="ri-motivo"
                                       placeholder="Motivo del rifiuto (l'operaio lo legge)">
                                <button type="submit" name="azione" value="rifiuta" class="ri-btn ri-btn-ko">
                                    Rifiuta
                                </button>
                                <button type="submit" name="azione" value="approva" class="ri-btn ri-btn-ok">
                                    Approva
                                </button>
                            </div>
                        </form>
                    </div>
                {% endfor %}

                {# Le date non si toccano da qui: se vanno corrette si usa
                   Modifica nell'elenco e poi si approva. Un'approvazione che
                   sposta i giorni di nascosto farebbe tornare l'operaio dalle
                   ferie il giorno sbagliato. #}
                <p class="fe-hint" style="margin-top:4px;">
                    Per cambiare le date prima di approvare, usa Modifica nell'elenco qui sotto.
                </p>
            </div>
        </div>
    {% endif %}

    {# ── Form registrazione ── #}
    <div class="fe-card">
        <div class="fe-card-head">
            <h3 class="fe-card-title" id="fe-form-title">Registra nuova assenza</h3>
        </div>
        <div class="fe-card-body">
            <form method="POST" action="/attendance/leaves/save" id="fe-form">
                <input type="hidden" name="record_id" value="">
                <div class="fe-grid">
                    <div>
                        <span class="fe-label">Tipo</span>
                        <div class="fe-tipo">
                            <button type="button" class="fe-tipo-chip on-ferie" data-tipo="ferie">Ferie</button>
                            <button type="button" class="fe-tipo-chip" data-tipo="permesso">Permesso</button>
                        </div>
                        <select name="tipo" id="tipoSelect" class="hidden">
                            <option value="ferie" selected>Ferie</option>
                            <option value="permesso">Permesso</option>
                        </select>
                    </div>
                    <div style="grid-column: span 2; min-width: 220px;">
                        <span class="fe-label">Operaio</span>
                        <select id="operaioSelect" name="operaio_id" required></select>
                    </div>
                    <div>
                        <span class="fe-label">Dal</span>
                        <input type="date" name="data_inizio" class="fe-input" required>
                    </div>
                    <div>
                        <span class="fe-label">Al</span>
                        <input type="date" name="data_fine" class="fe-input">
                        <span class="fe-hint">Vuoto = giorno singolo</span>
                    </div>
                    <div class="ore-wrap hidden">
                        <span class="fe-label">Ore</span>
                        <input type="number" name="ore" step="0.5" min="0.5" max="12" class="fe-input" placeholder="es. 4">
                        <span class="fe-hint">Vuoto = giornata intera</span>
                    </div>
                </div>
                <div style="margin-top: 14px;">
                    <span class="fe-label">Note</span>
                    <textarea name="note" class="fe-textarea" rows="2" placeholder="Eventuali note (motivo, riferimenti...)"></textarea>
                </div>
                <div class="fe-form-foot">
                    <button type="button" class="fe-btn-cancel" id="fe-cancel">Annulla modifica</button>
                    <button type="submit" class="fe-btn-save">
                        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Salva
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── Toolbar ── #}
    <div class="fe-toolbar">
        <div class="fe-search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchInput" placeholder="Cerca per operaio, azienda o data...">
        </div>
    </div>

    {# ── Tabella ── #}
    <div class="fe-table-wrap">
        <table class="fe-table" id="ferieTable">
            <thead>
            <tr>
                <th>Tipo</th>
                <th>Operaio</th>
                <th>Azienda</th>
                <th>Dal</th>
                <th>Al</th>
                <th>Ore</th>
                <th>Stato</th>
                <th>Note</th>
                <th style="text-align:right;">Azioni</th>
            </tr>
            </thead>
            <tbody>
            {% for row in righe %}
                {% set inCorso = row.data_inizio <= today and row.data_fine >= today %}
                <tr>
                    <td style="white-space:nowrap;">
                        {% if row.tipo == 'ferie' %}
                            <span class="fe-badge fe-badge-ferie">Ferie</span>
                        {% else %}
                            <span class="fe-badge fe-badge-permesso">Permesso</span>
                        {% endif %}
                        {% if inCorso %}<span class="fe-badge fe-badge-oggi">● oggi</span>{% endif %}
                    </td>
                    <td style="font-weight:600;">{{ row.operaio_nome }}</td>
                    <td style="color:#64748b;">{{ row.operaio_azienda ?: '—' }}</td>
                    <td style="white-space:nowrap;">{{ row.data_inizio|date('d/m/Y') }}</td>
                    <td style="white-space:nowrap;">{{ row.data_fine|date('d/m/Y') }}</td>
                    <td>{{ row.ore ? row.ore ~ ' h' : '—' }}</td>
                    {# Senza questa colonna una richiesta in attesa era
                       indistinguibile da una ferie concessa, e chi guardava
                       la riga dava per buono un permesso che nessuno aveva
                       dato. #}
                    <td style="white-space:nowrap;">
                        {% if row.stato == 'in_attesa' %}
                            <span class="ri-stato">in attesa</span>
                        {% elseif row.stato == 'rifiutata' %}
                            <span class="ri-stato ri-stato-rifiutata" title="{{ row.motivo|e('html_attr') }}">rifiutata</span>
                        {% else %}
                            <span class="ri-stato ri-stato-approvata">approvata</span>
                        {% endif %}
                        {% if row.richiesta_da_operaio %}
                            <span class="fe-badge fe-badge-app" title="Arrivata dall'app, non inserita dall'ufficio">app</span>
                        {% endif %}
                    </td>
                    <td style="font-size:12px; color:#64748b; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ row.note|e('html_attr') }}">{{ row.note }}</td>
                    <td>
                        <div style="display:flex; gap:6px; justify-content:flex-end;">
                            <button type="button" class="fe-btn fe-btn-edit edit-btn"
                                    data-id="{{ row.id }}"
                                    data-tipo="{{ row.tipo }}"
                                    data-operaio="{{ row.operaio_id }}"
                                    data-operaio-nome="{{ row.operaio_nome }}"
                                    data-dal="{{ row.data_inizio }}"
                                    data-al="{{ row.data_fine }}"
                                    data-ore="{{ row.ore }}"
                                    data-note="{{ row.note|e('html_attr') }}">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifica
                            </button>
                            <form method="POST"
                                  action="/attendance/leaves/save"
                                  class="inline-block"
                                  data-confirm="Confermi eliminazione di questo record?">
                                <input type="hidden" name="delete_id" value="{{ row.id }}">
                                <button type="submit" class="fe-btn fe-btn-del">
                                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    Elimina
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9" class="fe-empty">Nessuna ferie o permesso registrato. Usa il form qui sopra per iniziare.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="/assets/js/views/attendance/rifiuto_motivo.js?v=1"></script>
<script src="/assets/js/views/attendance/add_ferie.js"></script>
{% endblock %}
