{% extends 'layout/base.html.twig' %}

{#
  La giornata dei tecnici — pagina unica per autocarrate e mezzi sollevamento.

  Le due sezioni raccontano la stessa storia (cosa esce, cosa rientra, cosa e'
  in ritardo) e prima avevano due pagine gemelle con due macro quasi identiche.
  Ora la differenza sta tutta nei dati: App\Service\Poti\Giornata normalizza le
  righe in "schede" uguali, e qui si disegna una volta sola.

  Attese dal controller:
    titolo, sottotitolo, base, azione (url del POST), collegamenti,
    blocchi, riepilogo, prossime, data, ieri, domani, oggi, salvato.
#}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/poti/giornata.css?v=2">
{% endblock %}

{% block content %}
<div class="gi-page">

    <header class="gi-hero">
        <div class="gi-hero-testo">
            <h1>{{ titolo }}</h1>
            <p>{{ sottotitolo }}</p>
        </div>
        {% if collegamenti %}
            <nav class="gi-hero-link">
                {% for c in collegamenti %}
                    <a href="{{ c.href }}">{{ c.label }}</a>
                {% endfor %}
            </nav>
        {% endif %}
    </header>

    {# ── Barra del giorno: resta appesa in alto mentre si scorre ──────────── #}
    <div class="gi-barra" id="gi-barra">
        <form method="GET" action="{{ base }}" class="gi-giorni">
            <a href="{{ base }}?data={{ ieri }}" class="gi-freccia" aria-label="Giorno precedente">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </a>

            <div class="gi-data">
                <span class="gi-data-gg">
                    {{ ['','lunedi','martedi','mercoledi','giovedi','venerdi','sabato','domenica'][data|date('N')] }}
                </span>
                <span class="gi-data-n">{{ data|date('d/m/Y') }}</span>
                {% if data == oggi %}<span class="gi-oggi-pill">oggi</span>{% endif %}
            </div>

            <a href="{{ base }}?data={{ domani }}" class="gi-freccia" aria-label="Giorno successivo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </a>

            {% if data != oggi %}<a href="{{ base }}" class="gi-torna-oggi">Torna a oggi</a>{% endif %}

            <input type="date" name="data" value="{{ data }}"
                   aria-label="Scegli il giorno">
            {# il pulsante resta visibile: senza JS il campo data da solo non
               manda niente, e sembrerebbe che non funzioni #}
            <button class="gi-vai">Vai</button>
        </form>

        <label class="gi-cerca">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="search" id="gi-cerca" placeholder="Cerca targa, cliente, paese…"
                   autocomplete="off" aria-label="Cerca nella giornata">
        </label>
    </div>

    {% if salvato %}<div class="gi-avviso">Segnato.</div>{% endif %}

    {# il pezzo che cambia a ogni tocco, e che il server sa rimandare da solo #}
    <div id="gi-corpo">
        {% include 'poti/_giornata_corpo.html.twig' %}
    </div>

    {# ── Prossime partenze: serve a preparare i mezzi in anticipo ─────────── #}
    <section class="gi-prossime">
        <h2 class="gi-blocco-tit">
            <span class="gi-punto gi-p-prossime"></span>
            Prossime partenze
        </h2>
        {% for giorno, righe in prossime %}
            <div class="gi-giorno">
                <div class="gi-giorno-tit">
                    <strong>{{ giorno|date('d/m') }}</strong>
                    <span>{{ ['','lunedi','martedi','mercoledi','giovedi','venerdi','sabato','domenica'][giorno|date('N')] }}</span>
                    <span class="gi-conta">{{ righe|length }}</span>
                </div>
                {% for p in righe %}
                    <div class="gi-prossima">
                        <span class="gi-mezzo-mini">{{ p.mezzo }}</span>
                        <span class="gi-prossima-cliente">{{ p.cliente }}</span>
                        {% if p.luogo %}<span class="gi-prossima-luogo">{{ p.luogo }}</span>{% endif %}
                        <span class="gi-prossima-gg">{{ p.giorni }} gg</span>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="gi-vuoto">
                <span>Niente in partenza nei prossimi 14 giorni.</span>
            </div>
        {% endfor %}
    </section>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/poti/giornata.js?v=2"></script>
{% endblock %}
