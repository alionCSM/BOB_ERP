{% extends 'layout/base.html.twig' %}

{#
  La giornata dei tecnici — pagina unica per autocarrate e mezzi sollevamento.

  Le due sezioni raccontano la stessa storia (cosa esce, cosa rientra, cosa e'
  in ritardo) e prima avevano due pagine gemelle con due macro quasi identiche.
  Ora la differenza sta tutta nei dati: App\Service\Poti\Giornata normalizza le
  righe in "schede" uguali, e qui si disegna una volta sola.

  Attese dal controller:
    titolo, sottotitolo, base, azione (url del POST), collegamenti,
    blocchi, riepilogo, prossime, data, ieri, domani, oggi, salvato.
#}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/poti/giornata.css?v=6">
{% endblock %}

{% block content %}
<div class="gi-page">

    {# ── Testata: titolo, giorno e ricerca in un pezzo solo ───────────────── #}
    <div class="gi-testata">
        <div class="gi-testata-alto">
            <h1>{{ titolo }}</h1>
            {% if collegamenti %}
                <nav class="gi-link">
                    {% for c in collegamenti %}<a href="{{ c.href }}">{{ c.label }}</a>{% endfor %}
                </nav>
            {% endif %}
        </div>

        <div class="gi-testata-basso">
            <form method="GET" action="{{ base }}" class="gi-giorni">
                <a href="{{ base }}?data={{ ieri }}" class="gi-freccia" aria-label="Giorno precedente">‹</a>

                <span class="gi-data">
                    <b>{{ ['','lunedi','martedi','mercoledi','giovedi','venerdi','sabato','domenica'][data|date('N')] }}</b>
                    {{ data|date('d/m/Y') }}
                    {% if data == oggi %}<i class="gi-oggi">oggi</i>{% endif %}
                </span>

                <a href="{{ base }}?data={{ domani }}" class="gi-freccia" aria-label="Giorno successivo">›</a>

                {% if data != oggi %}<a href="{{ base }}" class="gi-torna">oggi</a>{% endif %}

                <input type="date" name="data" value="{{ data }}" aria-label="Scegli il giorno">
                {# resta visibile: senza JS il campo data da solo non manda
                   niente, e sembrerebbe che non funzioni #}
                <button class="gi-vai">Vai</button>
            </form>

            <label class="gi-cerca">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input type="search" id="gi-cerca" placeholder="Cerca targa, cliente, paese…"
                       autocomplete="off" aria-label="Cerca nella giornata">
            </label>
        </div>
    </div>

    {% if salvato %}<div class="gi-avviso">Segnato.</div>{% endif %}

    {# il pezzo che cambia a ogni tocco, e che il server sa rimandare da solo #}
    <div id="gi-corpo">
        {% include 'poti/_giornata_corpo.html.twig' %}
    </div>

    {# ── Prossime partenze: serve a preparare i mezzi in anticipo ─────────── #}
    <details class="gi-prossime"{% if prossime %} open{% endif %}>
        <summary>Prossime partenze</summary>
        <div class="gi-prossime-corpo">
            {% for giorno, righe in prossime %}
                <div class="gi-giorno">
                    <div class="gi-giorno-tit">
                        <b>{{ giorno|date('d/m') }}</b>
                        <span>{{ ['','lun','mar','mer','gio','ven','sab','dom'][giorno|date('N')] }}</span>
                        <i>{{ righe|length }}</i>
                    </div>
                    {% for p in righe %}
                        <div class="gi-prossima">
                            <span class="gi-targa-mini">{{ p.mezzo }}</span>
                            <span class="gi-prossima-cliente">{{ p.cliente }}</span>
                            {% if p.luogo %}<span class="gi-prossima-luogo">{{ p.luogo }}</span>{% endif %}
                            <span class="gi-prossima-gg">{{ p.giorni }}gg</span>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="gi-col-niente">Niente in partenza nei prossimi 14 giorni.</p>
            {% endfor %}
        </div>
    </details>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/poti/giornata.js?v=6"></script>
{% endblock %}
