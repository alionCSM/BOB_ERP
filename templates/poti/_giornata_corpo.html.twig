{#
  Il corpo della giornata: la board a colonne.

  Una colonna per momento della giornata, da sinistra a destra nell'ordine
  in cui le cose succedono: chi doveva rientrare, chi esce, chi rientra, chi
  resta fuori. Prima era un elenco unico in verticale, e per sapere quante
  autocarrate uscivano bisognava scorrere fino al blocco giusto.

  E' anche l'unica cosa che il server rimanda dopo un tocco (?frammento=1):
  ricaricare l'intera pagina — menu, barra in alto, prossime partenze — per
  cambiare una scheda sarebbe sprecato su un telefono in officina.

  Attese: blocchi, riepilogo, data, azione, csrfToken.
#}
{% import 'poti/_giornata_scheda.html.twig' as g %}

{# L'avanzamento sta qui e non nella barra in alto perche' cambia a ogni
   tocco: e' l'unica parte del riepilogo che si muove, ed e' anche l'unica
   che il tecnico guarda per sapere se ha finito. #}
<div class="gi-avanz{{ riepilogo.movimenti > 0 and riepilogo.mancanti == 0 ? ' is-finita' : '' }}">
    <span class="gi-avanz-n">{{ riepilogo.fatti }}/{{ riepilogo.movimenti }}</span>
    <span class="gi-avanz-lb">
        {% if riepilogo.movimenti == 0 %}
            nessun movimento oggi
        {% elseif riepilogo.mancanti == 0 %}
            giornata completata
        {% else %}
            {{ riepilogo.mancanti }} da segnare
        {% endif %}
    </span>
    <span class="gi-avanz-barra"><i style="width: {{ riepilogo.percentuale }}%"></i></span>
</div>

{# Le intestazioni contano e filtrano insieme: sul telefono le colonne si
   scorrono di lato, e toccare un titolo porta dritti a quella. #}
<div class="gi-board" id="gi-board">
    {% for chiave, b in blocchi %}
        <section class="gi-col gi-col-{{ chiave }}{{ b.schede|length ? '' : ' is-vuota' }}"
                 data-gi-col="{{ chiave }}">
            <header class="gi-col-testa">
                <span class="gi-col-tit">{{ b.etichetta }}</span>
                <span class="gi-col-n">{{ b.schede|length }}</span>
            </header>

            <div class="gi-col-corpo">
                {% for s in b.schede %}{{ g.scheda(s, data, azione, csrfToken) }}{% endfor %}

                {% if b.schede|length == 0 %}
                    <p class="gi-col-niente">—</p>
                {% endif %}

                {# compare quando la ricerca dal vivo non lascia niente in
                   questa colonna, ma qualcosa c'era #}
                <p class="gi-col-niente gi-col-cercato" hidden>nessuna corrispondenza</p>
            </div>
        </section>
    {% endfor %}
</div>
