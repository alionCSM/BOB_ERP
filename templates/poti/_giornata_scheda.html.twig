{#
  La scheda di un mezzo nella giornata.

  Sta in un file suo perche' la usano sia la pagina intera sia il pezzo che
  il server rimanda dopo ogni tocco: due copie divergerebbero al primo
  ritocco, e il tecnico si troverebbe due schede diverse a seconda che
  avesse ricaricato o no.

  Compatta di proposito: sta dentro una colonna della board, e in una
  giornata piena se ne devono vedere sei o sette senza scorrere.
  Niente importi: al tecnico serve sapere se e' pagato, non quanto.
#}
{% macro scheda(s, data, azione, csrf, azioneFoto) %}
    {# data-gi-* : ci si appoggiano il filtro e la ricerca dal vivo #}
    <article class="gi-card{{ s.fatta ? ' is-fatta' : '' }}"
             data-gi-blocco="{{ s.blocco }}"
             data-gi-cerca="{{ s.cerca }}">

        <div class="gi-riga1">
            <span class="gi-targa">{{ s.mezzo }}</span>
            {% if s.fatta %}
                <span class="gi-spunta" title="Gia' segnato">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                </span>
            {% endif %}
            {% if s.telefono %}
                <a class="gi-tel" href="tel:{{ s.telefonoUrl }}" title="Chiama {{ s.telefono }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 1.9.6 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.1a2 2 0 012.1-.5c.9.3 1.8.5 2.8.6a2 2 0 011.7 2z"/></svg>
                </a>
            {% endif %}
        </div>

        {% if s.sotto %}<div class="gi-sotto">{{ s.sotto }}</div>{% endif %}

        <div class="gi-cliente">{{ s.cliente }}</div>

        <div class="gi-meta">
            {% if s.luogo %}<span class="gi-luogo">{{ s.luogo }}</span>{% endif %}
            <span class="gi-periodo">{{ s.dal|date('d/m') }}→{{ s.al|date('d/m') }} · {{ s.giorni }}gg</span>
        </div>

        {# pallini invece di etichette: in colonna stretta due parole per
           stato mangerebbero tutta la riga #}
        <div class="gi-stati">
            <span class="gi-dot {{ s.pagata ? 'is-ok' : 'is-attesa' }}"
                  title="{{ s.pagata ? 'Pagata' : 'Da pagare' }}">€</span>
            <span class="gi-dot {{ s.firmato ? 'is-ok' : 'is-ko' }}"
                  title="{{ s.firmato ? 'Contratto firmato' : 'Contratto da firmare' }}">✍</span>
            {% if s.contratto %}<span class="gi-rif">{{ s.contratto }}</span>{% endif %}
            {% if s.consegnato %}<span class="gi-ora">↑ {{ s.consegnatoAt|date('H:i') }}</span>{% endif %}
            {% if s.rientrato %}<span class="gi-ora">↓ {{ s.rientratoAt|date('H:i') }}</span>{% endif %}
        </div>

        {% if s.note %}<div class="gi-note">{{ s.note }}</div>{% endif %}

        {# Carburante: si scrive com'e' scritto sullo strumento — tacche,
           percentuale o litri — perche' cambia da mezzo a mezzo e far
           convertire a mente in piazzale e' il modo piu' veloce per avere
           numeri sbagliati. Si vedono tutti e due i livelli: il senso di
           questo dato e' il confronto fra come e' uscito e come e' tornato. #}
        {% if s.carbUscita or s.carbRientro %}
            <div class="gi-carb">
                <span class="gi-carb-ic" aria-hidden="true">⛽</span>
                {{ s.carbUscita ?: '—' }}
                {%- if s.rientrato or s.carbRientro %} → {{ s.carbRientro ?: '—' }}{% endif -%}
            </div>
        {% endif %}

        {# Foto: quando il mezzo torna ammaccato, la discussione su chi
           l'ha rotto la chiude una fotografia fatta il giorno della
           consegna. Per questo si scattano qui, sul posto, e non da una
           schermata di archivio dove nessuno andrebbe mai. #}
        {% set fotoUscita  = s.foto.uscita  ?? [] %}
        {% set fotoRientro = s.foto.rientro ?? [] %}

        <div class="gi-foto">
            {% for f in fotoUscita %}
                <a class="gi-foto-t" href="{{ f.url }}" target="_blank" rel="noopener"
                   title="Foto dell'uscita">
                    <img src="{{ f.url }}" alt="Foto dell'uscita" loading="lazy">
                    <span class="gi-foto-m">↑</span>
                </a>
            {% endfor %}
            {% for f in fotoRientro %}
                <a class="gi-foto-t" href="{{ f.url }}" target="_blank" rel="noopener"
                   title="Foto del rientro">
                    <img src="{{ f.url }}" alt="Foto del rientro" loading="lazy">
                    <span class="gi-foto-m is-giu">↓</span>
                </a>
            {% endfor %}

            {# multiple e senza capture: capture forzerebbe la fotocamera e una
               foto per volta, mentre girando intorno al mezzo se ne fanno tre
               o quattro. Senza, il telefono offre lo stesso la fotocamera nel
               suo elenco, ma lascia anche prenderne piu' d'una gia' scattate. #}
            <label class="gi-foto-piu" title="Aggiungi foto">
                <input type="file" accept="image/*" multiple hidden
                       data-gi-foto="{{ azioneFoto }}"
                       data-gi-entita="{{ s.campi.riga_id ?? s.campi.id }}"
                       data-gi-momento="{{ s.rientrato or s.azione == 'rientrato' ? 'rientro' : 'uscita' }}"
                       data-gi-csrf="{{ csrf }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                    <circle cx="12" cy="13" r="4"/>
                </svg>
            </label>
        </div>

        {# Un'azione grande e ovvia — quella della colonna — e le altre
           dietro il tasto "…". Prima erano tre pulsanti uguali affiancati e
           bisognava leggerli tutti per capire quale premere. #}
        <div class="gi-azioni">
            {% if s.azione %}
                <form method="POST" action="{{ azione }}" class="gi-form">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="data" value="{{ data }}">
                    <input type="hidden" name="cosa" value="{{ s.azione }}">
                    {% for nome, valore in s.campi %}
                        <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                    {% endfor %}

                    {# Si compila insieme al tocco e non prima: chi segna
                       l'uscita ha il mezzo davanti e legge lo strumento in
                       quel momento. Sparisce una volta segnato, quando il
                       livello e' gia' scritto sulla scheda. #}
                    {% if not s.fatta %}
                        <input type="text" name="carburante" class="gi-carb-campo"
                               maxlength="40" autocomplete="off"
                               placeholder="{{ s.azione == 'consegnato' ? 'gasolio in uscita' : 'gasolio al rientro' }}"
                               aria-label="Livello carburante">
                    {% endif %}

                    <button class="gi-vai-btn{{ s.fatta ? ' is-fatta' : '' }}">
                        {% if s.fatta %}
                            {{ s.azione == 'consegnato' ? 'Uscita segnata' : 'Rientro segnato' }} · annulla
                        {% else %}
                            {{ s.azione == 'consegnato' ? 'Segna uscita' : 'Segna rientro' }}
                        {% endif %}
                    </button>
                </form>
            {% endif %}

            <details class="gi-altro">
                <summary aria-label="Altre azioni">···</summary>
                <div class="gi-altro-menu">
                    {% if s.azione != 'consegnato' %}
                        <form method="POST" action="{{ azione }}" class="gi-form">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <input type="hidden" name="data" value="{{ data }}">
                            <input type="hidden" name="cosa" value="consegnato">
                            {% for nome, valore in s.campi %}
                                <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                            {% endfor %}
                            <button>{{ s.consegnato ? 'Annulla uscita' : 'Segna uscita' }}</button>
                        </form>
                    {% endif %}

                    {% if s.azione != 'rientrato' %}
                        <form method="POST" action="{{ azione }}" class="gi-form">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <input type="hidden" name="data" value="{{ data }}">
                            <input type="hidden" name="cosa" value="rientrato">
                            {% for nome, valore in s.campi %}
                                <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                            {% endfor %}
                            <button>{{ s.rientrato ? 'Annulla rientro' : 'Segna rientro' }}</button>
                        </form>
                    {% endif %}

                    <form method="POST" action="{{ azione }}" class="gi-form">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <input type="hidden" name="data" value="{{ data }}">
                        <input type="hidden" name="cosa" value="firma">
                        {% for nome, valore in s.campi %}
                            <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                        {% endfor %}
                        <button>{{ s.firmato ? 'Togli firma' : 'Contratto firmato' }}</button>
                    </form>
                </div>
            </details>
        </div>
    </article>
{% endmacro %}
