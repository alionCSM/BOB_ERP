{#
  La scheda di un mezzo nella giornata.

  Sta in un file suo perche' la usano sia la pagina intera sia il pezzo che
  il server rimanda dopo ogni tocco: due copie divergerebbero al primo
  ritocco, e il tecnico si troverebbe due schede diverse a seconda che
  avesse ricaricato o no.

  Niente importi: al tecnico serve sapere se e' pagato, non quanto.
#}
{% macro scheda(s, data, azione, csrf) %}
    {# data-gi-* : ci si appoggiano il filtro e la ricerca dal vivo #}
    <article class="gi-card gi-{{ s.blocco }}{{ s.fatta ? ' is-fatta' : '' }}"
             data-gi-blocco="{{ s.blocco }}"
             data-gi-cerca="{{ s.cerca }}">

        <div class="gi-card-main">
            <div class="gi-mezzo-box">
                <span class="gi-mezzo">{{ s.mezzo }}</span>
                {% if s.sotto %}<span class="gi-sotto">{{ s.sotto }}</span>{% endif %}
            </div>

            <div class="gi-info">
                <div class="gi-cliente">{{ s.cliente }}</div>

                <div class="gi-meta">
                    {% if s.luogo %}
                        <span class="gi-meta-v">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            {{ s.luogo }}
                        </span>
                    {% endif %}
                    <span class="gi-meta-v">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        {{ s.dal|date('d/m') }} → {{ s.al|date('d/m') }} · {{ s.giorni }} gg
                    </span>
                </div>

                {# il telefono e' un pulsante, non un testo: in officina si
                   chiama il cliente, non si copia il numero a mano #}
                {% if s.telefono %}
                    <a class="gi-chiama" href="tel:{{ s.telefonoUrl }}">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 1.9.6 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.1a2 2 0 012.1-.5c.9.3 1.8.5 2.8.6a2 2 0 011.7 2z"/></svg>
                        {{ s.telefono }}
                    </a>
                {% endif %}

                <div class="gi-stati">
                    <span class="gi-tag {{ s.pagata ? 'is-ok' : 'is-attesa' }}">
                        {{ s.pagata ? 'Pagata' : 'Da pagare' }}
                    </span>
                    <span class="gi-tag {{ s.firmato ? 'is-ok' : 'is-ko' }}">
                        {{ s.firmato ? 'Contratto firmato' : 'Contratto da firmare' }}
                    </span>
                    {% if s.contratto %}<span class="gi-tag is-info">{{ s.contratto }}</span>{% endif %}
                    {% if s.consegnato %}
                        <span class="gi-tag is-fatto">Uscita {{ s.consegnatoAt|date('d/m H:i') }}</span>
                    {% endif %}
                    {% if s.rientrato %}
                        <span class="gi-tag is-fatto">Rientro {{ s.rientratoAt|date('d/m H:i') }}</span>
                    {% endif %}
                </div>

                {% if s.note %}<div class="gi-note">{{ s.note }}</div>{% endif %}
            </div>
        </div>

        <div class="gi-azioni">
            {# Un'azione grande e ovvia — quella del blocco — e le altre in
               piccolo. Prima erano tre pulsanti uguali e bisognava leggerli
               tutti per capire quale premere. #}
            {% if s.azione %}
                <form method="POST" action="{{ azione }}" class="gi-form">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="data" value="{{ data }}">
                    <input type="hidden" name="cosa" value="{{ s.azione }}">
                    {% for nome, valore in s.campi %}
                        <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                    {% endfor %}
                    <button class="gi-primaria{{ s.fatta ? ' is-fatta' : '' }}">
                        {% if s.fatta %}
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                            {{ s.azione == 'consegnato' ? 'Uscita segnata' : 'Rientro segnato' }}
                            <span class="gi-primaria-annulla">annulla</span>
                        {% else %}
                            {{ s.azione == 'consegnato' ? 'Segna uscita' : 'Segna rientro' }}
                        {% endif %}
                    </button>
                </form>
            {% endif %}

            <div class="gi-secondarie">
                {% if s.azione != 'consegnato' and not s.consegnato %}
                    <form method="POST" action="{{ azione }}" class="gi-form">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <input type="hidden" name="data" value="{{ data }}">
                        <input type="hidden" name="cosa" value="consegnato">
                        {% for nome, valore in s.campi %}
                            <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                        {% endfor %}
                        <button class="gi-secondaria">Segna uscita</button>
                    </form>
                {% endif %}

                {% if s.azione != 'rientrato' and not s.rientrato %}
                    <form method="POST" action="{{ azione }}" class="gi-form">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <input type="hidden" name="data" value="{{ data }}">
                        <input type="hidden" name="cosa" value="rientrato">
                        {% for nome, valore in s.campi %}
                            <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                        {% endfor %}
                        <button class="gi-secondaria">Segna rientro</button>
                    </form>
                {% endif %}

                <form method="POST" action="{{ azione }}" class="gi-form">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="data" value="{{ data }}">
                    <input type="hidden" name="cosa" value="firma">
                    {% for nome, valore in s.campi %}
                        <input type="hidden" name="{{ nome }}" value="{{ valore }}">
                    {% endfor %}
                    <button class="gi-secondaria">
                        {{ s.firmato ? 'Togli firma' : 'Contratto firmato' }}
                    </button>
                </form>
            </div>
        </div>
    </article>
{% endmacro %}
