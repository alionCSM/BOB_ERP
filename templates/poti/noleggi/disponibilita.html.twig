{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/poti/autocarrate.css?v=15">
{# la barra di paginazione sta qui: la usano tutte e tre le pagine #}
<link rel="stylesheet" href="/assets/css/views/poti/noleggi.css?v=5">
{% endblock %}

{% block content %}
<div class="ac-page">

    <div class="ac-hero">
        <div>
            <h1 class="ac-title">Disponibilita' mezzi sollevamento</h1>
            <p class="ac-sub">Quali sono liberi, quali impegnati e da quando tornano disponibili.</p>
        </div>
        <div class="ac-hero-links">
            <a href="/noleggi/elenco" class="ac-btn">Noleggi</a>
            <a href="/noleggi/macchine" class="ac-btn">Mezzi</a>
        </div>
    </div>

    {# ── La domanda, prima di tutto ──────────────────────────────────────
       Questa pagina serve a rispondere a "cosa ho libero il tal giorno".
       Con centinaia di mezzi partire dall'elenco completo non risponde a
       niente: nessuno lo scorre tutto. Quindi si chiede il periodo, e i
       mezzi compaiono dopo, gia' ridotti a quelli disponibili. #}
    <form method="GET" class="ac-check">
        <div class="ac-check-tile">
            <i data-lucide="calendar"></i>
            <span>Verifica disponibilita'</span>
        </div>
        <div class="ac-check-campi">
            <label class="ac-f">
                <span>dal</span>
                <input type="date" name="cerca_dal" value="{{ cercaDal }}" required>
            </label>
            <label class="ac-f">
                <span>al</span>
                <input type="date" name="cerca_al" value="{{ cercaAl }}" required>
            </label>
            <label class="ac-f">
                <span>tipo</span>
                <select name="tipo">
                    <option value="">tutti</option>
                    {% for t in tipi %}
                        <option value="{{ t }}" {{ tipo == t ? 'selected' : '' }}>{{ t }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="ac-f ac-f-cerca">
                <span>mezzo</span>
                <input type="search" name="q" value="{{ cerca }}"
                       placeholder="numero, matricola, modello…">
            </label>
            <input type="hidden" name="dal" value="{{ dal }}">
            <input type="hidden" name="al" value="{{ al }}">
            <button class="ac-btn ac-btn-primary">Verifica</button>
            {% if ricercaAttiva %}
                <a href="/noleggi" class="ac-link">azzera</a>
            {% endif %}
        </div>
    </form>

    {% if not ricercaAttiva %}
        {# Niente elenco finche' non c'e' un periodo: il calendario qui sotto
           da' gia' il quadro del mese. #}
        <div class="ac-vuoto">Nessun periodo selezionato.</div>
    {% else %}
        <div class="ac-risultato">
            <strong>{{ totale }}</strong>
            {{ totale == 1 ? 'mezzo disponibile' : 'mezzi disponibili' }}
            <span>{{ cercaDal|date('d/m/Y') }} — {{ cercaAl|date('d/m/Y') }}</span>
        </div>

        <div class="ac-mezzi">
            {% for m in macchine %}
                <div class="ac-mezzo is-ok">
                    <div class="ac-mezzo-top">
                        {# il numero grande: e' quello che si va a cercare in
                           piazzale, la matricola sta sotto come riscontro #}
                        {% if m.numero %}<span class="nl-numero">{{ m.numero }}</span>{% endif %}
                        <span class="ac-targa">{{ m.matricola }}</span>
                        {% if m.stato != 'attiva' %}
                            <span class="ac-stato ac-stato-{{ m.stato }}">{{ m.stato }}</span>
                        {% endif %}
                    </div>
                    <div class="ac-mezzo-mod">{{ m.tipo }}{{ m.modello ? ' — ' ~ m.modello : '' }}</div>
                    <div class="ac-specs">
                        {% if m.altezza_max_m %}<span>{{ m.altezza_max_m|number_format(2, ',', '.') }} m</span>{% endif %}
                        {% if m.portata_kg %}<span>{{ m.portata_kg }} kg</span>{% endif %}
                    </div>
                    <div class="ac-libero">Disponibile</div>
                </div>
            {% else %}
                <div class="ac-empty">
                    Nessun mezzo disponibile nel periodo{{ tipo or cerca ? ' con i filtri impostati' : '' }}.
                </div>
            {% endfor %}
        </div>

        {% include 'poti/_paginazione.html.twig' with {
            base: '/noleggi', nome: 'mezzi liberi'
        } %}
    {% endif %}

    {# ── Impegni del periodo ─────────────────────────────────────────────
       Solo il calendario. La timeline disegnava una riga per mezzo: su un
       parco da centinaia era una tabella alta quanto il parco, che nessuno
       leggeva. Il calendario invece raggruppa per giorno e resta della
       stessa altezza che ci siano dieci mezzi o mille. #}
    <div class="ac-box">
        <div class="ac-box-head">
            <span>Impegni</span>
            <form method="GET" class="ac-periodo">
                <input type="date" name="dal" value="{{ dal }}">
                <span>→</span>
                <input type="date" name="al" value="{{ al }}">
                <input type="hidden" name="cerca_dal" value="{{ cercaDal }}">
                <input type="hidden" name="cerca_al" value="{{ cercaAl }}">
                {# i filtri sui mezzi si portano dietro: cambiare il periodo
                   non deve rimettere in elenco tutto il parco #}
                <input type="hidden" name="tipo" value="{{ tipo }}">
                <input type="hidden" name="stato" value="{{ stato }}">
                <input type="hidden" name="q" value="{{ cerca }}">
                <input type="hidden" name="pagina" value="{{ pagina }}">
                <button class="ac-btn">Mostra</button>
            </form>
        </div>

        <div class="ac-cal" id="ac-vista-calendario">
            {% for mese in calendario %}
                <div class="ac-cal-mese">
                    <div class="ac-cal-tit">{{ mese.titolo }}</div>
                    <div class="ac-cal-wd">
                        {% for d in ['Lun','Mar','Mer','Gio','Ven','Sab','Dom'] %}
                            <span>{{ d }}</span>
                        {% endfor %}
                    </div>
                    <div class="ac-cal-grid">
                        {% for c in mese.celle %}
                            {% if c.vuota %}
                                <div class="ac-cal-c is-vuota"></div>
                            {% else %}
                                <div class="ac-cal-c{{ c.festivo ? ' is-fest' : '' }}{{ c.oggi ? ' is-oggi' : '' }}">
                                    <span class="ac-cal-n">{{ c.g }}</span>
                                    {% for e in c.eventi|slice(0, 3) %}
                                        <span class="ac-ev ac-ev-confermata"
                                              title="{{ e.etichetta }} — {{ e.cliente }}{{ e.luogo ? ' — ' ~ e.luogo : '' }}">
                                            {{ e.etichetta }}
                                        </span>
                                    {% endfor %}
                                    {% if c.eventi|length > 3 %}
                                        <span class="ac-ev-piu">+{{ c.eventi|length - 3 }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="ac-empty">Nessun mese nel periodo scelto.</div>
            {% endfor %}
        </div>

    </div>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/poti/noleggi.js?v=5"></script>
{% endblock %}
