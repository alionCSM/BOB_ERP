{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/poti/autocarrate.css?v=2">
{% endblock %}

{% block content %}
<div class="ac-page">

    <div class="ac-hero">
        <div>
            <h1 class="ac-title">Disponibilita' autocarrate</h1>
            <p class="ac-sub">Chi e' libero, chi e' impegnato e da quando torna disponibile.</p>
        </div>
        <div class="ac-hero-links">
            <a href="/autocarrate/prenotazioni" class="ac-btn">Prenotazioni</a>
            <a href="/autocarrate/mezzi" class="ac-btn">Mezzi</a>
        </div>
    </div>

    {# ── Ricerca disponibilita' ──────────────────────────────────────────── #}
    <form method="GET" class="ac-cerca">
        <div class="ac-cerca-tit">Mi serve un'autocarrata</div>
        <label class="ac-f">
            <span>dal</span>
            <input type="date" name="cerca_dal" value="{{ cercaDal }}">
        </label>
        <label class="ac-f">
            <span>al</span>
            <input type="date" name="cerca_al" value="{{ cercaAl }}">
        </label>
        <input type="hidden" name="dal" value="{{ dal }}">
        <input type="hidden" name="al" value="{{ al }}">
        <button class="ac-btn ac-btn-primary">Cerca</button>
        {% if ricercaAttiva %}
            <a href="/autocarrate" class="ac-link">azzera</a>
        {% endif %}
    </form>

    {# ── Elenco mezzi ────────────────────────────────────────────────────── #}
    <div class="ac-mezzi">
        {% for m in mezzi %}
            {% set occupato = ricercaAttiva and occupati[m.id] is defined %}
            {% set libero   = liberoDal[m.id] is defined and liberoDal[m.id] %}
            <div class="ac-mezzo{{ ricercaAttiva ? (occupato ? ' is-ko' : ' is-ok') : '' }}">
                <div class="ac-mezzo-top">
                    <span class="ac-targa">{{ m.targa }}</span>
                    {% if m.stato != 'attiva' %}
                        <span class="ac-stato ac-stato-{{ m.stato }}">{{ m.stato }}</span>
                    {% endif %}
                </div>
                <div class="ac-mezzo-mod">{{ m.modello ?: '—' }}</div>
                <div class="ac-specs">
                    {% if m.altezza_max_m %}<span>{{ m.altezza_max_m|number_format(2, ',', '.') }} m</span>{% endif %}
                    {% if m.portata_kg %}<span>{{ m.portata_kg }} kg</span>{% endif %}
                </div>
                <div class="ac-libero">
                    {% if ricercaAttiva %}
                        {{ occupato ? 'Occupata nel periodo' : 'Libera nel periodo' }}
                    {% elseif libero %}
                        Libera dal {{ liberoDal[m.id]|date('d/m/Y') }}
                    {% else %}
                        Libera adesso
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="ac-empty">
                Nessuna autocarrata registrata. <a href="/autocarrate/mezzi">Aggiungine una</a>.
            </div>
        {% endfor %}
    </div>

    {# ── Timeline ────────────────────────────────────────────────────────── #}
    {% if mezzi %}
    <div class="ac-box">
        <div class="ac-box-head">
            <span>Impegni</span>
            <form method="GET" class="ac-periodo">
                <input type="date" name="dal" value="{{ dal }}">
                <span>→</span>
                <input type="date" name="al" value="{{ al }}">
                <input type="hidden" name="cerca_dal" value="{{ cercaDal }}">
                <input type="hidden" name="cerca_al" value="{{ cercaAl }}">
                <button class="ac-btn">Mostra</button>
            </form>
        </div>

        {# scorre in orizzontale: il periodo puo' essere piu' largo dello schermo #}
        <div class="ac-tl-wrap">
            <table class="ac-tl" style="--giorni: {{ giorni|length }}">
                <thead>
                    <tr>
                        <th class="ac-tl-mezzo">Mezzo</th>
                        {% for g in giorni %}
                            <th class="ac-tl-g{{ g.festivo ? ' is-fest' : '' }}">
                                <span class="ac-tl-wd">{{ g.wd }}</span>
                                <span class="ac-tl-n">{{ g.g }}</span>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for m in mezzi %}
                        <tr>
                            <th class="ac-tl-mezzo">{{ m.targa }}</th>
                            {% set righeMezzo = griglia[m.id]|default({}) %}
                            {% for g in giorni %}
                                {% set cella = righeMezzo[g.iso]|default(null) %}
                                <td class="ac-tl-c{{ g.festivo ? ' is-fest' : '' }}">
                                    {% if cella %}
                                        <span class="ac-barra ac-barra-{{ cella.stato }}"
                                              title="{{ cella.testo }}"></span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="ac-legenda">
            <span><i class="ac-barra ac-barra-confermata"></i> confermata</span>
            <span><i class="ac-barra ac-barra-opzione"></i> opzione</span>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
