{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/poti/autocarrate.css?v=14">
{% endblock %}

{% block content %}
<div class="ac-page">

    <div class="ac-hero">
        <div>
            <h1 class="ac-title">Disponibilita' autocarrate</h1>
            <p class="ac-sub">Chi e' libero, chi e' impegnato e da quando torna disponibile.</p>
        </div>
        <div class="ac-hero-links">
            <a href="/autocarrate/prenotazioni" class="ac-btn">Prenotazioni</a>
            <a href="/autocarrate/mezzi" class="ac-btn">Mezzi</a>
        </div>
    </div>

    {# ── Ricerca disponibilita' ──────────────────────────────────────────── #}
    <form method="GET" class="ac-check">
        <div class="ac-check-tile">
            <i data-lucide="calendar"></i>
            <span>Verifica disponibilita'</span>
        </div>
        <div class="ac-check-campi">
            <label class="ac-f">
                <span>dal</span>
                <input type="date" name="cerca_dal" value="{{ cercaDal }}">
            </label>
            <label class="ac-f">
                <span>al</span>
                <input type="date" name="cerca_al" value="{{ cercaAl }}">
            </label>
            <input type="hidden" name="dal" value="{{ dal }}">
            <input type="hidden" name="al" value="{{ al }}">
            <button class="ac-btn ac-btn-primary">Verifica</button>
            {% if ricercaAttiva %}
                <a href="/autocarrate" class="ac-link">azzera</a>
            {% endif %}
        </div>
    </form>

    {# ── Elenco mezzi ────────────────────────────────────────────────────── #}
    <div class="ac-mezzi">
        {% for m in mezzi %}
            {% set occupato = ricercaAttiva and occupati[m.id] is defined %}
            {% set libero   = liberoDal[m.id] is defined and liberoDal[m.id] %}
            <div class="ac-mezzo{{ ricercaAttiva ? (occupato ? ' is-ko' : ' is-ok') : '' }}">
                <div class="ac-mezzo-top">
                    <span class="ac-targa">{{ m.targa }}</span>
                    {% if m.stato != 'attiva' %}
                        <span class="ac-stato ac-stato-{{ m.stato }}">{{ m.stato }}</span>
                    {% endif %}
                </div>
                <div class="ac-mezzo-mod">{{ m.modello ?: '—' }}</div>
                <div class="ac-specs">
                    {% if m.altezza_max_m %}<span>{{ m.altezza_max_m|number_format(2, ',', '.') }} m</span>{% endif %}
                    {% if m.portata_kg %}<span>{{ m.portata_kg }} kg</span>{% endif %}
                </div>
                <div class="ac-libero">
                    {% if ricercaAttiva %}
                        {{ occupato ? 'Occupata nel periodo' : 'Libera nel periodo' }}
                    {% elseif libero %}
                        Libera dal {{ liberoDal[m.id]|date('d/m/Y') }}
                    {% else %}
                        Libera adesso
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="ac-empty">
                Nessuna autocarrata registrata. <a href="/autocarrate/mezzi">Aggiungine una</a>.
            </div>
        {% endfor %}
    </div>

    {# ── Timeline ────────────────────────────────────────────────────────── #}
    {% if mezzi %}
    <div class="ac-box">
        <div class="ac-box-head">
            <span>Impegni</span>
            <div class="ac-vista">
                <button type="button" class="ac-vista-b on" data-ac-vista="calendario">Calendario</button>
                <button type="button" class="ac-vista-b" data-ac-vista="timeline">Timeline</button>
            </div>
            <form method="GET" class="ac-periodo">
                <input type="date" name="dal" value="{{ dal }}">
                <span>→</span>
                <input type="date" name="al" value="{{ al }}">
                <input type="hidden" name="cerca_dal" value="{{ cercaDal }}">
                <input type="hidden" name="cerca_al" value="{{ cercaAl }}">
                <button class="ac-btn">Mostra</button>
            </form>
        </div>

        {# ── Calendario ──────────────────────────────────────────────────── #}
        <div class="ac-cal" id="ac-vista-calendario">
            {% for m in calendario %}
                <div class="ac-cal-mese">
                    <div class="ac-cal-tit">{{ m.titolo }}</div>
                    <div class="ac-cal-wd">
                        {% for d in ['Lun','Mar','Mer','Gio','Ven','Sab','Dom'] %}
                            <span>{{ d }}</span>
                        {% endfor %}
                    </div>
                    <div class="ac-cal-grid">
                        {% for c in m.celle %}
                            {% if c.vuota %}
                                <div class="ac-cal-c is-vuota"></div>
                            {% else %}
                                <div class="ac-cal-c{{ c.festivo ? ' is-fest' : '' }}{{ c.oggi ? ' is-oggi' : '' }}">
                                    <span class="ac-cal-n">{{ c.g }}</span>
                                    {% for e in c.eventi|slice(0, 3) %}
                                        <span class="ac-ev ac-ev-{{ e.stato }}"
                                              title="{{ e.targa }} — {{ e.cliente }}{{ e.luogo ? ' — ' ~ e.luogo : '' }}">
                                            {{ e.targa }}
                                        </span>
                                    {% endfor %}
                                    {% if c.eventi|length > 3 %}
                                        <span class="ac-ev-piu">+{{ c.eventi|length - 3 }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="ac-empty">Nessun mese nel periodo scelto.</div>
            {% endfor %}
        </div>

        {# scorre in orizzontale: il periodo puo' essere piu' largo dello schermo #}
        <div class="ac-tl-wrap" id="ac-vista-timeline" hidden>
            <table class="ac-tl" style="--giorni: {{ giorni|length }}">
                <thead>
                    <tr>
                        <th class="ac-tl-mezzo">Mezzo</th>
                        {% for g in giorni %}
                            <th class="ac-tl-g{{ g.festivo ? ' is-fest' : '' }}">
                                <span class="ac-tl-wd">{{ g.wd }}</span>
                                <span class="ac-tl-n">{{ g.g }}</span>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for m in mezzi %}
                        <tr>
                            <th class="ac-tl-mezzo">{{ m.targa }}</th>
                            {% set righeMezzo = griglia[m.id]|default({}) %}
                            {% for g in giorni %}
                                {% set cella = righeMezzo[g.iso]|default(null) %}
                                <td class="ac-tl-c{{ g.festivo ? ' is-fest' : '' }}{{ cella ? ' is-pieno' : '' }}">
                                    {% if cella %}
                                        <span class="ac-barra ac-barra-{{ cella.stato }}{{ cella.inizio ? ' is-inizio' : '' }}{{ cella.fine ? ' is-fine' : '' }}"
                                              title="{{ cella.testo }}">
                                            {% if cella.inizio %}<span class="ac-barra-txt">{{ cella.cliente }}</span>{% endif %}
                                        </span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="ac-legenda">
            <span><i class="ac-barra ac-barra-confermata"></i> confermata</span>
            <span><i class="ac-cal-oggi-esempio"></i> oggi</span>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/poti/autocarrate.js?v=14"></script>
{% endblock %}
