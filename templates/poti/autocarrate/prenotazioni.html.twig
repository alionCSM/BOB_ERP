{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/poti/autocarrate.css?v=15">
{% endblock %}

{% block content %}
<div class="ac-page">

    <div class="ac-hero">
        <div>
            <h1 class="ac-title">Prenotazioni</h1>
            <p class="ac-sub">Impegni delle autocarrate, per periodo e per mezzo.</p>
        </div>
        <div class="ac-hero-links">
            <button type="button" class="ac-btn ac-btn-primary" data-ac-nuovo>Nuova prenotazione</button>
            <a href="/autocarrate" class="ac-btn">Disponibilita'</a>
            <a href="/autocarrate/giornata" class="ac-btn">Giornata</a>
            <a href="/autocarrate/registro" class="ac-btn">Registro</a>
        </div>
    </div>

    {% if salvato %}<div class="ac-alert is-ok">Modifiche salvate.</div>{% endif %}
    {% if errore %}<div class="ac-alert is-ko">{{ errore }}</div>{% endif %}

    <form method="GET" class="ac-filtri">
        <label class="ac-f">
            <span>Dal</span>
            <input type="date" name="dal" value="{{ dal }}">
        </label>
        <label class="ac-f">
            <span>Al</span>
            <input type="date" name="al" value="{{ al }}">
        </label>
        <label class="ac-f">
            <span>Mezzo</span>
            <select name="mezzo">
                <option value="0">tutti</option>
                {% for m in mezzi %}
                    <option value="{{ m.id }}" {{ mezzoId == m.id ? 'selected' : '' }}>{{ m.targa }}</option>
                {% endfor %}
            </select>
        </label>
        {# la ricerca filtra mentre si scrive: il pulsante serve solo a
           periodo e mezzo, che vanno richiesti al server #}
        <label class="ac-f ac-f-cerca">
            <span>Cerca <small id="ac-conta"></small></span>
            <input type="search" name="q" value="{{ cerca }}"
                   placeholder="cliente, luogo, targa, contratto, note…">
        </label>
        <button class="ac-btn ac-btn-primary">Filtra periodo</button>
        {% if cerca or mezzoId %}
            <a href="/autocarrate/prenotazioni?dal={{ dal }}&al={{ al }}" class="ac-link">azzera</a>
        {% endif %}
    </form>

    <div class="ac-box">
        <div class="ac-table-wrap">
            <table class="ac-table">
                <thead>
                    <tr>
                        <th>Mezzo</th>
                        <th>Cliente</th>
                        <th>Luogo</th>
                        <th>Dal</th>
                        <th>Al</th>
                        <th class="right">Giorni</th>
                        <th>Contratto</th>
                        <th class="right" title="Prezzo di un giorno di noleggio">Tariffa/g</th>
                        <th class="right" title="Giorni per tariffa, correggibile a mano">Totale</th>
                        <th>Commerciale</th>
                        <th>Stato</th>
                        <th>Pagamento</th>
                        <th>Note</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in prenotazioni %}
                        <tr>
                            <td class="ac-td-targa">{{ p.targa }}</td>
                            <td>
                                {{ p.cliente }}
                                {% if p.telefono %}<span class="ac-tel">{{ p.telefono }}</span>{% endif %}
                            </td>
                            <td>{{ p.luogo ?: '—' }}</td>
                            <td>{{ p.data_inizio|date('d/m/Y') }}</td>
                            <td>{{ p.data_fine|date('d/m/Y') }}</td>
                            <td class="right">{{ p.giorni }}</td>
                            <td>{{ p.contratto ?: '—' }}</td>
                            <td class="right">{{ p.tariffa_giorno ? '€ ' ~ p.tariffa_giorno|number_format(2, ',', '.') : '—' }}</td>
                            <td class="right">{{ p.totale ? '€ ' ~ p.totale|number_format(2, ',', '.') : '—' }}</td>
                            <td>{{ p.commerciale_nome ?: '—' }}</td>
                            <td><span class="ac-stato ac-stato-{{ p.stato }}">{{ p.stato }}</span></td>
                            <td>
                                <span class="ac-stato ac-pag-{{ p.pagamento|default('da_pagare') }}">
                                    {{ p.pagamento == 'pagata' ? 'pagata' : 'da pagare' }}
                                </span>
                            </td>
                            {# le note possono essere lunghe: si troncano e si leggono
                               per intero passandoci sopra o aprendo la prenotazione #}
                            <td class="ac-td-note" title="{{ p.note }}">{{ p.note ?: '—' }}</td>
                            <td class="right">
                                <button type="button" class="ac-link"
                                        data-ac-modifica="{{ p|json_encode|e('html_attr') }}">modifica</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="14" class="ac-empty">
                                {{ cerca ? 'Nessuna prenotazione trovata.' : 'Nessuna prenotazione nel periodo.' }}
                            </td>
                        </tr>
                    {% endfor %}

                    {# compare quando la ricerca dal vivo non lascia righe #}
                    <tr id="ac-nessuno" style="display:none">
                        <td colspan="14" class="ac-empty">Nessuna prenotazione corrisponde alla ricerca.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    {# ── Modale prenotazione ─────────────────────────────────────────────── #}
    <div class="ac-modal" id="ac-modal-pren" hidden aria-hidden="true">
        <div class="ac-modal-box">
            <div class="ac-modal-head">
                <span id="ac-modal-tit">Nuova prenotazione</span>
                <button type="button" class="ac-modal-close" data-ac-close>&times;</button>
            </div>
            <form method="POST" action="/autocarrate/prenotazioni/salva" class="ac-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="id" id="ac-p-id" value="">

                {# Prima le date, poi il mezzo: l'elenco delle autocarrate si
                   puo' restringere alle sole libere solo dopo aver saputo
                   per quando serve. #}
                <label class="ac-f">
                    <span>Dal</span>
                    <input type="date" name="data_inizio" id="ac-p-dal" required>
                </label>

                <label class="ac-f">
                    <span>Al</span>
                    <input type="date" name="data_fine" id="ac-p-al" required>
                </label>

                <label class="ac-f ac-f-2">
                    <span>Autocarrata</span>
                    {# il blocco lo mette il JS: se non parte, il campo resta
                       usabile e il controllo lo fa comunque il server #}
                    <select name="autocarrata_id" id="ac-p-mezzo" required>
                        {% for m in mezzi %}<option value="{{ m.id }}">{{ m.targa }} — {{ m.modello ?: 'senza modello' }}</option>{% endfor %}
                    </select>
                    <small class="ac-avviso" id="ac-p-avviso">Scegli prima le date.</small>
                </label>

                <label class="ac-f ac-f-2">
                    <span>Cliente</span>
                    <input type="text" name="cliente" id="ac-p-cliente" required maxlength="160">
                </label>

                <label class="ac-f">
                    <span>Telefono</span>
                    <input type="text" name="telefono" id="ac-p-tel" maxlength="40">
                </label>

                <label class="ac-f">
                    <span>Stato</span>
                    <select name="stato" id="ac-p-stato">
                        {% for s in stati %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
                    </select>
                </label>

                <label class="ac-f ac-f-2">
                    <span>Luogo</span>
                    <input type="text" name="luogo" id="ac-p-luogo" maxlength="200">
                </label>

                <label class="ac-f">
                    <span>Contratto</span>
                    <input type="text" name="contratto" id="ac-p-contratto" maxlength="100"
                           placeholder="rif. contratto">
                </label>

                {# la stessa casella che il tecnico spunta dalla giornata #}
                <label class="ac-f ac-check-riga">
                    <span>Firma</span>
                    <span class="ac-check-box">
                        <input type="checkbox" name="contratto_firmato" id="ac-p-firmato" value="1">
                        <span>Contratto firmato</span>
                    </span>
                </label>

                {# I tre importi si vedono senza il permesso prezzi: chi gestisce
                   le autocarrate deve poterli leggere e scrivere, altrimenti il
                   modulo non serve a niente. #}
                <div class="ac-f ac-f-4 ac-soldi">
                    <div class="ac-soldi-tit">Importi</div>
                    <div class="ac-soldi-campi">
                        <label class="ac-f">
                            <span>Tariffa al giorno</span>
                            <input type="text" name="tariffa_giorno" id="ac-p-tariffa" inputmode="decimal"
                                   placeholder="0,00">
                        </label>

                        <label class="ac-f">
                            <span>Totale</span>
                            <input type="text" name="totale" id="ac-p-totale" inputmode="decimal"
                                   placeholder="0,00">
                            {# resta vuoto finche' non c'e' un calcolo da mostrare #}
                            <small id="ac-p-calcolo"></small>
                        </label>
                    </div>
                </div>

                <label class="ac-f">
                    <span>Pagamento</span>
                    <select name="pagamento" id="ac-p-pagamento">
                        {% for p in pagamenti %}
                            <option value="{{ p }}">{{ p == 'pagata' ? 'pagata' : 'da pagare' }}</option>
                        {% endfor %}
                    </select>
                </label>

                {# il commerciale non si sceglie: e' chi registra la
                   prenotazione, e resta quello anche se poi la corregge
                   qualcun altro #}
                <div class="ac-f">
                    <span>Commerciale</span>
                    <div class="ac-fisso" id="ac-p-commerciale" data-predefinito="{{ utenteNome }}">
                        {{ utenteNome }}
                    </div>
                </div>

                <label class="ac-f ac-f-4">
                    <span>Note</span>
                    <textarea name="note" id="ac-p-note" rows="3"></textarea>
                </label>

                <div class="ac-actions">
                    <button type="button" class="ac-btn ac-btn-ko" id="ac-p-elimina" hidden>Elimina</button>
                    <button type="button" class="ac-btn" data-ac-close>Annulla</button>
                    <button class="ac-btn ac-btn-primary">Salva</button>
                </div>
            </form>

            {# form separato: eliminare da dentro il form di salvataggio
               manderebbe anche gli altri campi #}
            <form method="POST" action="/autocarrate/prenotazioni/elimina" id="ac-form-elimina" hidden>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="id" id="ac-del-id">
            </form>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/poti/autocarrate.js?v=14"></script>
{% endblock %}
