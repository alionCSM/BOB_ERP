{% extends 'layout/base.html.twig' %}

{#
   I miei cantieri: dove entra un cliente (e chi lavora in cantiere) appena
   fatto il login. Una scheda per cantiere con quello che serve a scegliere:
   cosa c'e' da fare, cosa c'e' di nuovo, e il nome che gli ha dato il
   cliente accanto al nostro.
#}
{% block content %}
<style>
.mc { max-width: 1180px; margin: 20px auto 40px; padding: 0 4px; }
.mc-testa { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
.mc-testa h2 { font-size: 22px; font-weight: 700; color: #0f172a; margin: 0; }
.mc-testa p { margin: 4px 0 0; color: #64748b; font-size: 13.5px; }
.mc-cerca { min-width: 240px; flex: 0 1 320px; border: 1px solid #e2e8f0; background: #fff; border-radius: 10px; padding: 9px 12px; font-size: 13.5px; color: #0f172a; outline: none; }
.mc-cerca:focus { border-color: #1e40af; }
.mc-avviso { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 10px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
.mc-griglia { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
.mc-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 12px;
           box-shadow: 0 1px 2px rgba(15,23,42,.04); transition: border-color .15s, box-shadow .15s; text-decoration: none; color: inherit; }
.mc-card:hover { border-color: #93c5fd; box-shadow: 0 6px 18px rgba(30,64,175,.08); }
.mc-codice { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; color: #1e40af; background: #eff6ff; border-radius: 6px; padding: 2px 8px; }
.mc-nome { font-size: 16px; font-weight: 700; color: #0f172a; line-height: 1.3; margin-top: 8px; }
.mc-luogo { font-size: 12.5px; color: #64748b; margin-top: 3px; }
.mc-rif-codice { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; color: #5b21b6; background: #f5f3ff; border-radius: 6px; padding: 2px 8px; }
.mc-nostro { font-size: 12.5px; color: #475569; margin-top: 4px; }
.mc-nostro b { font-weight: 600; color: #334155; }
.mc-senza-rif { font-size: 11.5px; color: #94a3b8; font-style: italic; }
.mc-numeri { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.mc-num { background: #f8fafc; border-radius: 10px; padding: 8px 10px; }
.mc-num b { display: block; font-size: 18px; color: #0f172a; line-height: 1.1; }
.mc-num span { font-size: 11px; color: #64748b; }
.mc-num.acceso b { color: #b45309; }
.mc-num.nuovo b { color: #1d4ed8; }
.mc-piede { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; }
.mc-ultima { font-size: 11.5px; color: #94a3b8; }
.mc-apri { background: #1e40af; color: #fff; border-radius: 9px; padding: 8px 16px; font-size: 13px; font-weight: 700; }
.mc-vuoto { background: #fff; border: 1px dashed #cbd5e1; border-radius: 14px; padding: 40px 24px; text-align: center; color: #475569; }
.mc-vuoto h3 { font-size: 16px; color: #0f172a; margin: 0 0 6px; }
.mc-vuoto p { font-size: 13.5px; margin: 0 auto; max-width: 460px; line-height: 1.5; }
.mc-nessuno { display: none; color: #64748b; font-size: 13.5px; padding: 20px 0; }
</style>

<div class="mc">
    <div class="mc-testa">
        <div>
            <h2>{{ t('menu_cantieri') }}</h2>
            <p>{{ worksites|length }} {{ worksites|length == 1 ? 'cantiere' : 'cantieri' }} · attività, foto, disegni, documenti e chat con CSM</p>
        </div>
        {% if worksites|length > 1 %}
            <input type="search" class="mc-cerca" id="mc-cerca" autocomplete="off"
                   placeholder="{{ cliente ? 'Cerca per nome, codice commessa, codice CSM o località…' : 'Cerca per nome, codice o località…' }}">
        {% endif %}
    </div>

    {% if nonDisponibile %}
        <div class="mc-avviso">{{ t('cantiere_non_disponibile') }}</div>
    {% endif %}

    {% if worksites is empty %}
        <div class="mc-vuoto">
            <h3>Nessun cantiere per ora</h3>
            <p>I cantieri condivisi da CSM compariranno in questa pagina e ne riceverete comunicazione via email.
               Per informazioni scrivere a <a href="mailto:info@csmontaggi.it">info@csmontaggi.it</a>.</p>
        </div>
    {% else %}
        <div class="mc-griglia" id="mc-griglia">
            {% for w in worksites %}
                <a class="mc-card" href="/worksites/{{ w.id }}/zone"
                   data-cerca="{{ (w.name ~ ' ' ~ w.worksite_code ~ ' ' ~ w.location ~ ' ' ~ (w.riferimento.nome ?? '') ~ ' ' ~ (w.riferimento.codice ?? ''))|lower }}">
                    {% set rifNome = w.riferimento.nome ?? '' %}
                    {% set rifCodice = w.riferimento.codice ?? '' %}
                    <div>
                        {% if cliente and (rifNome or rifCodice) %}
                            {# Per il committente prima il suo nome e la sua commessa, poi i nostri #}
                            {% if rifCodice %}<span class="mc-rif-codice" title="Vostro codice commessa">{{ rifCodice }}</span>{% endif %}
                            <div class="mc-nome">{{ rifNome ?: w.name }}</div>
                            <div class="mc-nostro">CSM: <b>{{ w.name }}</b>{% if w.worksite_code %} · {{ w.worksite_code }}{% endif %}</div>
                        {% else %}
                            {% if w.worksite_code %}<span class="mc-codice">{{ w.worksite_code }}</span>{% endif %}
                            <div class="mc-nome">{{ w.name }}</div>
                        {% endif %}
                        {% if w.location %}<div class="mc-luogo">{{ w.location }}</div>{% endif %}
                    </div>
                    {% if cliente and not (rifNome or rifCodice) %}
                        <span class="mc-senza-rif">Vostro nome e codice commessa non impostati: modificabili dalla Zone del cantiere.</span>
                    {% endif %}
                    <div class="mc-numeri">
                        <div class="mc-num {{ w.aperte ? 'acceso' : '' }}"><b>{{ w.aperte }}</b><span>attività aperte</span></div>
                        <div class="mc-num {{ w.segnalazioni ? 'acceso' : '' }}"><b>{{ w.segnalazioni }}</b><span>segnalazioni</span></div>
                        <div class="mc-num {{ w.non_letti ? 'nuovo' : '' }}"><b>{{ w.non_letti }}</b><span>messaggi nuovi</span></div>
                    </div>
                    <div class="mc-piede">
                        <span class="mc-ultima">{{ w.ultima ? 'Ultima novità ' ~ w.ultima|date('d/m/Y') : 'Ancora nessuna novità' }}</span>
                        <span class="mc-apri">Apri</span>
                    </div>
                </a>
            {% endfor %}
        </div>
        <div class="mc-nessuno" id="mc-nessuno">Nessun cantiere corrisponde alla ricerca.</div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script nonce="{{ cspNonce }}">
(function () {
    const q = document.getElementById('mc-cerca');
    if (!q) return;
    q.addEventListener('input', function () {
        const v = q.value.trim().toLowerCase();
        let n = 0;
        document.querySelectorAll('#mc-griglia .mc-card').forEach(function (c) {
            const si = !v || c.dataset.cerca.includes(v);
            c.style.display = si ? '' : 'none';
            if (si) n++;
        });
        document.getElementById('mc-nessuno').style.display = n ? 'none' : 'block';
    });
})();
</script>
{% endblock %}
