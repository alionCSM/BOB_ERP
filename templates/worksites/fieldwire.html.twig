{% extends "layout/base.html.twig" %}
{% set pageTitle = "BOB Zone — " ~ worksite.name %}

{% block head %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
<style>
/* ── Reset inside content ── */
.bz-wrap * { box-sizing: border-box; }

/* ── Outer wrapper ── */
.bz-wrap {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 80px);
    overflow: hidden;
    background: #f8fafc;
}

/* ── Header ── */
.bz-header {
    background: #0f172a;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    flex-shrink: 0;
}
.bz-header-left  { display: flex; align-items: center; gap: 16px; }
.bz-header-right { display: flex; align-items: center; gap: 12px; }

.bz-back {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px; color: #64748b; text-decoration: none;
    transition: color .15s;
}
.bz-back:hover { color: #94a3b8; }

.bz-sep { width: 1px; height: 16px; background: #1e293b; }

.bz-brand { display: flex; align-items: center; gap: 5px; }
.bz-brand-bob  { font-size: 13px; font-weight: 500; color: #64748b; }
.bz-brand-zone { font-size: 15px; font-weight: 600; color: #f1f5f9; letter-spacing: .01em; }

.bz-worksite {
    font-size: 13px; color: #94a3b8;
    max-width: 260px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
}

.bz-sync-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; color: #4ade80;
    background: rgba(74,222,128,.08);
    border: 1px solid rgba(74,222,128,.18);
    border-radius: 999px; padding: 3px 10px;
}
.bz-sync-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #4ade80;
    animation: bz-pulse 2s ease-in-out infinite;
}
@keyframes bz-pulse {
    0%,100% { opacity: 1; }
    50%      { opacity: .4; }
}

.bz-connect-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500; color: #94a3b8;
    background: #1e293b; border: 1px solid #334155;
    border-radius: 6px; padding: 5px 12px; cursor: pointer;
    font-family: inherit; transition: background .15s;
}
.bz-connect-btn:hover { background: #334155; }

/* ── Nav tabs ── */
.bz-nav {
    background: #1e293b;
    display: flex;
    padding: 0 24px;
    flex-shrink: 0;
    border-bottom: 1px solid #0f172a;
}
.bz-nav-tab {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 18px; font-size: 13px; font-weight: 500;
    color: #64748b; border: none; background: none;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    cursor: pointer; font-family: inherit; transition: color .15s;
    white-space: nowrap;
}
.bz-nav-tab i { font-size: 15px; }
.bz-nav-tab:hover { color: #94a3b8; }
.bz-nav-tab.active { color: #f1f5f9; border-bottom-color: #4ade80; }

/* ── Body ── */
.bz-body {
    flex: 1;
    overflow: hidden;
    position: relative;
}
.bz-tab-panel { display: none; height: 100%; }
.bz-tab-panel.active { display: flex; }

/* ── Tasks panel ── */
.bz-tasks-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    height: 100%;
    overflow: hidden;
}
@media(max-width:860px) {
    .bz-tasks-layout { grid-template-columns: 1fr; }
    .bz-detail { display: none; }
}

/* ── Task list ── */
.bz-tasklist {
    background: #fff;
    border-right: 1px solid #e2e8f0;
    display: flex; flex-direction: column;
    overflow: hidden;
}
.bz-tasklist-head {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
}
.bz-tasklist-title { font-size: 13px; font-weight: 600; color: #1e293b; }
.bz-new-btn {
    font-size: 12px; font-weight: 600; color: #0f172a;
    background: #f1f5f9; border: 1px solid #e2e8f0;
    border-radius: 6px; padding: 4px 10px;
    cursor: pointer; font-family: inherit; transition: background .15s;
    display: inline-flex; align-items: center; gap: 4px;
}
.bz-new-btn:hover { background: #e2e8f0; }
.bz-tasklist-body { flex: 1; overflow-y: auto; }
.bz-tasklist-body::-webkit-scrollbar { width: 4px; }
.bz-tasklist-body::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 4px; }

.bz-task-row {
    padding: 11px 16px; border-bottom: 1px solid #f8fafc;
    cursor: pointer; transition: background .1s;
    border-left: 3px solid transparent;
}
.bz-task-row:hover  { background: #f8fafc; }
.bz-task-row.active { background: #f0fdf4; border-left-color: #4ade80; }
.bz-task-name { font-size: 13px; font-weight: 500; color: #1e293b; margin-bottom: 5px; line-height: 1.4; }
.bz-task-foot { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

.bz-pill {
    display: inline-block; font-size: 10px; font-weight: 600;
    padding: 2px 8px; border-radius: 999px; white-space: nowrap;
}
.bz-pill-open     { background: #fef3c7; color: #92400e; }
.bz-pill-progress { background: #dbeafe; color: #1e40af; }
.bz-pill-done     { background: #d1fae5; color: #065f46; }
.bz-pill-verified { background: #ede9fe; color: #4c1d95; }

.bz-task-user { font-size: 11px; color: #94a3b8; display: flex; align-items: center; gap: 3px; }

.bz-tasklist-loading,
.bz-tasklist-empty {
    padding: 40px 20px; text-align: center;
    font-size: 13px; color: #94a3b8;
}

/* ── Task detail ── */
.bz-detail {
    display: flex; flex-direction: column;
    overflow: hidden; background: #fff;
}
.bz-detail-empty {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    color: #cbd5e1; text-align: center; padding: 40px;
}
.bz-detail-empty i { font-size: 40px; margin-bottom: 12px; }
.bz-detail-empty p { font-size: 13px; }

.bz-detail-head {
    padding: 14px 20px;
    border-bottom: 1px solid #f1f5f9;
    flex-shrink: 0;
}
.bz-detail-title { font-size: 15px; font-weight: 600; color: #1e293b; margin: 0 0 6px; }
.bz-detail-attrs { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.bz-detail-attr  { font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 4px; }
.bz-detail-attr i { font-size: 13px; }

.bz-detail-cols {
    flex: 1; display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-top: 1px solid #f1f5f9;
}
@media(max-width:1100px) {
    .bz-detail-cols { grid-template-columns: 1fr; overflow-y: auto; }
    .bz-col-chat { border-top: 1px solid #f1f5f9; border-left: none !important; }
}

.bz-col { display: flex; flex-direction: column; overflow: hidden; }
.bz-col-chat { border-left: 1px solid #f1f5f9; }

.bz-col-head {
    padding: 10px 16px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 11px; font-weight: 600; color: #94a3b8;
    text-transform: uppercase; letter-spacing: .06em;
    flex-shrink: 0;
}

/* ── Checklist ── */
.bz-col-body { flex: 1; overflow-y: auto; padding: 10px 16px; }
.bz-col-body::-webkit-scrollbar { width: 4px; }
.bz-col-body::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 4px; }

.bz-check-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 8px 0; border-bottom: 1px solid #f8fafc;
}
.bz-check-item:last-child { border-bottom: none; }
.bz-check-item input {
    width: 15px; height: 15px; margin-top: 1px;
    accent-color: #0f172a; cursor: pointer; flex-shrink: 0;
}
.bz-check-item label {
    font-size: 13px; color: #374151; cursor: pointer; line-height: 1.4;
}
.bz-check-item label.done { text-decoration: line-through; color: #94a3b8; }

/* ── Chat ── */
.bz-feed {
    flex: 1; overflow-y: auto;
    padding: 12px 16px;
    display: flex; flex-direction: column; gap: 14px;
}
.bz-feed::-webkit-scrollbar { width: 4px; }
.bz-feed::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 4px; }

.bz-bubble { display: flex; gap: 10px; align-items: flex-start; }
.bz-bubble-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: #1e293b; color: #94a3b8;
    font-size: 10px; font-weight: 600;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.bz-bubble-right { flex: 1; min-width: 0; }
.bz-bubble-meta  { display: flex; align-items: baseline; gap: 6px; margin-bottom: 3px; }
.bz-bubble-name  { font-size: 12px; font-weight: 600; color: #374151; }
.bz-bubble-time  { font-size: 10px; color: #94a3b8; }
.bz-bubble-text  { font-size: 13px; color: #475569; line-height: 1.5; word-break: break-word; }
.bz-bubble-img   { margin-top: 6px; max-width: 180px; border-radius: 8px; cursor: zoom-in; }

.bz-chat-bar {
    padding: 10px 14px;
    border-top: 1px solid #f1f5f9;
    display: flex; gap: 8px;
    flex-shrink: 0;
}
.bz-chat-input {
    flex: 1; border: 1px solid #e2e8f0; border-radius: 8px;
    padding: 8px 12px; font-size: 13px; font-family: inherit;
    resize: none; outline: none; transition: border-color .15s;
    color: #1e293b; background: #fff;
}
.bz-chat-input:focus { border-color: #334155; }
.bz-chat-send {
    background: #0f172a; color: #f8fafc;
    border: none; border-radius: 8px;
    padding: 0 16px; font-size: 12px; font-weight: 600;
    cursor: pointer; font-family: inherit; white-space: nowrap;
    transition: background .15s;
}
.bz-chat-send:hover    { background: #1e293b; }
.bz-chat-send:disabled { opacity: .4; cursor: not-allowed; }

/* ── Floorplans tab ── */
.bz-floorplans-wrap {
    padding: 20px 24px;
    overflow-y: auto;
    width: 100%;
}
.bz-floorplans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
}
.bz-fp-card {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 10px; padding: 16px;
    display: flex; flex-direction: column; gap: 8px;
    transition: border-color .15s;
}
.bz-fp-card:hover { border-color: #94a3b8; }
.bz-fp-icon { font-size: 24px; color: #334155; }
.bz-fp-name { font-size: 13px; font-weight: 600; color: #1e293b; }
.bz-fp-meta { font-size: 11px; color: #94a3b8; }
.bz-fp-link {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px; font-weight: 500; color: #334155;
    text-decoration: none; margin-top: 4px;
}
.bz-fp-link:hover { color: #0f172a; }

/* ── Not connected banner ── */
.bz-not-connected {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    height: 100%; text-align: center; padding: 40px;
    color: #94a3b8;
}
.bz-not-connected i { font-size: 48px; margin-bottom: 16px; color: #cbd5e1; }
.bz-not-connected h2 { font-size: 18px; font-weight: 600; color: #1e293b; margin: 0 0 8px; }
.bz-not-connected p  { font-size: 13px; max-width: 360px; margin: 0 0 24px; }
.bz-enable-btn {
    background: #0f172a; color: #f8fafc;
    border: none; border-radius: 8px;
    padding: 10px 28px; font-size: 13px; font-weight: 600;
    cursor: pointer; font-family: inherit; transition: background .15s;
    display: inline-flex; align-items: center; gap: 8px;
}
.bz-enable-btn:hover    { background: #1e293b; }
.bz-enable-btn:disabled { opacity: .5; cursor: not-allowed; }

/* ── Misc ── */
.bz-state {
    padding: 30px; text-align: center;
    font-size: 13px; color: #94a3b8;
}
</style>
{% endblock %}

{% block content %}
<div class="bz-wrap">

    {# ── Header ── #}
    <div class="bz-header">
        <div class="bz-header-left">
            <a href="/worksites/{{ worksite_id }}" class="bz-back">
                <i class="ti ti-chevron-left" aria-hidden="true"></i>
                Cantiere
            </a>
            <div class="bz-sep"></div>
            <div class="bz-brand">
                <span class="bz-brand-bob">BOB</span>
                <span class="bz-brand-zone">Zone</span>
            </div>
            <div class="bz-sep"></div>
            <span class="bz-worksite">{{ worksite.name }}</span>
        </div>
        <div class="bz-header-right">
            {% if fieldwire_project_id %}
                <span class="bz-sync-badge">
                    <span class="bz-sync-dot"></span>
                    Fieldwire sync
                </span>
            {% elseif fieldwire_enabled %}
                <button class="bz-connect-btn" id="btn-fw-connect">
                    <i class="ti ti-link" aria-hidden="true"></i>
                    Collega Fieldwire
                </button>
            {% endif %}
        </div>
    </div>

    {# ── Nav ── #}
    <div class="bz-nav">
        <button class="bz-nav-tab active" data-tab="tasks">
            <i class="ti ti-checkbox" aria-hidden="true"></i>
            Task
        </button>
        <button class="bz-nav-tab" data-tab="floorplans">
            <i class="ti ti-files" aria-hidden="true"></i>
            Tavole
        </button>
    </div>

    {# ── Body ── #}
    <div class="bz-body">

        {# ── Tasks tab ── #}
        <div class="bz-tab-panel active" id="tab-tasks">
            {% if fieldwire_project_id %}
            <div class="bz-tasks-layout">

                {# Task list #}
                <div class="bz-tasklist">
                    <div class="bz-tasklist-head">
                        <span class="bz-tasklist-title">Task</span>
                        <button class="bz-new-btn" id="btn-new-task">
                            <i class="ti ti-plus" style="font-size:12px" aria-hidden="true"></i>
                            Nuovo
                        </button>
                    </div>
                    <div class="bz-tasklist-body" id="bz-task-list">
                        <div class="bz-tasklist-loading">
                            <i class="ti ti-loader-2" style="font-size:20px;animation:spin 1s linear infinite;" aria-hidden="true"></i>
                            <br>Caricamento task...
                        </div>
                    </div>
                </div>

                {# Detail panel #}
                <div class="bz-detail" id="bz-detail">
                    <div class="bz-detail-empty">
                        <i class="ti ti-checkbox" aria-hidden="true"></i>
                        <p>Seleziona un task per vedere dettagli e messaggi</p>
                    </div>
                </div>

            </div>
            {% else %}
            <div class="bz-not-connected">
                <i class="ti ti-link-off" aria-hidden="true"></i>
                <h2>Fieldwire non collegato</h2>
                <p>Collega questo cantiere a Fieldwire per vedere e gestire i task, oppure crea task BOB-only.</p>
                {% if fieldwire_enabled %}
                <button class="bz-enable-btn" id="btn-fw-enable">
                    <i class="ti ti-link" aria-hidden="true"></i>
                    Collega a Fieldwire
                </button>
                {% endif %}
            </div>
            {% endif %}
        </div>

        {# ── Floorplans tab ── #}
        <div class="bz-tab-panel" id="tab-floorplans">
            {% if fieldwire_project_id %}
            <div class="bz-floorplans-wrap">
                <div id="bz-floorplans-content">
                    <div class="bz-state">
                        <i class="ti ti-loader-2" style="font-size:20px;animation:spin 1s linear infinite;" aria-hidden="true"></i>
                        <br>Caricamento tavole...
                    </div>
                </div>
            </div>
            {% else %}
            <div class="bz-not-connected">
                <i class="ti ti-file-off" aria-hidden="true"></i>
                <h2>Nessuna tavola</h2>
                <p>Collega Fieldwire per accedere alle tavole del cantiere.</p>
            </div>
            {% endif %}
        </div>

    </div>
</div>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
const WID = {{ worksite_id }};
const FWP = {{ fieldwire_project_id ? '"' ~ fieldwire_project_id ~ '"' : 'null' }};

/* ── Utils ── */
const $ = id => document.getElementById(id);

function initials(name) {
    if (!name) return '?';
    return name.split(' ').filter(Boolean).map(w => w[0]).join('').toUpperCase().slice(0, 2);
}

function relativeTime(str) {
    if (!str) return '';
    const s = Math.floor((Date.now() - new Date(str)) / 1000);
    if (s < 60)    return 'ora';
    if (s < 3600)  return Math.floor(s / 60) + 'm fa';
    if (s < 86400) return Math.floor(s / 3600) + 'h fa';
    return new Date(str).toLocaleDateString('it-IT', { day:'2-digit', month:'2-digit' });
}

function statusPill(s) {
    if (!s) return `<span class="bz-pill bz-pill-open">Aperto</span>`;
    const map = {
        open:      ['bz-pill-open',     'Aperto'],
        in_progress:['bz-pill-progress','In corso'],
        complete:  ['bz-pill-done',     'Completato'],
        completed: ['bz-pill-done',     'Completato'],
        verified:  ['bz-pill-verified', 'Verificato'],
    };
    const [cls, label] = map[s.toLowerCase()] || ['bz-pill-open', s];
    return `<span class="bz-pill ${cls}">${label}</span>`;
}

async function api(url, opts = {}) {
    const r = await fetch(url, opts);
    return r.json();
}

/* ── Tab switching ── */
document.querySelectorAll('.bz-nav-tab').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.bz-nav-tab').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.bz-tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const panel = $('tab-' + btn.dataset.tab);
        if (panel) panel.classList.add('active');
        if (btn.dataset.tab === 'floorplans') loadFloorplans();
    });
});

/* ══════════════════════════════════════════════
   TASKS
══════════════════════════════════════════════ */
let activeTaskId = null;

async function loadTasks() {
    const list = $('bz-task-list');
    if (!list) return;
    const res = await api(`/worksites/${WID}/zone/tasks`);
    if (!res.ok || !res.data?.length) {
        list.innerHTML = '<div class="bz-tasklist-empty">Nessun task trovato.</div>';
        return;
    }
    list.innerHTML = res.data.map(t => `
        <div class="bz-task-row" data-id="${t.id}" onclick="openTask(${JSON.stringify(t).replace(/"/g,'&quot;')})">
            <div class="bz-task-name">${t.name || 'Task senza titolo'}</div>
            <div class="bz-task-foot">
                ${statusPill(t.status)}
                ${t.assignee_name ? `<span class="bz-task-user"><i class="ti ti-user" style="font-size:11px"></i>${t.assignee_name}</span>` : ''}
            </div>
        </div>
    `).join('');
}

function openTask(task) {
    activeTaskId = task.id;
    document.querySelectorAll('.bz-task-row').forEach(el => {
        el.classList.toggle('active', el.dataset.id == task.id);
    });

    const detail = $('bz-detail');
    detail.innerHTML = `
        <div class="bz-detail-head">
            <div class="bz-detail-title">${task.name || 'Task'}</div>
            <div class="bz-detail-attrs">
                ${statusPill(task.status)}
                ${task.assignee_name ? `<span class="bz-detail-attr"><i class="ti ti-user"></i>${task.assignee_name}</span>` : ''}
                ${task.category_name ? `<span class="bz-detail-attr"><i class="ti ti-tag"></i>${task.category_name}</span>` : ''}
                ${task.due_date ? `<span class="bz-detail-attr"><i class="ti ti-calendar"></i>${new Date(task.due_date).toLocaleDateString('it-IT')}</span>` : ''}
            </div>
        </div>
        <div class="bz-detail-cols">
            <div class="bz-col">
                <div class="bz-col-head">Checklist</div>
                <div class="bz-col-body" id="bz-checklist-${task.id}">
                    <div class="bz-state">Caricamento...</div>
                </div>
            </div>
            <div class="bz-col bz-col-chat">
                <div class="bz-col-head">Messaggi</div>
                <div class="bz-feed" id="bz-feed-${task.id}">
                    <div class="bz-state">Caricamento...</div>
                </div>
                <div class="bz-chat-bar">
                    <textarea class="bz-chat-input" id="bz-msg-${task.id}"
                              placeholder="Scrivi un messaggio..." rows="2"
                              onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMsg('${task.id}')}"></textarea>
                    <button class="bz-chat-send" id="bz-send-${task.id}" onclick="sendMsg('${task.id}')">
                        <i class="ti ti-send" style="font-size:14px"></i>
                    </button>
                </div>
            </div>
        </div>
    `;

    loadChecklist(task.id);
    loadBubbles(task.id);
}

/* ── Checklist ── */
async function loadChecklist(taskId) {
    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/check-items`);
    const el  = $(`bz-checklist-${taskId}`);
    if (!el) return;

    if (!res.ok || !res.data?.length) {
        el.innerHTML = '<div class="bz-state">Nessun elemento.</div>';
        return;
    }

    el.innerHTML = res.data.map(c => `
        <div class="bz-check-item" id="chkrow-${c.id}">
            <input type="checkbox" id="chk-${c.id}" ${c.completed ? 'checked' : ''}
                   onchange="toggleCheck('${taskId}','${c.id}',this)">
            <label for="chk-${c.id}" class="${c.completed ? 'done' : ''}">${c.name}</label>
        </div>
    `).join('');
}

async function toggleCheck(taskId, checkId, cb) {
    cb.disabled = true;
    const label = cb.nextElementSibling;
    if (cb.checked) {
        await api(`/worksites/${WID}/zone/tasks/${taskId}/check-items/${checkId}/complete`, { method: 'POST' });
        if (label) label.classList.add('done');
    } else {
        if (label) label.classList.remove('done');
    }
    cb.disabled = false;
}

/* ── Bubbles ── */
async function loadBubbles(taskId) {
    const res  = await api(`/worksites/${WID}/zone/tasks/${taskId}/bubbles`);
    const feed = $(`bz-feed-${taskId}`);
    if (!feed) return;

    if (!res.ok || !res.data?.length) {
        feed.innerHTML = '<div class="bz-state" style="padding:20px 0;">Nessun messaggio ancora.</div>';
        return;
    }

    feed.innerHTML = res.data.map(b => {
        const name  = b.creator_name || b.creator_email || '?';
        const photo = b.file_url
            ? `<img src="${b.file_url}" class="bz-bubble-img" onclick="window.open('${b.file_url}','_blank')" alt="foto">`
            : '';
        return `
            <div class="bz-bubble">
                <div class="bz-bubble-avatar">${initials(name)}</div>
                <div class="bz-bubble-right">
                    <div class="bz-bubble-meta">
                        <span class="bz-bubble-name">${name}</span>
                        <span class="bz-bubble-time">${relativeTime(b.created_at)}</span>
                    </div>
                    ${b.text ? `<div class="bz-bubble-text">${b.text}</div>` : ''}
                    ${photo}
                </div>
            </div>`;
    }).join('');

    feed.scrollTop = feed.scrollHeight;
}

async function sendMsg(taskId) {
    const inp  = $(`bz-msg-${taskId}`);
    const btn  = $(`bz-send-${taskId}`);
    const text = inp?.value?.trim();
    if (!text) return;

    btn.disabled = true;
    inp.disabled = true;

    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/bubbles`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ text }),
    });

    if (res.ok) {
        inp.value = '';
        await loadBubbles(taskId);
    } else {
        alert('Errore: ' + (res.error || 'impossibile inviare il messaggio'));
    }

    btn.disabled = false;
    inp.disabled = false;
    inp.focus();
}

/* ══════════════════════════════════════════════
   FLOORPLANS
══════════════════════════════════════════════ */
let fpLoaded = false;
async function loadFloorplans() {
    if (fpLoaded) return;
    fpLoaded = true;
    const res = await api(`/worksites/${WID}/zone/floorplans`);
    const el  = $('bz-floorplans-content');
    if (!el) return;

    if (!res.ok || !res.data?.length) {
        el.innerHTML = '<div class="bz-state">Nessuna tavola in questo progetto.</div>';
        return;
    }

    el.innerHTML = `<div class="bz-floorplans-grid">${res.data.map(f => `
        <div class="bz-fp-card">
            <i class="ti ti-file bz-fp-icon" aria-hidden="true"></i>
            <div class="bz-fp-name">${f.name || 'Tavola'}</div>
            ${f.sheets_count ? `<div class="bz-fp-meta">${f.sheets_count} fogli</div>` : ''}
            <a href="https://app.fieldwire.com" target="_blank" class="bz-fp-link">
                <i class="ti ti-external-link" style="font-size:12px" aria-hidden="true"></i>
                Apri in Fieldwire
            </a>
        </div>`).join('')}
    </div>`;
}

/* ══════════════════════════════════════════════
   CONNECT TO FIELDWIRE
══════════════════════════════════════════════ */
['btn-fw-connect', 'btn-fw-enable'].forEach(id => {
    const btn = $(id);
    if (!btn) return;
    btn.addEventListener('click', async () => {
        if (!confirm('Creare il progetto Fieldwire per questo cantiere?')) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2" style="animation:spin 1s linear infinite;font-size:14px"></i> Collegamento...';
        const res = await api(`/worksites/${WID}/zone/enable`, { method: 'POST' });
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Errore: ' + (res.error || 'sconosciuto'));
            btn.disabled = false;
        }
    });
});

/* ══════════════════════════════════════════════
   INIT
══════════════════════════════════════════════ */
if (FWP) loadTasks();
</script>
{% endblock %}
