async function submitTask() {
    const name = document.getElementById('task-name').value.trim();
    if (!name) { document.getElementById('task-name').focus(); return; }

    const aSel = document.getElementById('task-assignee');
    const body = {
        name,
        description:      document.getElementById('task-desc').value,
        luogo:           document.getElementById('task-luogo').value,
        category:        document.getElementById('task-cat').value,
        priority:        parseInt(document.getElementById('task-priority').value) || 0,
        // anche un passaggio scritto e non ancora confermato con Invio
        checklist:       [...passiNuovi, document.getElementById('task-passo').value.trim()].filter(Boolean),
        punto:           puntoNuovo ? { document_id: puntoNuovo.document_id, page: puntoNuovo.page, x: puntoNuovo.x, y: puntoNuovo.y } : null,
        ...assegnazioneDaSelect(aSel),
        ...personeDalBottone('task-chi'),
        due_date:        document.getElementById('task-due').value || null,
        start_date:      document.getElementById('task-start').value || null,
    };
    // "solo ufficio" e "alla squadra" insieme non stanno: a chi tocca la
    // vede. Se l'ufficio la tiene per se' e non ha scelto nessuno, e' sua.
    if (Array.isArray(body.parti) && !body.parti.length && !(body.persone || []).length
        && body.assegnata_a === 'squadra' && !aSel.value) {
        body.assegnata_a = 'ufficio';
    }

    const btn = document.querySelector('.bz-modal-submit');
    btn.textContent = '...'; btn.disabled = true;

    const res = await api(`/worksites/${WID}/zone/tasks`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
    });

    if (res.ok) {
        // le foto, una per una, sull'attivita' appena creata
        let saltate = 0;
        for (const f of fotoNuove) {
            btn.textContent = 'Foto…';
            const fd = new FormData();
            fd.append('photo', f);
            fd.append('text', '');
            const r = await api(`/worksites/${WID}/zone/tasks/${res.data.id}/photo`, { method: 'POST', body: fd });
            if (!r.ok) saltate++;
        }
        btn.textContent = 'Crea attività'; btn.disabled = false;
        if (saltate) alert(saltate + (saltate === 1 ? ' foto non caricata' : ' foto non caricate') + ': riprova dall\'attività.');
        mediaLoaded = false;
        allTasks.unshift(res.data);
        closeModal();
        renderCurrentView();
        openTask(res.data.id);
        return;
    } else {
        btn.textContent = 'Crea attività'; btn.disabled = false;
        alert('Errore: ' + (res.error || 'Attività non creata'));
    }
}

/* ══════════ NOTIFICHE DEL CANTIERE ══════════
   Gli avvisi di BOB (gli stessi del campanello in alto e dell'app) che
   riguardano questo cantiere: il campanello nell'intestazione e i numeri
   sul menu. Aprire una sezione segna come viste le sue; cliccare un avviso
   porta proprio a quella cosa. Si aggiorna da solo ogni 30 secondi.      */
let avvisiStato = { avvisi: [], non_lette: 0, per_sezione: {} };

function quandoAvviso(s) {
    const d = new Date(String(s).replace(' ', 'T'));
    if (isNaN(d)) return '';
    const min = Math.round((Date.now() - d) / 60000);
    if (min < 1)  return 'adesso';
    if (min < 60) return min + ' min fa';
    if (min < 60 * 24 && d.toDateString() === new Date().toDateString())
        return 'oggi alle ' + d.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
    return d.toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit' }) + ' alle ' + d.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
}

const ICONA_AVVISO = { attivita: 'fa-list-check', disegni: 'fa-drafting-compass', files: 'fa-folder-open', forms: 'fa-clipboard-list',
                       segnalazioni: 'fa-triangle-exclamation', chat: 'fa-comments' };

async function caricaAvvisi() {
    if (!document.getElementById('bz-avvisi-btn')) return;
    const r = await api(`/worksites/${WID}/zone/avvisi`);
    if (!r.ok) return;
    avvisiStato = r.data;
    const n = document.getElementById('bz-avvisi-n');
    n.hidden = !avvisiStato.non_lette;
    n.textContent = avvisiStato.non_lette > 99 ? '99+' : avvisiStato.non_lette;
    ['attivita', 'disegni', 'files', 'forms'].forEach(k => {
        const b = document.getElementById('bz-badge-' + k);
        if (!b) return;
        const x = avvisiStato.per_sezione[k] || 0;
        b.hidden = !x;
        b.textContent = x;
    });
    const lista = document.getElementById('bz-avvisi-lista');
    lista.innerHTML = avvisiStato.avvisi.length
        ? avvisiStato.avvisi.map(a => `
            <button type="button" class="bz-avviso ${a.letta ? '' : 'nuovo'}" data-avviso="${a.id}" data-dove="${escAttr(a.dove)}">
                <i class="fas ${ICONA_AVVISO[a.sezione] || 'fa-bell'}"></i>
                <span class="c">
                    <span class="t">${escHtml(a.titolo)}</span>
                    <span class="m">${escHtml(a.testo)}</span>
                    <span class="q">${escHtml(quandoAvviso(a.quando))}</span>
                </span>
            </button>`).join('')
        : '<div class="bz-avvisi-vuoto">Nessuna notifica per questo cantiere.</div>';
}

async function segnaAvvisi(corpo) {
    await api(`/worksites/${WID}/zone/avvisi/letti`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo),
    });
    caricaAvvisi();
}

function avvisiSezioneVista(v) {
    if ((avvisiStato.per_sezione || {})[v] > 0) segnaAvvisi({ sezione: v });
}

/* Porta alla cosa di cui parla l'avviso: #attivita-12, #disegno-3,
   #moduli, #segnalazione-5, #chat-squadra */
async function vaiAdAvviso(dove) {
    if (dove.startsWith('attivita-')) {
        switchTop('attivita');
        const id = parseInt(dove.slice(9));
        if (!allTasks.some(t => Number(t.id) === id)) await loadTasks();
        if (allTasks.some(t => Number(t.id) === id)) openTask(id);
    } else if (dove.startsWith('disegno')) {
        switchTop('disegni');
    } else if (dove.startsWith('file-')) {
        switchTop('files');
    } else if (dove === 'moduli') {
        switchTop('forms');
    } else if ((dove.startsWith('segnalazione-') || dove.startsWith('chat-')) && window.bzdApri) {
        window.bzdApri(dove);
    }
}

