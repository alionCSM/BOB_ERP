// Event delegation for dynamically generated elements
document.addEventListener('click', e => {
    const t = e.target;

    // X buttons FIRST (otherwise the card/task-id wrapper catches the click)
    const delCheck = t.closest('[data-delete-check]');
    if (delCheck) {
        e.stopPropagation();
        const [tid, iid] = delCheck.dataset.deleteCheck.split(':').map(Number);
        deleteCheck(tid, iid); return;
    }
    const delComment = t.closest('[data-delete-comment]');
    if (delComment) {
        e.stopPropagation();
        const [tid, cid] = delComment.dataset.deleteComment.split(':').map(Number);
        deleteComment(tid, cid); return;
    }
    const editTask = t.closest('[data-edit-task]');
    if (editTask) { e.stopPropagation(); openEditModal(parseInt(editTask.dataset.editTask)); return; }
    const delTask = t.closest('[data-delete-task]');
    if (delTask)  { e.stopPropagation(); deleteTask(parseInt(delTask.dataset.deleteTask)); return; }

    // I bottoni dello stato prima di "apri l'attivita'": hanno anche loro
    // data-task-id, e controllati dopo ogni clic riapriva l'attivita'
    // invece di cambiarne lo stato.
    const stEl = t.closest('[data-set-status]');
    if (stEl) { setStatus(parseInt(stEl.dataset.taskId), stEl.dataset.setStatus); return; }

    // Open task from card / gantt / calendar
    const taskEl = t.closest('[data-task-id]');
    if (taskEl) { openTask(parseInt(taskEl.dataset.taskId)); return; }

    // Quick add from kanban column
    const qaEl = t.closest('[data-quick-add]');
    if (qaEl) { quickAdd(qaEl.dataset.quickAdd); return; }

    // Add checklist item button
    const acEl = t.closest('[data-add-check]');
    if (acEl) { addCheck(parseInt(acEl.dataset.addCheck)); return; }

    // Disegni: push to Fieldwire / delete
    const pushFw = t.closest('[data-push-fw]');
    if (pushFw) { pushDisegnoFw(parseInt(pushFw.dataset.pushFw), pushFw); return; }
    const delDz = t.closest('[data-del-disegno]');
    if (delDz) { deleteDisegno(parseInt(delDz.dataset.delDisegno)); return; }
    const annBtn = t.closest('[data-annot]');
    if (annBtn && window.BZAnnotator) {
        window.BZAnnotator.open({
            worksiteId: WID,
            csrf: CSRF,
            docId: parseInt(annBtn.dataset.annot),
            fileType: annBtn.dataset.annotType,
            fileName: annBtn.dataset.annotName,
            viewUrl: `/worksites/${WID}/disegni/${annBtn.dataset.annot}/view`,
            // alla chiusura le attivita' si ricaricano: un punto collegato
            // a un'attivita' compare subito nel Kanban e nel dettaglio
            onClose: async () => {
                await loadTasks();
                if (activeTaskId) openTask(activeTaskId);
            },
        });
        return;
    }
    const dwgConv = t.closest('[data-dwg-convert]');
    if (dwgConv) { convertDwg(parseInt(dwgConv.dataset.dwgConvert), dwgConv); return; }
});

async function convertDwg(docId, btn) {
