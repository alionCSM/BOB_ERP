[data-theme="light"] .bz-rapporto a:hover { color:#0f172a; }
[data-theme="light"] .bz-info-counts { border-top-color:#e2e8f0; }
[data-theme="light"] .c-aperto, [data-theme="light"] .bz-pres-tab .tu.mezza { color:#b45309; }
[data-theme="light"] .c-corso  { color:#1d4ed8; }
[data-theme="light"] .c-fatto  { color:#15803d; }
[data-theme="light"] .bz-vis-badge.solo { color:#dc2626; }
[data-theme="light"] #bz-filter-clear { background:#f1f5f9; color:#475569; border:1px solid #e2e8f0; }
[data-theme="light"] .bz-col-add-btn { border-color:#cbd5e1; color:#64748b; }
[data-theme="light"] .bz-col-add-btn:hover { border-color:#94a3b8; color:#334155; }
[data-theme="light"] .bz-disegni-title { color:#1e293b; }
[data-theme="light"] .bz-folder-new { border-color:#cbd5e1; color:#475569; }
[data-theme="light"] .bz-folder-item span, [data-theme="light"] .bz-folders span { color:#334155; }
[data-theme="light"] .bz-file-act { background:#f8fafc; border-color:#e2e8f0; color:#475569; }
[data-theme="light"] .bz-file-act:hover { color:#0f172a; }
[data-theme="light"] .bz-file-act.danger:hover { color:#b91c1c; border-color:#fecaca; }
[data-theme="light"] .bz-assegna { border-color:#e2e8f0; background:#fff; }
[data-theme="light"] .bz-assegna h4 { color:#0f172a; }
[data-theme="light"] .bz-assegna-row { color:#334155; border-top-color:#e2e8f0; }
[data-theme="light"] .bz-assegna-row .sub { color:#64748b; }
[data-theme="light"] .bz-assegna-row button { color:#b91c1c; border-color:#fecaca; }
[data-theme="light"] .bz-assegna-form select, [data-theme="light"] .bz-assegna-form input { background:#f8fafc; color:#1e293b; border-color:#e2e8f0; }
[data-theme="light"] .bzf-tab { color:#475569; }
[data-theme="light"] .bzf-btn-ghost { background:#f8fafc; border-color:#e2e8f0; color:#475569; }
[data-theme="light"] .bzf-btn-ghost:hover { color:#0f172a; }
[data-theme="light"] .bzf-tag { background:#f1f5f9; color:#475569; }
[data-theme="light"] .bzf-tag.universal { background:#dbeafe; color:#1d4ed8; }
[data-theme="light"] .bzd-filtro { background:#f1f5f9; }
[data-theme="light"] .bzd-filtro button { color:#475569; }
[data-theme="light"] .bzd-filtro button.on { background:#fff; color:#0f172a; }
[data-theme="light"] .bzd-pill.aperta  { background:#fef3c7; color:#b45309; }
[data-theme="light"] .bzd-pill.presa   { background:#dbeafe; color:#1d4ed8; }
[data-theme="light"] .bzd-pill.risolta { background:#dcfce7; color:#15803d; }
[data-theme="light"] .bzd-pill.blocca  { background:#fee2e2; color:#b91c1c; }
[data-theme="light"] .bzd-pill.alta    { background:#ffedd5; color:#c2410c; }
[data-theme="light"] .bzd-pill.tipo    { background:#f1f5f9; color:#334155; }
[data-theme="light"] .bzd-fissa { color:#b45309; }
/* Il bottone "Chi la vede" sta in due posti con due fondi: negli elenchi
   della pagina, che sono scuri, e dentro i moduli, che sono bianchi. Si
   parte dallo scuro e dentro .bz-modal si schiarisce — se no nel modulo
   bianco veniva un rettangolo nero. */
.bz-chi-btn { background:#0f172a; color:#cbd5e1; border:1px solid #334155; border-radius:7px;
              padding:4px 9px; font-size:11.5px; font-family:inherit; cursor:pointer;
              display:inline-flex; align-items:center; gap:5px; }
.bz-chi-btn:hover { border-color:#2563eb; color:#e2e8f0; }
[data-theme="light"] .bz-chi-btn { background:#f8fafc; color:#1e293b; border-color:#e2e8f0; }
.bz-modal .bz-chi-btn { background:#f8fafc; color:#1e293b; border-color:#e2e8f0; padding:8px 12px; font-size:13px; }
.bz-modal .bz-chi-btn:hover { border-color:#94a3b8; background:#fff; }

/* Il pannello e' un .bz-modal, quindi bianco come gli altri. */
.bz-chi-nota { margin:-12px 0 16px; font-size:11.5px; color:#64748b; }
.bz-chi-vuoto { font-size:12.5px; color:#64748b; padding:16px 0; }
#bz-chi-corpo { max-height:46vh; overflow-y:auto; margin-bottom:20px; }
.bz-chi-gruppo + .bz-chi-gruppo { margin-top:16px; }
.bz-chi-titolo { display:flex; align-items:center; justify-content:space-between;
                 font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
                 color:#94a3b8; padding-bottom:6px; border-bottom:1px solid #e2e8f0; margin-bottom:4px; }
/* ── Chi accede ── */
.acc-intro { font-size:12.5px; color:#475569; line-height:1.5; margin:-10px 0 16px; }
.acc-barra { border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; margin-bottom:14px; background:#faf5ff; }
.acc-barra-riga { display:flex; gap:10px; align-items:flex-start; cursor:pointer; }
.acc-barra-riga input { width:18px; height:18px; margin-top:1px; accent-color:#7c3aed; flex:none; }
.acc-barra-riga strong { font-size:13px; color:#1e293b; display:block; }
.acc-barra-chi { display:block; font-size:12px; color:#475569; margin-top:2px; line-height:1.45; }
.acc-aggiungi-riga { display:flex; gap:8px; align-items:flex-start; }
.acc-aggiungi-riga .ts-wrapper { flex:1; min-width:0; }
.acc-aggiungi-riga .ts-control { border-radius:8px; border-color:#e2e8f0; background:#f8fafc; min-height:40px; font-size:13px; color:#1e293b; }
.acc-aggiungi-riga .ts-dropdown { font-size:13px; color:#1e293b; }
.acc-opz { display:flex; flex-direction:column; }
.acc-opz small { color:#64748b; font-size:11.5px; }
.acc-aggiungi { background:#1e40af; color:#fff; border:0; border-radius:8px; padding:0 16px; height:40px; font-size:13px; font-weight:700; cursor:pointer; }
.acc-aggiungi:disabled { background:#e2e8f0; color:#64748b; cursor:default; }
.acc-riga { display:flex; align-items:center; gap:12px; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; margin-bottom:8px; transition:border-color .2s; }
.acc-riga.acc-ok { border-color:#4ade80; } .acc-riga.acc-ko { border-color:#f87171; }
.acc-chi { flex:1; min-width:0; }
.acc-chi strong { font-size:13px; color:#1e293b; }
.acc-azienda { font-size:11.5px; color:#64748b; margin-left:8px; }
.acc-spiega { font-size:11.5px; color:#64748b; margin-top:2px; }
.acc-tag { font-size:12px; font-weight:700; color:#7c3aed; background:#f5f3ff; border-radius:7px; padding:5px 10px; }
.acc-ruolo { background:#f8fafc; border:1px solid #e2e8f0; border-radius:7px; padding:6px 8px; font-size:12px; color:#1e293b; }
.acc-togli { background:none; border:1px solid #fecaca; color:#b91c1c; border-radius:7px; padding:5px 10px; font-size:11.5px; font-weight:700; cursor:pointer; }
.acc-vuoto { font-size:12.5px; color:#64748b; padding:18px 0; text-align:center; }
@media (max-width:560px) { .acc-riga { flex-wrap:wrap; } .acc-chi { flex-basis:100%; } }

.bz-rif { background:#1e293b; border:1px dashed #475569; color:#cbd5e1; border-radius:999px; padding:4px 11px; font-size:12px; cursor:pointer; font-family:inherit; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:40vw; }
.bz-rif:hover { border-color:#94a3b8; }
[data-theme="light"] .bz-rif { background:#f5f3ff; border-color:#c4b5fd; color:#5b21b6; }

.bz-rapporto summary { list-style:none; cursor:pointer; }
.bz-rapporto summary::-webkit-details-marker { display:none; }
.bz-rapporto-spiega { font-size:11px; line-height:1.45; color:#94a3b8; padding:2px 12px 6px 40px; margin:0; }
[data-theme="light"] .bz-rapporto-spiega { color:#64748b; }
.bz-rapporto a { display:block; padding:6px 12px 6px 40px; font-size:12px; color:#94a3b8; text-decoration:none; }
.bz-rapporto a:hover { color:#e2e8f0; }
.bz-chi-tutti { background:none; border:0; color:#2563eb; font-size:11px; font-weight:700;
                font-family:inherit; cursor:pointer; text-transform:none; letter-spacing:0; padding:2px 4px; }
.bz-chi-tutti:hover { text-decoration:underline; }
.bz-chi-riga { display:flex; align-items:center; gap:10px; padding:7px 6px; font-size:13px;
               color:#1e293b; cursor:pointer; border-radius:7px; }
.bz-chi-riga:hover { background:#f8fafc; }
.bz-chi-riga input { width:16px; height:16px; flex:0 0 auto; accent-color:#2563eb; margin:0; }
.bz-chi-riga em { margin-left:auto; font-style:normal; font-size:11.5px; color:#94a3b8; }
.bz-comment-flags { display:flex; gap:14px; padding:6px 14px 10px; font-size:11.5px; color:#94a3b8; }
.bz-comment-flags label { display:flex; align-items:center; gap:5px; cursor:pointer; }
.bz-folder-vis { display:flex; align-items:center; gap:6px; font-size:11.5px; color:#94a3b8; margin-left:12px; }
.bz-assegna { border:1px solid #1e293b; border-radius:12px; padding:14px 16px; margin-bottom:16px; }
.bz-assegna h4 { margin:0 0 10px; font-size:13px; color:#e2e8f0; }
.bz-assegna-row { display:flex; align-items:center; gap:10px; padding:8px 0; border-top:1px solid #1e293b; font-size:12.5px; color:#cbd5e1; }
.bz-assegna-row:first-of-type { border-top:0; }
.bz-assegna-row .sub { color:#64748b; font-size:11.5px; }
.bz-assegna .fatti { color:#22c55e; } .bz-assegna .mancano { color:#f87171; }
[data-theme="light"] .bz-assegna .fatti { color:#15803d; } [data-theme="light"] .bz-assegna .mancano { color:#b91c1c; }
.bz-assegna-form { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
.bz-assegna-form .ts-wrapper { flex:1 1 260px; min-width:220px; }
.bz-assegna-form .ts-control { background:#0f172a; border-color:#334155; color:#cbd5e1; border-radius:7px; min-height:32px; font-size:12px; }
.bz-assegna-form .ts-control input { color:#cbd5e1; }
.bz-assegna-form .ts-control .item { background:#1e293b; color:#e2e8f0; border-radius:5px; }
.bz-assegna-form .ts-dropdown { font-size:12.5px; }
[data-theme="light"] .bz-assegna-form .ts-control { background:#f8fafc; border-color:#e2e8f0; color:#1e293b; }
[data-theme="light"] .bz-assegna-form .ts-control input { color:#1e293b; }
[data-theme="light"] .bz-assegna-form .ts-control .item { background:#e0e7ff; color:#1e3a8a; }
.bz-assegna-form select, .bz-assegna-form input { background:#0f172a; color:#cbd5e1; border:1px solid #334155; border-radius:7px; padding:6px 8px; font-size:12px; }
.bz-assegna-form button, .bz-assegna-row button { background:#2563eb; color:#fff; border:0; border-radius:7px; padding:6px 12px; font-size:12px; font-weight:700; cursor:pointer; }
.bz-assegna-row button { background:none; color:#f87171; border:1px solid #7f1d1d; padding:3px 9px; margin-left:auto; }
/* Drag & drop highlight per le colonne Kanban (style inline per non dover
   toccare il CSS principale; safe perche' usato solo in BOB Zone). */
.bz-cards.dnd-over { background: rgba(96, 165, 250, 0.10); outline: 2px dashed rgba(96, 165, 250, 0.45); outline-offset: -4px; border-radius: 8px; }
.bz-card[draggable="true"] { cursor: grab; }
.bz-card[draggable="true"]:active { cursor: grabbing; }

/* ── Disegni view ── */
.bz-disegni { flex: 1; overflow-y: auto; padding: 20px 24px; }
.bz-disegni-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
.bz-disegni-title { font-size: 14px; font-weight: 600; color: #cbd5e1; display: flex; align-items: center; gap: 8px; }
.bz-disegni-title i { color: #64748b; }
.bz-upload-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; background: #4ade80; color: #0f172a; border-radius: 7px; font-size: 12px; font-weight: 700; cursor: pointer; transition: opacity .15s; }
.bz-upload-btn:hover { opacity: .88; }
.bz-disegni-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
.bz-dz-card { background: #1e293b; border: 1px solid #273548; border-radius: 10px; padding: 14px; display: flex; flex-direction: column; gap: 8px; transition: border-color .15s; }
.bz-dz-card:hover { border-color: #334155; }
.bz-dz-icon { font-size: 22px; color: #60a5fa; }
.bz-dz-icon.pdf { color: #f87171; } .bz-dz-icon.dwg { color: #fbbf24; } .bz-dz-icon.img { color: #4ade80; }
.bz-dz-ver { display:inline-block; font-size:10px; font-weight:700; color:#93c5fd; background:rgba(59,130,246,.15); border-radius:5px; padding:0 5px; margin-right:4px; }
.bz-dz-versioni { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
.bz-dz-versioni label.bz-dz-btn { cursor:pointer; }
.bz-dz-storico { margin-top:6px; border-top:1px solid #1e293b; padding-top:6px; display:flex; flex-direction:column; gap:4px; }
.bz-dz-storico a { font-size:11.5px; color:#cbd5e1; text-decoration:none; padding:4px 6px; border-radius:6px; }
.bz-dz-storico a:hover { background:#1e293b; }
.bz-dz-storico a span { display:block; font-size:10.5px; color:#94a3b8; }
[data-theme="light"] .bz-dz-ver { color:#1d4ed8; background:#dbeafe; }
[data-theme="light"] .bz-dz-storico { border-color:#e2e8f0; }
[data-theme="light"] .bz-dz-storico a { color:#1e293b; }
[data-theme="light"] .bz-dz-storico a:hover { background:#f1f5f9; }
[data-theme="light"] .bz-dz-storico a span { color:#64748b; }
.bz-dz-name { font-size: 13px; font-weight: 600; color: #e2e8f0; word-break: break-word; line-height: 1.3; }
.bz-dz-meta { font-size: 11px; color: #64748b; }
.bz-dz-folder { display: inline-block; font-size: 10px; padding: 1px 7px; border-radius: 999px; background: #273548; color: #94a3b8; text-transform: uppercase; letter-spacing: .3px; }
.bz-dz-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
.bz-dz-btn { flex: 1; min-width: 0; display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 6px 8px; border-radius: 6px; border: 1px solid #273548; background: #0f172a; color: #94a3b8; font-size: 11px; cursor: pointer; text-decoration: none; transition: all .12s; }
.bz-dz-btn:hover { color: #e2e8f0; border-color: #334155; }
.bz-dz-btn.danger:hover { color: #fca5a5; border-color: #471515; }
.bz-dz-btn.fw { color: #93c5fd; }
.bz-dz-fw-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; color: #4ade80; font-weight: 600; }
.bz-dz-empty { grid-column: 1/-1; text-align: center; color: #475569; font-size: 13px; padding: 40px 0; }
.bz-dz-meta { color:#94a3b8; }
[data-theme="light"] .bz-dz-card { background:#fff; border-color:#e2e8f0; box-shadow:0 1px 2px rgba(15,23,42,.04); }
[data-theme="light"] .bz-dz-card:hover { border-color:#cbd5e1; }
[data-theme="light"] .bz-dz-name { color:#0f172a; }
[data-theme="light"] .bz-dz-meta { color:#64748b; }
[data-theme="light"] .bz-dz-folder { background:#f1f5f9; color:#475569; }
[data-theme="light"] .bz-dz-btn { background:#f8fafc; border-color:#e2e8f0; color:#334155; }
[data-theme="light"] .bz-dz-btn:hover { color:#0f172a; border-color:#cbd5e1; }
[data-theme="light"] .bz-dz-btn.danger:hover { color:#b91c1c; border-color:#fecaca; }
[data-theme="light"] .bz-dz-btn.fw { color:#1d4ed8; }
[data-theme="light"] .bz-dz-fw-badge { color:#15803d; }

/* Filtri Kanban */
.bz-kanban-filters { display:flex; gap:8px; padding:10px 20px; flex-shrink:0; flex-wrap:wrap; align-items:center; border-bottom:1px solid #1e293b; }
.bz-kanban-filters input, .bz-kanban-filters select { background:#1e293b; border:1px solid #273548; border-radius:7px; padding:6px 10px; color:#e2e8f0; font-size:12px; font-family:inherit; }
.bz-kanban-filters input { min-width:180px; }
.bz-kanban-filters button { background:#1e293b; border:1px solid #273548; color:#94a3b8; border-radius:7px; width:32px; height:32px; cursor:pointer; }
.bz-kanban-filters button:hover { color:#e2e8f0; }

/* File viewer (immagini + PDF in-app) */
.bz-fileview { position:fixed; inset:0; z-index:10002; background:rgba(8,12,22,.96); display:none; flex-direction:column; }
.bz-fileview.open { display:flex; }
.bz-fileview-head { display:flex; align-items:center; justify-content:space-between; padding:10px 16px; border-bottom:1px solid #1e293b; color:#e2e8f0; font-size:13px; font-weight:600; flex-shrink:0; }
.bz-fileview-body { flex:1; overflow:auto; display:flex; align-items:center; justify-content:center; padding:16px; }
.bz-fileview-body img { max-width:95%; max-height:100%; border-radius:6px; }
.bz-fileview-body iframe { width:100%; height:100%; border:none; background:#fff; border-radius:6px; }
.bz-fileview-msg { color:#94a3b8; font-size:14px; text-align:center; line-height:1.6; }
.bz-file-clickable { cursor:pointer; }
.bz-file-clickable:hover .bz-file-name { color:#60a5fa; }

/* File (repository) */
.bz-files { flex:1; display:flex; overflow:hidden; }
.bz-folders { width:220px; flex-shrink:0; border-right:1px solid #1e293b; padding:14px 10px; overflow-y:auto; display:flex; flex-direction:column; gap:2px; }
.bz-folder { display:flex; align-items:center; gap:8px; padding:8px 10px; border:none; background:none; color:#94a3b8; font-size:13px; cursor:pointer; border-radius:7px; font-family:inherit; text-align:left; width:100%; }
.bz-folder span { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bz-folder em { font-size:10px; color:#64748b; font-style:normal; }
.bz-folder .bz-folder-del { opacity:0; color:#f87171; font-size:11px; }
.bz-folder:hover { background:#1e293b; color:#e2e8f0; }
.bz-folder:hover .bz-folder-del { opacity:.7; }
.bz-folder.active { background:#334155; color:#f1f5f9; }
.bz-folder-new { display:flex; align-items:center; gap:8px; padding:8px 10px; border:1px dashed #273548; background:none; color:#64748b; font-size:12px; cursor:pointer; border-radius:7px; font-family:inherit; margin-top:8px; }
.bz-folder-new:hover { color:#94a3b8; border-color:#475569; }
.bz-files-main { flex:1; display:flex; flex-direction:column; overflow:hidden; }
.bz-files-bar { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-bottom:1px solid #1e293b; flex-shrink:0; }
.bz-files-title { font-size:14px; font-weight:600; color:#cbd5e1; }
.bz-files-list { flex:1; overflow-y:auto; padding:12px 20px; }
.bz-file-row { display:flex; align-items:center; gap:12px; padding:10px 12px; border:1px solid #1e293b; border-radius:8px; margin-bottom:6px; }
.bz-file-row:hover { border-color:#334155; }
.bz-file-icon { font-size:20px; color:#60a5fa; width:24px; text-align:center; }
.bz-file-info { flex:1; min-width:0; }
.bz-file-name { font-size:13px; font-weight:600; color:#e2e8f0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bz-file-sub { font-size:11px; color:#64748b; margin-top:2px; }
.bz-file-act { background:#1e293b; border:1px solid #273548; color:#94a3b8; border-radius:6px; padding:6px 10px; font-size:12px; cursor:pointer; text-decoration:none; }
.bz-file-act:hover { color:#e2e8f0; }
.bz-file-act.danger:hover { color:#fca5a5; border-color:#471515; }
.bz-file-modal { position:fixed; inset:0; z-index:10001; background:rgba(0,0,0,.6); display:none; align-items:center; justify-content:center; }
.bz-file-modal.open { display:flex; }
.bz-file-modal-box { width:95%; max-width:520px; max-height:80vh; background:#0f172a; border:1px solid #1e293b; border-radius:12px; display:flex; flex-direction:column; overflow:hidden; }
.bz-file-modal-head { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid #1e293b; font-size:13px; font-weight:600; color:#e2e8f0; }
.bz-file-modal-head button { background:none; border:none; color:#64748b; font-size:22px; cursor:pointer; }
.bz-file-modal-body { flex:1; overflow-y:auto; padding:14px 16px; display:flex; flex-direction:column; gap:12px; }
.bz-file-modal-foot { display:flex; gap:8px; padding:12px 16px; border-top:1px solid #1e293b; }
.bz-file-modal-foot input { flex:1; background:#1e293b; border:1px solid #273548; border-radius:7px; padding:8px 10px; color:#e2e8f0; font-size:13px; font-family:inherit; }
.bz-file-modal-foot button { background:#3b82f6; border:none; color:#fff; border-radius:7px; padding:8px 14px; cursor:pointer; }
[data-theme="light"] .bz-folders { border-color:#e2e8f0; }
[data-theme="light"] .bz-files-bar { border-color:#e2e8f0; }
[data-theme="light"] .bz-file-row { border-color:#e2e8f0; }
[data-theme="light"] .bz-file-name, [data-theme="light"] .bz-files-title { color:#1e293b; }
[data-theme="light"] .bz-file-modal-box { background:#fff; border-color:#e2e8f0; }
[data-theme="light"] .bz-file-modal-head { color:#1e293b; border-color:#e2e8f0; }

/* Galleria */
.bz-media { flex:1; overflow-y:auto; padding:20px 24px; }
.bz-media-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px,1fr)); gap:12px; }
.bz-media-card { background:#1e293b; border:1px solid #273548; border-radius:10px; overflow:hidden; cursor:pointer; transition:border-color .12s; }
.bz-media-card:hover { border-color:#475569; }
.bz-media-card img { width:100%; height:140px; object-fit:cover; display:block; background:#0f172a; }
.bz-media-meta { padding:8px 10px; }
.bz-media-task { font-size:12px; font-weight:600; color:#e2e8f0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.bz-media-sub { font-size:10px; color:#64748b; margin-top:2px; }
[data-theme="light"] .bz-media-card { background:#fff; border-color:#e2e8f0; }
[data-theme="light"] .bz-media-task { color:#1e293b; }
/* Lightbox */
.bz-lightbox { position:fixed; inset:0; z-index:10001; background:rgba(0,0,0,.88); display:none; flex-direction:column; align-items:center; justify-content:center; padding:40px; }
.bz-lightbox.open { display:flex; }
.bz-lightbox img { max-width:92vw; max-height:82vh; border-radius:8px; box-shadow:0 10px 50px rgba(0,0,0,.6); }
.bz-lb-caption { color:#e2e8f0; font-size:13px; margin-top:14px; text-align:center; }
.bz-lb-close { position:absolute; top:16px; right:20px; background:none; border:none; color:#fff; font-size:34px; cursor:pointer; line-height:1; }

/* Foto su commenti */
.bz-comment-photo { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; flex-shrink:0; border-radius:8px; background:#1e293b; border:1px solid #273548; color:#94a3b8; cursor:pointer; transition:all .12s; }
.bz-comment-photo:hover { color:#e2e8f0; border-color:#334155; }
.bz-comment-photo.uploading { opacity:.5; pointer-events:none; }
.bz-comment-photo-thumb { margin-top:6px; max-width:100%; max-height:180px; border-radius:8px; border:1px solid #273548; display:block; }

/* ── Mobile / tablet ── */
@media (max-width: 820px) {
    .bz-header { flex-wrap: wrap; height: auto; padding: 8px 12px; gap: 8px; }
    .bz-wname { display: none; }
    /* sidebar → barra orizzontale scrollabile sopra il body */
    .bz-main { flex-direction: column; }
    .bz-sidebar { width: 100%; flex-direction: row; overflow-x: auto; padding: 6px 8px; gap: 4px; border-right: none; border-bottom: 1px solid #1e293b; align-items: center; }
    .bz-nav { flex-direction: row; gap: 4px; }
    .bz-nav-item { white-space: nowrap; padding: 7px 10px; }
    .bz-nav-item span { display: none; }      /* solo icone su mobile */
    .bz-nav-actions { display: flex; flex-direction: row; gap: 4px; }
    .bz-nav-sep, .bz-nav-spacer { display: none; }
    .bz-nav-fw { padding: 0; border: none; }
    .bz-nav-fw .bz-fw-off { display: none; }
    .bz-info { display: none; }
    .bz-nav-fw-btn span { display: inline; }   /* il connect FW mostra il testo */
    /* pannello dettaglio task: overlay a tutto schermo */
    .bz-detail-wrap { position: fixed; inset: 0; width: 100% !important; z-index: 50; border-left: none; }
    .bz-detail-wrap.closed { width: 0 !important; display: none; }
    /* file: cartelle in orizzontale sopra la lista */
    .bz-files { flex-direction: column; }
    .bz-folders { width: 100%; flex-direction: row; overflow-x: auto; border-right: none; border-bottom: 1px solid #1e293b; padding: 8px; }
    .bz-folder { white-space: nowrap; width: auto; }
    .bz-folder-new { margin-top: 0; }
    /* kanban: colonne piu' strette, scroll orizzontale */
    .bz-col { min-width: 78vw; }
    .bz-kanban-filters input { min-width: 0; flex: 1; }
    /* annotator: toolbar e pannello adattati */
    .bza-top { flex-wrap: wrap; height: auto; padding: 8px; gap: 6px; }
    .bza-side { position: fixed; inset: 0; width: 100% !important; z-index: 60; }
    .bza-tools { order: 3; width: 100%; justify-content: center; }
}
</style>

