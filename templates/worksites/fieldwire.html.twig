/* ── Checklist ── */
async function loadChecklist(taskId) {
    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/checklist`);
    const el  = document.getElementById(`bz-checklist-${taskId}`);
    if (!el) return;
    const items = res.ok && Array.isArray(res.data) ? res.data : [];
    // spunta chi ci lavora, toglie chi l'ha creata: le stesse regole del server
    const task = allTasks.find(t => t.id == taskId) || {};
    const spunta = taskAvanza(task), togli = DA_UFFICIO || taskMio(task);   // togliere un passaggio: CSM o chi l'ha creata
    if (!items.length) { el.innerHTML = '<div class="bz-detail-vuoto">Nessun passaggio.</div>'; return; }
    el.innerHTML = items.map(c => `
        <div class="bz-check-row" id="crow-${c.id}" style="display:flex;align-items:center;gap:6px;">
            <input type="checkbox" id="chk-${c.id}" ${c.completed ? 'checked' : ''}
                   ${spunta ? `data-toggle-check="${taskId}:${c.id}"` : 'disabled'}>
            <label ${spunta ? `for="chk-${c.id}"` : ''} class="${c.completed ? 'done' : ''}" style="flex:1;">${escHtml(c.name)}</label>
            ${togli ? `<button class="bz-x-btn bz-comment-del" data-delete-check="${taskId}:${c.id}" title="Togli passaggio">×</button>` : ''}
        </div>`).join('');
}

async function toggleCheck(taskId, itemId, cb) {
    cb.disabled = true;
    const label = cb.nextElementSibling;
    await api(`/worksites/${WID}/zone/tasks/${taskId}/checklist/${itemId}/complete`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ completed: cb.checked }),
    });
    label?.classList.toggle('done', cb.checked);
    cb.disabled = false;
}

async function addCheck(taskId) {
    const inp  = document.getElementById('new-check-input');
    const name = inp.value.trim();
    if (!name) return;
    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/checklist`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
    });
    if (res.ok) { inp.value = ''; loadChecklist(taskId); }
}

async function deleteCheck(taskId, itemId) {
    if (!confirm('Eliminare questo elemento della checklist?')) return;
    await api(`/worksites/${WID}/zone/tasks/${taskId}/checklist/${itemId}/delete`, { method: 'POST' });
    loadChecklist(taskId);
}

async function deleteComment(taskId, commentId) {
    if (!confirm('Eliminare questo commento?')) return;
    await api(`/worksites/${WID}/zone/tasks/${taskId}/comments/${commentId}/delete`, { method: 'POST' });
    loadComments(taskId);
}

async function deleteTask(taskId) {
    if (!confirm('Eliminare questa attività? Verranno eliminati anche messaggi, foto e checklist.')) return;
    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/delete`, { method: 'POST' });
    if (res.ok) {
        allTasks = allTasks.filter(t => t.id != taskId);
        closeDetail();
        renderCurrentView();
    } else {
        alert('Errore: ' + (res.error || 'impossibile eliminare'));
    }
}

/* ══════════ EDIT TASK MODAL ══════════ */
function openEditModal(taskId) {
    const t = allTasks.find(x => x.id == taskId);
    if (!t) return;
    document.getElementById('edit-task-id').value       = t.id;
    document.getElementById('edit-task-name').value     = t.name || '';
    document.getElementById('edit-task-desc').value     = t.description || '';
    document.getElementById('edit-task-luogo').value    = t.luogo || '';
    document.getElementById('edit-task-cat').value      = t.category || '';
    document.getElementById('edit-task-due').value      = t.due_date   || '';
    document.getElementById('edit-task-start').value    = t.start_date || '';
    document.getElementById('edit-task-priority').value = String(t.priority ?? 0);
    // assignee select per user_id; se il task ha un nome FW senza id, lo
    // aggiungo come opzione "custom" (value vuoto, solo display) cosi' si vede.
    const sel = document.getElementById('edit-task-assignee');
    if (t.assignee_user_id) {
        sel.value = String(t.assignee_user_id);
    } else if (t.assegnata_a && !['persona', 'squadra', 'capi', 'cantiere'].includes(t.assegnata_a)) {
        sel.value = '@' + t.assegnata_a;
    } else {
        sel.value = '';
    }
    const chiEdit = document.getElementById('edit-task-chi');
    chiEdit.dataset.chiTipo    = 'attivita';
    chiEdit.dataset.chiOggetto = t.id;
    chiEdit.innerHTML = '<i class="fas fa-eye"></i> ' + escHtml(chiTesto(t));
    document.getElementById('task-edit-modal').classList.remove('hidden');
    document.getElementById('edit-task-name').focus();
}
function closeEditModal() {
    document.getElementById('task-edit-modal').classList.add('hidden');
}

async function submitEdit() {
    const id = parseInt(document.getElementById('edit-task-id').value);
    const eSel = document.getElementById('edit-task-assignee');
    const body = {
        name:            document.getElementById('edit-task-name').value.trim(),
        description:     document.getElementById('edit-task-desc').value,
        luogo:           document.getElementById('edit-task-luogo').value,
        category:        document.getElementById('edit-task-cat').value || null,
        ...assegnazioneDaSelect(eSel),
        due_date:        document.getElementById('edit-task-due').value   || null,
        start_date:      document.getElementById('edit-task-start').value || null,
        priority:        parseInt(document.getElementById('edit-task-priority').value || '0'),
    };
    if (!body.name) { document.getElementById('edit-task-name').focus(); return; }

    const btn = document.getElementById('btn-edit-submit');
    btn.disabled = true; btn.textContent = '...';
    const res = await api(`/worksites/${WID}/zone/tasks/${id}/update`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
    });
    btn.disabled = false; btn.textContent = 'Salva modifiche';

    if (res.ok) {
        // sostituisci il task locale
        const idx = allTasks.findIndex(t => t.id == id);
        if (idx >= 0) allTasks[idx] = res.data;
        closeEditModal();
        renderCurrentView();
        openTask(id);
    } else {
        alert('Errore: ' + (res.error || 'impossibile aggiornare'));
    }
}

/* Override updateTaskName per usare l'endpoint giusto (era bacato — chiamava /status) */
function updateTaskName(taskId, name) {
    if (!name.trim()) return;
    const task = allTasks.find(t => t.id == taskId);
    if (!task) return;
    task.name = name;
    api(`/worksites/${WID}/zone/tasks/${taskId}/update`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...task, name }),
    });
}

/* ══════════ BOB USERS DROPDOWN ══════════ */
async function loadBobUsers() {
    // solo chi sta in questo cantiere: un'attivita' data a qualcuno che
    // qui non c'e' non la puo' aprire nessuno
    const res = await api(`/worksites/${WID}/zone/users?qui=1`);
    if (!res.ok || !Array.isArray(res.data)) return;
    // il nome con l'azienda: due Rossi si distinguono cosi'
    const html = res.data.map(u => `<option value="${u.id}">${escHtml(u.label + (u.azienda ? ' · ' + u.azienda : ''))}</option>`).join('');
    document.querySelectorAll('#task-assignee, #edit-task-assignee').forEach(sel => {
        // value = user_id (per notifiche); il testo è il nome (per display/Fieldwire)
        // prima i gruppi: un'attivita' di tutta la squadra non e' di nessuno
        // in particolare. Ufficio e cliente li assegna solo l'ufficio.
        // "i capi squadra" non c'e' piu': erano le stesse persone della
        // squadra. Il cliente chiede prima di tutto all'ufficio.
        const squadra = '<option value="">Squadra</option>';
        const ufficio = '<option value="@ufficio">CSM</option>';
        const cliente = '<option value="@cliente">Cliente</option>';
        const gruppi = RUOLO === 'cliente' ? ufficio + squadra
                     : DA_UFFICIO ? squadra + ufficio + cliente
                     : squadra + ufficio;
        sel.innerHTML = gruppi + '<optgroup label="Una persona">' + html + '</optgroup>';
    });
}

/* ── Comments ── */
async function loadComments(taskId) {
    const res  = await api(`/worksites/${WID}/zone/tasks/${taskId}/comments`);
    const el   = document.getElementById(`bz-comments-${taskId}`);
    if (!el) return;
    const items = res.ok && Array.isArray(res.data) ? res.data : [];
    // le foto dell'attivita' in cima, tutte insieme: prima erano sparse
    // fra i messaggi e per trovarle si scorreva il filo
    const foto = items.filter(c => c.file_url);
    const sez = document.getElementById(`bz-foto-sez-${taskId}`), striscia = document.getElementById(`bz-foto-${taskId}`);
    if (sez && striscia) {
        sez.hidden = !foto.length;
        striscia.innerHTML = foto.map(c => `<a href="${escAttr(c.file_url)}" target="_blank" rel="noopener" title="${escAttr(c.author_name || '')}"><img src="${escAttr(c.file_url)}" alt="" loading="lazy"></a>`).join('');
    }
    if (!items.length) { el.innerHTML = '<div class="bz-detail-vuoto">Nessun messaggio.</div>'; return; }
    el.innerHTML = items.map(c => `
        <div class="bz-comment">
            <div class="bz-comment-avatar">${initials(c.author_name)}</div>
            <div class="bz-comment-body">
                <div class="bz-comment-meta">
                    <span class="bz-comment-author">${escHtml(c.author_name || '?')}</span>
                    <span class="bz-comment-time">${ago(c.created_at)}</span>
                    ${c.interna == 1 ? '<span class="bz-vis-badge solo"><i class="fas fa-lock"></i> interna</span>' : ''}
                    ${DA_UFFICIO || Number(c.author_user_id) === Number(IO) ? `<button class="bz-x-btn bz-comment-del" data-delete-comment="${taskId}:${c.id}" title="Elimina">×</button>` : ''}
                </div>
                ${c.text ? `<div class="bz-comment-text">${escHtml(c.text)}</div>` : ''}
                ${c.file_url ? `<a href="${escAttr(c.file_url)}" target="_blank" rel="noopener"><img class="bz-comment-photo-thumb" src="${escAttr(c.file_url)}" alt="foto" loading="lazy"></a>` : ''}
            </div>
        </div>`).join('');
    el.scrollTop = el.scrollHeight;
}

function flagMessaggio() {
    return {
        interna:     document.getElementById('bz-flag-interna')?.checked ? 1 : 0,
        per_cliente: document.getElementById('bz-flag-cliente')?.checked ? 1 : 0,
    };
}
function azzeraFlag() {
    ['bz-flag-interna', 'bz-flag-cliente'].forEach(id => { const x = document.getElementById(id); if (x) x.checked = false; });
}

async function sendComment() {
    const inp  = document.getElementById('bz-comment-input');
    const text = inp?.value?.trim();
    if (!text || !activeTaskId) return;
    inp.disabled = true;
    const res = await api(`/worksites/${WID}/zone/tasks/${activeTaskId}/comments`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, ...flagMessaggio() }),
    });
    if (res.ok) { inp.value = ''; azzeraFlag(); loadComments(activeTaskId); }
    inp.disabled = false;
    inp.focus();
}

/* ══════════ DISEGNI / TAVOLE ══════════ */
let disegniLoaded = false;

async function loadDisegni() {
    const grid = document.getElementById('bz-disegni-grid');
    if (!disegniLoaded) grid.innerHTML = '<div class="bz-empty"><i class="fas fa-spinner bz-spin" style="font-size:20px"></i></div>';

    const res = await api(`/worksites/${WID}/zone/disegni`);
    disegniLoaded = true;
    if (!res.ok) { grid.innerHTML = `<div class="bz-dz-empty">Impossibile caricare i disegni.${res.error ? '<br><small>' + escHtml(res.error) + '</small>' : ''}</div>`; return; }

    const { bob = [], fieldwire = [], fieldwire_ready = false } = res.data || {};
    renderDisegni(bob, fieldwire_ready);
    renderFwFloorplans(fieldwire);
}

function dzIconClass(type) {
    const t = (type || '').toLowerCase();
    if (t === 'pdf') return 'pdf';
    if (t === 'dwg') return 'dwg';
    if (['png','jpg','jpeg'].includes(t)) return 'img';
    return '';
}
function dzIconGlyph(type) {
    const t = (type || '').toLowerCase();
    if (t === 'pdf') return 'fa-file-pdf';
    if (t === 'dwg') return 'fa-drafting-compass';
    if (['png','jpg','jpeg'].includes(t)) return 'fa-file-image';
    return 'fa-file';
}

function renderDisegni(items, fwReady) {
    const grid = document.getElementById('bz-disegni-grid');
    if (!items.length) {
        grid.innerHTML = '<div class="bz-dz-empty">Nessun disegno caricato.</div>';
        return;
    }
    grid.innerHTML = items.map(d => `
        <div class="bz-dz-card">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                <i class="fas ${dzIconGlyph(d.file_type)} bz-dz-icon ${dzIconClass(d.file_type)}"></i>
                <span class="bz-dz-folder">${escHtml(d.folder)}</span>
            </div>
            <div class="bz-dz-name" title="${escAttr(d.file_name)}">${escHtml(d.file_name)}</div>
            <div class="bz-dz-meta"><span class="bz-dz-ver" title="Versione in uso">v${d.versione || 1}</span> ${escHtml(d.uploader)} · ${fmtDateTime(d.created_at)}</div>
            ${DA_UFFICIO
                ? `<div class="bz-dz-meta">${chiBottone('disegno', d.id, d)}</div>
                   <div class="bz-dz-versioni">
                     <label class="bz-dz-btn" title="Carica una versione aggiornata. La versione attuale resta nello storico.">
                       <i class="fas fa-arrow-up-from-bracket"></i> Nuova versione
                       <input type="file" hidden accept=".pdf,.dwg,.dxf,.png,.jpg,.jpeg" data-nuova-versione="${d.id}">
                     </label>
                     ${d.n_versioni ? `<button type="button" class="bz-dz-btn" data-storico="${d.id}"><i class="fas fa-clock-rotate-left"></i> Versioni precedenti (${d.n_versioni})</button>` : ''}
                   </div>
                   <div class="bz-dz-storico" id="bz-storico-${d.id}" hidden></div>`
                : (RUOLO === 'cliente' && Number(d.created_by) === Number(IO)
                    // il committente aggiorna i disegni che ha caricato lui
                    ? `<div class="bz-dz-versioni">
                         <label class="bz-dz-btn" title="Carica una versione aggiornata. La versione attuale resta nello storico.">
                           <i class="fas fa-arrow-up-from-bracket"></i> Nuova versione
                           <input type="file" hidden accept=".pdf,.dwg,.dxf,.png,.jpg,.jpeg" data-nuova-versione="${d.id}">
                         </label>
                       </div>`
                    : '')}
            ${d.fw_synced ? '<div class="bz-dz-fw-badge"><i class="fas fa-check-circle"></i> Su Fieldwire</div>' : ''}
            ${d.is_dwg && d.dwg_status === 'pending' ? '<div class="bz-dz-meta"><i class="fas fa-spinner bz-spin"></i> Conversione DWG in corso…</div>' : ''}
            ${d.is_dwg && d.dwg_status === 'error' ? `<div class="bz-dz-meta" style="color:#fca5a5;" title="${escAttr(d.dwg_error || '')}">Conversione DWG non riuscita${d.dwg_error ? ': ' + escHtml(d.dwg_error.slice(0, 160)) : ''}</div>` : ''}
            <div class="bz-dz-actions">
                ${d.annotatable
                    ? (puoScrivere('disegni')
                        ? `<button class="bz-dz-btn" data-annot="${d.id}" data-annot-type="${escAttr(d.file_type)}" data-annot-name="${escAttr(d.file_name)}"><i class="fas fa-map-marker-alt"></i> Annota</button>`
                        : `<a class="bz-dz-btn" href="${d.view_url}" target="_blank" rel="noopener"><i class="fas fa-eye"></i> Apri</a>`)
                    : (d.is_dwg
                        ? (puoScrivere('disegni')
                            ? `<button class="bz-dz-btn" data-dwg-convert="${d.id}"><i class="fas fa-sync"></i> Converti</button>`
                            : '')
                        : `<a class="bz-dz-btn" href="${d.view_url}" target="_blank" rel="noopener"><i class="fas fa-eye"></i> Apri</a>`)}
                <a class="bz-dz-btn" href="${d.view_url}" download><i class="fas fa-download"></i></a>
                ${DA_UFFICIO && fwReady && !d.fw_synced ? `<button class="bz-dz-btn fw" data-push-fw="${d.id}"><i class="fas fa-cloud-upload-alt"></i> FW</button>` : ''}
                ${DA_UFFICIO ? `<button class="bz-dz-btn danger" data-del-disegno="${d.id}"><i class="fas fa-trash"></i></button>` : ''}
            </div>
        </div>`).join('');
}

function renderFwFloorplans(items) {
    const wrap = document.getElementById('bz-fw-floorplans');
    const grid = document.getElementById('bz-fw-floorplans-grid');
    if (!items.length) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';
    grid.innerHTML = items.map(f => `
        <div class="bz-dz-card">
            <i class="fas fa-layer-group bz-dz-icon"></i>
            <div class="bz-dz-name">${escHtml(f.name)}</div>
            <div class="bz-dz-meta">${f.sheets_count != null ? f.sheets_count + ' fogli' : ''}</div>
            <div class="bz-dz-actions">
                ${f.open_url ? `<a class="bz-dz-btn fw" href="${f.open_url}" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> Apri in Fieldwire</a>` : ''}
            </div>
        </div>`).join('');
}

async function uploadDisegno(file) {
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    fd.append('folder', 'altri');
    fd.append('ajax', '1');

    const grid = document.getElementById('bz-disegni-grid');
    const prev = grid.innerHTML;
    grid.insertAdjacentHTML('afterbegin', '<div class="bz-dz-empty" id="dz-uploading"><i class="fas fa-spinner bz-spin"></i> Caricamento...</div>');

    // upload usa l'endpoint BOB esistente (AJAX-aware). FormData → niente Content-Type manuale.
    const res = await api(`/worksites/${WID}/disegni/upload`, { method: 'POST', body: fd });
    if (!res.ok) {
        document.getElementById('dz-uploading')?.remove();
        alert('Errore di caricamento: ' + (res.error || 'sconosciuto'));
        return;
    }
    disegniLoaded = false;
    loadDisegni();
}

/* Una versione nuova dello stesso disegno: quella di prima va nello
   storico e resta apribile; chi vede il disegno riceve un avviso. */
async function nuovaVersione(docId, file) {
    if (!file) return;
    if (!confirm(`Caricare "${file.name}" come nuova versione? Quella di adesso resta nello storico.`)) return;
    const fd = new FormData();
    fd.append('file', file);
    fd.append('replace_id', docId);
    fd.append('ajax', '1');
    const res = await api(`/worksites/${WID}/disegni/upload`, { method: 'POST', body: fd });
    if (!res.ok) { alert('Versione non caricata: ' + (res.error || 'errore')); return; }
    disegniLoaded = false;
    loadDisegni();
}
async function mostraStorico(docId) {
    const box = document.getElementById(`bz-storico-${docId}`);
    if (!box) return;
    if (!box.hidden) { box.hidden = true; return; }
    box.hidden = false;
    box.innerHTML = '<i class="fas fa-spinner bz-spin"></i>';
    const r = await fetch(`/worksites/${WID}/disegni/${docId}/versions`, { headers: { 'X-CSRF-Token': CSRF } });
    const v = r.ok ? await r.json() : [];
    box.innerHTML = (Array.isArray(v) && v.length) ? v.map(x => `
        <a href="/worksites/${WID}/disegni/${docId}/view?version_id=${x.id}" target="_blank" rel="noopener">
          <b>v${x.version_number}</b> ${escHtml(x.file_name || '')}
          <span>${fmtDateTime(x.created_at)}${x.first_name ? ' · ' + escHtml((x.first_name + ' ' + (x.last_name || '')).trim()) : ''}</span>
        </a>`).join('') : '<span class="bz-detail-vuoto">Nessuna versione precedente.</span>';
}
document.addEventListener('change', e => {
    const inp = e.target.closest('[data-nuova-versione]');
    if (!inp) return;
    const f = inp.files?.[0]; inp.value = '';
    nuovaVersione(parseInt(inp.dataset.nuovaVersione), f);
});
document.addEventListener('click', e => {
    const b = e.target.closest('[data-storico]');
    if (b) mostraStorico(parseInt(b.dataset.storico));
});

async function deleteDisegno(docId) {
    if (!confirm('Eliminare questo disegno?')) return;
    // l'endpoint delete BOB e' GET e ritorna 204 (no JSON) → fetch diretto
    await fetch(`/worksites/${WID}/disegni/${docId}/delete`, {
        headers: { 'X-CSRF-Token': CSRF }, credentials: 'same-origin'
    });
    disegniLoaded = false;
    loadDisegni();
}

async function pushDisegnoFw(docId, btn) {
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner bz-spin"></i>'; }
    const res = await api(`/worksites/${WID}/zone/disegni/${docId}/push-fieldwire`, { method: 'POST' });
    if (res.ok) {
        disegniLoaded = false;
        loadDisegni();
    } else {
        alert('Errore sync Fieldwire: ' + (res.error || 'sconosciuto'));
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-cloud-upload-alt"></i> FW'; }
    }
}

function fmtDateTime(str) {
    if (!str) return '';
    const d = new Date(str.replace(' ', 'T'));
    if (isNaN(d)) return str;
    return d.toLocaleDateString('it-IT', { day:'2-digit', month:'2-digit', year:'2-digit' });
}

/* ══════════ GALLERIA ══════════ */
let mediaLoaded = false;
async function loadMedia() {
    const grid = document.getElementById('bz-media-grid');
    if (!mediaLoaded) grid.innerHTML = '<div class="bz-empty"><i class="fas fa-spinner bz-spin" style="font-size:20px"></i></div>';
    const res = await api(`/worksites/${WID}/zone/media`);
    mediaLoaded = true;
    const items = (res.ok && Array.isArray(res.data)) ? res.data : [];
    if (!items.length) { grid.innerHTML = '<div class="bz-dz-empty">Nessuna foto. Le foto si allegano alle attività.</div>'; return; }
    grid.innerHTML = items.map(m => `
        <div class="bz-media-card" data-lb="${escAttr(m.file_url)}"
             data-cap="${escAttr((m.task_name||'') + ' · ' + (m.author_name||'') + ' · ' + fmtDateTime(m.created_at))}"
             data-task="${m.task_id}">
            <img src="${escAttr(m.file_url)}" loading="lazy" alt="">
            <div class="bz-media-meta">
                <div class="bz-media-task">${escHtml(m.task_name || '—')}</div>
                <div class="bz-media-sub">${escHtml(m.author_name || '')} · ${fmtDateTime(m.created_at)}</div>
            </div>
        </div>`).join('');
}

function openLightbox(src, caption, taskId) {
    document.getElementById('bz-lb-img').src = src;
    const cap = document.getElementById('bz-lb-caption');
    cap.innerHTML = escHtml(caption) + (taskId ? ` <a href="#" data-lb-task="${taskId}" style="color:#60a5fa;margin-left:8px;">Apri attività</a>` : '');
    document.getElementById('bz-lightbox').classList.add('open');
}
function closeLightbox() { document.getElementById('bz-lightbox').classList.remove('open'); }

document.getElementById('bz-lb-close')?.addEventListener('click', closeLightbox);
document.getElementById('bz-lightbox')?.addEventListener('click', e => {
    if (e.target.id === 'bz-lightbox') closeLightbox();
    const tl = e.target.closest('[data-lb-task]');
    if (tl) {
        e.preventDefault();
        const tid = parseInt(tl.dataset.lbTask);
        closeLightbox();
        switchTop('attivita'); switchSub('kanban');
        setTimeout(() => openTask(tid), 50);
    }
});
document.addEventListener('click', e => {
    const card = e.target.closest('[data-lb]');
    if (card) openLightbox(card.dataset.lb, card.dataset.cap, card.dataset.task);
});

/* ══════════ FILE (repository documenti) ══════════ */
let curFolder = null;        // null = root
let fileActiveId = null;

function fileIcon(type) {
    const t = (type || '').toLowerCase();
    if (['jpg','jpeg','png','webp','gif'].includes(t)) return 'fa-file-image';
    if (t === 'pdf') return 'fa-file-pdf';
    if (['doc','docx'].includes(t)) return 'fa-file-word';
    if (['xls','xlsx','csv'].includes(t)) return 'fa-file-excel';
    if (['ppt','pptx'].includes(t)) return 'fa-file-powerpoint';
    if (['zip','rar','7z'].includes(t)) return 'fa-file-zipper';
    if (['dwg','dxf'].includes(t)) return 'fa-drafting-compass';
    return 'fa-file';
}
function humanSize(b) {
    b = +b || 0;
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b/1024).toFixed(0) + ' KB';
    return (b/1048576).toFixed(1) + ' MB';
}

async function loadFiles() {
    const list = document.getElementById('bz-files-list');
    list.innerHTML = '<div class="bz-empty"><i class="fas fa-spinner bz-spin" style="font-size:20px"></i></div>';
    const res = await api(`/worksites/${WID}/zone/files${curFolder ? '?folder=' + curFolder : ''}`);
    if (!res.ok) { list.innerHTML = '<div class="bz-dz-empty">Errore caricamento file.</div>'; return; }
    renderFolders(res.data.folders || []);
    renderFiles(res.data.files || []);
    // dentro una cartella, l'ufficio decide chi la vede: vale per tutti i file
    const cart = (res.data.folders || []).find(f => f.id == curFolder);
    const box  = document.getElementById('bz-folder-vis');
    if (box) {
        box.innerHTML = DA_UFFICIO && cart
            ? chiBottone('cartella', cart.id, cart)
            : '';
    }
}

function renderFolders(folders) {
    const el = document.getElementById('bz-folders');
    el.innerHTML = `
        <button class="bz-folder ${curFolder===null?'active':''}" data-folder=""><i class="fas fa-inbox"></i> Tutti i file</button>
        ${folders.map(f => `
            <button class="bz-folder ${curFolder==f.id?'active':''}" data-folder="${f.id}">
                <i class="fas fa-folder"></i> <span>${escHtml(f.name)}</span>${chiBadge(f)}
                <em>${f.file_count}</em>
                ${DA_UFFICIO || Number(f.created_by) === Number(IO) ? `<i class="fas fa-trash bz-folder-del" data-del-folder="${f.id}" title="Elimina cartella"></i>` : ''}
            </button>`).join('')}
        <button class="bz-folder-new" id="bz-new-folder"><i class="fas fa-plus"></i> Nuova cartella</button>
    `;
}

function renderFiles(files) {
    const list = document.getElementById('bz-files-list');
    const title = document.getElementById('bz-files-title');
    title.textContent = 'File' + (curFolder ? '' : ' — tutti');
    if (!files.length) { list.innerHTML = '<div class="bz-dz-empty">Nessun file presente.</div>'; return; }
    const canView = t => ['jpg','jpeg','png','webp','gif','pdf'].includes((t||'').toLowerCase());
    list.innerHTML = files.map(f => {
        const viewable = canView(f.file_type);
        return `
        <div class="bz-file-row">
            <i class="fas ${fileIcon(f.file_type)} bz-file-icon"></i>
            <div class="bz-file-info ${viewable?'bz-file-clickable':''}"
                 ${viewable?`data-view-file="${f.id}" data-vf-name="${escAttr(f.file_name)}" data-vf-type="${escAttr(f.file_type)}" data-vf-url="${f.download_url}"`:''}>
                <div class="bz-file-name">${escHtml(f.file_name)}</div>
                <div class="bz-file-sub">${escHtml(f.uploader||'—')} · ${fmtDateTime(f.created_at)} · ${humanSize(f.size_bytes)}</div>
            </div>
            ${viewable?`<button class="bz-file-act" data-view-file="${f.id}" data-vf-name="${escAttr(f.file_name)}" data-vf-type="${escAttr(f.file_type)}" data-vf-url="${f.download_url}" title="Anteprima"><i class="fas fa-eye"></i></button>`:''}
            <button class="bz-file-act" data-file-comments="${f.id}" data-file-name="${escAttr(f.file_name)}" title="Commenti"><i class="fas fa-comment"></i> ${f.comment_count>0?f.comment_count:''}</button>
            <a class="bz-file-act" href="${f.download_url}" target="_blank" rel="noopener" title="Scarica"><i class="fas fa-download"></i></a>
            ${DA_UFFICIO || Number(f.uploaded_by) === Number(IO) ? `<button class="bz-file-act danger" data-del-file="${f.id}" title="Elimina"><i class="fas fa-trash"></i></button>` : ''}
        </div>`;
    }).join('');
}

async function createFolder() {
    const name = prompt('Nome cartella:');
    if (!name || !name.trim()) return;
    await api(`/worksites/${WID}/zone/files/folder`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name:name.trim()}) });
    loadFiles();
}
async function deleteFolder(id) {
    if (!confirm('Eliminare la cartella? I file contenuti verranno spostati in "Tutti i file".')) return;
    await api(`/worksites/${WID}/zone/files/folder/${id}/delete`, { method:'POST' });
    if (curFolder == id) curFolder = null;
    loadFiles();
}
async function uploadFile(file) {
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    if (curFolder) fd.append('folder_id', curFolder);
    const res = await api(`/worksites/${WID}/zone/files`, { method:'POST', body: fd });
    if (res.ok) loadFiles();
    else alert('Errore di caricamento: ' + (res.error || 'sconosciuto'));
}
async function deleteFile(id) {
    if (!confirm('Eliminare questo file?')) return;
    await api(`/worksites/${WID}/zone/files/${id}/delete`, { method:'POST' });
    loadFiles();
}

/* viewer file in-app (immagini + PDF) */
function openFileView(name, type, url) {
    const t = (type || '').toLowerCase();
    const body = document.getElementById('bz-fileview-body');
    document.getElementById('bz-fileview-name').textContent = name;
    document.getElementById('bz-fileview-dl').href = url;
    if (['jpg','jpeg','png','webp','gif'].includes(t)) {
        body.innerHTML = `<img src="${escAttr(url)}" alt="">`;
    } else if (t === 'pdf') {
        body.innerHTML = `<iframe src="${escAttr(url)}" title="PDF"></iframe>`;
    } else {
        body.innerHTML = `<div class="bz-fileview-msg">Anteprima non disponibile per questo tipo di file.<br>Usa "Scarica" per aprirlo.</div>`;
    }
    document.getElementById('bz-fileview').classList.add('open');
}
function closeFileView() {
    document.getElementById('bz-fileview').classList.remove('open');
    document.getElementById('bz-fileview-body').innerHTML = ''; // stop iframe/video
}
document.getElementById('bz-fileview-close')?.addEventListener('click', closeFileView);
document.getElementById('bz-fileview')?.addEventListener('click', e => { if (e.target.id==='bz-fileview') closeFileView(); });

/* commenti file (modal) */
async function openFileComments(fileId, fileName) {
    fileActiveId = fileId;
    document.getElementById('bz-file-modal-name').textContent = fileName;
    document.getElementById('bz-file-modal').classList.add('open');
    loadFileComments();
}
async function loadFileComments() {
    const box = document.getElementById('bz-file-modal-comments');
    box.innerHTML = '<div class="bz-empty">Caricamento...</div>';
    const res = await api(`/worksites/${WID}/zone/files/${fileActiveId}/comments`);
    const items = (res.ok && Array.isArray(res.data)) ? res.data : [];
    box.innerHTML = items.length ? items.map(c => `
        <div class="bz-comment">
            <div class="bz-comment-avatar">${initials(c.author_name)}</div>
            <div class="bz-comment-body">
                <div class="bz-comment-meta"><span class="bz-comment-author">${escHtml(c.author_name||'?')}</span><span class="bz-comment-time">${ago(c.created_at)}</span></div>
                <div class="bz-comment-text">${escHtml(c.text||'')}</div>
            </div>
        </div>`).join('') : '<div style="font-size:12px;color:#64748b;">Nessun commento.</div>';
    box.scrollTop = box.scrollHeight;
}
async function sendFileComment() {
    const inp = document.getElementById('bz-file-comment-input');
    const text = inp.value.trim();
    if (!text || !fileActiveId) return;
    inp.disabled = true;
    const res = await api(`/worksites/${WID}/zone/files/${fileActiveId}/comments`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({text}) });
    inp.disabled = false;
    if (res.ok) { inp.value=''; loadFileComments(); loadFiles(); }
    inp.focus();
}

// listener delegati per la sezione file
document.addEventListener('click', e => {
    const folBtn = e.target.closest('[data-folder]');
    if (folBtn && !e.target.closest('[data-del-folder]')) { curFolder = folBtn.dataset.folder ? parseInt(folBtn.dataset.folder) : null; loadFiles(); return; }
    const delFol = e.target.closest('[data-del-folder]');
    if (delFol) { e.stopPropagation(); deleteFolder(parseInt(delFol.dataset.delFolder)); return; }
    if (e.target.closest('#bz-new-folder')) { createFolder(); return; }
    const vf = e.target.closest('[data-view-file]');
    if (vf) { openFileView(vf.dataset.vfName, vf.dataset.vfType, vf.dataset.vfUrl); return; }
    const fc = e.target.closest('[data-file-comments]');
    if (fc) { openFileComments(parseInt(fc.dataset.fileComments), fc.dataset.fileName); return; }
    const df = e.target.closest('[data-del-file]');
    if (df) { deleteFile(parseInt(df.dataset.delFile)); return; }
});
document.getElementById('bz-file-input')?.addEventListener('change', e => { const f=e.target.files?.[0]; e.target.value=''; if (f) uploadFile(f); });
document.getElementById('bz-file-modal-close')?.addEventListener('click', () => document.getElementById('bz-file-modal').classList.remove('open'));
document.getElementById('bz-file-modal')?.addEventListener('click', e => { if (e.target.id==='bz-file-modal') document.getElementById('bz-file-modal').classList.remove('open'); });
document.getElementById('bz-file-comment-send')?.addEventListener('click', sendFileComment);
document.getElementById('bz-file-comment-input')?.addEventListener('keydown', e => { if (e.key==='Enter'){ e.preventDefault(); sendFileComment(); } });

/* ══════════ NEW TASK MODAL ══════════ */
let quickAddStatus = null;

function quickAdd(status) {
    // un'attivita' nuova nasce sempre "da fare"
    quickAddStatus = null;
    openModal();
}

/* I passaggi e le foto della nuova attivita', in pagina finche' non si crea. */
let passiNuovi = [], fotoNuove = [];
/* Il punto su un disegno: {document_id, page, x, y, nome}. */
let puntoNuovo = null;

/* I disegni che si possono segnare, nella tendina di "Dove". */
async function preparaPunto() {
    puntoNuovo = null;
    const box = document.getElementById('task-punto-box');
    const sel = document.getElementById('task-disegno');
    document.getElementById('task-punto-scelto').hidden = true;
    const r = await api(`/worksites/${WID}/zone/disegni`);
    const segnabili = ((r.ok && r.data && r.data.bob) || []).filter(d => d.annotatable);
    box.hidden = !segnabili.length;
