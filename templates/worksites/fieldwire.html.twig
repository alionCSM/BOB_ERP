            ${task.start_date ? `<div style="font-size:12px;color:#64748b;margin-bottom:4px"><i class="fas fa-calendar-alt" style="font-size:13px;vertical-align:-2px"></i> Inizio: ${fmtDate(task.start_date)}</div>` : ''}
            ${task.due_date ? `<div style="font-size:12px;color:#64748b;"><i class="fas fa-calendar-check" style="font-size:13px;vertical-align:-2px"></i> Scadenza: ${fmtDate(task.due_date)}</div>` : ''}
            ${task.description ? `<p style="font-size:13px;color:#475569;margin-top:8px;line-height:1.5">${task.description}</p>` : ''}
        </div>

        <div class="bz-detail-section">
            <div class="bz-detail-section-title">Checklist</div>
            <div class="bz-check-list" id="bz-checklist-${id}">
                <div style="font-size:12px;color:#334155">Caricamento...</div>
            </div>
            <div class="bz-check-add">
                <input id="new-check-input" placeholder="Nuovo elemento..." data-check-enter="${id}">
                <button data-add-check="${id}"><i class="fas fa-plus"></i></button>
            </div>
