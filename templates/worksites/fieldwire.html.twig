/* ══════════ UTILS ══════════ */
function escHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escAttr(s) { return escHtml(s); }

function initials(name) {
    return (name || '?').split(' ').filter(Boolean).map(w => w[0]).join('').toUpperCase().slice(0, 2);
}
function ago(str) {
    if (!str) return '';
    const s = Math.floor((Date.now() - new Date(str)) / 1000);
    if (s < 60) return 'adesso';
    if (s < 3600) return Math.floor(s/60) + 'm fa';
    if (s < 86400) return Math.floor(s/3600) + 'h fa';
    return new Date(str).toLocaleDateString('it-IT', { day:'2-digit', month:'2-digit' });
}
/* Le date arrivano come "2026-11-04" o "2026-11-04 21:52:53". Si legge
   solo il giorno, in ora locale: new Date("2026-11-04") e' mezzanotte UTC,
   che in Italia diventa il giorno prima o sballa i conti del Gantt. */
function giorno(str) {
    const m = String(str || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
    return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
}
function chiaveGiorno(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
function fmtDate(str) {
    const d = giorno(str);
    if (!d) return '';
    const anno = d.getFullYear() !== new Date().getFullYear();
    return d.toLocaleDateString('it-IT', anno ? { day:'2-digit', month:'2-digit', year:'2-digit' } : { day:'2-digit', month:'2-digit' });
}

/* Da quando a quando va un'attivita', per Gantt e calendario.
   Con le date scritte, quelle. Senza: dal giorno in cui e' stata creata a
   oggi (o al giorno in cui e' stata chiusa), segnata come "senza date".
   Prima chi non scriveva le date non vedeva niente nel Gantt e nel
   calendario, cioe' quasi sempre. */
function periodoTask(t) {
    const fatta  = t.status === 'complete' || t.status === 'verified';
    const oggi   = new Date(); oggi.setHours(0, 0, 0, 0);
    const inizio = giorno(t.start_date) || giorno(t.due_date) || giorno(t.created_at) || oggi;
    let fine     = giorno(t.due_date) || giorno(t.start_date);
    const senzaDate = !t.start_date && !t.due_date;
    if (!fine) fine = fatta ? (giorno(t.updated_at) || inizio) : (oggi > inizio ? oggi : inizio);
    if (fine < inizio) fine = inizio;
    // il giorno del calendario: la scadenza, se no l'inizio, se no quando e' nata
    const quando = giorno(t.due_date) || giorno(t.start_date) || giorno(t.created_at) || oggi;
    return { inizio, fine, quando, senzaDate };
}

/* ══════════ REGISTRO PRESENZE ══════════
   Le presenze di BOB in sola lettura, piu' quelle che CSM scrive a mano
   (per ora si registrano cosi'). I giorni a sinistra, chi c'era a destra.
   Il server manda solo nome, azienda e turno: pasti, albergo e costi non
   escono da CSM.                                                          */
let presGiorno = null;

/* Il modulo per registrare a mano una presenza: solo CSM. Una persona
   (nome e azienda) o un'azienda con quante persone ha mandato. */
function formPresenza(data) {
    if (!DA_UFFICIO) return '';
    const oggi = new Date().toISOString().slice(0, 10);
    return `
        <form class="bz-pres-form" id="bz-pres-form">
            <div class="t">Registra presenza</div>
            <div class="r">
                <label>Data<input type="date" name="data" value="${escAttr(data || oggi)}" max="${oggi}" required></label>
                <label>Tipo<select name="tipo">
                    <option value="persona">Persona</option>
                    <option value="azienda">Azienda (numero di persone)</option>
                </select></label>
                <label class="solo-persona">Nome e cognome<input name="nome" maxlength="120" placeholder="Es. Mario Rossi"></label>
                <label>Azienda<input name="azienda" maxlength="120" placeholder="Es. CSM"></label>
                <label class="solo-azienda" hidden>Persone<input type="number" name="persone" min="1" max="500" value="1"></label>
                <label>Turno<select name="mezza">
                    <option value="0">Giornata intera</option>
                    <option value="1">Mezza giornata</option>
                </select></label>
                <button type="submit"><i class="fas fa-plus"></i> Aggiungi</button>
            </div>
        </form>`;
}

document.addEventListener('change', e => {
    const f = e.target.closest('#bz-pres-form');
    if (!f || e.target.name !== 'tipo') return;
    const azienda = e.target.value === 'azienda';
    f.querySelector('.solo-persona').hidden = azienda;
    f.querySelector('.solo-azienda').hidden = !azienda;
});
document.addEventListener('submit', async e => {
    const f = e.target.closest('#bz-pres-form');
    if (!f) return;
    e.preventDefault();
    const v = Object.fromEntries(new FormData(f));
    const persona = v.tipo === 'persona';
    if (persona && !v.nome.trim()) { alert('Inserisci il nome della persona.'); return; }
    if (!persona && !v.azienda.trim()) { alert("Inserisci il nome dell'azienda."); return; }
    const r = await api(`/worksites/${WID}/zone/presenze`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: v.data, nome: persona ? v.nome : '', azienda: v.azienda,
                               persone: persona ? 1 : parseInt(v.persone || '1', 10), mezza: v.mezza === '1' }),
    });
    if (!r.ok) { alert(r.error || 'Impossibile registrare la presenza.'); return; }
    presGiorno = null;               // ricarica anche l'elenco dei giorni
    loadPresenze(v.data);
});
document.addEventListener('click', async e => {
    const b = e.target.closest('[data-pres-elimina]');
    if (!b) return;
    if (!confirm('Eliminare questa presenza?')) return;
    const r = await api(`/worksites/${WID}/zone/presenze/${b.dataset.presElimina}/elimina`, { method: 'POST' });
    if (!r.ok) { alert(r.error || 'Impossibile eliminare la presenza.'); return; }
    const giorno = presGiorno;
    presGiorno = null;
    loadPresenze(giorno);
});

async function loadPresenze(data = null) {
    const corpo = document.getElementById('bz-pres-corpo');
    const colonna = document.getElementById('bz-pres-giorni');

    if (!presGiorno) {
        const g = await api(`/worksites/${WID}/zone/presenze/giorni`);
        const giorni = (g.data || g || []);
        if (!giorni.length) {
            colonna.innerHTML = '';
            corpo.innerHTML = formPresenza(null) + '<div class="bz-empty">Nessuna presenza registrata per questo cantiere.</div>';
            return;
        }
        colonna.innerHTML = giorni.map(x => `
            <button class="bz-pres-g" data-pres-data="${x.data}">
                <span class="d">${fmtDateLunga(x.data)}</span>
                <span class="n">${x.persone}</span>
            </button>
        `).join('');
        // il giorno chiesto, se c'e' ancora nell'elenco
        data = (data && giorni.some(x => x.data === data)) ? data : giorni[0].data;
    }

    presGiorno = data;
    colonna.querySelectorAll('[data-pres-data]').forEach(b =>
        b.classList.toggle('on', b.dataset.presData === presGiorno));

    corpo.innerHTML = '<div class="bz-empty"><i class="fas fa-spinner bz-spin" style="font-size:20px"></i></div>';
    const r = await api(`/worksites/${WID}/zone/presenze?data=${encodeURIComponent(presGiorno)}`);
    if (!r.ok) {
        corpo.innerHTML = `<div class="bz-empty">${escHtml(r.error || 'Impossibile caricare le presenze.')}</div>`;
        return;
    }
    const d = r.data || r;

    const nostri = (d.nostri || []).map(x => `
        <tr>
            <td>${escHtml(x.nome)}</td>
            <td class="az">${escHtml(x.azienda)}</td>
            <td class="tu${x.mezza ? ' mezza' : ''}">${escHtml(x.turno)}</td>
            ${DA_UFFICIO ? `<td class="az">${x.manuale ? `<button class="bz-pres-del" data-pres-elimina="${x.id}" title="Elimina"><i class="fas fa-trash"></i></button>` : ''}</td>` : ''}
        </tr>
    `).join('');

    const cons = (d.consorziate || []).map(x => `
        <tr>
            <td>${escHtml(x.azienda)}</td>
            <td class="tu${x.mezza ? ' mezza' : ''}">${x.persone} ${x.persone === 1 ? 'persona' : 'persone'}${x.mezza ? ' · mezza giornata' : ''}</td>
            ${DA_UFFICIO ? `<td class="az">${x.manuale ? `<button class="bz-pres-del" data-pres-elimina="${x.id}" title="Elimina"><i class="fas fa-trash"></i></button>` : ''}</td>` : ''}
        </tr>
    `).join('');

    corpo.innerHTML = formPresenza(d.data) + `
        <div class="bz-pres-testa">
            <h3>${fmtDateLunga(d.data)}</h3>
            <span>${d.persone} ${d.persone === 1 ? 'persona' : 'persone'} in cantiere</span>
            <span class="gu">${numIt(d.giornate)} ${d.giornate === 1 ? 'giornata uomo' : 'giornate uomo'}</span>
        </div>
        ${d.totali ? `
            <div class="bz-pres-tot">
                <div class="v">
                    <span class="n">${numIt(d.totali.giornate)}</span>
                    <span class="l">giornate uomo dall'inizio</span>
                </div>
                <div class="v">
                    <span class="n">${numIt(d.totali.nostri)}</span>
                    <span class="l">persone</span>
                </div>
                <div class="v">
                    <span class="n">${numIt(d.totali.consorziate)}</span>
                    <span class="l">aziende</span>
                </div>
                ${d.totali.dal ? `<div class="p">dal ${fmtDate(d.totali.dal)} al ${fmtDate(d.totali.al)}</div>` : ''}
            </div>` : ''}
        ${nostri ? `
            <div class="bz-pres-sez">
                <h4>Persone</h4>
                <table class="bz-pres-tab">
                    <thead><tr><th>Nome</th><th>Azienda</th><th>Turno</th>${DA_UFFICIO ? '<th></th>' : ''}</tr></thead>
                    <tbody>${nostri}</tbody>
                </table>
            </div>` : ''}
        ${cons ? `
            <div class="bz-pres-sez">
                <h4>Aziende</h4>
                <table class="bz-pres-tab">
                    <thead><tr><th>Azienda</th><th>Persone</th>${DA_UFFICIO ? '<th></th>' : ''}</tr></thead>
                    <tbody>${cons}</tbody>
                </table>
            </div>` : ''}
        ${!nostri && !cons ? '<div class="bz-empty">Nessuna presenza registrata in questa data.</div>' : ''}
    `;
}

/* 11.5 si scrive 11,5; 348 resta 348 (niente ",0" che non dice niente) */
function numIt(n) {
    return Number(n || 0).toLocaleString('it-IT', { maximumFractionDigits: 1 });
}

function fmtDateLunga(str) {
    if (!str) return '';
    return new Date(str + 'T00:00:00')
        .toLocaleDateString('it-IT', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
}

document.addEventListener('click', e => {
    const g = e.target.closest('[data-pres-data]');
    if (g) loadPresenze(g.dataset.presData);
});

/* ══════════ CHI VEDE COSA: i comandi ══════════ */
// Delegati sul documento: cartelle, disegni e messaggi si ridisegnano a ogni
// caricamento, e un ascoltatore attaccato all'elemento sparirebbe con lui.

/* I nomi scelti in un modulo di creazione: stanno sul bottone finche' non
   si salva, perche' l'oggetto non esiste ancora e non c'e' niente da
   condividere. Vuoto = come prima, la squadra: chi carica una foto non
   deve fermarsi a spuntare nomi. */
function personeDalBottone(idBottone) {
    const b = document.getElementById(idBottone);
    const v = (b?.dataset.persone || '').trim();
    const p = (b?.dataset.parti || '').trim();
    // niente scelto: decide il server (di base tutti)
    if (v === '' && p === '') return {};
    return { persone: v === '' ? [] : JSON.parse(v), parti: p === '' ? [] : JSON.parse(p) };
}

document.addEventListener('click', async e => {
    // il bottone "Chi la vede" di una cosa che esiste gia': si salva da se'
    const chi = e.target.closest('[data-chi-tipo]');
    if (chi) {
        e.stopPropagation();
        apriChi(chi.dataset.chiTipo, parseInt(chi.dataset.chiOggetto), null, null);
        return;
    }

    // lo stesso bottone dentro un modulo di creazione: la scelta resta qui
    const nuovo = e.target.closest('#task-chi');
    if (nuovo) {
        e.stopPropagation();
        const gia  = (nuovo.dataset.persone || '').trim();
        const giaP = (nuovo.dataset.parti || '').trim();
        apriChi('attivita', 0, {
            persone: gia === '' ? [] : JSON.parse(gia),
            parti:   giaP === '' && gia === '' ? null : (giaP === '' ? [] : JSON.parse(giaP)),
        }, (persone, parti) => {
            nuovo.dataset.persone = JSON.stringify(persone);
            nuovo.dataset.parti   = JSON.stringify(parti);
            nuovo.innerHTML = '<i class="fas fa-eye"></i> ' + escHtml(chiTesto({ condivisa_con: persone, condivisa_parti: parti }));
        });
        return;
    }

    if (e.target.closest('#bz-chi-salva'))   { await salvaChi(); return; }
    if (e.target.closest('#bz-chi-annulla')) { chiudiChi();      return; }

    // la parte intera: comprende tutti i nomi di quel gruppo, anche chi
    // entrera' dopo, quindi i nomi si spuntano e si fermano
    const parte = e.target.closest('.bz-chi-parte');
    if (parte) {
        document.querySelectorAll(`#bz-chi-corpo input[data-gruppo="${parte.dataset.parte}"]`)
            .forEach(c => { c.disabled = parte.checked; if (parte.checked) c.checked = true; });
        return;
    }

});

// fuori dal pannello si chiude, come gli altri
document.getElementById('bz-chi-modal').addEventListener('click', e => {
    if (e.target.id === 'bz-chi-modal') chiudiChi();
});

/* ══════════ INIT ══════════ */
// Da fuori dal cantiere non si carica niente: ogni chiamata risponderebbe
// 403, e una pagina piena di errori sembra un guasto invece di un confine.
if (!SOLO_ACCESSI) {
    loadTasks();
    renderCalendar();
    loadBobUsers();
}
/* BZForms init avviene lazy alla prima apertura della vista Moduli
   (forms.js è incluso a fine pagina, dopo questo script). */
</script>

