<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BOB Zone — {{ worksite.name }}</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
/* "hidden" vince sempre: senza, un display:flex di classe lo scavalca */
[hidden] { display: none !important; }
html, body { height: 100%; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; background: #0f172a; color: #e2e8f0; overflow: hidden; }

/* ── Shell ── */
.bz { display: flex; flex-direction: column; height: 100vh; }

/* ── Header ── */
.bz-header { height: 52px; background: #0f172a; border-bottom: 1px solid #1e293b; display: flex; align-items: center; padding: 0 20px; gap: 14px; flex-shrink: 0; }
.bz-back { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: #475569; text-decoration: none; transition: color .15s; }
.bz-back:hover { color: #94a3b8; }
.bz-sep { width: 1px; height: 18px; background: #1e293b; flex-shrink: 0; }
.bz-brand { display: flex; align-items: baseline; gap: 4px; flex-shrink: 0; }
.bz-brand-bob  { font-size: 12px; font-weight: 500; color: #475569; letter-spacing: .04em; }
.bz-brand-zone { font-size: 16px; font-weight: 600; color: #f1f5f9; }
.bz-wname { font-size: 13px; color: #475569; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.bz-header-right { margin-left: auto; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.bz-fw-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 500; color: #4ade80; background: rgba(74,222,128,.06); border: 1px solid rgba(74,222,128,.15); border-radius: 999px; padding: 4px 12px; }
.bz-fw-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1}50%{opacity:.3} }

.bz-fw-btn { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: #64748b; background: #1e293b; border: 1px solid #273548; border-radius: 7px; padding: 5px 12px; cursor: pointer; font-family: inherit; transition: all .15s; }
.bz-fw-btn:hover { color: #94a3b8; border-color: #334155; }

/* ── Toolbar ── */
.bz-toolbar { height: 48px; background: #0f172a; border-bottom: 1px solid #1e293b; display: flex; align-items: center; padding: 0 20px; gap: 12px; flex-shrink: 0; }
.bz-view-switcher { display: flex; background: #1e293b; border-radius: 8px; padding: 3px; gap: 2px; }
.bz-view-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 6px; border: none; background: none; color: #475569; font-size: 12px; font-weight: 500; cursor: pointer; font-family: inherit; transition: all .15s; white-space: nowrap; }
.bz-view-btn i { font-size: 14px; }
.bz-view-btn:hover { color: #94a3b8; }
.bz-view-btn.active { background: #334155; color: #f1f5f9; }

.bz-new-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; background: #4ade80; color: #0f172a; border: none; border-radius: 7px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; transition: opacity .15s; margin-left: auto; }
.bz-new-btn:hover { opacity: .88; }
.bz-new-btn i { font-size: 14px; }

/* ── Main + Sidebar ── */
.bz-main { flex: 1; display: flex; overflow: hidden; }
.bz-sidebar { width: 190px; flex-shrink: 0; background: #0f172a; border-right: 1px solid #1e293b; display: flex; flex-direction: column; padding: 12px 10px; }
.bz-nav { display: flex; flex-direction: column; gap: 2px; }
.bz-nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; border: none; background: none; color: #94a3b8; font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit; text-align: left; text-decoration: none; width: 100%; }
.bz-nav-item i { width: 18px; text-align: center; font-size: 15px; }
.bz-nav-item:hover { background: #1e293b; color: #e2e8f0; }
.bz-nav-item.active { background: #334155; color: #f1f5f9; }
.bz-nav-sep { height: 1px; background: #1e293b; margin: 10px 4px; }
.bz-nav-actions .bz-nav-item { color: #cbd5e1; }
.bz-nav-spacer { flex: 1; }
.bz-nav-fw { padding-top: 10px; border-top: 1px solid #1e293b; }
.bz-nav-fw-btn { color: #4ade80 !important; }
.bz-fw-off { font-size: 11px; color: #475569; padding: 8px 12px; display: block; line-height: 1.4; }

/* ── Body ── */
.bz-body { flex: 1; overflow: hidden; display: flex; }
.bz-view { display: none; flex: 1; overflow: hidden; }
.bz-view.active { display: flex; }
/* Attività: contenitore a colonna con sub-switcher in cima */
#view-attivita.active { flex-direction: column; }
.bz-subswitch { display: flex; gap: 4px; padding: 10px 16px; border-bottom: 1px solid #1e293b; flex-shrink: 0; }
.bz-sub-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: none; background: #1e293b; color: #94a3b8; font-size: 12px; font-weight: 500; border-radius: 7px; cursor: pointer; font-family: inherit; }
.bz-sub-btn:hover { color: #e2e8f0; }
.bz-sub-btn.active { background: #334155; color: #f1f5f9; }
.bz-act-body { flex: 1; display: flex; overflow: hidden; }
.bz-subview { display: none; flex: 1; overflow: hidden; }
.bz-subview.active { display: flex; }
[data-theme="light"] .bz-subswitch { border-color: #e2e8f0; }
[data-theme="light"] .bz-sub-btn { background: #f1f5f9; color: #64748b; }
[data-theme="light"] .bz-sub-btn.active { background: #e0e7ff; color: #1e3a8a; }

/* ══════════════════════════
   KANBAN
══════════════════════════ */
.bz-kanban { display: flex; gap: 12px; padding: 16px 20px; overflow-x: auto; overflow-y: hidden; align-items: flex-start; width: 100%; }
.bz-kanban::-webkit-scrollbar { height: 4px; } .bz-kanban::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }

.bz-col { display: flex; flex-direction: column; min-width: 260px; max-width: 300px; flex: 1; background: #111827; border: 1px solid #1e293b; border-radius: 10px; overflow: hidden; max-height: 100%; }
.bz-col-head { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid #1e293b; flex-shrink: 0; }
.bz-col-label { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .06em; }
.bz-col-dot { width: 8px; height: 8px; border-radius: 50%; }
.dot-open { background: #fbbf24; }
.dot-progress { background: #60a5fa; }
.dot-done { background: #4ade80; }
.dot-verified { background: #a78bfa; }
.bz-col-count { font-size: 11px; color: #334155; background: #1e293b; padding: 1px 7px; border-radius: 999px; }

.bz-cards { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; min-height: 60px; }
.bz-cards::-webkit-scrollbar { width: 3px; } .bz-cards::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

.bz-card { background: #1e293b; border: 1px solid #273548; border-radius: 8px; padding: 12px; cursor: pointer; transition: border-color .15s; }
.bz-card:hover { border-color: #334155; }
.bz-card.active { border-color: #4ade80; }
.bz-card-name { font-size: 13px; font-weight: 500; color: #e2e8f0; line-height: 1.4; margin-bottom: 8px; }
.bz-card-foot { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.bz-card-user { font-size: 11px; color: #475569; display: flex; align-items: center; gap: 3px; }
.bz-card-due  { font-size: 11px; color: #475569; display: flex; align-items: center; gap: 3px; margin-left: auto; }
.bz-card-due.overdue { color: #f87171; }
.bz-card-progress { display: flex; align-items: center; gap: 5px; width: 100%; margin-top: 6px; }
.bz-progress-bar { flex: 1; height: 3px; background: #273548; border-radius: 2px; overflow: hidden; }
.bz-progress-fill { height: 100%; background: #4ade80; border-radius: 2px; transition: width .3s; }
.bz-progress-text { font-size: 10px; color: #334155; white-space: nowrap; }

.bz-col-add { padding: 8px 10px; border-top: 1px solid #1e293b; flex-shrink: 0; }
.bz-col-add-btn { width: 100%; display: flex; align-items: center; gap: 6px; background: none; border: 1px dashed #1e293b; border-radius: 6px; padding: 7px 10px; color: #334155; font-size: 12px; cursor: pointer; font-family: inherit; transition: all .15s; }
.bz-col-add-btn:hover { border-color: #273548; color: #475569; }

/* ══════════════════════════
   GANTT
══════════════════════════ */
.bz-gantt { display: flex; flex-direction: column; flex: 1; overflow: hidden; background: #111827; }
.bz-gantt-wrap { flex: 1; overflow: auto; padding: 16px 20px; }
.bz-gantt-table { width: 100%; border-collapse: collapse; min-width: 800px; }
.bz-gantt-table th { font-size: 10px; font-weight: 600; color: #334155; text-transform: uppercase; letter-spacing: .06em; padding: 6px 8px; border-bottom: 1px solid #1e293b; white-space: nowrap; }
.bz-gantt-table td { padding: 6px 8px; border-bottom: 1px solid #1a2438; vertical-align: middle; }
.bz-gantt-name { font-size: 12px; font-weight: 500; color: #94a3b8; min-width: 180px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bz-gantt-timeline { position: relative; height: 28px; }
.bz-gantt-bar { position: absolute; height: 20px; top: 4px; border-radius: 4px; opacity: .85; display: flex; align-items: center; padding: 0 6px; font-size: 10px; font-weight: 600; color: #0f172a; overflow: hidden; white-space: nowrap; min-width: 6px; }
.bz-gantt-empty { text-align: center; padding: 40px; font-size: 13px; color: #334155; }

/* ══════════════════════════
   CALENDAR
══════════════════════════ */
.bz-calendar { display: flex; flex-direction: column; flex: 1; overflow: hidden; background: #111827; padding: 16px 20px; }
.bz-cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-shrink: 0; }
.bz-cal-title { font-size: 15px; font-weight: 600; color: #e2e8f0; }
.bz-cal-nav { display: flex; gap: 6px; }
.bz-cal-nav button { background: #1e293b; border: 1px solid #273548; color: #64748b; border-radius: 6px; padding: 5px 10px; cursor: pointer; font-family: inherit; font-size: 13px; transition: all .15s; }
.bz-cal-nav button:hover { color: #e2e8f0; }
.bz-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; flex: 1; overflow: hidden; }
.bz-cal-day-name { font-size: 10px; font-weight: 700; color: #334155; text-transform: uppercase; text-align: center; padding: 4px; letter-spacing: .06em; }
.bz-cal-day { background: #1a2438; border-radius: 6px; padding: 6px; overflow: hidden; cursor: default; min-height: 80px; }
.bz-cal-day.today { background: #1e293b; border: 1px solid #273548; }
.bz-cal-day.other-month { opacity: .35; }
.bz-cal-day-num { font-size: 11px; font-weight: 600; color: #475569; margin-bottom: 4px; }
.bz-cal-day.today .bz-cal-day-num { color: #4ade80; }
.bz-cal-event { font-size: 10px; font-weight: 500; padding: 2px 5px; border-radius: 3px; margin-bottom: 2px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; cursor: pointer; }
.bz-cal-event.open { background: rgba(251,191,36,.15); color: #fbbf24; }
.bz-cal-event.in_progress { background: rgba(96,165,250,.15); color: #60a5fa; }
.bz-cal-event.complete { background: rgba(74,222,128,.15); color: #4ade80; }

/* ══════════════════════════
   DETAIL PANEL (right side)
══════════════════════════ */
.bz-detail-wrap { width: 420px; flex-shrink: 0; background: #111827; border-left: 1px solid #1e293b; display: flex; flex-direction: column; overflow: hidden; transition: width .2s; }
.bz-detail-wrap.closed { width: 0; border-left: none; overflow: hidden; }

.bz-detail-topbar { padding: 12px 16px; border-bottom: 1px solid #1e293b; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
.bz-detail-close { background: none; border: none; color: #475569; cursor: pointer; font-size: 20px; padding: 2px; transition: color .15s; }
.bz-detail-close:hover { color: #94a3b8; }

.bz-detail-inner { flex: 1; overflow-y: auto; }
.bz-detail-inner::-webkit-scrollbar { width: 3px; } .bz-detail-inner::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

.bz-detail-section { padding: 14px 16px; border-bottom: 1px solid #1a2438; }
.bz-detail-section-title { font-size: 10px; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 10px; }

.bz-detail-title-input { width: 100%; background: none; border: none; color: #f1f5f9; font-size: 15px; font-weight: 600; font-family: inherit; outline: none; line-height: 1.4; }

.bz-status-row { display: flex; flex-wrap: wrap; gap: 6px; }
.bz-status-opt { padding: 5px 12px; border-radius: 999px; border: 1px solid transparent; font-size: 11px; font-weight: 600; cursor: pointer; font-family: inherit; transition: all .15s; }
.bz-status-opt.open     { background: rgba(251,191,36,.1);  color: #fbbf24; border-color: rgba(251,191,36,.2); }
.bz-status-opt.in_progress { background: rgba(96,165,250,.1); color: #60a5fa; border-color: rgba(96,165,250,.2); }
.bz-status-opt.complete  { background: rgba(74,222,128,.1); color: #4ade80; border-color: rgba(74,222,128,.2); }
.bz-status-opt.verified  { background: rgba(167,139,250,.1); color: #a78bfa; border-color: rgba(167,139,250,.2); }
.bz-task-action-btn { background:#1e293b; color:#cbd5e1; border:1px solid #334155; border-radius:6px; padding:6px 12px; font-size:12px; cursor:pointer; font-family:inherit; }
.bz-task-action-btn.danger { color:#fca5a5; border-color:#471515; }
.bz-card-luogo { font-size:11.5px; color:#94a3b8; margin-top:4px; }
.bz-card-user { color:#94a3b8; }
[data-theme="light"] .bz-card-user { color:#64748b; }
.bz-card-prio { display:inline-flex; align-items:center; gap:4px; font-size:10.5px; font-weight:700; margin-top:5px; margin-right:8px; }
.bz-card-prio.alta { color:#fbbf24; } .bz-card-prio.urgente { color:#f87171; }
[data-theme="light"] .bz-card-luogo { color:#64748b; }
[data-theme="light"] .bz-card-prio.alta { color:#b45309; } [data-theme="light"] .bz-card-prio.urgente { color:#b91c1c; }
.bz-gantt-bar.stimata { opacity:.55; background-image:repeating-linear-gradient(45deg, rgba(255,255,255,.25) 0 6px, transparent 6px 12px) !important; }
.bz-gantt-scala { position:relative; height:16px; }
.bz-gantt-scala span { position:absolute; transform:translateX(-50%); font-size:10px; font-weight:600; color:#94a3b8; white-space:nowrap; }
[data-theme="light"] .bz-gantt-scala span { color:#64748b; }
.bz-gantt-nd { font-style:normal; font-size:10px; color:#94a3b8; margin-left:4px; }
.bz-gantt-timeline { position:relative; }
.bz-gantt-oggi { position:absolute; top:0; bottom:0; width:2px; background:#ef4444; opacity:.6; z-index:1; }
.bz-cal-event.stimata { outline:1px dashed currentColor; outline-offset:-1px; }
.bz-cal-event.verified { background: rgba(167,139,250,.15); color: #a78bfa; }
.bz-cal-day-name { color:#94a3b8; }
.bz-cal-day-num { color:#94a3b8; }
.bz-cal-altri { font-size:10px; color:#94a3b8; }
.bz-gantt-name { color:#cbd5e1; }
[data-theme="light"] .bz-cal-nav button { background:#fff; border-color:#e2e8f0; color:#334155; }
[data-theme="light"] .bz-cal-nav button:hover { color:#0f172a; border-color:#cbd5e1; }
[data-theme="light"] .bz-cal-day-name, [data-theme="light"] .bz-cal-day-num, [data-theme="light"] .bz-cal-altri { color:#64748b; }
[data-theme="light"] .bz-cal-day.today .bz-cal-day-num { color:#1e40af; }
[data-theme="light"] .bz-cal-event.open        { background:#fef3c7; color:#92400e; }
[data-theme="light"] .bz-cal-event.in_progress { background:#dbeafe; color:#1e40af; }
[data-theme="light"] .bz-cal-event.complete    { background:#dcfce7; color:#166534; }
[data-theme="light"] .bz-cal-event.verified    { background:#ede9fe; color:#5b21b6; }
[data-theme="light"] .bz-gantt-name { color:#1e293b; }
[data-theme="light"] .bz-gantt-nd { color:#64748b; }

/* ── Gantt ── */
.bz-gantt-wrap { padding: 0 !important; }
.bzg { display:flex; height:100%; min-height:0; font-size:12px; }
.bzg-sx { padding-bottom:20px; flex:0 0 250px; border-right:1px solid #1e293b; overflow:hidden; background:#0f172a; z-index:2; }
.bzg-sx-testa { position:sticky; top:0; z-index:1; background:inherit; height:52px; display:flex; align-items:flex-end; padding:0 14px 8px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#94a3b8; border-bottom:1px solid #1e293b; }
.bzg-sx-riga { box-sizing:border-box; height:40px; display:grid; grid-template-columns:10px 1fr; grid-template-rows:auto auto; column-gap:8px; align-content:center; padding:0 14px; border-bottom:1px solid #16202f; cursor:pointer; }
.bzg-sx-riga:hover { background:#16202f; }
.bzg-pallino { grid-row:1 / span 2; width:8px; height:8px; border-radius:50%; align-self:center; }
.bzg-nome { color:#e2e8f0; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.bzg-chi { color:#94a3b8; font-size:10.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.bzg-dx { flex:1; overflow:auto; position:relative; }
.bzg-tela { position:relative; }
.bzg-testa { position:sticky; top:0; z-index:3; height:52px; background:#0f172a; border-bottom:1px solid #1e293b; }
.bzg-mesi, .bzg-giorni { position:relative; height:26px; }
.bzg-mesi div { position:absolute; top:0; height:26px; line-height:26px; padding-left:8px; font-size:11px; font-weight:700; color:#cbd5e1; text-transform:capitalize; border-left:1px solid #1e293b; white-space:nowrap; overflow:hidden; }
.bzg-giorni div { position:absolute; top:0; height:26px; text-align:center; font-size:11px; font-weight:600; color:#94a3b8; line-height:12px; padding-top:1px; }
.bzg-giorni small { display:block; font-size:8.5px; font-weight:500; opacity:.75; }
.bzg-giorni div.fest { color:#64748b; }
.bzg-giorni div.oggi { color:#fff; background:#ef4444; border-radius:6px; }
.bzg-corpo { position:relative; margin-bottom:20px; }
.bzg-fest { position:absolute; top:0; bottom:0; background:rgba(148,163,184,.06); }
.bzg-riga { position:absolute; left:0; right:0; height:40px; border-bottom:1px solid #16202f; }
.bzg-oggi { position:absolute; top:0; bottom:0; width:2px; margin-left:-1px; background:#ef4444; z-index:1; }
.bzg-barra { position:absolute; height:24px; border-radius:7px; background:var(--c); color:#0f172a; cursor:pointer; z-index:2;
             display:flex; align-items:center; padding:0 9px; font-size:11px; font-weight:700; overflow:hidden; white-space:nowrap;
             box-shadow:0 1px 2px rgba(0,0,0,.25); transition:transform .1s, box-shadow .1s; }
.bzg-barra span { overflow:hidden; text-overflow:ellipsis; }
.bzg-barra:hover { transform:translateY(-1px); box-shadow:0 4px 10px rgba(0,0,0,.3); }
.bzg-barra.stimata { background:repeating-linear-gradient(135deg, var(--c) 0 8px, color-mix(in srgb, var(--c) 55%, transparent) 8px 16px); }
.bzg-barra.complete span, .bzg-barra.verified span { text-decoration:none; }
.bzg-etichetta { position:absolute; font-size:11px; color:#cbd5e1; white-space:nowrap; pointer-events:none; z-index:2; }
[data-theme="light"] .bzg-sx, [data-theme="light"] .bzg-testa { background:#fff; border-color:#e2e8f0; }
[data-theme="light"] .bzg-sx-testa { color:#64748b; border-color:#e2e8f0; }
[data-theme="light"] .bzg-sx-riga, [data-theme="light"] .bzg-riga { border-color:#f1f5f9; }
[data-theme="light"] .bzg-sx-riga:hover { background:#f8fafc; }
[data-theme="light"] .bzg-nome { color:#0f172a; }
[data-theme="light"] .bzg-chi, [data-theme="light"] .bzg-giorni div { color:#64748b; }
[data-theme="light"] .bzg-giorni div.fest { color:#94a3b8; }
[data-theme="light"] .bzg-giorni div.oggi { color:#fff; }
[data-theme="light"] .bzg-mesi div { color:#1e293b; border-color:#e2e8f0; }
[data-theme="light"] .bzg-fest { background:#f8fafc; }
[data-theme="light"] .bzg-etichetta { color:#334155; }
[data-theme="light"] .bzg-barra { box-shadow:0 1px 2px rgba(15,23,42,.12); }
[data-theme="light"] .bz-gantt { background:#fff; }

.bz-dati { display:grid; grid-template-columns:auto 1fr; gap:6px 12px; margin:0; font-size:12.5px; }
.bz-dati dt { color:#94a3b8; white-space:nowrap; } .bz-dati dt i { width:14px; text-align:center; margin-right:4px; }
.bz-dati dd { margin:0; color:#e2e8f0; } .bz-dati dd.alta { color:#fbbf24; font-weight:600; } .bz-dati dd.urgente { color:#f87171; font-weight:600; }
.bz-link { background:none; border:0; padding:0; color:#60a5fa; cursor:pointer; font:inherit; text-align:left; text-decoration:underline; }
[data-theme="light"] .bz-link { color:#1d4ed8; }
.bz-dati-desc { font-size:13px; color:#cbd5e1; margin-top:10px; line-height:1.5; white-space:pre-line; }
.bz-foto-striscia { display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; }
.bz-foto-striscia a { flex:0 0 auto; width:76px; height:76px; border-radius:8px; overflow:hidden; border:1px solid #334155; }
.bz-foto-striscia img { width:100%; height:100%; object-fit:cover; display:block; }
[data-theme="light"] .bz-dati dt { color:#64748b; } [data-theme="light"] .bz-dati dd { color:#1e293b; }
[data-theme="light"] .bz-dati dd.alta { color:#b45309; } [data-theme="light"] .bz-dati dd.urgente { color:#b91c1c; }
[data-theme="light"] .bz-dati-desc { color:#334155; } [data-theme="light"] .bz-foto-striscia a { border-color:#e2e8f0; }
.bz-comment-del { background:transparent; color:#94a3b8; border:0; cursor:pointer; font-size:15px; padding:0 4px; margin-left:auto; line-height:1; }
.bz-comment-del:hover { color:#f87171; }
[data-theme="light"] .bz-task-action-btn { background:#f8fafc; color:#334155; border-color:#e2e8f0; }
[data-theme="light"] .bz-task-action-btn.danger { color:#b91c1c; border-color:#fecaca; }
[data-theme="light"] .bz-status-opt.open        { background:#fef3c7; color:#b45309; border-color:#fde68a; }
[data-theme="light"] .bz-status-opt.in_progress { background:#dbeafe; color:#1d4ed8; border-color:#bfdbfe; }
[data-theme="light"] .bz-status-opt.complete    { background:#dcfce7; color:#15803d; border-color:#bbf7d0; }
[data-theme="light"] .bz-status-opt.verified    { background:#ede9fe; color:#6d28d9; border-color:#ddd6fe; }
.bz-status-opt.selected  { opacity: 1; } .bz-status-opt:not(.selected) { opacity: .4; }

.bz-check-list { display: flex; flex-direction: column; gap: 6px; }
.bz-check-row { display: flex; align-items: flex-start; gap: 8px; }
.bz-check-row input { width: 14px; height: 14px; margin-top: 2px; accent-color: #4ade80; cursor: pointer; flex-shrink: 0; }
.bz-check-row label { font-size: 13px; color: #94a3b8; cursor: pointer; line-height: 1.4; flex: 1; }
.bz-check-row label.done { text-decoration: line-through; color: #334155; }
.bz-check-add { display: flex; gap: 6px; margin-top: 8px; }
.bz-check-add input { flex: 1; background: #1e293b; border: 1px solid #273548; border-radius: 6px; padding: 6px 10px; font-size: 12px; color: #e2e8f0; font-family: inherit; outline: none; }
.bz-check-add button { background: #1e293b; border: 1px solid #273548; border-radius: 6px; padding: 6px 10px; color: #4ade80; cursor: pointer; font-size: 13px; }
[data-theme="light"] .bz-check-add button { background:#f0fdf4; border-color:#bbf7d0; color:#15803d; }

.bz-comments { display: flex; flex-direction: column; gap: 12px; }
.bz-comment { display: flex; gap: 8px; align-items: flex-start; }
.bz-comment-avatar { width: 26px; height: 26px; border-radius: 50%; background: #1e293b; color: #64748b; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.bz-comment-body { flex: 1; min-width: 0; }
.bz-comment-meta { display: flex; align-items: baseline; gap: 6px; margin-bottom: 3px; }
.bz-comment-author { font-size: 11px; font-weight: 600; color: #94a3b8; }
.bz-comment-time   { font-size: 10px; color: #334155; }
.bz-comment-text   { font-size: 13px; color: #64748b; line-height: 1.5; word-break: break-word; }

.bz-comment-input-wrap { padding: 12px 16px; border-top: 1px solid #1e293b; display: flex; gap: 8px; flex-shrink: 0; }
.bz-comment-input { flex: 1; background: #1e293b; border: 1px solid #273548; border-radius: 8px; padding: 8px 12px; font-size: 13px; color: #e2e8f0; font-family: inherit; resize: none; outline: none; transition: border-color .15s; }
.bz-comment-input::placeholder { color: #334155; }
.bz-comment-input:focus { border-color: #334155; }
.bz-comment-send { background: none; border: none; color: #4ade80; font-size: 20px; cursor: pointer; padding: 4px; transition: opacity .15s; display: flex; align-items: center; }
.bz-comment-send:hover { opacity: .7; }

/* ══════════════════════════
   MODAL: New task
══════════════════════════ */
.bz-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; z-index: 100; }
.bz-overlay.hidden { display: none; }
.bz-modal { background: #fff; border-radius: 14px; padding: 28px; width: 460px; max-width: 95vw; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
.bz-modal h3 { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 20px; }
.bz-modal-field { margin-bottom: 14px; }
.bz-modal-field label { display: block; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px; }
.bz-modal-field input,
.bz-modal-field select,
.bz-modal-field textarea { width: 100%; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 9px 12px; font-size: 13px; color: #1e293b; font-family: inherit; outline: none; transition: border-color .15s; }
.bz-modal-field input:focus,
.bz-modal-field select:focus,
.bz-modal-field textarea:focus { border-color: #94a3b8; background: #fff; }
.bz-modal-field textarea { resize: vertical; min-height: 80px; }
.bz-modal-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width:560px) { .bz-modal-row { grid-template-columns: 1fr; } }
.bz-task-form { width: 560px; max-height: 92vh; overflow-y: auto; }
.bz-task-punto { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; align-items:center; }
.bz-task-punto select { flex:1 1 140px; min-width:0; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:6px 8px; font-size:12px; color:#1e293b; }
.bz-task-punto button#task-punto-scegli { background:#eff6ff; border:1px solid #bfdbfe; color:#1d4ed8; border-radius:8px; padding:6px 10px; font-size:12px; font-weight:600; cursor:pointer; white-space:nowrap; }
#task-punto-scelto { flex-basis:100%; font-size:12px; color:#1d4ed8; }
#task-punto-scelto button { background:none; border:0; color:#94a3b8; cursor:pointer; font-size:15px; }
.bz-task-sez { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #1e40af; margin: 18px 0 8px; padding-top: 12px; border-top: 1px solid #e2e8f0; }
.bz-task-sez span { text-transform: none; letter-spacing: 0; font-weight: 400; color: #64748b; margin-left: 6px; }
.bz-task-passi { list-style: none; margin: 0 0 6px; padding: 0; }
.bz-task-passi li { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 5px; font-size: 13px; color: #1e293b; }
.bz-task-passi li span { flex: 1; }
.bz-task-passi li i { color: #94a3b8; }
.bz-task-passi button, .bz-task-foto-mini button { background: none; border: 0; color: #94a3b8; font-size: 16px; cursor: pointer; line-height: 1; }
.bz-task-passi button:hover, .bz-task-foto-mini button:hover { color: #dc2626; }
.bz-task-passo-nuovo { display: flex; gap: 6px; }
.bz-task-passo-nuovo input { flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 11px; font-size: 13px; color: #1e293b; font-family: inherit; outline: none; }
.bz-task-passo-nuovo button { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; border-radius: 8px; padding: 0 12px; cursor: pointer; }
.bz-task-foto { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
.bz-task-foto-mini { position: relative; width: 72px; height: 72px; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0; }
.bz-task-foto-mini img { width: 100%; height: 100%; object-fit: cover; }
.bz-task-foto-mini button { position: absolute; top: 2px; right: 2px; background: rgba(255,255,255,.9); border-radius: 50%; width: 20px; height: 20px; font-size: 14px; }
.bz-task-foto-add { display: inline-flex; align-items: center; gap: 7px; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 8px 12px; font-size: 13px; color: #334155; cursor: pointer; }
.bz-task-foto-add:hover { border-color: #1e40af; color: #1e40af; }
.bz-modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
.bz-modal-cancel { background: #f1f5f9; border: none; border-radius: 8px; padding: 9px 18px; color: #64748b; font-size: 13px; cursor: pointer; font-family: inherit; font-weight: 500; }
.bz-modal-cancel:hover { background: #e2e8f0; }
.bz-modal-submit { background: #0f172a; border: none; border-radius: 8px; padding: 9px 22px; color: #4ade80; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
.bz-modal-submit:hover { background: #1e293b; }

/* ── Misc ── */
.bz-empty { padding: 40px; text-align: center; font-size: 13px; color: #334155; width: 100%; }
@keyframes spin { to { transform: rotate(360deg); } }
.bz-spin { animation: spin .8s linear infinite; display: inline-block; }
.pill { display: inline-flex; align-items: center; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 999px; }
.pill-open { background: rgba(251,191,36,.12); color: #fbbf24; }
.pill-progress { background: rgba(96,165,250,.12); color: #60a5fa; }
.pill-done { background: rgba(74,222,128,.12); color: #4ade80; }
.pill-verified { background: rgba(167,139,250,.12); color: #a78bfa; }

/* ══════════════════════════
   TEMA CHIARO (override: il dark è il default)
══════════════════════════ */
[data-theme="light"] body { background: #f1f5f9; color: #1e293b; }
[data-theme="light"] .bz-header,
[data-theme="light"] .bz-sidebar { background: #ffffff; border-color: #e2e8f0; }
[data-theme="light"] .bz-header { border-bottom-color: #e2e8f0; }
[data-theme="light"] .bz-sidebar { border-right-color: #e2e8f0; }
[data-theme="light"] .bz-sep, [data-theme="light"] .bz-nav-sep,
[data-theme="light"] .bz-nav-fw { background: #e2e8f0; border-color: #e2e8f0; }
[data-theme="light"] .bz-brand-zone { color: #0f172a; }
[data-theme="light"] .bz-brand-bob, [data-theme="light"] .bz-wname,
[data-theme="light"] .bz-back { color: #64748b; }
[data-theme="light"] .bz-nav-item { color: #475569; }
[data-theme="light"] .bz-nav-item:hover { background: #f1f5f9; color: #0f172a; }
[data-theme="light"] .bz-nav-item.active { background: #e0e7ff; color: #1e3a8a; }
[data-theme="light"] .bz-nav-actions .bz-nav-item { color: #334155; }
[data-theme="light"] .bz-info { background: #f8fafc; border-color: #e2e8f0; }
[data-theme="light"] .bz-info-title { color: #94a3b8; }
[data-theme="light"] .bz-info-row { color: #475569; }
[data-theme="light"] .bz-col, [data-theme="light"] .bz-gantt,
[data-theme="light"] .bz-calendar, [data-theme="light"] .bz-detail-wrap { background: #ffffff; border-color: #e2e8f0; }
[data-theme="light"] .bz-col-head, [data-theme="light"] .bz-detail-topbar,
[data-theme="light"] .bz-detail-section, [data-theme="light"] .bz-col-add { border-color: #e2e8f0; }
[data-theme="light"] .bz-card { background: #f8fafc; border-color: #e2e8f0; }
[data-theme="light"] .bz-card:hover { border-color: #cbd5e1; }
[data-theme="light"] .bz-card-name { color: #1e293b; }
[data-theme="light"] .bz-detail-title-input { color: #0f172a; }
[data-theme="light"] .bz-check-row label { color: #334155; }
[data-theme="light"] .bz-cal-day { background: #f1f5f9; }
[data-theme="light"] .bz-cal-day.today { background: #e0e7ff; border-color: #c7d2fe; }
[data-theme="light"] .bz-cal-title { color: #1e293b; }
[data-theme="light"] .bz-kanban-filters { border-color: #e2e8f0; }
[data-theme="light"] .bz-kanban-filters input,
[data-theme="light"] .bz-kanban-filters select,
[data-theme="light"] .bz-check-add input,
[data-theme="light"] .bz-comment-input { background: #ffffff; border-color: #e2e8f0; color: #1e293b; }
[data-theme="light"] .bz-comment-photo { background: #f1f5f9; border-color: #e2e8f0; color: #64748b; }
[data-theme="light"] .bz-col-count { background: #f1f5f9; color: #64748b; }
[data-theme="light"] .bz-comment-input-wrap { border-color: #e2e8f0; }

/* Theme toggle button */
.bz-theme-toggle { background: none; border: 1px solid #273548; color: #94a3b8; width: 32px; height: 32px; border-radius: 7px; cursor: pointer; font-size: 14px; }
.bz-theme-toggle:hover { color: #e2e8f0; }
/* campanello delle notifiche del cantiere */
.bz-avvisi { position: relative; }
.bz-avvisi-btn { position: relative; }
.bz-avvisi-n { position: absolute; top: -6px; right: -6px; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 9px;
               background: #ef4444; color: #fff; font-size: 10.5px; font-weight: 700; line-height: 17px; text-align: center; }
.bz-avvisi-panel { position: absolute; right: 0; top: 40px; width: 360px; max-width: calc(100vw - 24px); max-height: 70vh;
                   display: flex; flex-direction: column; background: #0f172a; border: 1px solid #273548; border-radius: 12px;
                   box-shadow: 0 16px 40px rgba(0,0,0,.45); z-index: 300; overflow: hidden; }
.bz-avvisi-panel[hidden] { display: none; }
.bz-avvisi-testa { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px; border-bottom: 1px solid #1e293b;
                   font-size: 13px; font-weight: 700; color: #e2e8f0; }
.bz-avvisi-testa button { background: none; border: 0; color: #60a5fa; font-size: 12px; cursor: pointer; }
.bz-avvisi-lista { overflow-y: auto; }
.bz-avviso { display: flex; gap: 10px; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid #16202f;
             padding: 11px 14px; cursor: pointer; color: #94a3b8; }
.bz-avviso:hover { background: #111c2e; }
.bz-avviso > i { margin-top: 2px; width: 16px; color: #64748b; }
.bz-avviso.nuovo { background: rgba(37, 99, 235, .08); }
.bz-avviso.nuovo > i { color: #60a5fa; }
.bz-avviso .c { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.bz-avviso .t { font-size: 13px; font-weight: 600; color: #e2e8f0; }
.bz-avviso .m { font-size: 12.5px; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.bz-avviso .q { font-size: 11px; color: #64748b; }
.bz-avvisi-vuoto { padding: 22px 14px; text-align: center; font-size: 13px; color: #64748b; }
[data-theme="light"] .bz-avvisi-panel { background: #fff; border-color: #e2e8f0; box-shadow: 0 16px 40px rgba(15,23,42,.15); }
[data-theme="light"] .bz-avvisi-testa { color: #1e293b; border-bottom-color: #e2e8f0; }
[data-theme="light"] .bz-avviso { border-bottom-color: #f1f5f9; color: #475569; }
[data-theme="light"] .bz-avviso:hover { background: #f8fafc; }
[data-theme="light"] .bz-avviso .t { color: #1e293b; }
[data-theme="light"] .bz-avviso.nuovo { background: #eff6ff; }
[data-theme="light"] .bz-theme-toggle { border-color: #e2e8f0; color: #64748b; }

/* Info cantiere (sidebar) */
.bz-info { margin-top: 12px; padding: 10px; background: #111827; border: 1px solid #1e293b; border-radius: 8px; }
.bz-info-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #475569; margin-bottom: 8px; }
.bz-info-row { display: flex; align-items: center; gap: 7px; font-size: 11px; color: #94a3b8; margin-bottom: 5px; line-height: 1.3; }
.bz-info-row i { width: 13px; text-align: center; color: #64748b; flex-shrink: 0; }
.bz-info-counts { display: flex; flex-direction: column; gap: 3px; margin-top: 8px; padding-top: 8px; border-top: 1px solid #1e293b; font-size: 11px; color: #94a3b8; }
</style>
<script nonce="{{ cspNonce }}">
/* applica il tema PRIMA del render per evitare il flash */
(function () {
    var pref = localStorage.getItem('bzTheme') || 'system';
    var light = pref === 'light' || (pref === 'system' && window.matchMedia &&
                window.matchMedia('(prefers-color-scheme: light)').matches);
    document.documentElement.setAttribute('data-theme', light ? 'light' : 'dark');
})();
</script>
</head>
<body>
<div class="bz">

    {# ── Header (sottile) ── #}
    <header class="bz-header">
        {# la scheda cantiere e' dell'ufficio: cliente e squadra tornano ai
           loro cantieri (prima il link portava a una pagina vietata) #}
        {% if daUfficio %}
        <a href="/worksites/{{ worksite_id }}" class="bz-back"><i class="fas fa-arrow-left"></i> Cantiere</a>
        {% else %}
        <a href="/worksites/my" class="bz-back"><i class="fas fa-arrow-left"></i> I miei cantieri</a>
        {% endif %}
        <div class="bz-sep"></div>
        <div class="bz-brand">
            <span class="bz-brand-bob">BOB</span>
            <span class="bz-brand-zone">Zone</span>
        </div>
        <div class="bz-sep"></div>
        <span class="bz-wname">{{ worksite.worksite_code ? '[' ~ worksite.worksite_code ~ '] ' : '' }}{{ worksite.name }}</span>
        {# Il cliente da' al cantiere il suo nome e il suo codice commessa #}
        <button type="button" class="bz-rif" id="bz-rif" hidden title="Il tuo nome e il tuo codice per questo cantiere"></button>
        <div class="bz-header-right">
            {% if not soloAccessi %}
            {# Le novita' di questo cantiere: gli stessi avvisi del campanello
               di BOB e dell'app, filtrati sul cantiere #}
            <div class="bz-avvisi">
                <button class="bz-theme-toggle bz-avvisi-btn" id="bz-avvisi-btn" title="Notifiche del cantiere">
                    <i class="fas fa-bell"></i><span class="bz-avvisi-n" id="bz-avvisi-n" hidden></span>
                </button>
                <div class="bz-avvisi-panel" id="bz-avvisi-panel" hidden>
                    <div class="bz-avvisi-testa">
                        <span>Notifiche del cantiere</span>
                        <button type="button" id="bz-avvisi-tutte">Segna tutte come lette</button>
                    </div>
                    <div class="bz-avvisi-lista" id="bz-avvisi-lista"></div>
                </div>
            </div>
            {% endif %}
            <button class="bz-theme-toggle" id="bz-theme-toggle" title="Tema">
                <i class="fas fa-circle-half-stroke"></i>
            </button>
        </div>
    </header>

    {# ── Main: sidebar + body ── #}
    <div class="bz-main">

        {# Side menu #}
        <aside class="bz-sidebar">
            <nav class="bz-nav">
                {# Chi non ha accesso a una sezione non se la vede nemmeno:
                   lasciare la voce e farla rispondere 403 sembra un guasto,
                   e chi la trova continua a cliccarci. #}
                {% if accessi.attivita > 0 %}<button class="bz-nav-item active" data-view="attivita"><i class="fas fa-list-check"></i><span>Attività</span><span class="bzd-badge" id="bz-badge-attivita" hidden></span></button>{% endif %}
                {% if accessi.disegni  > 0 %}<button class="bz-nav-item" data-view="disegni"><i class="fas fa-drafting-compass"></i><span>Disegni</span><span class="bzd-badge" id="bz-badge-disegni" hidden></span></button>{% endif %}
                {% if accessi.foto     > 0 %}<button class="bz-nav-item" data-view="media"><i class="fas fa-images"></i><span>Foto</span></button>{% endif %}
                {% if accessi.file     > 0 %}<button class="bz-nav-item" data-view="files"><i class="fas fa-folder-open"></i><span>File</span><span class="bzd-badge" id="bz-badge-files" hidden></span></button>{% endif %}
                {% if accessi.moduli   > 0 %}<button class="bz-nav-item" data-view="forms"><i class="fas fa-clipboard-list"></i><span>Moduli</span><span class="bzd-badge" id="bz-badge-forms" hidden></span></button>{% endif %}
                {# presenze, chat e segnalazioni: chiunque entri nel cantiere;
                   cosa legge lo decide il server #}
                {% if not soloAccessi %}
                <button class="bz-nav-item" data-view="presenze"><i class="fas fa-user-check"></i><span>Presenze</span></button>
                <button class="bz-nav-item" data-view="segnalazioni"><i class="fas fa-triangle-exclamation"></i><span>Segnalazioni</span><span class="bzd-badge" id="bzd-badge-segn" hidden></span></button>
                <button class="bz-nav-item" data-view="chat"><i class="fas fa-comments"></i><span>Chat</span><span class="bzd-badge" id="bzd-badge-chat" hidden></span></button>
                {% endif %}
            </nav>
            <div class="bz-nav-sep"></div>
            <div class="bz-nav-actions">
                {% if accessi.attivita > 1 %}<button class="bz-nav-item" id="btn-new-task"><i class="fas fa-plus"></i><span>Nuova attività</span></button>{% endif %}
                {# Il rapporto di un periodo: cosa e' stato fatto, cosa resta,
                   segnalazioni, presenze e moduli. Si sceglie il periodo. #}
                {% if accessi.report   > 0 %}
                <details class="bz-rapporto">
                    <summary class="bz-nav-item"><i class="fas fa-file-pdf"></i><span>Riepilogo lavori</span></summary>
                    <p class="bz-rapporto-spiega">Documento riepilogativo da scaricare o inviare: lavori eseguiti
                        (con foto), lavori da eseguire, segnalazioni, presenze e moduli. Include solo i contenuti visibili al tuo profilo.</p>
                    <a href="/worksites/{{ worksite_id }}/zone/report?periodo=7" target="_blank">Ultima settimana</a>
                    <a href="/worksites/{{ worksite_id }}/zone/report?periodo=30" target="_blank">Ultimi 30 giorni</a>
                    <a href="/worksites/{{ worksite_id }}/zone/report?periodo=tutto" target="_blank">Dall'inizio</a>
                </details>
                {% endif %}
                {% if puoGestire %}<button class="bz-nav-item" id="btn-accessi"><i class="fas fa-user-shield"></i><span>Chi accede</span></button>{% endif %}
            </div>

            {# ── Info cantiere ── #}
            <div class="bz-info">
                <div class="bz-info-title">Cantiere</div>
                {% if clientName %}<div class="bz-info-row"><i class="fas fa-user-tie"></i><span>{{ clientName }}</span></div>{% endif %}
                <div class="bz-info-row" id="bz-rif-info" hidden><i class="fas fa-tag"></i><span></span></div>
                {% if worksite.location %}<div class="bz-info-row"><i class="fas fa-location-dot"></i><span>{{ worksite.location }}</span></div>{% endif %}
                {% if worksite.status %}<div class="bz-info-row"><i class="fas fa-circle-info"></i><span>{{ worksite.status }}</span></div>{% endif %}
                {% if worksite.start_date %}<div class="bz-info-row"><i class="fas fa-calendar-day"></i><span>Inizio {{ worksite.start_date|date('d/m/Y') }}</span></div>{% endif %}
                {% if worksite.order_number %}<div class="bz-info-row"><i class="fas fa-file-signature"></i><span>Ord. {{ worksite.order_number }}</span></div>{% endif %}
                <div class="bz-info-counts">
                    <span title="Aperti"><b class="c-aperto">{{ taskCounts.open }}</b> aperti</span>
                    <span title="In corso"><b class="c-corso">{{ taskCounts.in_progress }}</b> in corso</span>
                    <span title="Completati"><b class="c-fatto">{{ taskCounts.complete }}</b> fatti</span>
                </div>
            </div>

            <div class="bz-nav-spacer"></div>
            {# Collegare un cantiere a Fieldwire e' una cosa da ufficio: a chi
               ci lavora dentro non serve, e il bottone chiede conferma per
               un'operazione che non saprebbe valutare. #}
            <div class="bz-nav-fw"{{ daUfficio and (fieldwire_project_id or fieldwire_enabled) ? '' : ' hidden' }}>
                {% if fieldwire_project_id %}
                    <span class="bz-fw-pill"><span class="bz-fw-dot"></span>Fieldwire collegato</span>
                {% elseif fieldwire_enabled %}
                    <button class="bz-nav-item bz-nav-fw-btn" id="btn-fw-connect"><i class="fas fa-link"></i><span>Collega Fieldwire</span></button>
                {% endif %}
            </div>
        </aside>

    {# ── Body ── #}
