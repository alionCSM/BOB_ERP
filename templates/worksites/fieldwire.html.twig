/* Cosa puo' fare questa persona su un'attivita': le stesse regole del
   server (FieldwireController::pretendeStato), cosi' non si disegnano
   bottoni che poi rispondono di no. */
const GRUPPO_TASK = { squadra: 'cantiere', capi: 'cantiere', cantiere: 'cantiere', cliente: 'cliente', ufficio: 'ufficio' };
const TOCCA_A     = { squadra: 'Squadra', capi: 'Squadra', cantiere: 'Squadra',
                      ufficio: 'CSM', cliente: RUOLO === 'cliente' ? 'Noi' : 'Cliente' };
/* A chi tocca, in parole: la persona per nome, o il gruppo. */
function chiCe(t) {
    if (Number(t.assignee_user_id) > 0) return String(t.assignee_name || 'una persona').replace(/ · .*$/, '');
    return TOCCA_A[t.assegnata_a || 'squadra'] || 'Squadra';
}
function taskMio(t)      { return Number(t.created_by) === Number(IO); }
// CSM e il committente cambiano e portano avanti qualsiasi attivita' che
// vedono; verificare resta a CSM
function taskModifica(t) { return DA_UFFICIO || RUOLO === 'cliente' || taskMio(t); }
function taskAvanza(t) {
    if (DA_UFFICIO) return true;
    if (t.status === 'verified') return false;
    if (RUOLO === 'cliente') return true;
    // data a una persona: solo lei; a un gruppo: chi ne fa parte
    return Number(t.assignee_user_id) > 0
        ? Number(t.assignee_user_id) === Number(IO)
        : GRUPPO_TASK[t.assegnata_a || 'squadra'] === RUOLO;
}
// ha il modulo Zone ma non e' nell'elenco di questo cantiere
const SOLO_ACCESSI = {{ soloAccessi ? 'true' : 'false' }};
const puoScrivere = (sezione) => (ACC[sezione] || 0) > 1;
const STATUSES = { open: 'Aperto', in_progress: 'In corso', complete: 'Completato', verified: 'Verificato' };

/* ── Chi vede cosa ──
   Le stesse cinque scelte ovunque. Le regole le applica il server: qui si
   mostra e si sceglie. Il capo puo' dare solo "squadra" e "capi". */
/* ── Chi la vede ───────────────────────────────────────────────────────────
   Si spuntano le persone del cantiere, raggruppate per ruolo.

   Prima erano cinque etichette — solo ufficio, ufficio e squadra, ufficio e
   capi, ufficio e cliente, tutti. Dicevano una categoria, e la categoria
   comprendeva sempre qualcuno in piu' di quanto si voleva: "ufficio e
   squadra" su una lettera al committente la faceva leggere a quindici
   persone per darla a una.

   L'elenco dei nomi arriva dal server insieme a chi e' gia' dentro: non si
   tiene in pagina, perche' fra l'apertura della Zone e il momento in cui si
   decide qualcuno puo' essere stato aggiunto al cantiere.                 */
let chiAperto = null;   // { tipo, oggetto, onSalva }

/* Chi vede una cosa, in due parole. riga = l'oggetto col suo
   condivisa_con (persone) e condivisa_parti (squadra, cliente). Accetta
   anche il solo elenco di persone, come prima. */
function chiTesto(riga) {
    const con   = Array.isArray(riga) ? riga : ((riga && riga.condivisa_con) || []);
    const parti = Array.isArray(riga) ? [] : ((riga && riga.condivisa_parti) || []);
    const sq = parti.includes('cantiere'), cl = parti.includes('cliente');
    // il cliente legge "noi": "CSM e cliente" gli faceva cercare un altro cliente
    let t = sq && cl ? 'Tutti' : sq ? 'CSM e squadra' : cl ? (RUOLO === 'cliente' ? 'CSM e noi' : 'CSM e cliente') : '';
    if (con.length) t += (t ? ' + ' : '') + con.length + (con.length === 1 ? ' persona' : ' persone');
    return t || 'Solo CSM';
}
function chiBadge(riga) {
    if (!DA_UFFICIO) return '';
    const t = chiTesto(riga);
    if (t === 'Tutti') return '';   // il caso normale non ha bisogno di bollino
    const solo = t === 'Solo CSM';
    return `<span class="bz-vis-badge ${solo ? 'solo' : 'muto'}" title="Chi la vede oltre a CSM">`
         + `<i class="fas ${solo ? 'fa-lock' : 'fa-user-check'}"></i> ${escHtml(t)}</span>`;
}

function chiBottone(tipo, oggetto, riga) {
    if (!DA_UFFICIO) return '';
    return `<button type="button" class="bz-chi-btn" data-chi-tipo="${tipo}" data-chi-oggetto="${oggetto}">`
         + `<i class="fas fa-eye"></i> ${escHtml(chiTesto(riga))}</button>`;
}

/* Il pannello. onSalva riceve l'elenco scelto; se non c'e', si salva da
   se' sul server — e' il caso delle cartelle e dei disegni, che esistono
   gia'. Nei moduli di creazione l'oggetto non esiste ancora, quindi la
   scelta resta in pagina e parte con il resto del modulo. */
async function apriChi(tipo, oggetto, scelte, onSalva) {
    // scelte: un elenco di persone (come prima) o { persone, parti }
    const scelteParti = scelte && !Array.isArray(scelte) ? (scelte.parti ?? null) : null;
    if (scelte && !Array.isArray(scelte)) scelte = scelte.persone || [];
    const pan = document.getElementById('bz-chi-modal');
    const box = document.getElementById('bz-chi-corpo');
    chiAperto = { tipo, oggetto, onSalva };
    box.innerHTML = '<p class="bz-chi-vuoto">Caricamento…</p>';
    pan.classList.remove('hidden');

    let persone = [];
    let con   = scelte || [];
    // una cosa nuova nasce condivisa con tutte e due le parti
    let parti = scelteParti ?? ['cantiere', 'cliente'];
    if (oggetto) {
        const r = await api(`/worksites/${WID}/zone/condivisione?tipo=${tipo}&oggetto=${oggetto}`);
        if (!r.ok) { box.innerHTML = `<p class="bz-chi-vuoto">${escHtml(r.error || 'Impossibile caricare i dati.')}</p>`; return; }
        const d = r.data || r;
        persone = (d.gruppi || []).flatMap(g => g.persone.map(x => ({ ...x, ruolo: g.ruolo })));
        if (!scelte) con = d.con || [];
        if (scelteParti === null) parti = d.parti || [];
    } else {
        const r = await api(`/worksites/${WID}/zone/accessi`);
        persone = (((r.data || r).persone) || [])
            .map(x => ({ id: x.user_id, nome: x.nome, azienda: x.company || '', ruolo: x.ruolo }));
    }

    // Le due parti del cantiere ci sono sempre, anche vuote: condividere
    // con "il cliente" prima che il cliente entri vuol dire che appena
    // entra lo trova.
    const gruppi = [
        { ruolo: 'cantiere', titolo: 'Squadra' },
        { ruolo: 'cliente',  titolo: RUOLO === 'cliente' ? 'Noi' : 'Cliente' },
    ].map(g => ({ ...g, persone: persone.filter(x => x.ruolo === g.ruolo) }));

    const dentro = new Set(con.map(Number));
    box.innerHTML = gruppi.map(g => {
        const tutta = parti.includes(g.ruolo);
        return `
        <div class="bz-chi-gruppo">
            <label class="bz-chi-titolo" style="cursor:pointer">
                <span><input type="checkbox" class="bz-chi-parte" data-parte="${g.ruolo}" ${tutta ? 'checked' : ''}>
                    ${escHtml(g.titolo)} <em style="font-weight:400">— tutti, inclusi gli utenti aggiunti in seguito</em></span>
            </label>
            ${g.persone.length ? g.persone.map(pr => `
                <label class="bz-chi-riga">
                    <input type="checkbox" value="${pr.id}" data-gruppo="${g.ruolo}"
                        ${tutta || dentro.has(pr.id) ? 'checked' : ''} ${tutta ? 'disabled' : ''}>
                    <span>${escHtml(pr.nome)}</span>
                    ${pr.azienda ? `<em>${escHtml(pr.azienda)}</em>` : ''}
                </label>
            `).join('') : `<p class="bz-chi-vuoto" style="text-align:left">Nessun utente.</p>`}
        </div>`;
      }).join('');
}

function chiudiChi() {
    document.getElementById('bz-chi-modal').classList.add('hidden');
    chiAperto = null;
}

/* { persone, parti }: le persone spuntate una per una (fuori dalle parti
   intere, che le comprendono gia') e le parti intere. */
function chiScelte() {
    const parti = [...document.querySelectorAll('#bz-chi-corpo .bz-chi-parte:checked')].map(c => c.dataset.parte);
    const persone = [...document.querySelectorAll('#bz-chi-corpo input[data-gruppo]:checked')]
        .filter(c => !parti.includes(c.dataset.gruppo))
        .map(c => parseInt(c.value));
    return { persone, parti };
}

async function salvaChi() {
    if (!chiAperto) return;
    const { persone, parti } = chiScelte();
    const { tipo, oggetto, onSalva } = chiAperto;

    if (onSalva) { onSalva(persone, parti); chiudiChi(); return; }

    const res = await api(`/worksites/${WID}/zone/condivisione`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo, oggetto, persone, parti }),
    });
    if (!res.ok) { alert(res.error || res.message || 'Non salvato'); return; }
    chiudiChi();
    if (tipo === 'cartella' || tipo === 'file') loadFiles();
    else if (tipo === 'disegno') loadDisegni();
    else loadTasks();
}

/* "Assegnato a": una persona, o un gruppo. Nel select i gruppi hanno @. */
function assegnazioneDaSelect(sel) {
    const v = sel.value || '';
    // a un gruppo: nessun nome di persona (prima finiva salvato "— il nostro ufficio —")
    if (v.startsWith('@')) return { assegnata_a: v.slice(1), assignee_user_id: null, assignee_name: null };
    if (v) return { assegnata_a: 'persona', assignee_user_id: v, assignee_name: (sel.options[sel.selectedIndex]?.text || '').split(' · ')[0] || null };
    return { assegnata_a: 'squadra', assignee_user_id: null, assignee_name: null };
}
const STATUS_COLORS = { open: '#fbbf24', in_progress: '#60a5fa', complete: '#4ade80', verified: '#a78bfa' };

let allTasks = [];
let activeTaskId = null;
let calYear = new Date().getFullYear();
let calMonth = new Date().getMonth();

/* ── API ── */
async function api(url, opts = {}) {
    try {
        // Inietta sempre il CSRF token (il middleware lo richiede sui POST).
        // Lo mettiamo su tutte le richieste: per i GET viene semplicemente ignorato.
        opts.headers = { 'X-CSRF-Token': CSRF, ...(opts.headers || {}) };
        const r = await fetch(url, { credentials: 'same-origin', ...opts });
        const text = await r.text();
        try {
            const json = JSON.parse(text);
            if (!json.ok && json.where) {
                console.warn('[API error]', url, json.type, json.error, '@', json.where);
            }
            return json;
        } catch {
            console.error('[Non-JSON response]', url, 'HTTP', r.status, '\n--- body ---\n', text.slice(0, 1500));
            return { ok: false, error: 'Risposta non valida dal server (HTTP ' + r.status + ') — vedi DevTools Console' };
        }
    } catch (e) {
        console.error('Fetch error', url, e);
        return { ok: false, error: e.message };
    }
}

/* ── Data ── */
async function loadTasks() {
    const res = await api(`/worksites/${WID}/zone/tasks`);
    allTasks = (res.ok && Array.isArray(res.data)) ? res.data : [];
    renderCurrentView();
}

let currentTop = 'attivita';   // attivita | disegni | media | files | forms
let activeSub  = 'kanban';     // kanban | gantt | calendar

function switchTop(v) {
    // un modulo a meta' (in costruzione o in compilazione) non si perde in silenzio
    if (currentTop === 'forms' && v !== 'forms' && window.bzfPuoiUscire && !window.bzfPuoiUscire()) return;
    currentTop = v;
    // aprendo una sezione, le sue notifiche sono viste
    if (typeof avvisiSezioneVista === 'function') avvisiSezioneVista(v);
    document.querySelectorAll('.bz-view').forEach(x => x.classList.remove('active'));
    document.getElementById('view-' + v)?.classList.add('active');
    document.querySelectorAll('.bz-nav-item').forEach(b => b.classList.toggle('active', b.dataset.view === v));
    if (v === 'attivita')      renderSub();
    else if (v === 'disegni')  loadDisegni();
    else if (v === 'media')    loadMedia();
    else if (v === 'files')    loadFiles();
    else if (v === 'forms')    openForms();
    else if (v === 'presenze') loadPresenze();
    window.BZDialogo?.vista(v);
}

function switchSub(s) {
    activeSub = s;
    document.querySelectorAll('.bz-subview').forEach(x => x.classList.remove('active'));
    document.getElementById('view-' + s)?.classList.add('active');
    document.querySelectorAll('.bz-sub-btn').forEach(b => b.classList.toggle('active', b.dataset.sub === s));
    renderSub();
}

function renderSub() {
    if (activeSub === 'kanban')   renderKanban();
    if (activeSub === 'gantt')    renderGantt();
    if (activeSub === 'calendar') renderCalendar();
}

function openForms() {
    if (!window.BZForms) return;
    if (!window._bzFormsInited) {
        BZForms.init({
            worksiteId: WID, csrf: CSRF,
            puoCompilare: puoScrivere('moduli'),
            daUfficio: DA_UFFICIO,
            wsName: {{ worksite.name|json_encode|raw }},
            wsCode: {{ (worksite.worksite_code ?? '')|json_encode|raw }},
            clientName: {{ (clientName ?? '')|json_encode|raw }}
        });
        window._bzFormsInited = true;
    }
    BZForms.show();
}

/* compat: chiamato dopo modifiche ai task → ridisegna la vista attività corrente */
function renderCurrentView() {
    if (currentTop === 'attivita') renderSub();
}

/* ══════════ KANBAN ══════════ */
const COLS = [
    { key: 'open',        label: 'Aperto',      dot: 'dot-open' },
    { key: 'in_progress', label: 'In corso',     dot: 'dot-progress' },
    { key: 'complete',    label: 'Completato',   dot: 'dot-done' },
    { key: 'verified',    label: 'Verificato',   dot: 'dot-verified' },
];

let kFilter = { q: '', assignee: '', cat: '' };

function filteredTasks() {
    const q = kFilter.q.toLowerCase();
    return allTasks.filter(t => {
        if (kFilter.assignee && chiCe(t) !== kFilter.assignee) return false;
        if (kFilter.cat && (t.category || '') !== kFilter.cat) return false;
        if (q) {
            const blob = `${t.name||''} ${t.assignee_name||''} ${t.category||''} ${t.description||''}`.toLowerCase();
            if (!blob.includes(q)) return false;
        }
        return true;
    });
}

function refreshKanbanFilterOptions() {
    const aSel = document.getElementById('bz-filter-assignee');
    const cSel = document.getElementById('bz-filter-cat');
    if (!aSel || !cSel) return;
    const assignees = [...new Set(allTasks.map(chiCe).filter(Boolean))].sort();
    const cats      = [...new Set(allTasks.map(t => t.category).filter(Boolean))].sort();
    aSel.innerHTML = '<option value="">Tutte le persone</option>' + assignees.map(a=>`<option ${a===kFilter.assignee?'selected':''}>${escHtml(a)}</option>`).join('');
    cSel.innerHTML = '<option value="">Tutte le categorie</option>' + cats.map(c=>`<option ${c===kFilter.cat?'selected':''}>${escHtml(c)}</option>`).join('');
}

function renderKanban() {
    refreshKanbanFilterOptions();
    const board = document.getElementById('bz-kanban');
    const grouped = {};
    COLS.forEach(c => grouped[c.key] = []);
    filteredTasks().forEach(t => { if (grouped[t.status] !== undefined) grouped[t.status].push(t); else grouped['open'].push(t); });

    board.innerHTML = COLS.map(col => `
        <div class="bz-col">
            <div class="bz-col-head">
                <span class="bz-col-label">
                    <span class="bz-col-dot ${col.dot}"></span>
                    ${col.label}
                </span>
                <span class="bz-col-count">${grouped[col.key].length}</span>
            </div>
            <div class="bz-cards" id="col-${col.key}">
                ${grouped[col.key].map(t => cardHtml(t)).join('') || ''}
            </div>
            <div class="bz-col-add">
                <button class="bz-col-add-btn" data-quick-add="${col.key}">
                    <i class="fas fa-plus" style="font-size:13px"></i> Aggiungi
                </button>
            </div>
        </div>
    `).join('');
}

function cardHtml(t) {
    const overdue = t.due_date && new Date(t.due_date) < new Date() && t.status !== 'complete' && t.status !== 'verified';
    const prio = Number(t.priority) > 1 ? '<span class="bz-card-prio urgente" title="Urgente"><i class="fas fa-flag"></i> Urgente</span>'
               : Number(t.priority) === 1 ? '<span class="bz-card-prio alta" title="Priorità alta"><i class="fas fa-flag"></i> Alta</span>' : '';
    // si trascina solo chi la puo' portare avanti
    return `
        <div class="bz-card ${activeTaskId == t.id ? 'active' : ''}" data-task-id="${t.id}" draggable="${taskAvanza(t) ? 'true' : 'false'}">
            <div class="bz-card-name">${escHtml(t.name)}</div>
            ${t.luogo ? `<div class="bz-card-luogo"><i class="fas fa-location-dot"></i> ${escHtml(t.luogo)}</div>` : ''}
            ${t.disegno ? `<div class="bz-card-luogo" title="Collegata a un disegno"><i class="fas fa-drafting-compass"></i> ${escHtml(t.disegno.nome)}</div>` : ''}
            ${prio}${chiBadge(t)}
            <div class="bz-card-foot">
                ${Number(t.assignee_user_id) > 0 ? `<span class="bz-card-user"><i class="fas fa-user" style="font-size:11px"></i>${escHtml(chiCe(t))}</span>`
                  : `<span class="bz-card-user"><i class="fas fa-users" style="font-size:11px"></i>${escHtml(TOCCA_A[t.assegnata_a || 'squadra'] || '')}</span>`}
                ${t.due_date ? `<span class="bz-card-due ${overdue ? 'overdue' : ''}"><i class="fas fa-calendar-alt" style="font-size:11px"></i>${fmtDate(t.due_date)}</span>` : ''}
            </div>
        </div>`;
}

/* ══════════ GANTT ══════════ */
function renderGantt() {
    /* Un Gantt vero: una colonna per giorno, il fine settimana in grigio,
       mese e giorni in testa, i nomi fermi a sinistra mentre si scorre,
       la linea di oggi. Si apre su oggi. */
    const el = document.getElementById('bz-gantt-content');
    const righe = filteredTasks()
        .map(t => ({ t, p: periodoTask(t) }))
        .sort((a, b) => a.p.inizio - b.p.inizio || a.p.fine - b.p.fine);
    if (!righe.length) {
        el.innerHTML = '<div class="bz-gantt-empty">Nessuna attività.</div>';
        return;
    }

    const GIORNO = 86400000, PX = 34;
    const oggi = new Date(); oggi.setHours(0, 0, 0, 0);
    const date = righe.flatMap(x => [x.p.inizio, x.p.fine]).concat([oggi]);
    const da = new Date(Math.min(...date)); da.setDate(da.getDate() - 3);
    const a  = new Date(Math.max(...date)); a.setDate(a.getDate() + 10);
    const giorni = [];
    for (let d = new Date(da); d <= a; d.setDate(d.getDate() + 1)) giorni.push(new Date(d));
    const largo = giorni.length * PX;
    const x = d => Math.round((d - da) / GIORNO) * PX;

    // i mesi: un blocco per mese, largo quanto i suoi giorni
    const mesi = [];
    giorni.forEach((d, i) => {
        const k = d.getFullYear() * 12 + d.getMonth();
        if (!mesi.length || mesi[mesi.length - 1].k !== k) mesi.push({ k, da: i, n: 0, d });
        mesi[mesi.length - 1].n++;
    });
    const nomeMese = d => d.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
    const iniziale = ['D', 'L', 'M', 'M', 'G', 'V', 'S'];

    const sfondoGiorni = giorni.map((d, i) => {
        const fest = d.getDay() === 0 || d.getDay() === 6;
        return fest ? `<div class="bzg-fest" style="left:${i * PX}px;width:${PX}px"></div>` : '';
    }).join('');

    el.innerHTML = `
      <div class="bzg">
        <div class="bzg-sx">
          <div class="bzg-sx-testa">Attività</div>
          ${righe.map(({ t, p }) => `
            <div class="bzg-sx-riga" data-task-id="${t.id}" title="${escHtml(t.name)}">
              <span class="bzg-pallino" style="background:${STATUS_COLORS[t.status] || STATUS_COLORS.open}"></span>
              <span class="bzg-nome">${escHtml(t.name)}</span>
              <span class="bzg-chi">${escHtml(chiCe(t))}${p.senzaDate ? ' · senza date' : ''}</span>
            </div>`).join('')}
        </div>
        <div class="bzg-dx" id="bzg-dx">
          <div class="bzg-tela" style="width:${largo}px">
            <div class="bzg-testa">
              <div class="bzg-mesi">${mesi.map(m => `<div style="left:${m.da * PX}px;width:${m.n * PX}px">${m.n >= 4 ? nomeMese(m.d) : ''}</div>`).join('')}</div>
              <div class="bzg-giorni">${giorni.map((d, i) => `
                <div class="${d.getDay() === 0 || d.getDay() === 6 ? 'fest' : ''} ${d.getTime() === oggi.getTime() ? 'oggi' : ''}" style="left:${i * PX}px;width:${PX}px">
                  <small>${iniziale[d.getDay()]}</small>${d.getDate()}</div>`).join('')}</div>
            </div>
            <div class="bzg-corpo" style="height:${righe.length * 40}px">
              ${sfondoGiorni}
              <div class="bzg-oggi" style="left:${x(oggi) + PX / 2}px"></div>
              ${righe.map(({ t, p }, r) => {
                  const sx = x(p.inizio) + 3, w = Math.max(PX - 6, x(p.fine) - x(p.inizio) + PX - 6);
                  const col = STATUS_COLORS[t.status] || STATUS_COLORS.open;
                  const tit = `${t.name} · ${fmtDate(chiaveGiorno(p.inizio))} – ${fmtDate(chiaveGiorno(p.fine))}${p.senzaDate ? ' (senza date: dalla creazione a oggi)' : ''}`;
                  return `
                    <div class="bzg-riga" style="top:${r * 40}px"></div>
                    <div class="bzg-barra ${p.senzaDate ? 'stimata' : ''} ${t.status}" data-task-id="${t.id}" title="${escHtml(tit)}"
                         style="top:${r * 40 + 8}px;left:${sx}px;width:${w}px;--c:${col}">
                      <span>${w > 90 ? escHtml(t.name) : ''}</span>
                    </div>
                    ${w <= 90 ? `<div class="bzg-etichetta" style="top:${r * 40 + 11}px;left:${sx + w + 6}px">${escHtml(t.name)}</div>` : ''}`;
              }).join('')}
            </div>
          </div>
        </div>
      </div>`;

    // si apre su oggi, con qualche giorno prima
    const dx = document.getElementById('bzg-dx');
    if (dx) {
        dx.scrollLeft = Math.max(0, x(oggi) - PX * 5);
        // i nomi a sinistra scorrono in su e in giu' insieme alle barre
        const sx = el.querySelector('.bzg-sx');
        dx.addEventListener('scroll', () => { sx.scrollTop = dx.scrollTop; }, { passive: true });
    }
}

/* ══════════ CALENDAR ══════════ */
function renderCalendar() {
    const months = ['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'];
    const days   = ['Lun','Mar','Mer','Gio','Ven','Sab','Dom'];
    document.getElementById('cal-title').textContent = `${months[calMonth]} ${calYear}`;

    const grid = document.getElementById('bz-cal-grid');
    const today = new Date(); today.setHours(0,0,0,0);

    // Day headers
    let html = days.map(d => `<div class="bz-cal-day-name">${d}</div>`).join('');

    const first = new Date(calYear, calMonth, 1);
    let startDow = first.getDay(); // 0=Sun
    startDow = startDow === 0 ? 6 : startDow - 1; // Mon=0

    const tasksByDate = {};
    filteredTasks().forEach(t => {
        const p = periodoTask(t);
        const key = chiaveGiorno(p.quando);
        (tasksByDate[key] ??= []).push(t);
    });

    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    const prevDays    = new Date(calYear, calMonth, 0).getDate();

    // Fill prev month
    for (let i = startDow - 1; i >= 0; i--) {
        html += `<div class="bz-cal-day other-month"><div class="bz-cal-day-num">${prevDays - i}</div></div>`;
    }
    // Current month
    for (let d = 1; d <= daysInMonth; d++) {
        const dt = new Date(calYear, calMonth, d);
        const key = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const isToday = dt.getTime() === today.getTime();
        const events  = (tasksByDate[key] || []).slice(0, 3);
        html += `
            <div class="bz-cal-day ${isToday ? 'today' : ''}">
                <div class="bz-cal-day-num">${d}</div>
                ${events.map(t => `
                    <div class="bz-cal-event ${t.status} ${!t.start_date && !t.due_date ? 'stimata' : ''}" data-task-id="${t.id}"
                         title="${escHtml(t.name + (t.due_date ? ' · scadenza' : t.start_date ? ' · inizio' : ' · creata, senza date'))}" style="cursor:pointer">${escHtml(t.name)}</div>
                `).join('')}
                ${(tasksByDate[key]||[]).length > 3 ? `<div class="bz-cal-altri">+${(tasksByDate[key]||[]).length - 3} altre</div>` : ''}
            </div>`;
    }
    // Fill next month
    const total = startDow + daysInMonth;
    const rem   = total % 7 === 0 ? 0 : 7 - (total % 7);
    for (let d = 1; d <= rem; d++) {
        html += `<div class="bz-cal-day other-month"><div class="bz-cal-day-num">${d}</div></div>`;
    }

    grid.innerHTML = html;
}

function calNav(dir) {
    if (dir === 0) { calYear = new Date().getFullYear(); calMonth = new Date().getMonth(); }
    else { calMonth += dir; if (calMonth < 0) { calMonth = 11; calYear--; } if (calMonth > 11) { calMonth = 0; calYear++; } }
    renderCalendar();
}

/* ══════════ DETAIL PANEL ══════════ */
async function openTask(id) {
    activeTaskId = id;
    document.querySelectorAll('.bz-card').forEach(c => c.classList.toggle('active', parseInt(c.dataset.taskId) === id));
    document.getElementById('bz-detail-wrap').classList.remove('closed');

    const task = allTasks.find(t => t.id == id);
    if (!task) return;

    const inner = document.getElementById('bz-detail-inner');
    inner.innerHTML = `
        <div class="bz-detail-section">
            <input class="bz-detail-title-input" value="${escHtml(task.name)}"
                   data-task-name-id="${id}" ${taskModifica(task) ? '' : 'readonly'}>
            ${task.category ? `<div style="font-size:11px;color:#475569;margin-top:4px">${escHtml(task.category)}</div>` : ''}
            <div style="display:flex;gap:8px;margin-top:10px;">
                ${taskModifica(task) ? `<button class="bz-task-action-btn" data-edit-task="${id}">
                    <i class="fas fa-pen" style="font-size:11px"></i> Modifica
                </button>` : ''}
                ${DA_UFFICIO || taskMio(task) ? `<button class="bz-task-action-btn danger" data-delete-task="${id}">
                    <i class="fas fa-trash" style="font-size:11px"></i> Elimina
                </button>` : ''}
            </div>
        </div>

        <div class="bz-detail-section">
            <div class="bz-detail-section-title">Stato</div>
            <div class="bz-status-row">
                ${Object.entries(STATUSES)
                    // "Verificato" e' l'ultima parola, dell'ufficio: agli
                    // altri si mostra solo quando c'e' gia'
                    .filter(([k]) => DA_UFFICIO || k !== 'verified' || task.status === 'verified')
                    .map(([k,v]) => `
                    <button class="bz-status-opt ${k} ${task.status === k ? 'selected' : ''}"
                            ${taskAvanza(task) ? `data-set-status="${k}"` : 'disabled'} data-task-id="${id}">
                        ${v}
                    </button>`).join('')}
            </div>
            ${taskAvanza(task) ? '' : `<div style="font-size:11px;color:#64748b;margin-top:6px">${task.status === 'verified'
                ? "Verificata da CSM."
                : "La porta avanti la persona o il gruppo a cui è assegnata."}</div>`}
        </div>

        <div class="bz-detail-section">
            <div class="bz-detail-section-title">Dettagli</div>
            <dl class="bz-dati">
                <dt><i class="fas fa-user"></i> Assegnata a</dt><dd>${escHtml(task.assignee_user_id || task.assegnata_a === 'persona'
                    ? (task.assignee_name || 'una persona')
                    : (TOCCA_A[task.assegnata_a || 'squadra'] || 'Squadra'))}</dd>
                ${task.luogo ? `<dt><i class="fas fa-location-dot"></i> Posizione</dt><dd>${escHtml(task.luogo)}</dd>` : ''}
                ${task.disegno ? `<dt><i class="fas fa-drafting-compass"></i> Disegno</dt><dd><button type="button" class="bz-link" data-annot="${task.disegno.document_id}" data-annot-type="${escAttr(task.disegno.tipo)}" data-annot-name="${escAttr(task.disegno.nome)}">${escHtml(task.disegno.nome)}${task.disegno.page > 1 ? ' · pag. ' + task.disegno.page : ''}</button></dd>` : ''}
                ${Number(task.priority) > 0 ? `<dt><i class="fas fa-flag"></i> Priorità</dt><dd class="${Number(task.priority) > 1 ? 'urgente' : 'alta'}">${Number(task.priority) > 1 ? 'Urgente' : 'Alta'}</dd>` : ''}
                ${task.start_date ? `<dt><i class="fas fa-calendar-alt"></i> Inizio</dt><dd>${fmtDate(task.start_date)}</dd>` : ''}
                ${task.due_date ? `<dt><i class="fas fa-calendar-check"></i> Scadenza</dt><dd class="${task.status !== 'complete' && task.status !== 'verified' && task.due_date.slice(0,10) < new Date().toISOString().slice(0,10) ? 'urgente' : ''}">${fmtDate(task.due_date)}</dd>` : ''}
                ${task.category ? `<dt><i class="fas fa-tag"></i> Categoria</dt><dd>${escHtml(task.category)}</dd>` : ''}
                <dt><i class="fas fa-clock"></i> Creata</dt><dd>${fmtDate(task.created_at)}</dd>
            </dl>
            ${task.description ? `<p class="bz-dati-desc">${escHtml(task.description)}</p>` : ''}
        </div>

        <div class="bz-detail-section" id="bz-foto-sez-${id}" hidden>
            <div class="bz-detail-section-title">Foto</div>
            <div class="bz-foto-striscia" id="bz-foto-${id}"></div>
        </div>

        <div class="bz-detail-section">
            <div class="bz-detail-section-title">Passaggi</div>
            <div class="bz-check-list" id="bz-checklist-${id}">
                <div style="font-size:12px;color:#334155">Caricamento...</div>
            </div>
            <div class="bz-check-add" ${taskModifica(task) || taskAvanza(task) ? '' : 'hidden'}>
                <input id="new-check-input" placeholder="Aggiungi un passaggio…" data-check-enter="${id}">
                <button data-add-check="${id}"><i class="fas fa-plus"></i></button>
            </div>
        </div>

        <div class="bz-detail-section" style="border-bottom:none">
            <div class="bz-detail-section-title">Commenti</div>
            <div class="bz-comments" id="bz-comments-${id}">
                <div style="font-size:12px;color:#334155">Caricamento...</div>
            </div>
        </div>
    `;

    loadChecklist(id);
    loadComments(id);
}

function closeDetail() {
    activeTaskId = null;
    document.getElementById('bz-detail-wrap').classList.add('closed');
    document.querySelectorAll('.bz-card').forEach(c => c.classList.remove('active'));
}

async function setStatus(taskId, status) {
    const r = await api(`/worksites/${WID}/zone/tasks/${taskId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
    });
    // un rifiuto del server si dice, invece di far finta che sia cambiato
    if (!r.ok) { alert(r.error || "Impossibile cambiare lo stato dell'attività."); return; }
    const task = allTasks.find(t => t.id == taskId);
    if (task) task.status = status;
    renderCurrentView();
    // update buttons
    document.querySelectorAll('.bz-status-opt').forEach(b => {
        b.classList.toggle('selected', b.classList.contains(status));
    });
}

