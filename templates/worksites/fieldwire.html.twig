/* ══════════ DRAG & DROP KANBAN ══════════ */
let dragTaskId = null;

document.addEventListener('dragstart', e => {
    const card = e.target.closest && e.target.closest('.bz-card');
    if (!card) return;
    dragTaskId = parseInt(card.dataset.taskId);
    card.style.opacity = '0.4';
    if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
});
document.addEventListener('dragend', e => {
    const card = e.target.closest && e.target.closest('.bz-card');
    if (card) card.style.opacity = '';
    dragTaskId = null;
    document.querySelectorAll('.bz-cards.dnd-over').forEach(el => el.classList.remove('dnd-over'));
});
document.addEventListener('dragover', e => {
    const col = e.target.closest && e.target.closest('.bz-cards');
    if (!col || dragTaskId === null) return;
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
    document.querySelectorAll('.bz-cards.dnd-over').forEach(el => el.classList.remove('dnd-over'));
    col.classList.add('dnd-over');
});
document.addEventListener('drop', e => {
    const col = e.target.closest && e.target.closest('.bz-cards');
    if (!col || dragTaskId === null) return;
    e.preventDefault();
    col.classList.remove('dnd-over');

    // ricava lo status dalla colonna (id="col-<status>")
    const status = (col.id || '').replace('col-', '');
    if (!status) return;
    const taskId = dragTaskId;
    dragTaskId = null;

    // ottimistico: muovi il task in memoria + ridisegna
    const task = allTasks.find(t => t.id == taskId);
    if (task && task.status !== status) {
        task.status = status;
        renderCurrentView();
        // poi server
        setStatus(taskId, status);
    }
});

document.addEventListener('change', e => {
    const cb = e.target;
    if (cb.dataset.toggleCheck) {
        const [taskId, itemId] = cb.dataset.toggleCheck.split(':').map(Number);
        toggleCheck(taskId, itemId, cb);
    }
});

document.addEventListener('keydown', e => {
    if (e.key === 'Enter' && e.target.dataset.checkEnter) {
        addCheck(parseInt(e.target.dataset.checkEnter));
    }
});

document.addEventListener('blur', e => {
    if (e.target.dataset.taskNameId) {
        updateTaskName(parseInt(e.target.dataset.taskNameId), e.target.value);
    }
}, true);

/* ══════════ UTILS ══════════ */
function escHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escAttr(s) { return escHtml(s); }

function initials(name) {
    return (name || '?').split(' ').filter(Boolean).map(w => w[0]).join('').toUpperCase().slice(0, 2);
}
function ago(str) {
    if (!str) return '';
    const s = Math.floor((Date.now() - new Date(str)) / 1000);
    if (s < 60) return 'adesso';
    if (s < 3600) return Math.floor(s/60) + 'm fa';
    if (s < 86400) return Math.floor(s/3600) + 'h fa';
    return new Date(str).toLocaleDateString('it-IT', { day:'2-digit', month:'2-digit' });
}
function fmtDate(str) {
    if (!str) return '';
    return new Date(str + 'T00:00:00').toLocaleDateString('it-IT', { day:'2-digit', month:'2-digit' });
}

/* ══════════ INIT ══════════ */
loadTasks();
renderCalendar();
loadBobUsers();
/* BZForms init avviene lazy alla prima apertura della vista Moduli
   (forms.js è incluso a fine pagina, dopo questo script). */
</script>

