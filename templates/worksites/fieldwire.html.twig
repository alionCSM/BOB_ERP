    if (res.ok && res.data?.status === 'ok') {
        disegniLoaded = false; loadDisegni();
    } else {
        alert('Conversione DWG non riuscita: ' + (res.data?.error || res.error || 'errore'));
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-sync"></i> Converti'; }
