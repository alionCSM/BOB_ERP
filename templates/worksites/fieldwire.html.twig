<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BOB Zone — {{ worksite.name }}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    background: #0f172a;
    color: #e2e8f0;
    overflow: hidden;
}

/* ── App shell ── */
.bz-app {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

/* ── Header ── */
.bz-header {
    height: 52px;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
    display: flex;
    align-items: center;
    padding: 0 20px;
    gap: 16px;
    flex-shrink: 0;
}

.bz-back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #475569;
    text-decoration: none;
    transition: color .15s;
    white-space: nowrap;
}
.bz-back:hover { color: #94a3b8; }
.bz-back i { font-size: 15px; }

.bz-divider { width: 1px; height: 18px; background: #1e293b; flex-shrink: 0; }

.bz-brand {
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-shrink: 0;
}
.bz-brand-bob  { font-size: 12px; font-weight: 500; color: #475569; letter-spacing: .04em; }
.bz-brand-zone { font-size: 16px; font-weight: 600; color: #f1f5f9; letter-spacing: .01em; }

.bz-worksite-name {
    font-size: 13px;
    color: #64748b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

.bz-header-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}

.bz-sync-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 500;
    color: #4ade80;
    background: rgba(74,222,128,.06);
    border: 1px solid rgba(74,222,128,.15);
    border-radius: 999px;
    padding: 4px 12px;
}
.bz-sync-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

.bz-connect-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: #94a3b8;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 6px 14px;
    cursor: pointer;
    font-family: inherit;
    transition: background .15s, color .15s;
}
.bz-connect-btn:hover { background: #273548; color: #e2e8f0; }
.bz-connect-btn i { font-size: 14px; }

/* ── Nav tabs ── */
.bz-nav {
    display: flex;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
    padding: 0 20px;
    flex-shrink: 0;
    gap: 2px;
}

.bz-nav-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #475569;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    font-family: inherit;
    transition: color .15s;
    white-space: nowrap;
}
.bz-nav-tab i { font-size: 15px; }
.bz-nav-tab:hover { color: #94a3b8; }
.bz-nav-tab.active { color: #f1f5f9; border-bottom-color: #4ade80; }

/* ── Body ── */
.bz-body {
    flex: 1;
    overflow: hidden;
    background: #0f172a;
}

.bz-panel {
    display: none;
    height: 100%;
}
.bz-panel.active { display: flex; }

/* ══════════════════════════════════════
   TASKS layout: sidebar + detail
══════════════════════════════════════ */
.bz-tasks-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    height: 100%;
    overflow: hidden;
}

/* ── Task sidebar ── */
.bz-sidebar {
    background: #0f172a;
    border-right: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.bz-sidebar-head {
    padding: 12px 16px;
    border-bottom: 1px solid #1e293b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.bz-sidebar-title {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: .06em;
}
.bz-new-task-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #4ade80;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .15s;
}
.bz-new-task-btn:hover { opacity: .7; }

.bz-task-list {
    flex: 1;
    overflow-y: auto;
}
.bz-task-list::-webkit-scrollbar { width: 3px; }
.bz-task-list::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

.bz-task-item {
    padding: 12px 16px;
    border-bottom: 1px solid #1a2438;
    cursor: pointer;
    transition: background .1s;
    border-left: 3px solid transparent;
}
.bz-task-item:hover  { background: #131f32; }
.bz-task-item.active { background: #131f32; border-left-color: #4ade80; }

.bz-task-item-name {
    font-size: 13px;
    font-weight: 500;
    color: #e2e8f0;
    line-height: 1.4;
    margin-bottom: 6px;
}
.bz-task-item-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}

/* Status pills */
.bz-pill {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
}
.bz-pill-open     { background: rgba(251,191,36,.12);  color: #fbbf24; }
.bz-pill-progress { background: rgba(96,165,250,.12);  color: #60a5fa; }
.bz-pill-done     { background: rgba(74,222,128,.12);  color: #4ade80; }
.bz-pill-verified { background: rgba(167,139,250,.12); color: #a78bfa; }

.bz-task-user {
    font-size: 11px;
    color: #475569;
    display: flex;
    align-items: center;
    gap: 3px;
}
.bz-task-user i { font-size: 11px; }

.bz-state-msg {
    padding: 40px 20px;
    text-align: center;
    font-size: 13px;
    color: #475569;
}

/* ── Detail panel ── */
.bz-detail {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #111827;
}

.bz-detail-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #1e293b;
    text-align: center;
    gap: 12px;
}
.bz-detail-empty i  { font-size: 48px; }
.bz-detail-empty p  { font-size: 13px; color: #334155; }

.bz-detail-head {
    padding: 16px 20px;
    border-bottom: 1px solid #1e293b;
    flex-shrink: 0;
}
.bz-detail-title {
    font-size: 16px;
    font-weight: 600;
    color: #f1f5f9;
    margin-bottom: 8px;
    line-height: 1.4;
}
.bz-detail-attrs {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.bz-detail-attr {
    font-size: 12px;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 4px;
}
.bz-detail-attr i { font-size: 13px; }

/* ── Two-column detail body ── */
.bz-detail-cols {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    min-height: 0;
}

.bz-col {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}
.bz-col + .bz-col { border-left: 1px solid #1e293b; }

.bz-col-head {
    padding: 10px 16px;
    font-size: 10px;
    font-weight: 700;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: .08em;
    border-bottom: 1px solid #1e293b;
    flex-shrink: 0;
}

/* Checklist */
.bz-col-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 10px 16px;
    min-height: 0;
}
.bz-col-scroll::-webkit-scrollbar { width: 3px; }
.bz-col-scroll::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

.bz-check-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #1a2438;
}
.bz-check-item:last-child { border-bottom: none; }
.bz-check-item input[type=checkbox] {
    width: 14px; height: 14px;
    margin-top: 2px;
    accent-color: #4ade80;
    cursor: pointer;
    flex-shrink: 0;
}
.bz-check-label {
    font-size: 13px;
    color: #94a3b8;
    cursor: pointer;
    line-height: 1.4;
}
.bz-check-label.done { text-decoration: line-through; color: #334155; }

/* Chat */
.bz-feed {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
}
.bz-feed::-webkit-scrollbar { width: 3px; }
.bz-feed::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

.bz-bubble { display: flex; gap: 10px; align-items: flex-start; }
.bz-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #1e293b;
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    letter-spacing: .02em;
}
.bz-bubble-body   { flex: 1; min-width: 0; }
.bz-bubble-meta   { display: flex; align-items: baseline; gap: 6px; margin-bottom: 4px; }
.bz-bubble-author { font-size: 12px; font-weight: 600; color: #94a3b8; }
.bz-bubble-time   { font-size: 10px; color: #334155; }
.bz-bubble-text   { font-size: 13px; color: #64748b; line-height: 1.55; word-break: break-word; }
.bz-bubble-img    { margin-top: 8px; max-width: 200px; border-radius: 8px; cursor: zoom-in; opacity: .9; }

.bz-chat-bar {
    padding: 10px 14px;
    border-top: 1px solid #1e293b;
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    background: #111827;
}
.bz-chat-input {
    flex: 1;
    background: #1e293b;
    border: 1px solid #273548;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #e2e8f0;
    font-family: inherit;
    resize: none;
    outline: none;
    transition: border-color .15s;
}
.bz-chat-input::placeholder { color: #334155; }
.bz-chat-input:focus { border-color: #334155; }
.bz-chat-send {
    background: #1e293b;
    color: #4ade80;
    border: 1px solid #273548;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 20px;
    cursor: pointer;
    font-family: inherit;
    transition: background .15s;
    display: flex;
    align-items: center;
}
.bz-chat-send:hover { background: #273548; }
.bz-chat-send:disabled { opacity: .3; cursor: not-allowed; }

/* ══════════════════════════════════════
   FLOORPLANS tab
══════════════════════════════════════ */
.bz-fp-wrap {
    width: 100%;
    padding: 24px;
    overflow-y: auto;
    background: #111827;
}
.bz-fp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
}
.bz-fp-card {
    background: #1e293b;
    border: 1px solid #273548;
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color .15s;
}
.bz-fp-card:hover { border-color: #334155; }
.bz-fp-icon { font-size: 28px; color: #334155; }
.bz-fp-name { font-size: 13px; font-weight: 600; color: #e2e8f0; line-height: 1.4; }
.bz-fp-meta { font-size: 11px; color: #475569; }
.bz-fp-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 500;
    color: #60a5fa;
    text-decoration: none;
    margin-top: 4px;
}
.bz-fp-link:hover { color: #93c5fd; }

/* ══════════════════════════════════════
   Not-connected state
══════════════════════════════════════ */
.bz-not-connected {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    background: #111827;
}
.bz-not-connected i   { font-size: 52px; color: #1e293b; margin-bottom: 16px; }
.bz-not-connected h2  { font-size: 18px; font-weight: 600; color: #e2e8f0; margin-bottom: 8px; }
.bz-not-connected p   { font-size: 13px; color: #475569; max-width: 360px; margin-bottom: 24px; }

.bz-enable-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1e293b;
    color: #4ade80;
    border: 1px solid #273548;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background .15s;
}
.bz-enable-btn:hover { background: #273548; }
.bz-enable-btn:disabled { opacity: .4; cursor: not-allowed; }

/* ── Spinner ── */
@keyframes spin { to { transform: rotate(360deg); } }
.bz-spin { animation: spin .8s linear infinite; display: inline-block; }
</style>
</head>
<body>
<div class="bz-app">

    {# ── Header ── #}
    <header class="bz-header">
        <a href="/worksites/{{ worksite_id }}" class="bz-back">
            <i class="ti ti-arrow-left"></i>
            Cantiere
        </a>
        <div class="bz-divider"></div>
        <div class="bz-brand">
            <span class="bz-brand-bob">BOB</span>
            <span class="bz-brand-zone">Zone</span>
        </div>
        <div class="bz-divider"></div>
        <span class="bz-worksite-name">{{ worksite.name }}</span>

        <div class="bz-header-right">
            {% if fieldwire_project_id %}
                <span class="bz-sync-pill">
                    <span class="bz-sync-dot"></span>
                    Fieldwire
                </span>
            {% elseif fieldwire_enabled %}
                <button class="bz-connect-btn" id="btn-fw-connect">
                    <i class="ti ti-link"></i>
                    Collega Fieldwire
                </button>
            {% endif %}
        </div>
    </header>

    {# ── Nav ── #}
    <nav class="bz-nav">
        <button class="bz-nav-tab active" data-tab="tasks">
            <i class="ti ti-checkbox"></i>
            Task
        </button>
        <button class="bz-nav-tab" data-tab="floorplans">
            <i class="ti ti-files"></i>
            Tavole
        </button>
    </nav>

    {# ── Body ── #}
    <div class="bz-body">

        {# ── Tasks ── #}
        <div class="bz-panel active" id="panel-tasks">
            {% if fieldwire_project_id %}
            <div class="bz-tasks-layout">

                <div class="bz-sidebar">
                    <div class="bz-sidebar-head">
                        <span class="bz-sidebar-title">Task</span>
                        <button class="bz-new-task-btn" id="btn-new-task">
                            <i class="ti ti-plus" style="font-size:13px"></i>
                            Nuovo
                        </button>
                    </div>
                    <div class="bz-task-list" id="bz-task-list">
                        <div class="bz-state-msg">
                            <i class="ti ti-loader-2 bz-spin" style="font-size:20px"></i>
                        </div>
                    </div>
                </div>

                <div class="bz-detail" id="bz-detail">
                    <div class="bz-detail-empty">
                        <i class="ti ti-checkbox"></i>
                        <p>Seleziona un task</p>
                    </div>
                </div>

            </div>
            {% else %}
            <div class="bz-not-connected">
                <i class="ti ti-link-off"></i>
                <h2>Fieldwire non collegato</h2>
                <p>Collega questo cantiere a Fieldwire per gestire task, disegni e messaggi.</p>
                {% if fieldwire_enabled %}
                <button class="bz-enable-btn" id="btn-fw-enable">
                    <i class="ti ti-link"></i>
                    Collega a Fieldwire
                </button>
                {% endif %}
            </div>
            {% endif %}
        </div>

        {# ── Floorplans ── #}
        <div class="bz-panel" id="panel-floorplans">
            {% if fieldwire_project_id %}
            <div class="bz-fp-wrap">
                <div id="bz-fp-content">
                    <div class="bz-state-msg">
                        <i class="ti ti-loader-2 bz-spin" style="font-size:20px"></i>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="bz-not-connected">
                <i class="ti ti-file-off"></i>
                <h2>Nessuna tavola</h2>
                <p>Collega Fieldwire per accedere alle tavole.</p>
            </div>
            {% endif %}
        </div>

    </div>
</div>

<script>
const WID = {{ worksite_id }};
const FWP = {{ fieldwire_project_id ? '"' ~ fieldwire_project_id ~ '"' : 'null' }};

const $ = id => document.getElementById(id);

/* ── Tabs ── */
document.querySelectorAll('.bz-nav-tab').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.bz-nav-tab').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.bz-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        $('panel-' + btn.dataset.tab)?.classList.add('active');
        if (btn.dataset.tab === 'floorplans') loadFloorplans();
    });
});

/* ── Utils ── */
function initials(name) {
    return (name || '?').split(' ').filter(Boolean).map(w => w[0]).join('').toUpperCase().slice(0, 2);
}
function ago(str) {
    if (!str) return '';
    const s = Math.floor((Date.now() - new Date(str)) / 1000);
    if (s < 60) return 'adesso';
    if (s < 3600) return Math.floor(s / 60) + 'm fa';
    if (s < 86400) return Math.floor(s / 3600) + 'h fa';
    return new Date(str).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit' });
}
function pill(s) {
    const m = {
        open:       ['bz-pill-open',     'Aperto'],
        in_progress:['bz-pill-progress', 'In corso'],
        complete:   ['bz-pill-done',     'Completato'],
        completed:  ['bz-pill-done',     'Completato'],
        verified:   ['bz-pill-verified', 'Verificato'],
    };
    const [cls, label] = m[(s||'').toLowerCase()] || ['bz-pill-open', s || 'Aperto'];
    return `<span class="bz-pill ${cls}">${label}</span>`;
}
async function api(url, opts = {}) {
    const r = await fetch(url, opts);
    return r.json();
}

/* ════════════ TASKS ════════════ */
async function loadTasks() {
    const list = $('bz-task-list');
    if (!list) return;
    const res = await api(`/worksites/${WID}/zone/tasks`);
    if (!res.ok || !res.data?.length) {
        list.innerHTML = '<div class="bz-state-msg">Nessun task trovato.</div>';
        return;
    }
    list.innerHTML = res.data.map(t => `
        <div class="bz-task-item" data-id="${t.id}"
             onclick="openTask(${JSON.stringify(t).replace(/"/g,'&quot;')})">
            <div class="bz-task-item-name">${t.name || 'Task senza titolo'}</div>
            <div class="bz-task-item-foot">
                ${pill(t.status)}
                ${t.assignee_name
                    ? `<span class="bz-task-user"><i class="ti ti-user"></i>${t.assignee_name}</span>`
                    : ''}
            </div>
        </div>
    `).join('');
}

function openTask(task) {
    document.querySelectorAll('.bz-task-item').forEach(el =>
        el.classList.toggle('active', el.dataset.id == task.id));

    $('bz-detail').innerHTML = `
        <div class="bz-detail-head">
            <div class="bz-detail-title">${task.name || 'Task'}</div>
            <div class="bz-detail-attrs">
                ${pill(task.status)}
                ${task.assignee_name
                    ? `<span class="bz-detail-attr"><i class="ti ti-user"></i>${task.assignee_name}</span>`
                    : ''}
                ${task.category_name
                    ? `<span class="bz-detail-attr"><i class="ti ti-tag"></i>${task.category_name}</span>`
                    : ''}
                ${task.due_date
                    ? `<span class="bz-detail-attr"><i class="ti ti-calendar"></i>${new Date(task.due_date).toLocaleDateString('it-IT')}</span>`
                    : ''}
            </div>
        </div>
        <div class="bz-detail-cols">
            <div class="bz-col">
                <div class="bz-col-head">Checklist</div>
                <div class="bz-col-scroll" id="bz-checks-${task.id}">
                    <div class="bz-state-msg"><i class="ti ti-loader-2 bz-spin"></i></div>
                </div>
            </div>
            <div class="bz-col">
                <div class="bz-col-head">Messaggi</div>
                <div class="bz-feed" id="bz-feed-${task.id}">
                    <div class="bz-state-msg"><i class="ti ti-loader-2 bz-spin"></i></div>
                </div>
                <div class="bz-chat-bar">
                    <textarea class="bz-chat-input" id="bz-msg-${task.id}"
                              placeholder="Scrivi un messaggio..." rows="2"
                              onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMsg('${task.id}')}"></textarea>
                    <button class="bz-chat-send" id="bz-send-${task.id}" onclick="sendMsg('${task.id}')">
                        <i class="ti ti-send"></i>
                    </button>
                </div>
            </div>
        </div>
    `;

    loadChecklist(task.id);
    loadBubbles(task.id);
}

/* ── Checklist ── */
async function loadChecklist(taskId) {
    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/check-items`);
    const el  = $(`bz-checks-${taskId}`);
    if (!el) return;
    if (!res.ok || !res.data?.length) {
        el.innerHTML = '<div class="bz-state-msg" style="padding:16px 0;">Nessun elemento.</div>';
        return;
    }
    el.innerHTML = res.data.map(c => `
        <div class="bz-check-item">
            <input type="checkbox" id="chk-${c.id}" ${c.completed ? 'checked' : ''}
                   onchange="toggleCheck('${taskId}','${c.id}',this)">
            <label for="chk-${c.id}" class="bz-check-label ${c.completed ? 'done' : ''}">${c.name}</label>
        </div>
    `).join('');
}

async function toggleCheck(taskId, checkId, cb) {
    cb.disabled = true;
    const label = cb.nextElementSibling;
    if (cb.checked) {
        await api(`/worksites/${WID}/zone/tasks/${taskId}/check-items/${checkId}/complete`, { method: 'POST' });
        label?.classList.add('done');
    } else {
        label?.classList.remove('done');
    }
    cb.disabled = false;
}

/* ── Bubbles ── */
async function loadBubbles(taskId) {
    const res  = await api(`/worksites/${WID}/zone/tasks/${taskId}/bubbles`);
    const feed = $(`bz-feed-${taskId}`);
    if (!feed) return;
    if (!res.ok || !res.data?.length) {
        feed.innerHTML = '<div class="bz-state-msg" style="padding:16px 0;">Nessun messaggio.</div>';
        return;
    }
    feed.innerHTML = res.data.map(b => {
        const name  = b.creator_name || b.creator_email || '?';
        const photo = b.file_url
            ? `<img src="${b.file_url}" class="bz-bubble-img"
                    onclick="window.open('${b.file_url}','_blank')" alt="foto">`
            : '';
        return `
            <div class="bz-bubble">
                <div class="bz-avatar">${initials(name)}</div>
                <div class="bz-bubble-body">
                    <div class="bz-bubble-meta">
                        <span class="bz-bubble-author">${name}</span>
                        <span class="bz-bubble-time">${ago(b.fw_created_at || b.created_at)}</span>
                    </div>
                    ${b.text ? `<div class="bz-bubble-text">${b.text}</div>` : ''}
                    ${photo}
                </div>
            </div>`;
    }).join('');
    feed.scrollTop = feed.scrollHeight;
}

async function sendMsg(taskId) {
    const inp  = $(`bz-msg-${taskId}`);
    const btn  = $(`bz-send-${taskId}`);
    const text = inp?.value?.trim();
    if (!text) return;
    btn.disabled = true;
    inp.disabled = true;
    const res = await api(`/worksites/${WID}/zone/tasks/${taskId}/bubbles`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
    });
    if (res.ok) {
        inp.value = '';
        await loadBubbles(taskId);
    } else {
        alert('Errore: ' + (res.error || 'impossibile inviare'));
    }
    btn.disabled = false;
    inp.disabled = false;
    inp.focus();
}

/* ════════════ FLOORPLANS ════════════ */
let fpLoaded = false;
async function loadFloorplans() {
    if (fpLoaded) return;
    fpLoaded = true;
    const res = await api(`/worksites/${WID}/zone/floorplans`);
    const el  = $('bz-fp-content');
    if (!el) return;
    if (!res.ok || !res.data?.length) {
        el.innerHTML = '<div class="bz-state-msg">Nessuna tavola trovata.</div>';
        return;
    }
    el.innerHTML = `<div class="bz-fp-grid">${res.data.map(f => `
        <div class="bz-fp-card">
            <i class="ti ti-file bz-fp-icon"></i>
            <div class="bz-fp-name">${f.name || 'Tavola'}</div>
            ${f.sheets_count ? `<div class="bz-fp-meta">${f.sheets_count} fogli</div>` : ''}
            <a href="https://app.fieldwire.com" target="_blank" class="bz-fp-link">
                <i class="ti ti-external-link" style="font-size:12px"></i>
                Apri in Fieldwire
            </a>
        </div>`).join('')}
    </div>`;
}

/* ════════════ CONNECT ════════════ */
['btn-fw-connect','btn-fw-enable'].forEach(id => {
    const btn = $(id);
    if (!btn) return;
    btn.addEventListener('click', async () => {
        if (!confirm('Creare il progetto Fieldwire per questo cantiere?')) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2 bz-spin"></i> Collegamento...';
        const res = await api(`/worksites/${WID}/zone/enable`, { method: 'POST' });
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Errore: ' + (res.error || 'sconosciuto'));
            btn.disabled = false;
        }
    });
});

/* ════════════ INIT ════════════ */
if (FWP) loadTasks();
</script>
</body>
</html>
