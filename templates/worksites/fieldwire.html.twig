<script nonce="{{ cspNonce }}">
const WID = {{ worksite_id }};
const CSRF = '{{ csrfToken }}';

// I permessi anche qui: meta' dei bottoni li disegna il JavaScript, e un
// controllo fatto solo in Twig non li tocca. Il server rifiuta comunque —
// ogni endpoint si guarda da solo — ma un bottone che risponde 403 sembra
// un guasto, e chi lo trova continua a premerlo.
const ACC = {{ accessi|json_encode|raw }};
const DA_UFFICIO = {{ daUfficio ? 'true' : 'false' }};
// il ruolo su questo cantiere: ufficio, cantiere o cliente
const RUOLO = {{ ruolo|default('')|json_encode|raw }};
const IO    = {{ (user.id ?? 0)|json_encode|raw }};
// come chiama il cliente questo cantiere: {nome, codice} o null
let RIF     = {{ (riferimento ?? null)|json_encode|raw }};

/* Il riferimento del cliente: lui lo vede (e lo cambia) accanto al nome
   del cantiere, l'ufficio nel riquadro Cantiere. */
function rifTesto(r) { return r ? [r.nome, r.codice].filter(Boolean).join(' · ') : ''; }
function mostraRif() {
    const b = document.getElementById('bz-rif'), info = document.getElementById('bz-rif-info');
    if (RUOLO === 'cliente' && b) {
        b.hidden = false;
        b.innerHTML = RIF ? '<i class="fas fa-tag"></i> ' + escHtml(rifTesto(RIF)) + ' <i class="fas fa-pen" style="font-size:10px;opacity:.6"></i>'
                          : '<i class="fas fa-tag"></i> Aggiungi il tuo nome o codice commessa';
    }
    if (RUOLO !== 'cliente' && info && RIF) {
        info.hidden = false;
        info.querySelector('span').textContent = 'Per il cliente: ' + rifTesto(RIF);
    }
}
document.addEventListener('DOMContentLoaded', mostraRif);
// Chi ha il permesso Zone ma non e' nell'elenco: si aggiunge come CSM con
