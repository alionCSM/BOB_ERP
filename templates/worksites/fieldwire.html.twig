let quickAddStatus = null;

function quickAdd(status) {
    quickAddStatus = status;
    document.getElementById('task-status').value = status;
    openModal();
}

function openModal() {
    document.getElementById('task-modal').classList.remove('hidden');
    document.getElementById('task-name').focus();
}
function closeModal() {
    document.getElementById('task-modal').classList.add('hidden');
    quickAddStatus = null;
    ['task-name','task-desc','task-cat','task-assignee','task-due','task-start'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
    document.getElementById('task-status').value = 'open';
}

async function submitTask() {
    const name = document.getElementById('task-name').value.trim();
    if (!name) { document.getElementById('task-name').focus(); return; }

    const aSel = document.getElementById('task-assignee');
    const body = {
        name,
        description:      document.getElementById('task-desc').value,
        status:          document.getElementById('task-status').value,
        category:        document.getElementById('task-cat').value,
        assignee_user_id: aSel.value || null,
        assignee_name:   aSel.value ? (aSel.options[aSel.selectedIndex]?.text || null) : null,
        due_date:        document.getElementById('task-due').value || null,
        start_date:      document.getElementById('task-start').value || null,
    };

    const btn = document.querySelector('.bz-modal-submit');
    btn.textContent = '...'; btn.disabled = true;

    const res = await api(`/worksites/${WID}/zone/tasks`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
    });

    btn.textContent = 'Crea Task'; btn.disabled = false;

    if (res.ok) {
        allTasks.unshift(res.data);
        closeModal();
        renderCurrentView();
        openTask(res.data.id);
    } else {
        alert('Errore: ' + (res.error || 'impossibile creare il task'));
    }
}

