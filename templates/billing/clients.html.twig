{% extends "layout/base.html.twig" %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/billing/billing_clients.css">
{% endblock %}

{% block content %}
<div class="bc-page">

{# ── Hero ── #}
<div class="bc-hero">
    <div class="bc-hero-content">
        <div class="bc-hero-left">
            <div class="bc-hero-icon">
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <div>
                <h1 class="bc-hero-title">Fatture per Cliente</h1>
                <p class="bc-hero-sub">Riepilogo fatture da emettere ed emesse, raggruppate per cliente</p>
            </div>
        </div>
        <a href="/billing" class="bc-btn-back">
            <svg viewBox="0 0 24 24"><path d="M2 20h20"/><path d="M5 20V6l7-3 7 3v14"/></svg>
            Cantieri Movimentati
        </a>
    </div>
</div>

{# ── Apri dettaglio emesse-reale per un mese specifico (apre solo la modale, via AJAX) ── #}
{# Two native <select>s instead of <input type=month> for cross-browser parity (Safari desktop) #}
{% set _ymParts  = defaultPickerValue|split('-') %}
{% set _ymYear   = _ymParts[0] + 0 %}
{% set _ymMonth  = _ymParts[1] + 0 %}
{% set _curYear  = "now"|date("Y") + 0 %}
{% set _monthsIt = {
    1:'Gennaio', 2:'Febbraio', 3:'Marzo', 4:'Aprile', 5:'Maggio', 6:'Giugno',
    7:'Luglio', 8:'Agosto', 9:'Settembre', 10:'Ottobre', 11:'Novembre', 12:'Dicembre'
} %}
<form id="bc-picker-form" class="bc-period-picker">
    <label class="bc-period-label">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Apri dettaglio emesse di un altro mese
    </label>
    <select id="bc-pick-month" name="bc-pick-month" class="bc-period-input" required>
        {% for n, label in _monthsIt %}
            <option value="{{ '%02d'|format(n) }}"{{ n == _ymMonth ? ' selected' : '' }}>{{ label }}</option>
        {% endfor %}
    </select>
    <select id="bc-pick-year" name="bc-pick-year" class="bc-period-input" required>
        {% for y in (_curYear)..(_curYear - 5) %}
            <option value="{{ y }}"{{ y == _ymYear ? ' selected' : '' }}>{{ y }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="bc-period-btn">Apri dettaglio</button>
</form>

{# ── Stats Row ── #}
<div class="bc-stats">
    {# Emesse reale — mese corrente (da YARD) — cliccabile, apre modale #}
    <div class="bc-stat bc-stat-clickable" data-er-period="cur" data-er-label="{{ emessRealCurLabel }}" style="cursor:pointer;">
        <div class="bc-stat-dot" style="background:#0ea5e9;box-shadow:0 0 6px rgba(14,165,233,.4);"></div>
        <div>
            <div class="er-period-pill er-period-pill-cur">{{ emessRealCurLabel }}</div>
            <div class="bc-stat-value" style="color:#0284c7;">{{ emessRealCur.count }}</div>
            <div class="bc-stat-sub">€ {{ emessRealCur.imponibile|number_format(2, ',', '.') }}</div>
            <div class="bc-stat-label">Emesse reale</div>
        </div>
    </div>
    {# Emesse reale — mese precedente (da YARD) — cliccabile, apre modale #}
    <div class="bc-stat bc-stat-clickable" data-er-period="prev" data-er-label="{{ emessRealPrevLabel }}" style="cursor:pointer;">
        <div class="bc-stat-dot" style="background:#6366f1;box-shadow:0 0 6px rgba(99,102,241,.4);"></div>
        <div>
            <div class="er-period-pill er-period-pill-prev">{{ emessRealPrevLabel }}</div>
            <div class="bc-stat-value" style="color:#4f46e5;">{{ emessRealPrev.count }}</div>
            <div class="bc-stat-sub">€ {{ emessRealPrev.imponibile|number_format(2, ',', '.') }}</div>
            <div class="bc-stat-label">Emesse reale</div>
        </div>
    </div>
    <div class="bc-stat">
        <div class="bc-stat-dot" style="background:#ef4444;box-shadow:0 0 6px rgba(239,68,68,.4);"></div>
        <div>
            <div class="bc-stat-value" style="color:#dc2626;">{{ totDaEmettere }}</div>
            <div class="bc-stat-sub">€ {{ totEuroDa|number_format(2, ',', '.') }}</div>
            <div class="bc-stat-label">Da emettere <span style="opacity:.55;font-size:10px;">({{ currentYear }})</span></div>
        </div>
    </div>
    <div class="bc-stat">
        <div class="bc-stat-dot" style="background:#22c55e;box-shadow:0 0 6px rgba(34,197,94,.4);"></div>
        <div>
            <div class="bc-stat-value" style="color:#16a34a;">{{ totEmesse }}</div>
            <div class="bc-stat-sub">€ {{ totEuroEm|number_format(2, ',', '.') }}</div>
            <div class="bc-stat-label">Emesse <span style="opacity:.55;font-size:10px;">({{ currentYear }})</span></div>
        </div>
    </div>
    <div class="bc-stat">
        <div class="bc-stat-dot" style="background:#f59e0b;box-shadow:0 0 6px rgba(245,158,11,.4);"></div>
        <div>
            <div class="bc-stat-value">{{ totDaEmettere + totEmesse }}</div>
            <div class="bc-stat-label">Totale <span style="opacity:.55;font-size:10px;">({{ currentYear }})</span></div>
        </div>
    </div>
</div>

{# ── Filters ── #}
<div class="bc-filters">
    <div class="bc-search-wrap">
        <svg class="bc-search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="search-input" type="text" placeholder="Cerca cliente…">
    </div>
</div>

{# ── Counter ── #}
<div class="bc-counter">
    <p class="bc-counter-text"><strong id="bc-count">{{ clients|length }}</strong> clienti</p>
</div>

{# ── Table ── #}
<div class="bc-table-wrap">
    {% if clients is empty %}
    <div class="bc-empty">
        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <p class="bc-empty-text">Nessuna fattura registrata.</p>
    </div>
    {% else %}
    {# ── Macro: render una riga cliente ── #}
    {% macro client_row(c, prospettiDone, lastProspettoDone, suggestedYear, suggestedMonth, mesiNomi) %}
        {% set done = prospettiDone[c.id] is defined ? prospettiDone[c.id] : null %}
        {% set last = lastProspettoDone[c.id] is defined ? lastProspettoDone[c.id] : null %}
        {% set lastPeriodNum = last ? (last.year * 12 + last.month) : 0 %}
        {% set suggestedNum  = suggestedYear * 12 + suggestedMonth %}
        {# behind = ultimo done strettamente prima del periodo suggerito #}
        {% set behind = last and lastPeriodNum < suggestedNum %}
        <tr class="client-row" data-name="{{ c.name|lower }}">
            <td><span class="bc-name">{{ c.name }}</span></td>
            <td class="center">
                {% if c.da_emettere_count > 0 %}
                    <span class="bc-count-danger">{{ c.da_emettere_count }}</span>
                {% else %}
                    <span class="bc-count-zero">0</span>
                {% endif %}
            </td>
            <td class="right">
                {% if c.da_emettere_euro > 0 %}
                    <span class="bc-euro-danger">€ {{ c.da_emettere_euro|number_format(2, ',', '.') }}</span>
                {% else %}
                    <span class="bc-dash">—</span>
                {% endif %}
            </td>
            <td class="center" style="color:#64748b;">{{ c.emesse_count }}</td>
            <td class="right" style="color:#64748b;">
                {% if c.emesse_euro > 0 %}
                    € {{ c.emesse_euro|number_format(2, ',', '.') }}
                {% else %}
                    <span class="bc-dash">—</span>
                {% endif %}
            </td>
            <td class="center bc-prospetto-cell">
                {# Riga 1: stato del periodo SUGGERITO (chip verde se fatto, button se no) #}
                {% if done %}
                    <button type="button"
                            class="bc-prospetto-chip"
                            data-action="open-prospetto-modal"
                            data-client-id="{{ c.id }}"
                            data-client-name="{{ c.name }}"
                            data-done-year="{{ done.year }}"
                            data-done-month="{{ done.month }}"
                            title="Prospetto già marcato come fatto. Clicca per cambiare o rimuovere.">
                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        {{ mesiNomi[done.month] }} {{ done.year }}
                    </button>
                {% else %}
                    <button type="button"
                            class="bc-prospetto-btn"
                            data-action="open-prospetto-modal"
                            data-client-id="{{ c.id }}"
                            data-client-name="{{ c.name }}">
                        Marca come fatto
                    </button>
                {% endif %}
                {# Riga 2: indicatore 'Ultimo: <Mese Anno>' — rosso se in ritardo,
                   muted se è già il periodo suggerito (già coperto dal chip sopra) #}
                {% if last and not done %}
                    <div class="bc-prospetto-last {{ behind ? 'is-behind' : 'is-uptodate' }}"
                         title="Ultimo prospetto marcato per questo cliente">
                        Ultimo: {{ mesiNomi[last.month] }} {{ last.year }}
                    </div>
                {% elseif not last %}
                    <div class="bc-prospetto-last is-never">Mai segnato</div>
                {% endif %}
            </td>
            <td class="right">
                <a href="/billing/client/{{ c.id }}" class="bc-btn-detail">
                    Dettaglio
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </td>
        </tr>
    {% endmacro %}
    {% import _self as bc %}

    {% set mesiNomi = ['', 'Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'] %}

    <table class="bc-table" id="clients-table">
        <thead>
        <tr>
            <th>Cliente</th>
            <th class="center">Da emettere</th>
            <th class="right">Importo da emettere</th>
            <th class="center">Emesse</th>
            <th class="right">Importo emesso</th>
            <th class="center" style="width:200px;">Prospetto {{ mesiNomi[suggestedMonth] }} {{ suggestedYear }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {# Single visual table: clienti con importo da emettere prima (A→Z),
           poi quelli senza (A→Z). Stesso <tbody>, niente divisori. #}
        {% for c in clientsConImporto %}
            {{ bc.client_row(c, prospettiDone, lastProspettoDone, suggestedYear, suggestedMonth, mesiNomi) }}
        {% endfor %}
        {% for c in clientsSenzaImporto %}
            {{ bc.client_row(c, prospettiDone, lastProspettoDone, suggestedYear, suggestedMonth, mesiNomi) }}
        {% endfor %}
        </tbody>
    </table>

    {# ── Modal Prospetto fatto ── #}
    <div id="bc-prospetto-modal" class="bc-prospetto-modal" style="display:none;"
         data-suggested-year="{{ suggestedYear }}" data-suggested-month="{{ suggestedMonth }}">
        <div class="bc-prospetto-modal-backdrop" data-close></div>
        <div class="bc-prospetto-modal-dialog">
            <div class="bc-prospetto-modal-head">
                <div class="bc-prospetto-modal-icon">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                    <h3 class="bc-prospetto-modal-title">Prospetto fatto e mandato</h3>
                    <p class="bc-prospetto-modal-sub" id="bc-prospetto-client-name">—</p>
                </div>
                <button type="button" class="bc-prospetto-modal-close" data-close>&times;</button>
            </div>
            <div class="bc-prospetto-modal-body">
                <p class="bc-prospetto-text">
                    Sarà marcato come <strong>prospetto fatto e mandato</strong> per
                    <strong id="bc-prospetto-period-label">—</strong>.
                </p>
                <button type="button" class="bc-prospetto-change-link" id="bc-prospetto-change-link">
                    Clicca qui per cambiare mese
                </button>
                <div class="bc-prospetto-period-selector" id="bc-prospetto-period-selector" style="display:none;">
                    <label>Mese</label>
                    <select id="bc-prospetto-month">
                        {% for i in 1..12 %}
                            <option value="{{ i }}"{% if i == suggestedMonth %} selected{% endif %}>{{ mesiNomi[i] }}</option>
                        {% endfor %}
                    </select>
                    <label>Anno</label>
                    <select id="bc-prospetto-year">
                        {% for y in (currentYear - 1)..(currentYear + 1) %}
                            <option value="{{ y }}"{% if y == suggestedYear %} selected{% endif %}>{{ y }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="bc-prospetto-modal-err" id="bc-prospetto-err" style="display:none;"></div>
            </div>
            <div class="bc-prospetto-modal-foot">
                <button type="button" class="bc-prospetto-btn-unmark" id="bc-prospetto-unmark" style="display:none;">
                    Rimuovi marcatura
                </button>
                <span style="flex:1"></span>
                <button type="button" class="bc-prospetto-btn-cancel" data-close>Annulla</button>
                <button type="button" class="bc-prospetto-btn-confirm" id="bc-prospetto-confirm">Conferma</button>
            </div>
        </div>
    </div>
    <div id="bc-no-results" class="bc-empty" style="display:none;">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <p class="bc-empty-text">Nessun cliente trovato.</p>
    </div>
    {% endif %}
</div>

{# ── Modale "Emesse reale" — mostra le righe del mese cliccato ── #}
<div id="er-modal" class="er-modal" aria-hidden="true">
    <div class="er-modal-backdrop" data-er-close></div>
    <div class="er-modal-dialog" role="dialog" aria-modal="true">
        <div class="er-modal-header">
            <h2 class="er-modal-title">Fatture emesse reale — <span id="er-modal-period">—</span></h2>
            <button type="button" class="er-modal-close" data-er-close aria-label="Chiudi">×</button>
        </div>
        <div class="er-modal-body">
            {% set periods = [
                { key: 'cur',  fatture: emessRealCurFatture,  total: emessRealCurRowsTotal  },
                { key: 'prev', fatture: emessRealPrevFatture, total: emessRealPrevRowsTotal }
            ] %}
            {# AJAX-injected panel for the picker (rendered server-side as a fragment) #}
            <div id="er-picked-panel" data-er-rows="picked" style="display:none;"></div>
            {% for p in periods %}
                <div class="er-rows" data-er-rows="{{ p.key }}" style="display:none;">
                    {% if p.fatture is empty %}
                        <p class="er-empty">Nessuna fattura emessa nel periodo.</p>
                    {% else %}
                        <div style="overflow-x:auto;">
                            <table class="er-table er-fatture-table">
                                <thead>
                                    <tr>
                                        <th style="width:32px;"></th>
                                        <th>Data</th>
                                        <th>Numero</th>
                                        <th>Cliente</th>
                                        <th class="center">Voci</th>
                                        <th class="right">Imponibile</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for f in p.fatture %}
                                        <tr class="er-fattura-row" data-er-toggle="{{ p.key }}-{{ loop.index }}">
                                            <td class="er-toggle-cell">
                                                <span class="er-chevron">▸</span>
                                            </td>
                                            <td style="white-space:nowrap;">{{ f.data ? f.data|date('d/m/Y') : '—' }}</td>
                                            <td style="white-space:nowrap; font-weight:600;">{{ f.numero_label }}</td>
                                            <td>
                                                {% if f.clienti is empty %}
                                                    —
                                                {% else %}
                                                    {{ f.clienti|join(', ') }}
                                                {% endif %}
                                            </td>
                                            <td class="center">{{ f.rows|length }}</td>
                                            <td class="right" style="font-weight:600;">€ {{ f.totale|number_format(2, ',', '.') }}</td>
                                        </tr>
                                        <tr class="er-fattura-detail" data-er-detail="{{ p.key }}-{{ loop.index }}" style="display:none;">
                                            <td></td>
                                            <td colspan="5" style="padding:0;">
                                                <table class="er-detail-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Cantiere</th>
                                                            <th>Descrizione</th>
                                                            <th class="right">Imponibile</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for r in f.rows %}
                                                        <tr>
                                                            <td>{{ r.nome_cantiere ?: '—' }}</td>
                                                            <td style="max-width:520px;">{{ r.descrizione ?: '—' }}</td>
                                                            <td class="right">€ {{ (r.totale_imponibile ?? 0)|number_format(2, ',', '.') }}</td>
                                                        </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="5" class="right" style="font-weight:600;">Totale</td>
                                        <td class="right" style="font-weight:600;">
                                            € {{ p.total|number_format(2, ',', '.') }}
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<style nonce="{{ cspNonce }}">
.bc-period-picker {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin: 4px 0 16px 0; padding: 10px 14px;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
}
.bc-period-label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #475569; font-weight: 500; }
.bc-period-input {
    height: 34px; padding: 0 10px; border: 1px solid #cbd5e1; border-radius: 6px;
    font-size: 13px; color: #0f172a; background: #fff;
}
.bc-period-input:focus { outline: 2px solid rgba(99,102,241,.25); border-color: #6366f1; }
.bc-period-btn {
    height: 34px; padding: 0 14px; border: 0; border-radius: 6px;
    background: #6366f1; color: #fff; font-size: 13px; font-weight: 500; cursor: pointer;
}
.bc-period-btn:hover { background: #4f46e5; }
.bc-period-reset { font-size: 12px; color: #64748b; text-decoration: underline; margin-left: 4px; }
.bc-period-reset:hover { color: #0f172a; }

.bc-stat-clickable { transition: transform .12s ease, box-shadow .12s ease; }
.bc-stat-clickable:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,.06); }

/* Period pill — calls out the month/year on each emesse-reale card */
.er-period-pill {
    display: inline-block;
    font-size: 12px; font-weight: 700; letter-spacing: .3px;
    padding: 3px 10px; border-radius: 999px;
    margin-bottom: 6px; text-transform: uppercase;
}
.er-period-pill-cur  { background: #e0f2fe; color: #0369a1; }
.er-period-pill-prev { background: #e0e7ff; color: #4338ca; }

.er-modal { position: fixed; inset: 0; display: none; z-index: 1000; }
.er-modal.is-open { display: block; }
.er-modal-backdrop { position: absolute; inset: 0; background: rgba(15,23,42,.55); backdrop-filter: blur(2px); }
.er-modal-dialog {
    position: relative; max-width: 1100px; width: calc(100% - 32px);
    margin: 40px auto; background: #fff; border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0,0,0,.35); overflow: hidden;
}
.er-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; border-bottom: 1px solid #e2e8f0;
}
.er-modal-title { font-size: 16px; font-weight: 600; margin: 0; color: #0f172a; }
.er-modal-close {
    background: transparent; border: 0; font-size: 26px; line-height: 1;
    color: #64748b; cursor: pointer; padding: 4px 8px;
}
.er-modal-close:hover { color: #0f172a; }
.er-modal-body { padding: 16px 20px; max-height: 70vh; overflow-y: auto; }
.er-empty { color: #64748b; text-align: center; padding: 32px 0; margin: 0; }
.er-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.er-table thead th { background: #f1f5f9; text-align: left; padding: 8px 10px; font-weight: 600; color: #475569; border-bottom: 1px solid #e2e8f0; }
.er-table tbody td { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; color: #1e293b; }
.er-table tbody tr:hover { background: #f8fafc; }
.er-table .right, .er-table thead th.right { text-align: right; }
.er-table tfoot td { padding: 10px; background: #f8fafc; border-top: 1px solid #e2e8f0; }
.er-table .center, .er-table thead th.center { text-align: center; }

.er-fattura-row { cursor: pointer; }
.er-toggle-cell { width: 32px; }
.er-chevron { display: inline-block; transition: transform .15s ease; color: #64748b; font-size: 11px; }
.er-fattura-row.is-open .er-chevron { transform: rotate(90deg); color: #0f172a; }

.er-fattura-detail td { background: #f8fafc; }
.er-detail-table { width: 100%; border-collapse: collapse; font-size: 12px; margin: 4px 0 8px 0; }
.er-detail-table thead th { background: transparent; color: #64748b; font-weight: 500; padding: 6px 10px; border-bottom: 1px dashed #cbd5e1; text-align: left; }
.er-detail-table thead th.right { text-align: right; }
.er-detail-table tbody td { padding: 6px 10px; border-bottom: 1px dashed #e2e8f0; }
.er-detail-table tbody tr:last-child td { border-bottom: 0; }
.er-detail-table .right { text-align: right; }
</style>

<script nonce="{{ cspNonce }}">
(function () {
    var modal      = document.getElementById('er-modal');
    if (!modal) return;
    var titleSpan  = document.getElementById('er-modal-period');
    var rowGroups  = modal.querySelectorAll('[data-er-rows]');

    function openFor(period, label) {
        titleSpan.textContent = label || '';
        rowGroups.forEach(function (g) {
            g.style.display = (g.getAttribute('data-er-rows') === period) ? '' : 'none';
        });
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
    }

    function close() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('.bc-stat-clickable').forEach(function (card) {
        card.addEventListener('click', function () {
            openFor(card.getAttribute('data-er-period'), card.getAttribute('data-er-label'));
        });
    });

    modal.querySelectorAll('[data-er-close]').forEach(function (el) {
        el.addEventListener('click', close);
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
    });

    // Toggle expansion of a single fattura row → its detail row.
    // Delegated so dynamically-injected AJAX rows work too.
    modal.addEventListener('click', function (e) {
        var row = e.target.closest('.er-fattura-row');
        if (!row || !modal.contains(row)) return;
        var key = row.getAttribute('data-er-toggle');
        var detail = modal.querySelector('[data-er-detail="' + key + '"]');
        if (!detail) return;
        var open = row.classList.toggle('is-open');
        detail.style.display = open ? '' : 'none';
    });

    // Picker form → fetch fragment, inject into picked panel, open modal
    var pickerForm = document.getElementById('bc-picker-form');
    var pickerBtn  = pickerForm ? pickerForm.querySelector('button[type=submit]') : null;
    var pickedPanel = document.getElementById('er-picked-panel');

    function monthLabelIt(ym) {
        var labels = ['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'];
        var p = (ym || '').split('-');
        if (p.length !== 2) return ym;
        var idx = parseInt(p[1], 10) - 1;
        if (idx < 0 || idx > 11) return ym;
        return labels[idx] + ' ' + p[0];
    }

    if (pickerForm && pickedPanel) {
        pickerForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var ySel = document.getElementById('bc-pick-year');
            var mSel = document.getElementById('bc-pick-month');
            var y = ySel ? ySel.value : '';
            var mm = mSel ? mSel.value : '';
            if (!/^\d{4}$/.test(y) || !/^\d{2}$/.test(mm)) return;
            var ym = y + '-' + mm;

            // Don't request a future month — Yard wouldn't have data
            var now = new Date();
            var nowYm = now.getFullYear() + '-' + ('0' + (now.getMonth() + 1)).slice(-2);
            if (ym > nowYm) {
                alert('Il mese selezionato è nel futuro.');
                return;
            }

            var label = monthLabelIt(ym);
            if (pickerBtn) { pickerBtn.disabled = true; pickerBtn.textContent = 'Caricamento…'; }
            pickedPanel.innerHTML = '<p class="er-empty">Caricamento…</p>';
            openFor('picked', label);

            fetch('/billing/clients/emesse-month?month=' + encodeURIComponent(ym), {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(function (html) {
                pickedPanel.innerHTML = html;
            })
            .catch(function (err) {
                pickedPanel.innerHTML = '<p class="er-empty">Errore caricamento: ' + (err && err.message ? err.message : 'sconosciuto') + '</p>';
            })
            .finally(function () {
                if (pickerBtn) { pickerBtn.disabled = false; pickerBtn.textContent = 'Apri dettaglio'; }
            });
        });
    }
})();
</script>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/billing/clients.js"></script>
{% endblock %}
