{# Dashboard dinamica: scorciatoie e contatori costruiti sui permessi
   dell'utente (bb_user_permissions). Variabili da dataForDynamic():
   name, greeting, todayStr, shortcuts[], stats[], recentNotifications[] #}
<link rel="stylesheet" href="/assets/css/views/dashboard/partials/dashboard_documents.css">

<div class="dd-page">

    <!-- ── HERO ────────────────────────────────── -->
    <div class="dd-hero">
        <div class="dd-hero-content">
            <h1 class="dd-greeting">{{ greeting }}, {{ name }}</h1>
            <p class="dd-date">{{ todayStr }}</p>
        </div>
        <div class="dd-hero-pills">
            {% for s in stats|slice(0, 3) %}
            <div class="dd-hero-pill">
                <span class="dd-hero-pill-num">{{ s.num }}</span> {{ s.label }}
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- ── STAT CARDS ──────────────────────────── -->
    {% if stats is not empty %}
    <div class="dd-stats">
        {% for s in stats %}
        <a href="{{ s.href }}" class="dd-stat">
            <div class="dd-stat-icon" style="background:{{ s.bg }};">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="{{ s.color }}" stroke-width="2"><path d="{{ s.icon }}"/></svg>
            </div>
            <div>
                <div class="dd-stat-value" style="color:{{ s.color }};">{{ s.num }}</div>
                <div class="dd-stat-label">{{ s.label }}</div>
                <div class="dd-stat-sub">{{ s.sub }}</div>
            </div>
        </a>
        {% endfor %}
    </div>
    {% endif %}

    <div class="dd-grid-2">

        <!-- ── SCORCIATOIE ─────────────────────── -->
        <div class="dd-section">
            <div class="dd-section-head">
                <h3 class="dd-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
                    Le tue aree
                </h3>
                <span class="dd-section-badge" style="background:#f5f3ff;color:#6366f1;">{{ shortcuts|length }}</span>
            </div>
            <div class="dd-section-body">
                {% if shortcuts is empty %}
                    <div class="dd-empty">
                        Nessun modulo assegnato al tuo utente.<br>
                        Chiedi a un amministratore di configurare i tuoi permessi.
                    </div>
                {% else %}
                    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:10px;">
                        {% for s in shortcuts %}
                            <a href="{{ s.href }}" style="display:flex;align-items:center;gap:12px;padding:13px 15px;border-radius:12px;border:1.5px solid #e8edf3;background:#fff;text-decoration:none;transition:all .15s;">
                                <div style="width:38px;height:38px;border-radius:10px;background:{{ s.bg }};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="{{ s.color }}" stroke-width="2"><path d="{{ s.icon }}"/></svg>
                                </div>
                                <div style="min-width:0;">
                                    <div style="font-size:13.5px;font-weight:700;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ s.label }}</div>
                                    <div style="font-size:11.5px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ s.sub }}</div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- ── NOTIFICHE ───────────────────────── -->
        <div class="dd-section">
            <div class="dd-section-head">
                <h3 class="dd-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
                    Cronologia Notifiche
                </h3>
                <span class="dd-section-badge" style="background:#f5f3ff;color:#6366f1;">{{ recentNotifications|length }}</span>
            </div>
            <div class="dd-section-body" style="max-height:420px;overflow-y:auto;">
                {% if recentNotifications is empty %}
                    <div class="dd-empty">Nessuna notifica recente</div>
                {% endif %}
                {% for notif in recentNotifications %}
                    {% set dotClass = notif.is_read ? 'dd-notif-dot-read' : 'dd-notif-dot-unread' %}
                    <div class="dd-notif-row">
                        <div class="dd-notif-dot {{ dotClass }}"></div>
                        <div class="dd-notif-info">
                            <div class="dd-notif-title">
                                {% if notif.link is not empty %}
                                    <a href="{{ notif.link }}">{{ notif.title|default('Notifica') }}</a>
                                {% else %}
                                    {{ notif.title|default('Notifica') }}
                                {% endif %}
                            </div>
                            {% if notif.message is not empty %}
                                <div class="dd-notif-msg">{{ notif.message }}</div>
                            {% endif %}
                            <div class="dd-notif-meta">
                                <span>{{ notif.created_by_name|default('Sistema') }}</span>
                            </div>
                        </div>
                        <div class="dd-notif-time">{{ notif.time_ago|default('') }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>

    </div>

</div>
