{% extends 'layout/base.html.twig' %}

{% block head %}
<link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
<style>
  .rn-hero {
      position: relative; overflow: hidden;
      border-radius: 18px;
      padding: 26px 30px 22px;
      background: linear-gradient(135deg, #0c1929 0%, #122444 40%, #1e3a5f 100%);
      color: #fff; margin: 16px 0 18px;
  }
  .rn-hero::before {
      content: ''; position: absolute; top: -80px; right: -40px;
      width: 220px; height: 220px; border-radius: 50%;
      background: rgba(245,158,11,.14); pointer-events: none;
  }
  .rn-hero-content { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; }
  .rn-hero-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: rgba(255,255,255,.1);
      display: flex; align-items: center; justify-content: center;
  }
  .rn-hero-icon svg { width: 22px; height: 22px; stroke: #fff; stroke-width: 1.5; fill: none; }
  .rn-hero-title { font-size: 20px; font-weight: 800; margin: 0 0 2px; }
  .rn-hero-sub { font-size: 13px; opacity: .55; margin: 0; }

  .rn-picker {
      background: #fff; border-radius: 14px; border: 1.5px solid #e8edf3;
      padding: 16px 20px; margin-bottom: 16px;
  }

  /* Righe mezzo in stile card */
  #mezzi-container .row-item {
      background: #fff !important;
      border: 1.5px solid #e8edf3;
      border-radius: 14px;
      padding: 16px 18px !important;
      position: relative;
  }
  #mezzi-container .row-item::before {
      content: ''; position: absolute; top: 0; left: 0; bottom: 0;
      width: 4px; background: #2563eb; border-radius: 14px 0 0 14px;
  }
  /* chips giorni settimana */
  .rn-days { display: flex; gap: 5px; flex-wrap: wrap; }
  .rn-day {
      min-width: 40px; padding: 7px 0; text-align: center;
      border-radius: 9px; border: 1.5px solid #dbe3ec;
      background: #fff; color: #94a3b8;
      font-size: 12px; font-weight: 700; cursor: pointer;
      transition: all .12s; user-select: none;
  }
  .rn-day:hover { border-color: #93c5fd; color: #3b82f6; }
  .rn-day.on {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      border-color: #2563eb; color: #fff;
      box-shadow: 0 2px 6px rgba(37,99,235,.25);
  }

  /* switch festivi */
  .rn-fest { display: inline-flex; align-items: center; gap: 9px; cursor: pointer; padding-top: 8px; user-select: none; }
  .rn-fest input { position: absolute; opacity: 0; }
  .rn-fest-track {
      width: 38px; height: 21px; border-radius: 999px;
      background: #cbd5e1; position: relative; transition: background .15s; flex: none;
  }
  .rn-fest-track::after {
      content: ''; position: absolute; top: 2.5px; left: 3px;
      width: 16px; height: 16px; border-radius: 50%;
      background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25);
      transition: transform .15s;
  }
  .rn-fest input:checked + .rn-fest-track { background: #16a34a; }
  .rn-fest input:checked + .rn-fest-track::after { transform: translateX(16px); }
  .rn-fest-label { font-size: 12.5px; font-weight: 600; color: #334155; }

  .cal-wrap.hidden { display: none; }
</style>
{% endblock %}

{% block content %}
<div class="rn-hero">
    <div class="rn-hero-content">
        <div class="rn-hero-icon">
            <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18M10 12h4"/></svg>
        </div>
        <div>
            <h1 class="rn-hero-title">Assegna Mezzi — Noleggio</h1>
            <p class="rn-hero-sub">Aggiungi mezzi di sollevamento a un cantiere</p>
        </div>
    </div>
</div>

<div class="rn-picker">
    <label class="form-label">Seleziona Cantiere</label>
    <select id="worksiteSelect" class="tomselect" placeholder="Cerca cantiere..."
            data-mezzi="{{ mezzi|json_encode }}"
            data-selected-value="{{ selectedOption.value ?? '' }}"
            data-selected-text="{{ selectedOption.text ?? '' }}"
    ></select>
</div>

{# TODO: 'selectedWorksite' comes from $_GET['worksite_id'] — passed from controller as `selectedWorksite` variable #}
{% if selectedWorksite %}
    <form method="POST">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <input type="hidden" name="worksite_id" value="{{ selectedWorksite }}">
        <input type="hidden" name="save_all" value="1">

        <div id="mezzi-container" class="mt-12 space-y-2">
            <div class="mt-2">
                <button
                        type="button"
                        id="copy-start-date"
                        class="btn btn-success"
                >
                    Copia Prima Data Inizio
                </button>
            </div>
            <!-- Prima riga -->
            <div class="row-item grid grid-cols-12 gap-2 items-end bg-gray-50 p-2 rounded">
                <div class="col-span-3">
                    <label class="form-label">Mezzo</label>
                    <select name="mezzo_id[]" class="form-select mezzo-select" required>
                        <option value="">-- Scegli mezzo --</option>
                        {% for m in mezzi %}
                            <option
                                    value="{{ m.id }}"
                                    data-special="{{ m.descrizione == 'Trasporto A/R' ? '1' : '0' }}"
                            >
                                {{ m.descrizione }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-span-2">
                    <label class="form-label">Tipo</label>
                    <select name="tipo_noleggio[]" class="form-select tipo-select">
                        <option value="Giornaliero">Giornaliero</option>
                        <option value="Settimanale">Settimanale</option>
                        <option value="Mensile">Mensile</option>
                        <option value="Una Tantum">Una Tantum</option>
                    </select>
                </div>

                <div class="col-span-2">
                    <label class="form-label">Quantità</label>
                    <input type="number" name="quantita[]" min="1" value="1" class="form-control" required>
                </div>

                <div class="col-span-2">
                    <label class="form-label costo-label">Costo (€/giorno)</label>
                    <input type="number" step="0.01" name="costo[]" class="form-control" required>
                </div>

                <div class="col-span-2">
                    <label class="form-label">Data Inizio</label>
                    <input type="date" name="data_inizio[]" class="form-control" required>
                </div>

                <div class="col-span-1">
                    <button type="button" class="btn btn-danger remove-row hidden">Elimina Riga</button>
                </div>

                {# Solo per Giornaliero: quali giorni si contano #}
                <div class="col-span-4 cal-wrap">
                    <label class="form-label">Giorni conteggiati</label>
                    <div class="rn-days">
                        <button type="button" class="rn-day on" data-day="1">Lun</button>
                        <button type="button" class="rn-day on" data-day="2">Mar</button>
                        <button type="button" class="rn-day on" data-day="3">Mer</button>
                        <button type="button" class="rn-day on" data-day="4">Gio</button>
                        <button type="button" class="rn-day on" data-day="5">Ven</button>
                        <button type="button" class="rn-day" data-day="6">Sab</button>
                        <button type="button" class="rn-day" data-day="7">Dom</button>
                    </div>
                    <input type="hidden" name="calendario[]" class="cal-value" value="1,2,3,4,5">
                </div>
                <div class="col-span-3 cal-wrap">
                    <label class="form-label">Festivi nazionali</label>
                    <label class="rn-fest">
                        <input type="checkbox" class="fest-check">
                        <span class="rn-fest-track"></span>
                        <span class="rn-fest-label">Conta anche i festivi</span>
                    </label>
                    <input type="hidden" name="festivi_inclusi[]" class="fest-value" value="">
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button id="add-row" type="button" class="btn btn-primary">+ Aggiungi Mezzo</button>
        </div>

        <div class="flex justify-end mt-6">
            <button type="submit" class="btn btn-primary">Salva</button>
        </div>
    </form>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="/assets/js/views/equipment/assign_lifting_equipment.js"></script>
{% endblock %}
