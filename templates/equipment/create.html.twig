{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/equipment/noleggio.css">
{% endblock %}

{% block content %}
<div class="rn-page" style="max-width: 1000px;">

    <div class="rn-hero">
        <div class="rn-hero-content">
            <div class="rn-hero-left">
                <div class="rn-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18M10 12h4"/></svg>
                </div>
                <div>
                    <h1 class="rn-hero-title">{{ editing ? "Modifica Mezzo di Sollevamento" : "Gestione Mezzi Sollevamento" }}</h1>
                    <p class="rn-hero-sub">{{ editing ? "Stai modificando un mezzo esistente" : "Aggiungi nuovi mezzi al listino e gestisci quelli esistenti" }}</p>
                </div>
            </div>
        </div>
    </div>

    {% if successMessage is not empty %}
        <div class="rn-toast">
            <span>✓ {{ successMessage }}</span>
            <button type="button" data-dismiss-alert>&times;</button>
        </div>
    {% endif %}

    <!-- FORM -->
    <div class="rn-card {{ editing ? '' : 'is-plain' }}">
        <div class="rn-card-head">
            <h3 class="rn-card-title">{{ editing ? "Modifica: " ~ editData.descrizione : "Nuovo mezzo" }}</h3>
            {% if editing %}<span class="rn-badge rn-badge-corso">In modifica</span>{% endif %}
        </div>
        <div class="rn-card-body">
            <form method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                {% if editing %}
                    <input type="hidden" name="update_item" value="1">
                    <input type="hidden" name="edit_id" value="{{ editData.id }}">
                {% else %}
                    <input type="hidden" name="create_item" value="1">
                {% endif %}

                <div class="rn-grid">
                    <div style="grid-column: span 2;">
                        <span class="rn-field-label">Descrizione</span>
                        <input type="text" name="descrizione"
                               value="{{ editing ? editData.descrizione : '' }}"
                               class="rn-input" placeholder="es. Piattaforma 18m" required>
                    </div>
                    <div>
                        <span class="rn-field-label">Costo giornaliero (€)</span>
                        <input type="number" name="costo_giornaliero" step="0.01" min="0"
                               value="{{ editing ? editData.costo_giornaliero : '' }}"
                               class="rn-input" placeholder="0,00" required>
                    </div>
                </div>

                <div class="rn-card-foot">
                    <span></span>
                    <div style="display:flex; gap:8px;">
                        {% if editing %}
                            <a href="/equipment/manage" class="rn-btn" style="color:#64748b; border-color:#e2e8f0;">Annulla</a>
                            <button type="submit" class="rn-btn rn-btn-primary">Aggiorna</button>
                        {% else %}
                            <button type="submit" class="rn-btn rn-btn-primary">
                                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Aggiungi al listino
                            </button>
                        {% endif %}
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="rn-toolbar" style="margin-top: 20px;">
        <div class="rn-search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="search-mezzo" type="text" placeholder="Cerca mezzo...">
        </div>
    </div>

    <!-- TABLE -->
    <div class="rn-table-wrap">
        <table class="rn-table" id="mezzi-table">
            <thead>
            <tr>
                <th>Descrizione</th>
                <th style="text-align:center">Costo giornaliero (€)</th>
                <th style="text-align:right">Azioni</th>
            </tr>
            </thead>
            <tbody>
            {% for m in listaMezzi %}
                <tr>
                    <td style="font-weight:600">{{ m.descrizione }}</td>
                    <td style="text-align:center">{{ m.costo_giornaliero|number_format(2, ',', '.') }}</td>
                    <td>
                        <div class="rn-actions-cell" style="justify-content:flex-end">
                            {# TODO: 'edit_id' is a GET param — controller reads $_GET['edit_id'] and passes `editing`/`editData` #}
                            <a class="rn-btn rn-btn-edit" href="?edit_id={{ m.id }}">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifica
                            </a>
                            <button type="button"
                                    class="rn-btn rn-btn-delete"
                                    data-delete-id="{{ m.id }}"
                                    data-tw-toggle="modal"
                                    data-tw-target="#deleteModal">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                Elimina
                            </button>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div id="deleteModal" class="modal" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="delete_item" value="1">
            <input type="hidden" id="delete_id_input" name="delete_id">

            <div class="modal-body p-5 text-center">
                <i data-lucide="x-circle" class="w-16 h-16 text-danger mx-auto"></i>
                <h3 class="text-3xl mt-5">Sei sicuro?</h3>
                <p class="text-slate-500 mt-2">Questa operazione è irreversibile.</p>
            </div>

            <div class="modal-footer px-5 pb-8 text-center">
                <button type="button" data-tw-dismiss="modal" class="btn btn-outline-secondary w-24 mr-1">
                    Annulla
                </button>
                <button type="submit" class="btn btn-danger w-24">
                    Elimina
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/equipment/add_lifting_equipment.js"></script>
{% endblock %}
