{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/equipment/noleggio.css">
{% endblock %}

{% block content %}
<div class="rn-page">

    <div class="rn-hero">
        <div class="rn-hero-content">
            <div class="rn-hero-left">
                <div class="rn-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18M10 12h4"/></svg>
                </div>
                <div>
                    <h1 class="rn-hero-title">Noleggi Mezzi Sollevamento</h1>
                    <p class="rn-hero-sub">Situazione noleggi per cantiere</p>
                </div>
            </div>
            <div class="rn-hero-actions">
                <a href="/equipment/assign" class="rn-btn-hero is-primary">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Assegna nuovo noleggio
                </a>
            </div>
        </div>
        <div class="rn-hero-stats">
            <div class="rn-stat">
                <div class="rn-stat-num">{{ noleggi|length }}</div>
                <div class="rn-stat-lbl">Cantieri</div>
            </div>
            <div class="rn-stat">
                <div class="rn-stat-num">{{ noleggi|reduce((c, r) => c + r.mezzi_attivi, 0) }}</div>
                <div class="rn-stat-lbl">Mezzi attivi</div>
            </div>
            <div class="rn-stat">
                <div class="rn-stat-num">{{ noleggi|reduce((c, r) => c + r.total_mezzi, 0) }}</div>
                <div class="rn-stat-lbl">Mezzi totali</div>
            </div>
        </div>
    </div>

    <div class="rn-toolbar">
        <div class="rn-search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="search-rental" placeholder="Cerca cantiere...">
        </div>
        <button id="filter-active" class="rn-btn-filter">
            <svg viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            Attivi prima
        </button>
    </div>

    {% if noleggi is empty %}
        <div class="rn-empty">
            <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18"/></svg>
            <p class="rn-empty-text">Nessun noleggio registrato.</p>
        </div>
    {% else %}
    <div class="rn-table-wrap">
        <table class="rn-table" id="rentalTable">
            <thead>
            <tr>
                <th>Cantiere</th>
                <th>Periodo</th>
                <th style="text-align:center">Mezzi</th>
                <th style="text-align:center">Attivi</th>
                <th style="text-align:right">Azioni</th>
            </tr>
            </thead>
            <tbody>
            {% for row in noleggi %}
                <tr>
                    <td>
                        {# click sul cantiere → Termina noleggio (azione piu' frequente) #}
                        <a href="/equipment/rentals/{{ row.worksite_id }}/complete" class="rn-link">
                            {{ row.worksite_code ~ ' — ' ~ row.cantiere_nome }}
                        </a>
                    </td>
                    <td>
                        {{ row.prima_data_inizio|date('d/m/Y') }}
                        {% if row.ultima_data_fine %}
                            → {{ row.ultima_data_fine|date('d/m/Y') }}
                        {% else %}
                            <span class="rn-badge rn-badge-corso" style="margin-left:6px">in corso</span>
                        {% endif %}
                    </td>
                    <td style="text-align:center; font-weight:600">{{ row.total_mezzi }}</td>
                    <td style="text-align:center">
                        <span class="attivi-count rn-badge {{ row.mezzi_attivi > 0 ? 'rn-badge-attivo' : 'rn-badge-servizio' }}">{{ row.mezzi_attivi }}</span>
                    </td>
                    <td>
                        <div class="rn-actions-cell" style="justify-content:flex-end">
                            <a href="/equipment/rentals/{{ row.worksite_id }}/complete" class="rn-btn rn-btn-warn">
                                <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                Termina
                            </a>
                            <a href="javascript:;" class="rn-btn rn-btn-edit"
                               data-tw-toggle="modal"
                               data-tw-target="#modifica-confirmation-modal"
                               data-edit-url="/equipment/rentals/{{ row.worksite_id }}/edit">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifica
                            </a>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

</div>

<!-- BEGIN: Modifica Confirmation Modal -->
<div id="modifica-confirmation-modal" class="modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-body p-5 text-center">
                <i data-lucide="alert-triangle" class="w-16 h-16 text-warning mx-auto"></i>

                <h3 class="text-2xl mt-5">Confermare la modifica?</h3>

                <p class="text-slate-500 mt-2">
                    Stai per modificare i <strong>dati di noleggio</strong> associati al cantiere.<br><br>
                    Questa operazione può influire su costi, storico mezzi e consuntivi.<br><br>
                    Se devi solo ritirare i mezzi, utilizza l'azione
                    <strong>"Termina Noleggio"</strong>.
                </p>
            </div>

            <div class="modal-footer px-5 pb-8 text-center">
                <button type="button"
                        data-tw-dismiss="modal"
                        class="btn btn-outline-secondary w-24 mr-1">
                    Annulla
                </button>

                <a href="#"
                   id="confirmModificaBtn"
                   class="btn btn-warning w-40">
                    Sì, modifica
                </a>
            </div>

        </div>
    </div>
</div>
<!-- END: Modifica Confirmation Modal -->
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/equipment/rental_list.js"></script>
{% endblock %}
