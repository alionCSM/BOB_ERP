{% extends 'layout/base.html.twig' %}

{% block content %}
<div class="intro-y box p-5 mt-5">
    <h2 class="text-lg font-medium mb-4">
        Modifica Mezzi Noleggio - {{ worksite.worksite_code }} {{ worksite.name }}
    </h2>

    {% if message is not empty %}
        <div class="alert alert-success mb-4 flex justify-between items-center p-4 bg-green-100 rounded">
            <span>{{ message }}</span>
            <button type="button" data-dismiss-alert class="text-green-800 text-lg font-bold ml-4">&times;</button>
        </div>
    {% endif %}

    <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="save_changes" value="1">

        <table class="table w-full text-sm">
            <thead class="bg-sky-100 text-slate-700">
            <tr>
                <th>Mezzo</th>
                <th>Tipo</th>
                <th>Calendario</th>
                <th>Quantità</th>
                <th>Costo € / periodo</th>
                <th>Data Inizio</th>
                <th>Stato</th>
                <th>Azioni</th>
            </tr>
            </thead>
            <tbody>
            {# Mostriamo TUTTI i noleggi (Attivo + Completato + Finito).
               Il template internamente rende readonly quelli completati.
               Prima un filtro esterno "solo Attivo" nascondeva tutto cio'
               che era stato terminato via /equipment/rentals/.../complete,
               lasciando visibili solo le "Una Tantum" (es. Trasporto A/R)
               che la pagina Termina non gestisce. #}
            {% for row in mezzi %}
                <tr class="hover:bg-slate-100 {{ row.stato in ['Completato','Finito'] ? 'bg-slate-50 opacity-90' : '' }}">
                    <td>
                        {{ row.mezzo_descrizione }}
                        {% if row.stato in ['Completato','Finito'] and row.data_fine %}
                            <div class="text-xs text-slate-500">Terminato il {{ row.data_fine|date('d/m/Y') }}</div>
                        {% endif %}
                        <input type="hidden" name="id[]" value="{{ row.id }}">
                    </td>
                    <td>
                        {% if row.stato == 'Completato' or row.stato == 'Finito' %}
                            <select class="form-select w-full" disabled>
                                <option selected>{{ row.tipo_noleggio }}</option>
                            </select>
                            <input type="hidden" name="tipo_noleggio[]" value="{{ row.tipo_noleggio }}">
                        {% else %}
                            <select name="tipo_noleggio[]" class="form-select w-full tipo-select">
                                <option value="Giornaliero"  {{ row.tipo_noleggio == 'Giornaliero'  ? 'selected' : '' }}>Giornaliero</option>
                                <option value="Settimanale"  {{ row.tipo_noleggio == 'Settimanale'  ? 'selected' : '' }}>Settimanale</option>
                                <option value="Mensile"      {{ row.tipo_noleggio == 'Mensile'      ? 'selected' : '' }}>Mensile</option>
                                <option value="Una Tantum"   {{ row.tipo_noleggio == 'Una Tantum'   ? 'selected' : '' }}>Una Tantum</option>
                            </select>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.stato == 'Completato' or row.stato == 'Finito' %}
                            {% if row.tipo_noleggio == 'Giornaliero' %}
                                <span class="text-xs text-slate-500">
                                    {{ {'lun_ven':'Lun–Ven','lun_sab':'Lun–Sab','lun_dom':'Lun–Dom','sab_dom':'Sab–Dom'}[row.calendario ?? 'lun_ven'] }}
                                    {{ row.festivi_inclusi ? '+ festivi' : '' }}
                                    {{ (row.giorni_extra ?? 0) > 0 ? '· +' ~ row.giorni_extra ~ ' gg extra' : '' }}
                                </span>
                            {% else %}
                                <span class="text-xs text-slate-400">—</span>
                            {% endif %}
                            <input type="hidden" name="calendario[]" value="{{ row.calendario ?? 'lun_ven' }}">
                            <input type="hidden" name="festivi_inclusi[]" value="{{ row.festivi_inclusi ? '1' : '' }}">
                            <input type="hidden" name="giorni_extra[]" value="{{ row.giorni_extra ?? 0 }}">
                        {% else %}
                            <div class="cal-wrap {{ row.tipo_noleggio != 'Giornaliero' ? 'invisible' : '' }}">
                                <select name="calendario[]" class="form-select w-full mb-1">
                                    <option value="lun_ven" {{ (row.calendario ?? 'lun_ven') == 'lun_ven' ? 'selected' : '' }}>Lun – Ven</option>
                                    <option value="lun_sab" {{ (row.calendario ?? '') == 'lun_sab' ? 'selected' : '' }}>Lun – Sab</option>
                                    <option value="lun_dom" {{ (row.calendario ?? '') == 'lun_dom' ? 'selected' : '' }}>Lun – Dom</option>
                                    <option value="sab_dom" {{ (row.calendario ?? '') == 'sab_dom' ? 'selected' : '' }}>Solo Sab – Dom</option>
                                </select>
                                <select name="festivi_inclusi[]" class="form-select w-full mb-1">
                                    <option value=""  {{ not row.festivi_inclusi ? 'selected' : '' }}>Festivi esclusi</option>
                                    <option value="1" {{ row.festivi_inclusi ? 'selected' : '' }}>Festivi inclusi</option>
                                </select>
                                {# Giorni fuori calendario aggiunti a mano (vedi email alert) #}
                                <div class="flex items-center gap-1">
                                    <span class="text-xs text-slate-500 whitespace-nowrap">Giorni extra</span>
                                    <input type="number" name="giorni_extra[]" min="0" class="form-input w-16 text-center"
                                           value="{{ row.giorni_extra ?? 0 }}" title="Giorni fuori calendario conteggiati comunque (es. uso di sabato con noleggio Lun–Ven)">
                                </div>
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.stato == 'Completato' or row.stato == 'Finito' %}
                            {{ row.quantita }}
                            <input type="hidden" name="quantita[]" value="{{ row.quantita }}">
                        {% else %}
                            <input type="number" name="quantita[]" class="form-input w-20 text-center" min="1" value="{{ row.quantita }}">
                        {% endif %}
                    </td>
                    <td>
                        {% if row.stato == 'Completato' or row.stato == 'Finito' %}
                            {{ row.costo_giornaliero|number_format(2, ',', '.') }}
                            <input type="hidden" name="costo[]" value="{{ row.costo_giornaliero }}">
                        {% else %}
                            <input type="number" step="0.01" name="costo[]" class="form-input w-full" value="{{ row.costo_giornaliero }}">
                        {% endif %}
                    </td>
                    <td>
                        {% if row.stato == 'Completato' or row.stato == 'Finito' %}
                            {{ row.data_inizio|date('d/m/Y') }}
                            <input type="hidden" name="data_inizio[]" value="{{ row.data_inizio }}">
                        {% else %}
                            <input type="date" name="data_inizio[]" class="form-input w-full" value="{{ row.data_inizio }}">
                        {% endif %}
                    </td>
                    <td>
                        {% if row.stato == 'Completato' or row.stato == 'Finito' %}
                            <select name="stato[]" class="form-select w-full">
                                <option value="Completato" selected>Completato</option>
                                <option value="Attivo">Attivo</option>
                            </select>
                        {% else %}
                            <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded">
                                Attivo
                            </span>
                            <input type="hidden" name="stato[]" value="Attivo">
                        {% endif %}
                    </td>
                    <td>
                        {% if row.stato == 'Attivo' %}
                            <button type="button" class="btn btn-danger text-xs px-3 py-1" data-delete-id="{{ row.id }}">
                                Elimina
                            </button>
                        {% else %}
                            <span class="text-xs text-slate-400">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="text-right mt-5">
            <button type="submit" class="btn btn-primary">
                Salva Modifiche
            </button>
        </div>
    </form>
</div>

{% endblock %}

{% block scripts %}
<script src="/assets/js/views/equipment/edit_lifting_equipment.js"></script>
{% endblock %}
