{% extends 'layout/base.html.twig' %}

{% block head %}
<style>
  .rn-page { margin-top: 16px; }

  /* Hero (allineato a wd-/fl-/bc-) */
  .rn-hero {
      position: relative; overflow: hidden;
      border-radius: 18px;
      padding: 26px 30px 22px;
      background: linear-gradient(135deg, #0c1929 0%, #122444 40%, #1e3a5f 100%);
      color: #fff; margin-bottom: 18px;
  }
  .rn-hero::before {
      content: ''; position: absolute; top: -80px; right: -40px;
      width: 220px; height: 220px; border-radius: 50%;
      background: rgba(245,158,11,.14); pointer-events: none;
  }
  .rn-hero-content {
      position: relative; z-index: 1;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 14px;
  }
  .rn-hero-left { display: flex; align-items: center; gap: 14px; }
  .rn-hero-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: rgba(255,255,255,.1);
      display: flex; align-items: center; justify-content: center;
  }
  .rn-hero-icon svg { width: 22px; height: 22px; stroke: #fff; stroke-width: 1.5; fill: none; }
  .rn-hero-title { font-size: 20px; font-weight: 800; margin: 0 0 2px; }
  .rn-hero-sub { font-size: 13px; opacity: .55; margin: 0; }

  .rn-btn-back {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 16px; border-radius: 10px;
      background: rgba(255,255,255,.12); color: #fff;
      font-size: 13px; font-weight: 600;
      border: 1px solid rgba(255,255,255,.18);
      text-decoration: none; transition: all .15s;
  }
  .rn-btn-back:hover { background: rgba(255,255,255,.2); color: #fff; }

  /* Toast successo */
  .rn-toast {
      display: flex; justify-content: space-between; align-items: center;
      background: #dcfce7; border: 1.5px solid #86efac; color: #166534;
      border-radius: 12px; padding: 12px 18px; margin-bottom: 14px;
      font-size: 13px; font-weight: 600;
  }
  .rn-toast button { color: #166534; font-size: 18px; font-weight: 800; background: none; border: 0; cursor: pointer; }

  /* Card noleggio */
  .rn-card {
      background: #fff; border-radius: 14px;
      border: 1.5px solid #e8edf3;
      padding: 18px 22px; margin-bottom: 12px;
      position: relative;
  }
  .rn-card::before {
      content: ''; position: absolute; top: 0; left: 0; bottom: 0;
      width: 4px; background: #2563eb; border-radius: 14px 0 0 14px;
  }
  .rn-card.is-done { background: #f8fafc; }
  .rn-card.is-done::before { background: #94a3b8; }

  .rn-card-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; flex-wrap: wrap; margin-bottom: 14px;
  }
  .rn-card-title { font-size: 15px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 10px; }
  .rn-card-title svg { width: 18px; height: 18px; stroke: #64748b; fill: none; stroke-width: 1.6; }

  .rn-badge {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 10px; border-radius: 999px;
      font-size: 11px; font-weight: 700; letter-spacing: .3px;
  }
  .rn-badge-attivo     { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
  .rn-badge-completato { background: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc; }
  .rn-badge-servizio   { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

  /* Griglia campi */
  .rn-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
  }
  .rn-field-label {
      color: #94a3b8; font-weight: 600; text-transform: uppercase;
      letter-spacing: .3px; font-size: 10px; margin-bottom: 4px; display: block;
  }
  .rn-field-value { color: #0f172a; font-weight: 600; font-size: 13px; padding-top: 6px; }
  .rn-input, .rn-select {
      width: 100%; border: 1.5px solid #e2e8f0; border-radius: 8px;
      padding: 7px 10px; font-size: 13px; color: #0f172a; background: #fff;
      transition: border-color .12s;
  }
  .rn-input:focus, .rn-select:focus { outline: none; border-color: #2563eb; }

  /* Blocco calendario (solo Giornaliero) */
  .rn-cal-fields { display: contents; }
  .rn-cal-fields.rn-hidden > div { display: none; }

  /* Giorni extra evidenziati */
  .rn-extra-wrap { position: relative; }
  .rn-extra-wrap .rn-input { border-color: #fde68a; background: #fffbeb; }
  .rn-extra-wrap .rn-input:focus { border-color: #f59e0b; }
  .rn-hint { font-size: 10.5px; color: #b45309; margin-top: 4px; line-height: 1.35; }

  .rn-card-foot {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 14px; padding-top: 12px; border-top: 1px solid #f1f5f9;
      flex-wrap: wrap; gap: 8px;
  }
  .rn-done-note { font-size: 12px; color: #64748b; }

  .rn-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: 8px;
      font-size: 13px; font-weight: 600;
      border: 1.5px solid; cursor: pointer;
      text-decoration: none; transition: all .12s;
  }
  .rn-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }
  .rn-btn-delete { background: #fff; color: #dc2626; border-color: #fca5a5; }
  .rn-btn-delete:hover { background: #fee2e2; }

  /* Barra salvataggio */
  .rn-savebar {
      display: flex; justify-content: flex-end; gap: 10px;
      margin-top: 16px;
  }
  .rn-btn-save {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 11px 26px; border-radius: 10px;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #fff; font-size: 14px; font-weight: 700;
      border: 0; cursor: pointer; transition: all .15s;
  }
  .rn-btn-save:hover { box-shadow: 0 6px 16px rgba(37,99,235,.3); }
  .rn-btn-save svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; }

  /* Empty */
  .rn-empty {
      background: #fff; border-radius: 14px; border: 1.5px solid #e8edf3;
      padding: 60px 20px; text-align: center;
  }
  .rn-empty svg { width: 40px; height: 40px; stroke: #cbd5e1; fill: none; opacity: .5; margin: 0 auto 12px; display: block; }
  .rn-empty-text { font-size: 14px; color: #94a3b8; margin: 0; }
</style>
{% endblock %}

{% set calLabels = {'lun_ven':'Lun – Ven','lun_sab':'Lun – Sab','lun_dom':'Lun – Dom','sab_dom':'Solo Sab – Dom'} %}
{% set costoLabels = {'Giornaliero':'Costo € / giorno','Settimanale':'Costo € / settimana','Mensile':'Costo € / mese','Una Tantum':'Costo €'} %}

{% block content %}
<div class="rn-page">

    <div class="rn-hero">
        <div class="rn-hero-content">
            <div class="rn-hero-left">
                <div class="rn-hero-icon">
                    {# gru / sollevamento #}
                    <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18M10 12h4"/></svg>
                </div>
                <div>
                    <h1 class="rn-hero-title">Noleggio Mezzi Sollevamento</h1>
                    <p class="rn-hero-sub">{{ worksite.worksite_code }} — {{ worksite.name }} · {{ mezzi|filter(m => m.stato == 'Attivo')|length }} noleggi attivi</p>
                </div>
            </div>
            <a href="/worksites/{{ worksiteId }}" class="rn-btn-back">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Torna al cantiere
            </a>
        </div>
    </div>

    {% if message is not empty %}
        <div class="rn-toast">
            <span>✓ {{ message }}</span>
            <button type="button" data-dismiss-alert>&times;</button>
        </div>
    {% endif %}

    {% if mezzi is empty %}
        <div class="rn-empty">
            <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18"/></svg>
            <p class="rn-empty-text">Nessun noleggio per questo cantiere.</p>
        </div>
    {% else %}
    <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="save_changes" value="1">

        {# Mostriamo TUTTI i noleggi (Attivo + Completato + Finito): quelli
           terminati sono readonly ma riattivabili via select Stato. #}
        {% for row in mezzi %}
            {% set done = row.stato in ['Completato', 'Finito'] %}
            <div class="rn-card {{ done ? 'is-done' : '' }}">
                <input type="hidden" name="id[]" value="{{ row.id }}">

                <div class="rn-card-head">
                    <h3 class="rn-card-title">
                        <svg viewBox="0 0 24 24"><path d="M3 21h18M6 21V8l12-5v18M10 12h4"/></svg>
                        {{ row.mezzo_descrizione }}
                    </h3>
                    <div>
                        {% if row.tipo_noleggio == 'Una Tantum' %}
                            <span class="rn-badge rn-badge-servizio">Servizio</span>
                        {% elseif done %}
                            <span class="rn-badge rn-badge-completato">Terminato{{ row.data_fine ? ' il ' ~ row.data_fine|date('d/m/Y') : '' }}</span>
                        {% else %}
                            <span class="rn-badge rn-badge-attivo">● Attivo</span>
                        {% endif %}
                    </div>
                </div>

                {% if done %}
                    {# ── Readonly: valori mostrati, campi inviati come hidden ── #}
                    <div class="rn-grid">
                        <div>
                            <span class="rn-field-label">Tipo</span>
                            <div class="rn-field-value">{{ row.tipo_noleggio }}</div>
                        </div>
                        {% if row.tipo_noleggio == 'Giornaliero' %}
                        <div>
                            <span class="rn-field-label">Calendario</span>
                            <div class="rn-field-value">
                                {{ calLabels[row.calendario ?? 'lun_ven'] }}{{ row.festivi_inclusi ? ' + festivi' : '' }}
                                {{ (row.giorni_extra ?? 0) > 0 ? ' · +' ~ row.giorni_extra ~ ' gg extra' : '' }}
                            </div>
                        </div>
                        {% endif %}
                        <div>
                            <span class="rn-field-label">Quantità</span>
                            <div class="rn-field-value">{{ row.quantita }}</div>
                        </div>
                        <div>
                            <span class="rn-field-label">{{ costoLabels[row.tipo_noleggio] ?? 'Costo €' }}</span>
                            <div class="rn-field-value">{{ row.costo_giornaliero|number_format(2, ',', '.') }} €</div>
                        </div>
                        <div>
                            <span class="rn-field-label">Periodo</span>
                            <div class="rn-field-value">{{ row.data_inizio|date('d/m/Y') }} → {{ row.data_fine ? row.data_fine|date('d/m/Y') : '—' }}</div>
                        </div>
                        <div>
                            <span class="rn-field-label">Stato</span>
                            <select name="stato[]" class="rn-select">
                                <option value="Completato" selected>Completato</option>
                                <option value="Attivo">Riattiva</option>
                            </select>
                        </div>
                    </div>
                    <input type="hidden" name="tipo_noleggio[]"   value="{{ row.tipo_noleggio }}">
                    <input type="hidden" name="calendario[]"      value="{{ row.calendario ?? 'lun_ven' }}">
                    <input type="hidden" name="festivi_inclusi[]" value="{{ row.festivi_inclusi ? '1' : '' }}">
                    <input type="hidden" name="giorni_extra[]"    value="{{ row.giorni_extra ?? 0 }}">
                    <input type="hidden" name="quantita[]"        value="{{ row.quantita }}">
                    <input type="hidden" name="costo[]"           value="{{ row.costo_giornaliero }}">
                    <input type="hidden" name="data_inizio[]"     value="{{ row.data_inizio }}">
                    <div class="rn-card-foot">
                        <span class="rn-done-note">Noleggio terminato: seleziona "Riattiva" e salva per riaprirlo.</span>
                    </div>
                {% else %}
                    {# ── Editabile ── #}
                    <div class="rn-grid">
                        <div>
                            <span class="rn-field-label">Tipo noleggio</span>
                            <select name="tipo_noleggio[]" class="rn-select tipo-select">
                                <option value="Giornaliero"  {{ row.tipo_noleggio == 'Giornaliero'  ? 'selected' : '' }}>Giornaliero</option>
                                <option value="Settimanale"  {{ row.tipo_noleggio == 'Settimanale'  ? 'selected' : '' }}>Settimanale</option>
                                <option value="Mensile"      {{ row.tipo_noleggio == 'Mensile'      ? 'selected' : '' }}>Mensile</option>
                                <option value="Una Tantum"   {{ row.tipo_noleggio == 'Una Tantum'   ? 'selected' : '' }}>Una Tantum</option>
                            </select>
                        </div>

                        <div class="rn-cal-fields {{ row.tipo_noleggio != 'Giornaliero' ? 'rn-hidden' : '' }}">
                            <div>
                                <span class="rn-field-label">Calendario conteggio</span>
                                <select name="calendario[]" class="rn-select">
                                    <option value="lun_ven" {{ (row.calendario ?? 'lun_ven') == 'lun_ven' ? 'selected' : '' }}>Lun – Ven</option>
                                    <option value="lun_sab" {{ (row.calendario ?? '') == 'lun_sab' ? 'selected' : '' }}>Lun – Sab</option>
                                    <option value="lun_dom" {{ (row.calendario ?? '') == 'lun_dom' ? 'selected' : '' }}>Lun – Dom</option>
                                    <option value="sab_dom" {{ (row.calendario ?? '') == 'sab_dom' ? 'selected' : '' }}>Solo Sab – Dom</option>
                                </select>
                            </div>
                            <div>
                                <span class="rn-field-label">Festivi</span>
                                <select name="festivi_inclusi[]" class="rn-select">
                                    <option value=""  {{ not row.festivi_inclusi ? 'selected' : '' }}>Esclusi</option>
                                    <option value="1" {{ row.festivi_inclusi ? 'selected' : '' }}>Inclusi</option>
                                </select>
                            </div>
                            <div class="rn-extra-wrap">
                                <span class="rn-field-label">Giorni extra</span>
                                <input type="number" name="giorni_extra[]" min="0" class="rn-input"
                                       value="{{ row.giorni_extra ?? 0 }}">
                                <div class="rn-hint">Giorni fuori calendario da contare comunque (es. sabato lavorato con noleggio Lun–Ven)</div>
                            </div>
                        </div>

                        <div>
                            <span class="rn-field-label">Quantità</span>
                            <input type="number" name="quantita[]" min="1" class="rn-input" value="{{ row.quantita }}">
                        </div>
                        <div>
                            <span class="rn-field-label costo-label">{{ costoLabels[row.tipo_noleggio] ?? 'Costo €' }}</span>
                            <input type="number" step="0.01" name="costo[]" class="rn-input" value="{{ row.costo_giornaliero }}">
                        </div>
                        <div>
                            <span class="rn-field-label">Data inizio</span>
                            <input type="date" name="data_inizio[]" class="rn-input" value="{{ row.data_inizio }}">
                        </div>
                    </div>
                    <input type="hidden" name="stato[]" value="Attivo">

                    <div class="rn-card-foot">
                        <span></span>
                        <button type="button" class="rn-btn rn-btn-delete" data-delete-id="{{ row.id }}">
                            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            Elimina noleggio
                        </button>
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        <div class="rn-savebar">
            <button type="submit" class="rn-btn-save">
                <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Salva modifiche
            </button>
        </div>
    </form>
    {% endif %}

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/equipment/edit_lifting_equipment.js"></script>
{% endblock %}
