{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/report/fatturato.css?v=5">
{% endblock %}

{% macro delta(oggi, prima) %}
    {% if prima is not empty and prima != 0 %}
        {% set pct = ((oggi - prima) / prima * 100) %}
        <span class="rp-delta {{ pct >= 0 ? 'is-up' : 'is-down' }}">
            {{ pct >= 0 ? '▲' : '▼' }} {{ pct|abs|number_format(1, ',', '.') }}%
        </span>
    {% else %}
        <span class="rp-delta is-none">—</span>
    {% endif %}
{% endmacro %}
{% import _self as f %}

{% block content %}
<div class="rp-page">

    {# ── Hero ── #}
    <div class="rp-hero">
        <div class="rp-hero-content">
            <div class="rp-hero-left">
                <div class="rp-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
                </div>
                <div>
                    <h1 class="rp-hero-title">Andamento fatturato</h1>
                    <p class="rp-hero-sub">Dati dal gestionale Business · per data documento</p>
                </div>
            </div>
            <form method="GET" class="rp-year-form" id="rp-year-form">
                <select name="anno" aria-label="Anno">
                    {% for y in anniScelta %}
                        <option value="{{ y }}" {{ y == aAnno ? 'selected' : '' }}>{{ y }}</option>
                    {% endfor %}
                </select>
            </form>
        </div>
    </div>

    {% if errore %}
        <div class="rp-alert">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
                <strong>Dati non disponibili.</strong> {{ errore }}<br>
                <small>I totali qui sotto sono a zero perché la lettura non è riuscita, non perché non ci sia stato fatturato.</small>
            </div>
        </div>
    {% endif %}

    {% set tOggi = totali[annoTop] ?? {'entrate':0,'uscite':0,'iva_vendite':0,'iva_acquisti':0} %}
    {% set tPrec = totali[annoPrec] ?? null %}

    {# Il confronto fra anni a pari periodo: sull'anno in corso dal 1 gennaio
       a oggi contro lo stesso intervallo dell'anno prima (ytd, letto apposta
       da Business); su un anno chiuso, anno intero contro anno intero. #}
    {% if ytd %}
        {% set vOggi = ytd.oggi.vendite %}{% set vPrec = ytd.prima.vendite %}
        {% set aOggi = ytd.oggi.acquisti %}{% set aPrec = ytd.prima.acquisti %}
        {% set rifPrec = annoPrec ~ ' allo stesso giorno (' ~ oggi ~ ')' %}
    {% else %}
        {% set vOggi = tOggi.entrate %}{% set vPrec = tPrec ? tPrec.entrate : null %}
        {% set aOggi = tOggi.uscite %}{% set aPrec = tPrec ? tPrec.uscite : null %}
        {% set rifPrec = annoPrec ~ ' (anno intero)' %}
    {% endif %}


    {# ── Card principali ── #}
    <div class="rp-cards">
        <div class="rp-card is-in">
            <div class="rp-card-lbl">Fatturato {{ annoTop }}{{ ytd ? ' (al ' ~ oggi ~ ')' : '' }}</div>
            <div class="rp-card-val">€ {{ vOggi|number_format(0, ',', '.') }}</div>
            <div class="rp-card-foot">
                {{ f.delta(vOggi, vPrec) }}
                <span class="rp-card-ref">vs {{ rifPrec }}: € {{ (vPrec ?: 0)|number_format(0, ',', '.') }}</span>
            </div>
        </div>
        <div class="rp-card is-out">
            <div class="rp-card-lbl">Acquisti fatturati {{ annoTop }}{{ ytd ? ' (al ' ~ oggi ~ ')' : '' }}</div>
            <div class="rp-card-val">€ {{ aOggi|number_format(0, ',', '.') }}</div>
            <div class="rp-card-foot">
                {{ f.delta(aOggi, aPrec) }}
                <span class="rp-card-ref">vs {{ rifPrec }}: € {{ (aPrec ?: 0)|number_format(0, ',', '.') }}</span>
            </div>
        </div>
    </div>

    {# ── Grafico ── #}
    <div class="rp-panel">
        <div class="rp-panel-head">
            <h3 class="rp-panel-title">Confronto mensile</h3>
            <div class="rp-switch" id="rp-switch">
                <button type="button" class="on" data-serie="entrate">Fatturato</button>
                <button type="button" data-serie="uscite">Acquisti fatturati</button>
            </div>
        </div>
        <div class="rp-chart-wrap">
            <canvas id="rp-chart"
                    data-mesi='{{ mesi|json_encode }}'
                    data-serie='{{ serie|json_encode }}'
                    data-anno-corrente="{{ annoCorrente }}"
                    data-mese-corrente="{{ meseCorrente }}"></canvas>
        </div>
    </div>

    {# ── Tabella mensile ── #}
    <div class="rp-panel">
        <div class="rp-panel-head">
            <h3 class="rp-panel-title">Dettaglio mensile {{ annoTop }}</h3>
        </div>
        <div class="rp-table-wrap">
            <table class="rp-table">
                <thead>
                    <tr>
                        <th>Mese</th>
                        <th class="right">Fatturato</th>
                        <th class="right">Acquisti fatturati</th>
                        <th class="right">Fatturato {{ annoPrec }}</th>
                        <th class="right">Var.</th>
                    </tr>
                </thead>
                <tbody>
                {% set sOggi = serie[annoTop] ?? null %}
                {% set sPrec = serie[annoPrec] ?? null %}
                {% for i in 0..11 %}
                    {% set e  = sOggi ? sOggi.entrate[i] : 0 %}
                    {% set u  = sOggi ? sOggi.uscite[i]  : 0 %}
                    {% set ep = sPrec ? sPrec.entrate[i] : 0 %}
                    {# mese futuro: niente valori ne' variazioni; mese in corso:
                       valori fin qui, ma nessuna variazione contro un mese intero #}
                    {% set futuro  = annoInCorso and (i + 1) > meseCorrente %}
                    {% set inCorso = annoInCorso and (i + 1) == meseCorrente %}
                    <tr class="{{ futuro ? 'rp-futuro' : 'rp-row' }}" data-mese="{{ i + 1 }}" data-anno="{{ annoTop }}">
                        <td class="rp-mese">{{ mesi[i] }}{% if inCorso %} <small class="rp-muted">in corso</small>{% endif %}</td>
                        <td class="right">{{ futuro ? '—' : '€ ' ~ e|number_format(0, ',', '.') }}</td>
                        <td class="right rp-out">{{ futuro ? '—' : '€ ' ~ u|number_format(0, ',', '.') }}</td>
                        <td class="right rp-muted">€ {{ ep|number_format(0, ',', '.') }}</td>
                        <td class="right">{% if futuro or inCorso %}<span class="rp-delta is-none">—</span>{% else %}{{ f.delta(e, ep) }}{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td>Totale{{ ytd ? ' al ' ~ oggi : '' }}</td>
                        <td class="right">€ {{ tOggi.entrate|number_format(0, ',', '.') }}</td>
                        <td class="right">€ {{ tOggi.uscite|number_format(0, ',', '.') }}</td>
                        <td class="right rp-muted" title="{{ ytd ? annoPrec ~ ' dal 1° gennaio al ' ~ oggi : annoPrec ~ ', anno intero' }}">€ {{ (vPrec ?: 0)|number_format(0, ',', '.') }}</td>
                        <td class="right">{{ f.delta(vOggi, vPrec) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    {# ── Confronto tra anni ── #}
    <div class="rp-panel">
        <div class="rp-panel-head">
            <h3 class="rp-panel-title">Totali per anno</h3>
        </div>
        <div class="rp-table-wrap">
            <table class="rp-table">
                <thead>
                    <tr>
                        <th>Anno</th>
                        <th class="right">Fatturato</th>
                        <th class="right">Acquisti fatturati</th>
                    </tr>
                </thead>
                <tbody>
                {% for y, t in totali|reverse(true) %}
                    <tr>
                        <td class="rp-mese">{{ y }}{% if y == annoCorrente %} <small class="rp-muted">al {{ oggi }}</small>{% endif %}</td>
                        <td class="right">€ {{ t.entrate|number_format(0, ',', '.') }}</td>
                        <td class="right rp-out">€ {{ t.uscite|number_format(0, ',', '.') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ── Principali clienti e fornitori ──
       Per fatturato del periodo, non per incassato: i pagamenti stanno
       nello scadenzario, non nel registro IVA. #}
    <div class="rp-panel" id="rp-controparti">
        <div class="rp-panel-head">
            <h2 class="rp-panel-title">Principali clienti e fornitori</h2>
            <div class="rp-cp-cmd">
                <div class="rp-switch">
                    <button type="button" class="on" data-registro="V">Clienti</button>
                    <button type="button" data-registro="A">Fornitori</button>
                </div>
                <select id="rp-cp-anno" class="rp-cp-sel">
                    {% for a in anni %}
                        <option value="{{ a }}" {{ a == annoTop ? 'selected' : '' }}>{{ a }}</option>
                    {% else %}
                        <option value="{{ annoTop }}" selected>{{ annoTop }}</option>
                    {% endfor %}
                </select>
                <select id="rp-cp-mese" class="rp-cp-sel">
                    <option value="0">Tutto l'anno</option>
                    {% for i, m in mesi %}
                        <option value="{{ i + 1 }}">{{ m }}</option>
                    {% endfor %}
                </select>
                <input type="text" id="rp-cp-cerca" class="rp-cp-sel" placeholder="Cerca un nome…">
            </div>
        </div>
        <div id="rp-cp-corpo" class="rp-table-wrap">
            <div class="rp-empty">Caricamento…</div>
        </div>
    </div>

</div>

{# Finestra di verifica (causali e documenti) — fuori da qualsiasi contenitore con transform #}
<div id="rp-modal" class="rp-modal" aria-hidden="true" hidden>
    <div class="rp-modal-box" role="dialog" aria-modal="true">
        <div class="rp-modal-head">
            <h3 class="rp-modal-title" id="rp-modal-title">Dettaglio</h3>
            <button type="button" class="rp-modal-close" data-rp-close aria-label="Chiudi">&times;</button>
        </div>
        <div class="rp-modal-body" id="rp-modal-body">
            <div class="rp-loading">Caricamento…</div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{# Chart.js si carica qui. Il commento in fatturato.js diceva che stava
   gia' nel bundle del template: il codice c'e' dentro, ma il bundle non
   lo espone come variabile globale, quindi la pagina scriveva "Libreria
   grafici non disponibile" e basta. Dal CDN, con il nonce perche' la CSP
   di BOB non ha 'unsafe-inline', e con la versione fissata: cdnjs e'
   gia' fra le sorgenti consentite. #}
<script nonce="{{ cspNonce }}"
        src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="/assets/js/views/report/fatturato.js?v=9"></script>
{% endblock %}
