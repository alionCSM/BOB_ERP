{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/report/fatturato.css?v=2">
{% endblock %}

{% macro delta(oggi, prima) %}
    {% if prima is not empty and prima != 0 %}
        {% set pct = ((oggi - prima) / prima * 100) %}
        <span class="rp-delta {{ pct >= 0 ? 'is-up' : 'is-down' }}">
            {{ pct >= 0 ? '▲' : '▼' }} {{ pct|abs|number_format(1, ',', '.') }}%
        </span>
    {% else %}
        <span class="rp-delta is-none">—</span>
    {% endif %}
{% endmacro %}
{% import _self as f %}

{% block content %}
<div class="rp-page">

    {# ── Hero ── #}
    <div class="rp-hero">
        <div class="rp-hero-content">
            <div class="rp-hero-left">
                <div class="rp-hero-icon">
                    <svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
                </div>
                <div>
                    <h1 class="rp-hero-title">Andamento fatturato</h1>
                    <p class="rp-hero-sub">Dati dal gestionale Business · per {{ criterioData == 'reg' ? 'data registrazione' : 'data documento' }}</p>
                </div>
            </div>
            <form method="GET" class="rp-year-form">
                <label>Dal</label>
                <select name="da_anno">
                    {% for y in (aAnno - 9)..aAnno %}
                        <option value="{{ y }}" {{ y == daAnno ? 'selected' : '' }}>{{ y }}</option>
                    {% endfor %}
                </select>
                <label>al</label>
                <select name="a_anno">
                    {% for y in (aAnno - 9)..(aAnno + 1) %}
                        <option value="{{ y }}" {{ y == aAnno ? 'selected' : '' }}>{{ y }}</option>
                    {% endfor %}
                </select>
                <select name="data" title="Quale data usare per assegnare i documenti al mese">
                    <option value="doc" {{ criterioData != 'reg' ? 'selected' : '' }}>Data documento</option>
                    <option value="reg" {{ criterioData == 'reg' ? 'selected' : '' }}>Data registrazione</option>
                </select>
                <button type="submit">Mostra</button>
            </form>
        </div>
    </div>

    {% if errore %}
        <div class="rp-alert">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
                <strong>Dati non disponibili.</strong> {{ errore }}<br>
                <small>I totali qui sotto sono a zero perché la lettura non è riuscita, non perché non ci sia stato fatturato.</small>
            </div>
        </div>
    {% endif %}

    {% set tOggi = totali[annoTop] ?? {'entrate':0,'uscite':0,'saldo':0,'iva_vendite':0,'iva_acquisti':0} %}
    {% set tPrec = totali[annoPrec] ?? null %}

    {# Il confronto fra anni va fatto sullo STESSO periodo. Su un anno in
       corso si fermano tutti e due al mese che stiamo vivendo: prima
       l'anno a meta' veniva paragonato all'anno prima intero, e usciva
       sempre un calo che non esiste. #}
    {% set riferimento = annoInCorso ? 'periodo' : 'anno' %}
    {% set pOggi = annoInCorso ? tOggi.entrate_periodo : tOggi.entrate %}
    {% set pPrec = tPrec ? (annoInCorso ? tPrec.entrate_periodo : tPrec.entrate) : null %}
    {% set uOggi = annoInCorso ? tOggi.uscite_periodo : tOggi.uscite %}
    {% set uPrec = tPrec ? (annoInCorso ? tPrec.uscite_periodo : tPrec.uscite) : null %}
    {% set sOggiTot = annoInCorso ? tOggi.saldo_periodo : tOggi.saldo %}
    {% set sPrecTot = tPrec ? (annoInCorso ? tPrec.saldo_periodo : tPrec.saldo) : null %}

    {% if annoInCorso %}
        <p class="rp-nota-periodo">
            Il confronto con {{ annoPrec }} si ferma a <strong>{{ meseNome }}</strong>,
            per paragonare lo stesso periodo. I totali grandi sono invece tutto
            quello fatturato finora.
        </p>
    {% endif %}

    {# ── Card principali ── #}
    <div class="rp-cards">
        <div class="rp-card is-in">
            <div class="rp-card-lbl">Entrate {{ annoTop }}</div>
            <div class="rp-card-val">€ {{ tOggi.entrate|number_format(0, ',', '.') }}</div>
            <div class="rp-card-foot">
                {{ f.delta(pOggi, pPrec) }}
                <span class="rp-card-ref">
                    vs {{ annoPrec }}{{ annoInCorso ? ' (a ' ~ meseNome ~ ')' : '' }}:
                    € {{ (pPrec ?: 0)|number_format(0, ',', '.') }}
                </span>
            </div>
        </div>
        <div class="rp-card is-out">
            <div class="rp-card-lbl">Uscite {{ annoTop }}</div>
            <div class="rp-card-val">€ {{ tOggi.uscite|number_format(0, ',', '.') }}</div>
            <div class="rp-card-foot">
                {{ f.delta(uOggi, uPrec) }}
                <span class="rp-card-ref">
                    vs {{ annoPrec }}{{ annoInCorso ? ' (a ' ~ meseNome ~ ')' : '' }}:
                    € {{ (uPrec ?: 0)|number_format(0, ',', '.') }}
                </span>
            </div>
        </div>
        <div class="rp-card is-saldo">
            <div class="rp-card-lbl">Saldo {{ annoTop }}</div>
            <div class="rp-card-val {{ tOggi.saldo < 0 ? 'is-neg' : '' }}">€ {{ tOggi.saldo|number_format(0, ',', '.') }}</div>
            <div class="rp-card-foot">
                {{ f.delta(sOggiTot, sPrecTot) }}
                <span class="rp-card-ref">
                    vs {{ annoPrec }}{{ annoInCorso ? ' (a ' ~ meseNome ~ ')' : '' }}:
                    € {{ (sPrecTot ?: 0)|number_format(0, ',', '.') }}
                </span>
            </div>
        </div>
    </div>

    {# ── Grafico ── #}
    <div class="rp-panel">
        <div class="rp-panel-head">
            <h3 class="rp-panel-title">Confronto mensile</h3>
            <div class="rp-switch" id="rp-switch">
                <button type="button" class="on" data-serie="entrate">Entrate</button>
                <button type="button" data-serie="uscite">Uscite</button>
                <button type="button" data-serie="saldo">Saldo</button>
            </div>
        </div>
        <div class="rp-chart-wrap">
            <canvas id="rp-chart"
                    data-mesi='{{ mesi|json_encode }}'
                    data-serie='{{ serie|json_encode }}'></canvas>
        </div>
    </div>

    {# ── Tabella mensile ── #}
    <div class="rp-panel">
        <div class="rp-panel-head">
            <h3 class="rp-panel-title">Dettaglio mensile {{ annoTop }}</h3>
            <span class="rp-panel-note">Clicca un mese per vedere da quali causali arrivano i totali</span>
        </div>
        <div class="rp-table-wrap">
            <table class="rp-table">
                <thead>
                    <tr>
                        <th>Mese</th>
                        <th class="right">Entrate</th>
                        <th class="right">Uscite</th>
                        <th class="right">Saldo</th>
                        <th class="right">Entrate {{ annoPrec }}</th>
                        <th class="right">Var.</th>
                    </tr>
                </thead>
                <tbody>
                {% set sOggi = serie[annoTop] ?? null %}
                {% set sPrec = serie[annoPrec] ?? null %}
                {% for i in 0..11 %}
                    {% set e  = sOggi ? sOggi.entrate[i] : 0 %}
                    {% set u  = sOggi ? sOggi.uscite[i]  : 0 %}
                    {% set s  = e - u %}
                    {% set ep = sPrec ? sPrec.entrate[i] : 0 %}
                    <tr class="rp-row" data-mese="{{ i + 1 }}" data-anno="{{ annoTop }}">
                        <td class="rp-mese">{{ mesi[i] }}</td>
                        <td class="right">€ {{ e|number_format(0, ',', '.') }}</td>
                        <td class="right rp-out">€ {{ u|number_format(0, ',', '.') }}</td>
                        <td class="right {{ s < 0 ? 'rp-neg' : 'rp-pos' }}">€ {{ s|number_format(0, ',', '.') }}</td>
                        <td class="right rp-muted">€ {{ ep|number_format(0, ',', '.') }}</td>
                        <td class="right">{{ f.delta(e, ep) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td>Totale</td>
                        <td class="right">€ {{ tOggi.entrate|number_format(0, ',', '.') }}</td>
                        <td class="right">€ {{ tOggi.uscite|number_format(0, ',', '.') }}</td>
                        <td class="right {{ tOggi.saldo < 0 ? 'rp-neg' : 'rp-pos' }}">€ {{ tOggi.saldo|number_format(0, ',', '.') }}</td>
                        <td class="right rp-muted">€ {{ (tPrec ? tPrec.entrate : 0)|number_format(0, ',', '.') }}</td>
                        <td class="right">{{ f.delta(tOggi.entrate, tPrec ? tPrec.entrate : null) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    {# ── Confronto tra anni ── #}
    <div class="rp-panel">
        <div class="rp-panel-head">
            <h3 class="rp-panel-title">Totali per anno</h3>
        </div>
        <div class="rp-table-wrap">
            <table class="rp-table">
                <thead>
                    <tr>
                        <th>Anno</th>
                        <th class="right">Entrate</th>
                        <th class="right">Uscite</th>
                        <th class="right">Saldo</th>
                        {# L'IVA dei due registri, al posto di "gia' incassato" e
                           "gia' pagato": quelli stavano sulle testate dei
                           documenti, nel registro IVA non ci sono, e mostrarli
                           a zero sarebbe peggio che non mostrarli. Quanto e'
                           stato incassato davvero sta nello scadenzario. #}
                        <th class="right">IVA vendite</th>
                        <th class="right">IVA acquisti</th>
                    </tr>
                </thead>
                <tbody>
                {% for y, t in totali|reverse(true) %}
                    <tr>
                        <td class="rp-mese">{{ y }}</td>
                        <td class="right">€ {{ t.entrate|number_format(0, ',', '.') }}</td>
                        <td class="right rp-out">€ {{ t.uscite|number_format(0, ',', '.') }}</td>
                        <td class="right {{ t.saldo < 0 ? 'rp-neg' : 'rp-pos' }}">€ {{ t.saldo|number_format(0, ',', '.') }}</td>
                        <td class="right rp-muted">€ {{ t.iva_vendite|number_format(0, ',', '.') }}</td>
                        <td class="right rp-muted">€ {{ t.iva_acquisti|number_format(0, ',', '.') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

{# Modale dettaglio causali — fuori da qualsiasi contenitore con transform #}
<div id="rp-modal" class="rp-modal" aria-hidden="true" hidden>
    <div class="rp-modal-box" role="dialog" aria-modal="true">
        <div class="rp-modal-head">
            <h3 class="rp-modal-title" id="rp-modal-title">Dettaglio</h3>
            <button type="button" class="rp-modal-close" data-rp-close aria-label="Chiudi">&times;</button>
        </div>
        <div class="rp-modal-body" id="rp-modal-body">
            <div class="rp-loading">Caricamento…</div>
        </div>
    </div>
</div>

    {# ── Chi ci ha pagato, chi abbiamo pagato ──
       Il totale in una riga sola non risponde alla domanda vera, che e'
       "con chi": qui una riga per controparte, ordinata per importo. #}
    <div class="rp-panel" id="rp-controparti">
        <div class="rp-panel-head">
            <h2 class="rp-panel-title">Chi ci ha pagato, chi abbiamo pagato</h2>
            <div class="rp-cp-cmd">
                <div class="rp-switch">
                    <button type="button" class="on" data-registro="V">Clienti</button>
                    <button type="button" data-registro="A">Fornitori</button>
                </div>
                <select id="rp-cp-anno" class="rp-cp-sel">
                    {% for a in anni %}
                        <option value="{{ a }}" {{ a == annoTop ? 'selected' : '' }}>{{ a }}</option>
                    {% else %}
                        <option value="{{ annoTop }}" selected>{{ annoTop }}</option>
                    {% endfor %}
                </select>
                <select id="rp-cp-mese" class="rp-cp-sel">
                    <option value="0">Tutto l'anno</option>
                    {% for i, m in mesi %}
                        <option value="{{ i + 1 }}">{{ m }}</option>
                    {% endfor %}
                </select>
                <input type="text" id="rp-cp-cerca" class="rp-cp-sel" placeholder="Cerca un nome…">
            </div>
        </div>
        <div id="rp-cp-corpo" class="rp-table-wrap">
            <div class="rp-empty">Carico…</div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
{# Chart.js si carica qui. Il commento in fatturato.js diceva che stava
   gia' nel bundle del template: il codice c'e' dentro, ma il bundle non
   lo espone come variabile globale, quindi la pagina scriveva "Libreria
   grafici non disponibile" e basta. Dal CDN, con il nonce perche' la CSP
   di BOB non ha 'unsafe-inline', e con la versione fissata: cdnjs e'
   gia' fra le sorgenti consentite. #}
<script nonce="{{ cspNonce }}"
        src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="/assets/js/views/report/fatturato.js?v=5"></script>
{% endblock %}
