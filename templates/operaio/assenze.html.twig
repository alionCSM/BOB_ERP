{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/operaio/operaio.css?v=5">
{% endblock %}

{#
  Ferie, permessi e malattia.

  Tutto nella stessa pagina perche' per chi la usa e' la stessa domanda:
  "quel giorno non ci sono". Cambia solo il perche', e il perche' decide
  quali campi servono.
#}
{% block content %}
<div class="op">

    <div class="op-testa">
        <h1 class="op-titolo">{{ t('menu_assenze') }}</h1>
        <p class="op-sotto">{{ t('chiesto_e_dato') }}</p>
    </div>

    {% if successMsg %}
        <div class="op-avviso op-avviso-ok" role="status">
            <svg viewBox="0 0 24 24" class="op-avviso-i"><path d="M20 6L9 17l-5-5"/></svg>
            <div>{{ successMsg }}</div>
        </div>
    {% endif %}
    {% if errorMsg %}
        <div class="op-avviso op-avviso-ko" role="alert">
            <svg viewBox="0 0 24 24" class="op-avviso-i"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 16h.01"/></svg>
            <div>{{ errorMsg }}</div>
        </div>
    {% endif %}

    <div class="op-colonne">
    <div>
    <details class="op-apri">
        <summary>{{ t('chiedi_ferie') }}</summary>
        <div class="op-card">
            <form method="POST" action="/io/assenze">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                <div class="op-campo">
                    <label>{{ t('di_cosa') }}</label>
                    <div class="op-scelte">
                        <label class="op-scelta">
                            <input type="radio" name="tipo" value="ferie" checked data-tipo>
                            <span>{{ t('ferie') }}</span>
                        </label>
                        <label class="op-scelta">
                            <input type="radio" name="tipo" value="permesso" data-tipo>
                            <span>{{ t('permesso') }}</span>
                        </label>
                        <label class="op-scelta">
                            <input type="radio" name="tipo" value="malattia" data-tipo>
                            <span>{{ t('malattia') }}</span>
                        </label>
                    </div>
                </div>

                <div class="op-campo">
                    <label for="a-dal">{{ t('dal') }}</label>
                    <input type="date" id="a-dal" name="dal" required>
                </div>

                <div class="op-campo">
                    <label for="a-al">{{ t('al') }}</label>
                    <input type="date" id="a-al" name="al">
                    <span class="op-aiuto">{{ t('vuoto_un_giorno') }}</span>
                </div>

                {# Le ore solo sul permesso, il certificato solo sulla
                   malattia: i campi che non servono non si vedono, e quello
                   che resta scritto in uno nascosto non parte. #}
                <div class="op-campo" data-solo="permesso" hidden>
                    <label for="a-ore">{{ t('quante_ore') }}</label>
                    <input type="number" id="a-ore" name="ore" step="0.5" min="0.5" max="12" placeholder="es. 4">
                    <span class="op-aiuto">{{ t('vuoto_intera') }}</span>
                </div>

                <div class="op-campo" data-solo="malattia" hidden>
                    <label for="a-prot">{{ t('n_certificato') }}</label>
                    <input type="text" id="a-prot" name="protocollo" maxlength="32" placeholder="es. 1234567890">
                    <span class="op-aiuto">{{ t('cert_dopo') }}</span>
                </div>

                <div class="op-campo">
                    <label for="a-note">{{ t('note') }}</label>
                    <textarea id="a-note" name="note" placeholder="{{ t('note_qualcosa') }}"></textarea>
                </div>

                <button type="submit" class="op-btn op-btn-primo">{{ t('manda') }}</button>
            </form>
        </div>
    </details>

    </div>

    <div>
    <div class="op-sez">{{ t('tue_assenze') }}</div>

    {# Le ferie si contano per anno: nessuno chiede quante ne ha prese a
       marzo. L'elenco mostra solo gli anni in cui ha qualcosa. #}
    <form method="GET" class="op-mese">
        <select name="anno" id="op-anno-sel" aria-label="{{ t('anno') }}">
            {% for a in anni %}
                <option value="{{ a }}"{{ a == anno ? ' selected' : '' }}>{{ a }}</option>
            {% else %}
                <option value="{{ anno }}" selected>{{ anno }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="op-btn op-btn-secondo op-btn-piccolo">{{ t('vai') }}</button></noscript>
    </form>

    <div class="op-conti">
        <div class="op-conto">
            <div class="op-conto-n">{{ contiAnno.ferie }}</div>
            <div class="op-conto-e">{{ t('giorni_ferie') }}</div>
        </div>
        {% if contiAnno.permessi_ore or contiAnno.permessi_giorni %}
            <div class="op-conto">
                <div class="op-conto-n">
                    {{ contiAnno.permessi_ore ? contiAnno.permessi_ore|number_format(contiAnno.permessi_ore == contiAnno.permessi_ore|round ? 0 : 1, ',', '.') ~ 'h' : contiAnno.permessi_giorni }}
                </div>
                <div class="op-conto-e">{{ t('permessi') }}</div>
            </div>
        {% endif %}
        {% if contiAnno.malattia %}
            <div class="op-conto">
                <div class="op-conto-n">{{ contiAnno.malattia }}</div>
                <div class="op-conto-e">{{ t('giorni_malattia') }}</div>
            </div>
        {% endif %}
        {% if contiAnno.attesa %}
            <div class="op-conto">
                <div class="op-conto-n">{{ contiAnno.attesa }}</div>
                <div class="op-conto-e">{{ t('in_attesa_n') }}</div>
            </div>
        {% endif %}
    </div>

    {% if righe|length > 5 %}
        <div class="op-campo op-cerca">
            <input type="search" id="op-filtro" placeholder="{{ t('cerca_assenza') }}"
                   autocomplete="off" aria-label="{{ t('cerca_assenza') }}">
        </div>
    {% endif %}

    <div id="op-elenco">

    {% for r in righe %}
        <div class="op-voce" data-cerca="{{ (r.tipo ~ ' ' ~ r.data_inizio|date('d/m/Y') ~ ' ' ~ r.data_fine|date('d/m/Y') ~ ' ' ~ r.stato ~ ' ' ~ (r.protocollo ?: ''))|lower|e('html_attr') }}">
            <div class="op-voce-testa">
                <div>
                    <div class="op-data">
                        {{ r.data_inizio|date('d/m/Y') }}{% if r.data_fine != r.data_inizio %} → {{ r.data_fine|date('d/m/Y') }}{% endif %}
                    </div>
                    <div class="op-dove">
                        <span class="op-tag op-tag-{{ r.tipo }}">{{ t(r.tipo) }}</span>
                        {% if r.ore %} · {{ r.ore }} {{ t('ore') }}{% endif %}
                        {% if r.protocollo %} · {{ t('cert') }} {{ r.protocollo }}{% endif %}
                    </div>
                </div>
                {% if r.stato == 'approvata' %}
                    <span class="op-tag op-tag-ok">{{ r.tipo == 'malattia' ? t('registrata') : t('approvata') }}</span>
                {% elseif r.stato == 'rifiutata' %}
                    <span class="op-tag op-tag-ko">{{ r.tipo == 'malattia' ? t('non_accettata') : t('rifiutata') }}</span>
                {% else %}
                    <span class="op-tag op-tag-attesa">{{ t('in_attesa') }}</span>
                {% endif %}
            </div>

            {% if r.motivo %}
                <div class="op-motivo">{{ r.motivo }}</div>
            {% endif %}
            {% if r.note %}
                <div class="op-dove" style="margin-top:8px;">{{ r.note }}</div>
            {% endif %}
        </div>
    {% else %}
        <div class="op-vuoto">
            {{ t('nessuna_assenza') }}
        </div>
    {% endfor %}
    </div>
    <div class="op-vuoto" id="op-niente" hidden>{{ t('nessuna_assenza_trovata') }}</div>

    </div>
    </div>

    <a href="/io" class="op-btn op-btn-secondo op-torna">{{ t('torna') }}</a>

</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/views/operaio/assenze.js?v=2"></script>
{% endblock %}
