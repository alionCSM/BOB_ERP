{% extends 'layout/base.html.twig' %}

{% block head %}
<link rel="stylesheet" href="/assets/css/views/operaio/operaio.css?v=4">
{% endblock %}

{#
  Dove vai, con chi, chi comanda.

  La prima schermata risponde alla domanda che uno si fa davvero la sera —
  "domani dove vado?" — e non gliene fa nessuna. Oggi e domani insieme:
  la sera si guarda domani, la mattina si guarda oggi.
#}
{% block content %}
<div class="op">

    <div class="op-testa">
        <h1 class="op-titolo">Ciao {{ user.first_name }}</h1>
        <p class="op-sotto">Oggi e domani</p>
    </div>

    {# I giorni che mancano in cima, con il bottone per rimediare: e' la
       cosa che costa soldi a tutti se resta li'. #}
    {% if daDichiarare %}
        <div class="op-avviso op-avviso-att">
            <svg viewBox="0 0 24 24" class="op-avviso-i"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            <div>
                Ti manca{{ daDichiarare|length > 1 ? 'no' : '' }}
                {{ daDichiarare|length }} giornat{{ daDichiarare|length > 1 ? 'e' : 'a' }}:
                {% for g in daDichiarare %}{{ g.data|date('d/m') }}{{ not loop.last ? ', ' : '' }}{% endfor %}
                <a href="/io/presenze" class="op-btn op-btn-primo op-btn-stretto op-avviso-b">Segnale</a>
            </div>
        </div>
    {% endif %}

    <div class="op-colonne">
    {% for g in giorni %}
        <div class="op-card{{ g.data == oggi ? ' oggi' : '' }}">

            <div class="op-giorno">
                {{ g.data == oggi ? 'Oggi' : 'Domani' }} · {{ g.data|date('d/m/Y') }}
            </div>

            <div class="op-cantiere">
                {{ g.cantiere_nome ?: g.cantiere ?: 'Cantiere da definire' }}
            </div>
            {% if g.location or g.worksite_code %}
                <div class="op-luogo">
                    {{ g.worksite_code }}{{ g.worksite_code and g.location ? ' · ' : '' }}{{ g.location }}
                </div>
            {% endif %}

            <div class="op-righe">
                {% if g.auto_targa %}
                    <div class="op-riga"><span class="op-et">Auto</span><b>{{ g.auto_targa }}</b></div>
                {% endif %}
                {% if g.trasferta %}
                    <div class="op-riga">
                        <span class="op-et">Trasferta</span>
                        <span class="op-tag op-tag-trasferta">Si dorme fuori</span>
                    </div>
                {% endif %}
                {% if g.sei_capo %}
                    <div class="op-riga">
                        <span class="op-et">Squadra</span>
                        <span class="op-tag op-tag-ok">Sei tu il capo</span>
                    </div>
                {% endif %}
            </div>

            {# La squadra la vedono tutti: sono i tre o quattro con cui uno
               sale in macchina domattina, non centoquaranta sconosciuti. #}
            {% if g.squadra|length > 1 %}
                <div class="op-squadra">
                    <div class="op-squadra-t">Con te ci sono</div>
                    {% for p in g.squadra %}
                        <div class="op-persona">
                            <span class="{{ p.sei_tu ? 'op-tu' : '' }}">{{ p.sei_tu ? 'Tu' : p.nome }}</span>
                            {% if p.capo_squadra %}<span class="op-capo">capo</span>{% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="op-card">
            <div class="op-vuoto">
                Per oggi e domani non risulti in nessuna squadra.<br>
                Se non torna, chiedi in ufficio.
            </div>
        </div>
    {% endfor %}
    </div>

    <div class="op-sez">Cosa puoi fare</div>
    <div class="op-azioni">
        <a href="/io/presenze" class="op-btn op-btn-primo">Le mie presenze</a>
        <a href="/io/assenze"  class="op-btn op-btn-secondo">Ferie e assenze</a>
    </div>

</div>
{% endblock %}
