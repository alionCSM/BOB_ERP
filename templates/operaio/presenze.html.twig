{% extends 'layout/base.html.twig' %}

{% block head %}
<link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/views/operaio/operaio.css?v=3">
{% endblock %}

{#
  Le mie presenze.

  Tre blocchi, in ordine di quanto servono: quello che manca, il modulo per
  tutto il resto, lo storico.

  Il primo e' il cuore. Per una giornata normale — intera, niente pasti,
  niente albergo — non si compila niente: il giorno lo sappiamo, il cantiere
  lo sappiamo dalla pianificazione, e resta un bottone. Nove volte su dieci
  finisce li'. Il modulo sotto esiste per la decima.
#}
{% block content %}
<div class="op">

    <div class="op-testa">
        <h1 class="op-titolo">Le mie presenze</h1>
        <p class="op-sotto">Ultimi due mesi</p>
    </div>

    {% if successMsg %}
        <div class="op-avviso op-avviso-ok" role="status">
            <svg viewBox="0 0 24 24" class="op-avviso-i"><path d="M20 6L9 17l-5-5"/></svg>
            <div>{{ successMsg }}</div>
        </div>
    {% endif %}
    {% if errorMsg %}
        <div class="op-avviso op-avviso-ko" role="alert">
            <svg viewBox="0 0 24 24" class="op-avviso-i"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 16h.01"/></svg>
            <div>{{ errorMsg }}</div>
        </div>
    {% endif %}

    <div class="op-colonne">
        <div>

            {# ── Quello che manca: un tocco e basta ── #}
            {% if daSegnare %}
                <div class="op-sez">Da segnare — {{ daSegnare|length }}</div>

                {% for g in daSegnare %}
                    <div class="op-manca">
                        <div class="op-manca-d">
                            <div class="op-manca-g">{{ g.data|date('d/m') }}</div>
                            <div class="op-manca-c">
                                {% if g.worksite_id %}
                                    {{ g.cantiere_codice }} — {{ g.cantiere_nome }}
                                {% else %}
                                    Cantiere da scegliere
                                {% endif %}
                            </div>
                        </div>

                        {# Col cantiere noto si manda e basta. Senza, si apre
                           il modulo gia' su quel giorno. #}
                        {% if g.worksite_id %}
                            <form method="POST" action="/io/presenze">
                                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                                <input type="hidden" name="data" value="{{ g.data }}">
                                <input type="hidden" name="worksite_id" value="{{ g.worksite_id }}">
                                <input type="hidden" name="turno" value="Intero">
                                <button type="submit" class="op-btn op-btn-primo op-btn-stretto">
                                    Giornata intera
                                </button>
                            </form>
                        {% else %}
                            <button type="button" class="op-btn op-btn-secondo op-btn-stretto"
                                    data-apri-modulo="{{ g.data }}">Scegli</button>
                        {% endif %}
                    </div>
                {% endfor %}

                <p class="op-nota">
                    Mezza giornata, o hai mangiato fuori? Usa
                    <b>Segna un altro giorno</b> qui sotto.
                </p>
            {% endif %}

            {# ── Il modulo, per tutto il resto ── #}
            <details class="op-apri" id="op-modulo">
                <summary>{{ daSegnare ? 'Segna un altro giorno' : 'Segna una giornata' }}</summary>
                <div class="op-card">
                    <form method="POST" action="/io/presenze">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                        <div class="op-campo">
                            <label for="p-data">Che giorno</label>
                            <input type="date" id="p-data" name="data" max="{{ oggi }}" value="{{ oggi }}" required>
                        </div>

                        <div class="op-campo">
                            <label>Dove hai lavorato</label>

                            <div id="p-proposta" class="op-proposta" hidden>
                                <div class="op-proposta-t">Quel giorno eri qui</div>
                                <div class="op-proposta-n"></div>
                                <button type="button" class="op-proposta-no">Non era questo cantiere</button>
                            </div>

                            <div id="p-cerca" hidden>
                                {# senza name: la scelta la scrive nel campo
                                   nascosto qui sotto, che e' l'unico che parte #}
                                <select id="p-cantiere" placeholder="Scrivi il nome o il codice…"></select>
                                <span class="op-aiuto">Scrivi almeno due lettere e aspetta un attimo</span>
                            </div>

                            <input type="hidden" name="worksite_id" id="p-scelto" value="">
                        </div>

                        <div class="op-campo">
                            <label>Quanto hai lavorato</label>
                            <div class="op-scelte">
                                <label class="op-scelta">
                                    <input type="radio" name="turno" value="Intero" checked>
                                    <span>Giornata intera</span>
                                </label>
                                <label class="op-scelta">
                                    <input type="radio" name="turno" value="Mezzo">
                                    <span>Mezza giornata</span>
                                </label>
                            </div>
                        </div>

                        {# Pasti, albergo, auto e note stanno chiusi: nove
                           giornate su dieci non hanno niente da metterci, e
                           quattro campi vuoti da scorrere ogni volta sono
                           quattro campi di troppo. #}
                        <details class="op-extra">
                            <summary>Pasti, albergo, auto</summary>

                            <div class="op-campo">
                                <label>Pranzo — chi ha pagato?</label>
                                <div class="op-scelte">
                                    <label class="op-scelta">
                                        <input type="radio" name="pranzo" value="" checked>
                                        <span>Non l'ho fatto</span>
                                    </label>
                                    <label class="op-scelta">
                                        <input type="radio" name="pranzo" value="io">
                                        <span>Io</span>
                                    </label>
                                    <label class="op-scelta">
                                        <input type="radio" name="pranzo" value="azienda">
                                        <span>L'azienda</span>
                                    </label>
                                </div>
                            </div>

                            <div class="op-campo">
                                <label>Cena — chi ha pagato?</label>
                                <div class="op-scelte">
                                    <label class="op-scelta">
                                        <input type="radio" name="cena" value="" checked>
                                        <span>Non l'ho fatto</span>
                                    </label>
                                    <label class="op-scelta">
                                        <input type="radio" name="cena" value="io">
                                        <span>Io</span>
                                    </label>
                                    <label class="op-scelta">
                                        <input type="radio" name="cena" value="azienda">
                                        <span>L'azienda</span>
                                    </label>
                                </div>
                            </div>

                            <div class="op-campo">
                                <label class="op-spunta">
                                    <input type="checkbox" name="trasferta" value="1">
                                    <span>Ho dormito fuori</span>
                                </label>
                            </div>

                            <div class="op-campo">
                                <label for="p-hotel">Albergo</label>
                                <input type="text" id="p-hotel" name="hotel" placeholder="Nome, se hai dormito fuori">
                            </div>

                            <div class="op-campo">
                                <label for="p-auto">Auto</label>
                                <input type="text" id="p-auto" name="targa_auto" placeholder="Targa">
                            </div>

                            <div class="op-campo">
                                <label for="p-note">Note</label>
                                <textarea id="p-note" name="note" placeholder="Se c'e' qualcosa da dire all'ufficio"></textarea>
                            </div>
                        </details>

                        <button type="submit" class="op-btn op-btn-primo">Manda in ufficio</button>
                        <span class="op-aiuto op-centro">La controlla l'ufficio prima di registrarla.</span>
                    </form>
                </div>
            </details>

        </div>

        {# ── Lo storico ── #}
        <div>
            <div class="op-sez">Le tue giornate</div>

            {% for r in righe %}
                <div class="op-voce">
                    <div class="op-voce-testa">
                        <div>
                            <div class="op-data">{{ r.data|date('d/m/Y') }}</div>
                            <div class="op-dove">
                                {{ r.cantiere_codice ? r.cantiere_codice ~ ' · ' : '' }}{{ r.cantiere_nome ?: 'cantiere non indicato' }}
                                {% if r.turno == 'Mezzo' %} · mezza giornata{% endif %}
                            </div>
                        </div>
                        {% if r.stato == 'registrata' %}
                            <span class="op-tag op-tag-ok">registrata</span>
                        {% elseif r.stato == 'in_attesa' %}
                            <span class="op-tag op-tag-attesa">in attesa</span>
                        {% else %}
                            <span class="op-tag op-tag-ko">rifiutata</span>
                        {% endif %}
                    </div>

                    {% if r.motivo %}
                        <div class="op-motivo"><b>Rifiutata:</b> {{ r.motivo }}</div>
                    {% endif %}

                    {# Si ritira solo finche' l'ufficio non ha deciso: dopo
                       vorrebbe dire cancellare una decisione altrui. #}
                    {% if r.stato == 'in_attesa' %}
                        <form method="POST" action="/io/presenze/{{ r.richiesta_id }}/ritira"
                              class="op-voce-azione" data-confirm="Ritirare questa giornata?">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                            <button type="submit" class="op-btn op-btn-secondo op-btn-piccolo">Ritira</button>
                        </form>
                    {% endif %}
                </div>
            {% else %}
                <div class="op-vuoto">Nessuna giornata negli ultimi due mesi.</div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="/assets/js/views/operaio/presenze.js?v=2"></script>
{% endblock %}
